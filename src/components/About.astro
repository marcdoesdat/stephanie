---
import IconeSection from './IconeSection.astro';
import { Image } from 'astro:assets';
import stephaniePhoto from '../assets/stephanie-2.webp';
import { loadSiteConfig } from '../config';
import { Handshake, Zap, BadgeCheck } from '@lucide/astro';

const config = loadSiteConfig();
const prenom = config.nom.split(' ')[0];
---

<div class="section-inner">
    <div class="apropos-grid">

      <div class="apropos-img fade-left">
        <Image
          src={stephaniePhoto}
          alt={`${config.nom}, ${config.titre} chez ${config.organisation} à Repentigny`}
          width={500}
          height={500}
          loading="lazy"
          decoding="async"
        />
      </div>
      
      <div class="fade-right" style="transition-delay:.15s">
        <div class="apropos-text">
          <IconeSection nom="apropos" />
          <h2>Bonjour, moi c'est {prenom}.</h2>

          <p>
            Courtière hypothécaire chez <strong>Hypotheca</strong> depuis quatre ans, j'accompagne des clients partout au <strong>Québec</strong>, à partir de <strong>Repentigny</strong>, au cœur de <strong>Lanaudière</strong> — pour l'une des décisions financières les plus importantes de leur vie.
          </p>
          <p>
            Mon approche est simple : je prends le temps de comprendre votre situation, vos
            objectifs et vos contraintes avant même de parler de taux. Parce qu'une bonne
            hypothèque, c'est d'abord une hypothèque qui vous ressemble.
          </p>
          <p>
            Première propriété, renouvellement, ou un non de votre banque? Chaque situation
            mérite qu'on explore toutes les options ensemble — et c'est exactement mon rôle.
          </p>
          
          <ul class="apropos-values">
            <li class="val-item">
              <span class="val-icon" aria-hidden="true"><Handshake size={18} stroke-width={1.8} /></span>
              <span>Transparence sur les taux et les conditions, du début à la fin</span>
            </li>
            <li class="val-item">
              <span class="val-icon" aria-hidden="true"><Zap size={18} stroke-width={1.8} /></span>
              <span>Réponse rapide et accompagnement jusqu'à la signature</span>
            </li>
            <li class="val-item">
              <span class="val-icon" aria-hidden="true"><BadgeCheck size={18} stroke-width={1.8} /></span>
              <span>Dans la plupart des cas, mes services ne vous coûtent rien : je suis rémunérée par le prêteur</span>
            </li>
          </ul>

          <!-- L'essentiel en quatre lignes, en clôture du texte : après « Bonjour », un résumé
               arrivait avant que rien n'ait été dit, et son titre-affiche disputait la place
               au titre de la section. Rien ici qui ne soit dit ailleurs sur la page : mêmes
               mots pour les frais (« dans la plupart des cas ») et pour l'accompagnement
               (Teams, téléphone ou texto). -->
          <div class="apropos-bref">
            <!-- « Bref » en français, « TLDR » en anglais (dictionnaire) : le ton est voulu
                 jeune, et le mot est traité en affiche. L'émoji est décoratif, hors du texte à traduire. -->
            <div class="apropos-bref-tete">
              <h3 class="apropos-bref-titre" id="apropos-bref-titre">Bref</h3>
              <span class="apropos-bref-emoji" aria-hidden="true">🤑</span>
            </div>
            <dl aria-labelledby="apropos-bref-titre">
              <div>
                <dt>Rôle</dt>
                <dd>Courtière hypothécaire chez {config.organisation} depuis quatre ans</dd>
              </div>
              <div>
                <dt>Prêteurs</dt>
                <dd>Plus de 20 comparés pour vous</dd>
              </div>
              <div>
                <dt>Où</dt>
                <dd>Partout au Québec, par Teams, téléphone ou texto</dd>
              </div>
              <div>
                <dt>Frais</dt>
                <dd>0&nbsp;$ pour vous dans la plupart des cas</dd>
              </div>
            </dl>
          </div>


        </div>
      </div>

    </div>
  </div>

<style>
  .apropos-text h2 {
    font-family:var(--font-display);
    font-size: 2rem;
    font-style: italic;
    color: var(--clay);
    margin-bottom: 1.2rem;
  }


  /* « Bref » : une carte lilas sur le fond vert de la section, deux colonnes sur
     ordinateur, une seule sur téléphone. */
  .apropos-bref {
    background: var(--lilac);
    border-radius: var(--radius-lg);
    padding: 2rem 2.1rem 2.1rem;
    margin-top: 2.4rem;
  }
  /* Le titre est un mot-affiche : très gros, très gras, l'émoji à sa taille. */
  .apropos-bref-tete {
    display: flex;
    align-items: center;
    gap: 0.12em;
    font-size: clamp(3.2rem, 7vw, 4.6rem);
    margin-bottom: 1.4rem;
  }
  .apropos-text .apropos-bref-titre {
    font-family: var(--font-display);
    font-size: 1em;
    font-weight: 800;
    font-style: normal;
    letter-spacing: -0.03em;
    text-transform: uppercase;
    line-height: 0.9;
    color: var(--ink);
    margin: 0;
  }
  /* L'émoji tourne avec le défilement : c'est le script au bas du composant qui pose
     l'angle, proportionnel à la position de la page. Aucune animation qui tourne seule —
     page immobile, émoji immobile. Sans JavaScript ou sous prefers-reduced-motion, il
     reste droit. */
  .apropos-bref-emoji {
    display: inline-block;
    font-size: 0.92em;
    line-height: 1;
    transform-origin: 50% 50%;
    will-change: transform;
  }
  .apropos-bref dl {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 1.15rem 1.75rem;
    margin: 0;
  }
  .apropos-bref dt {
    font-size: 0.72rem;
    font-weight: 700;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: var(--ink);
    opacity: 0.68;
    margin-bottom: 0.25rem;
  }
  .apropos-bref dd {
    margin: 0;
    font-size: 1.02rem;
    font-weight: 600;
    line-height: 1.4;
    color: var(--ink);
  }
  @media (max-width: 600px) {
    .apropos-bref { padding: 1.6rem 1.4rem 1.7rem; }
    .apropos-bref dl { grid-template-columns: 1fr; gap: 0.85rem; }
  }
</style>

<script>
  // L'émoji de « Bref » tourne au rythme du défilement : un tour complet par 720 px,
  // dans le sens des aiguilles en descendant, à rebours en remontant. L'angle est lu sur
  // la position de la page, pas accumulé : revenir au même endroit redonne le même angle.
  // On n'écoute le défilement que lorsque l'émoji est à l'écran, et on n'écrit qu'une fois
  // par image.
  const DEGRES_PAR_PIXEL = 0.5;
  const emoji = document.querySelector<HTMLElement>('.apropos-bref-emoji');
  const calme = window.matchMedia('(prefers-reduced-motion: reduce)');

  if (emoji && 'IntersectionObserver' in window) {
    let enAttente = false;
    let ecoute = false;

    const tourner = () => {
      enAttente = false;
      emoji.style.transform = calme.matches ? '' : `rotate(${(window.scrollY * DEGRES_PAR_PIXEL) % 360}deg)`;
    };
    const auDefilement = () => {
      if (enAttente) return;
      enAttente = true;
      requestAnimationFrame(tourner);
    };

    new IntersectionObserver(([entree]) => {
      const visible = !!entree?.isIntersecting;
      if (visible && !ecoute) {
        window.addEventListener('scroll', auDefilement, { passive: true });
        tourner();
      } else if (!visible && ecoute) {
        window.removeEventListener('scroll', auDefilement);
      }
      ecoute = visible;
    }, { rootMargin: '100px 0px' }).observe(emoji);

    calme.addEventListener('change', tourner);
  }
</script>
