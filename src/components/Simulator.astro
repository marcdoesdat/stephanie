---
import { FRAIS_DEFAUT } from '../utils/capaciteEmprunt';

interface Props {
  defaultRate?: number;
}
const { defaultRate = 3.79 } = Astro.props;
---

<section id="simulateur">
  <div class="section-inner">

    <div class="fade-up">
      <h2 class="section-title">Combien puis-je <br /><em>emprunter ?</em></h2>
      <p class="section-sub">
        Entrez vos informations pour obtenir une estimation de votre capacité d'emprunt au Québec en quelques secondes.
      </p>
    </div>

    <div class="sim-wrapper">

      <div class="sim-form fade-up">
        <div class="sim-group">
          <label for="sim-revenu">Revenu annuel brut de votre ménage ($)</label>
          <input type="text" id="sim-revenu" value="80 000" inputmode="numeric" autocomplete="off" />
        </div>

        <div class="sim-group">
          <label for="sim-dettes">Dettes mensuelles ($) <span style="font-weight:400;text-transform:none;letter-spacing:0">(auto, cartes, prêts...)</span></label>
          <input type="text" id="sim-dettes" value="500" inputmode="numeric" autocomplete="off" />
        </div>

        <div class="sim-group">
          <label for="sim-mise">Mise de fonds disponible ($)</label>
          <input type="text" id="sim-mise" value="50 000" inputmode="numeric" autocomplete="off" />
        </div>

        <div class="sim-group">
          <label for="sim-taux">Taux d'intérêt estimé (%)</label>
          <input type="number" id="sim-taux" value={defaultRate.toFixed(2)} step="0.01" inputmode="decimal" min="0" />
          <div class="taux-easter-note" id="sim-taux-note" style="display:none;"></div>
        </div>

        <div class="sim-group">
          <label for="sim-amort">Amortissement</label>
          <select id="sim-amort">
            <option value="25">25 ans</option>
            <option value="30">30 ans (mise de fonds ≥ 20 % requise)</option>
            <option value="20">20 ans</option>
          </select>
        </div>

        <!-- Frais de propriété (inclus dans les ratios ABD/ATD) -->
        <div class="sim-adv-options">
          <div class="sim-adv-heading">Frais de propriété</div>
          <div class="sim-group">
            <label for="sim-taxes">Taxes municipales et scolaires ($/mois)</label>
            <input type="number" id="sim-taxes" value={FRAIS_DEFAUT.taxes} inputmode="decimal" min="0" />
          </div>
          <div class="sim-group">
            <label for="sim-chauffage">Frais de chauffage ($/mois)</label>
            <input type="number" id="sim-chauffage" value={FRAIS_DEFAUT.chauffage} inputmode="decimal" min="0" />
          </div>
          <div class="sim-group">
            <label for="sim-condo">Frais de copropriété / condo ($/mois)</label>
            <input type="number" id="sim-condo" value="0" inputmode="decimal" min="0" />
            <small style="color:var(--muted);font-size:.7rem;margin-top:.25rem;display:block;">50 % de ce montant est inclus dans le calcul des ratios ABD/ATD</small>
          </div>
        </div>

      </div>

      <div class="sim-results fade-up" style="transition-delay:.2s" aria-live="polite">
        <div class="sim-warning" id="sim-warning" style="display:none"></div>

        <!-- Résultat principal : basé sur la mise de fonds de l'utilisateur -->
        <div class="sim-result-main">
          <div class="sr-label">Prix d'achat maximal estimé</div>
          <div class="sr-val" id="sim-max">—</div>
          <div class="sr-sub" id="sim-sub">Entrez vos informations</div>
        </div>

        <!-- Détails -->
        <div class="sim-gate" id="sim-gate">

          <div class="sim-gate-content">
            <div class="sim-cards">
              <div class="sim-card">
                <div class="sc-label">Prêt hypothécaire</div>
                <div class="sc-val" id="sim-pret">—</div>
              </div>
              <div class="sim-card">
                <div class="sc-label">Versement mensuel</div>
                <div class="sc-val" id="sim-pmt">—</div>
              </div>
              <div class="sim-card">
                <div class="sc-label">Ratio ABD</div>
                <div class="sc-val" id="sim-abd">—</div>
              </div>
              <div class="sim-card">
                <div class="sc-label">Ratio ATD</div>
                <div class="sc-val" id="sim-atd">—</div>
              </div>
            </div>

            <!-- Nouvelle carte : scenario alternatif a l'achat -->
            <div class="sim-absolute-max" id="sim-absolute-card" style="display:none;">
              <div class="sam-header">
                <span class="sam-tag">SCÉNARIO ALTERNATIF À L'ACHAT</span>
                <span class="sam-info" id="sam-info-btn" role="button" tabindex="0" aria-label="Plus d'information sur le scénario alternatif">
                  ℹ️
                  <span class="sam-tooltip" id="sam-tooltip">Capacité calculée uniquement sur vos revenus et dettes, sans tenir compte de votre mise de fonds actuelle.</span>
                </span>
              </div>
              <div class="sam-label">Achat avec mise de fonds minimale</div>
              <div class="sam-val" id="sim-abs-prix">—</div>
              <div class="sam-sub" id="sim-abs-sub">Nécessite une mise de fonds minimale de</div>
              <div class="sam-mise" id="sim-abs-mise">—</div>
            </div>

            <div class="sim-note">
              <strong>Stress test :</strong> Capacité calculée au taux de qualification canadien (taux + 2 % ou 5,25 %, le plus élevé).<br/>
              * Inclut taxes, chauffage et 50 % des frais de condo dans les ratios d'endettement.<br/>
              * Prime SCHL ajoutée au prêt si la mise de fonds est inférieure à 20 %.
            </div>
          </div>

        </div>
      </div>

    </div>
  </div>
</section>

<script>
  import { formatMoney } from '../utils/mortgageCalc';
  import {
    calculerCapacite,
    messageEchec,
    lireMontant,
    formaterSaisie,
    decoderTransfert,
    CLE_TRANSFERT_EXPRESS,
  } from '../utils/capaciteEmprunt';

  function saveSimulationResult(type: string, resultat: string) {
    try {
      const payload = JSON.stringify({
        type,
        resultat,
        date: new Date().toISOString()
      });
      sessionStorage.setItem('simulation-resultat:' + type, payload);
      sessionStorage.setItem('simulation-resultat', payload);
    } catch (e) { /* ignore */ }
  }

  document.addEventListener('DOMContentLoaded', () => {
    const INPUT_DEBOUNCE_MS = 120;
    let simDebounceTimer: number | undefined;

    function fmt(n: number): string {
      return formatMoney(Math.round(n));
    }

    const revenuEl = document.getElementById('sim-revenu') as HTMLInputElement;
    const dettesEl = document.getElementById('sim-dettes') as HTMLInputElement;
    const miseEl   = document.getElementById('sim-mise') as HTMLInputElement;
    const condoEl  = document.getElementById('sim-condo') as HTMLInputElement;

    // --- Formatage français pour les champs montant ---
    [revenuEl, dettesEl, miseEl].forEach(el => {
      el.addEventListener('blur', () => {
        const val = lireMontant(el.value);
        if (val > 0) el.value = formaterSaisie(val);
      });
      el.addEventListener('focus', () => {
        const val = lireMontant(el.value);
        if (val > 0) el.value = Math.round(val).toString();
        el.select();
      });
    });

    // --- Info tooltip (mobile + desktop) ---
    const infoBtn = document.getElementById('sam-info-btn');
    const tooltip = document.getElementById('sam-tooltip');
    if (infoBtn && tooltip) {
      infoBtn.addEventListener('click', (e) => {
        e.stopPropagation();
        tooltip.classList.toggle('open');
      });
      // Fermer au clic ailleurs
      document.addEventListener('click', () => tooltip.classList.remove('open'));
    }

    const simTauxEl = document.getElementById('sim-taux') as HTMLInputElement;
    const simTauxNoteEl = document.getElementById('sim-taux-note')!;
    function updateSimTauxNote() {
      const v = simTauxEl.value.trim();
      if (v === '0') {
        simTauxNoteEl.textContent = 'On aimerait tous ça… ✨';
        simTauxNoteEl.style.display = 'block';
      } else if (parseFloat(v) === 69) {
        simTauxNoteEl.textContent = 'noice';
        simTauxNoteEl.style.display = 'block';
      } else {
        simTauxNoteEl.style.display = 'none';
      }
    }
    simTauxEl.addEventListener('input', updateSimTauxNote);

    function showWarning(msg: string | null) {
      const el = document.getElementById('sim-warning')!;
      if (msg) {
        el.textContent = '⚠️ ' + msg;
        el.style.display = 'block';
      } else {
        el.style.display = 'none';
      }
    }

    function resetDisplay() {
      document.getElementById('sim-max')!.textContent = '—';
      document.getElementById('sim-max')!.style.fontSize = '';
      document.getElementById('sim-sub')!.textContent = '';
      ['sim-pret', 'sim-pmt', 'sim-abd', 'sim-atd'].forEach(id => {
        const el = document.getElementById(id)!;
        el.textContent = '—';
        el.style.color = '';
      });
      document.getElementById('sim-absolute-card')!.style.display = 'none';
    }

    /** Return a CSS color based on ABD or ATD ratio value vs thresholds */
    function ratioColor(value: number, greenMax: number, orangeMax: number): string {
      if (value <= greenMax)  return '#3d8a57'; // vert
      if (value <= orangeMax) return '#8e5a1f'; // orange/ambre (assombri pour contraste WCAG AA)
      return '#c0392b';                          // rouge
    }

    function simuler() {
      const tauxEl = document.getElementById('sim-taux') as HTMLInputElement;
      const revenu = lireMontant(revenuEl.value);
      const dettes = lireMontant(dettesEl.value);
      const mise   = lireMontant(miseEl.value);
      const taux   = parseFloat(tauxEl.value) || 3.79;

      // Easter egg : taux à 0 %
      if (tauxEl.value.trim() === '0' && revenu > 0) {
        resetDisplay();
        return;
      }

      const entrees = {
        revenu,
        dettes,
        mise,
        taux,
        amortAns:  parseInt((document.getElementById('sim-amort') as HTMLSelectElement).value) || 25,
        taxes:     parseFloat((document.getElementById('sim-taxes') as HTMLInputElement).value) || 0,
        chauffage: parseFloat((document.getElementById('sim-chauffage') as HTMLInputElement).value) || 0,
        condo:     parseFloat(condoEl.value) || 0,
      };
      const r = calculerCapacite(entrees);

      if (!r.ok) {
        resetDisplay();
        showWarning(messageEchec(r.motif, entrees));
        if (r.motif === 'revenu_insuffisant') {
          const maxEl = document.getElementById('sim-max')!;
          maxEl.textContent = 'Revenu insuffisant';
          maxEl.style.fontSize = '1.8rem';
        }
        return;
      }

      const typeLabel = r.assure ? 'assuré' : 'conventionnel';
      const partMise  = (mise / r.prixMax * 100).toFixed(1);

      // --- Update DOM ---
      showWarning(r.plafonneParMise
        ? 'Mise de fonds insuffisante pour la capacité maximale. Prix limité à ' + fmt(r.prixMax) + '.'
        : null);

      const maxEl = document.getElementById('sim-max')!;
      maxEl.style.fontSize = '';
      maxEl.textContent = fmt(r.prixMax);
      document.getElementById('sim-sub')!.textContent =
        'Prêt ' + typeLabel + ' · Mise de fonds de ' + fmt(mise) + ' (' + partMise + ' %)';
      document.getElementById('sim-pret')!.textContent = fmt(r.pretTotal);
      document.getElementById('sim-pmt')!.textContent  = fmt(r.versement) + ' / mois';

      const abdEl = document.getElementById('sim-abd')!;
      abdEl.textContent = r.abd.toFixed(1) + ' %';
      // Green < 32%, Orange 32–39%, Red > 39%
      abdEl.style.color = ratioColor(r.abd, 32, r.abdLimite);

      const atdEl = document.getElementById('sim-atd')!;
      atdEl.textContent = r.atd.toFixed(1) + ' %';
      // Green < 40%, Orange 40–44%, Red > 44%
      atdEl.style.color = ratioColor(r.atd, 40, r.atdLimite);

      // --- Capacité maximale absolue (plafonds assurés, mise de fonds minimale) ---
      const absCard = document.getElementById('sim-absolute-card')!;
      if (r.maxAbsolu) {
        absCard.style.display = '';
        document.getElementById('sim-abs-prix')!.textContent = fmt(r.maxAbsolu.prix);
        document.getElementById('sim-abs-mise')!.textContent = fmt(r.maxAbsolu.miseMin);
        document.getElementById('sim-abs-sub')!.textContent =
          r.maxAbsolu.prix >= 1_000_000
            ? 'Prêt conventionnel · Mise de fonds minimale de'
            : 'Prêt assuré (SCHL) · Mise de fonds minimale de';
      } else {
        absCard.style.display = 'none';
      }

      // Sauvegarder dans sessionStorage pour le formulaire « On en parle »
      saveSimulationResult('simulateur',
        `Simulateur d'emprunt — Prix max : ${fmt(r.prixMax)}, ` +
        `Revenu annuel : ${fmt(revenu)}, ` +
        `Mise de fonds : ${fmt(mise)} (${partMise} %), ` +
        `Taux : ${taux.toFixed(2).replace('.', ',')} %, ` +
        `Versement : ${fmt(r.versement)}/mois, ` +
        `Prêt ${typeLabel} : ${fmt(r.pretTotal)}, ` +
        `Ratio ABD : ${r.abd.toFixed(1)} %, Ratio ATD : ${r.atd.toFixed(1)} %`
      );
    }

    function scheduleSimulation() {
      if (simDebounceTimer) {
        window.clearTimeout(simDebounceTimer);
      }
      simDebounceTimer = window.setTimeout(() => {
        simuler();
      }, INPUT_DEBOUNCE_MS);
    }

    ['sim-revenu', 'sim-dettes', 'sim-mise', 'sim-taux', 'sim-taxes', 'sim-chauffage', 'sim-condo'].forEach(id => {
      const el = document.getElementById(id)!;
      el.addEventListener('input', scheduleSimulation);
      el.addEventListener('change', scheduleSimulation);
    });
    document.getElementById('sim-amort')!.addEventListener('change', simuler);

    // Arrivée depuis le calculateur express de l'accueil : reprendre ses chiffres, une seule
    // fois. Le transfert est effacé dès la lecture — un retour sur la page plus tard repart
    // des valeurs par défaut plutôt que d'un calcul oublié.
    try {
      const t = decoderTransfert(sessionStorage.getItem(CLE_TRANSFERT_EXPRESS), Date.now());
      sessionStorage.removeItem(CLE_TRANSFERT_EXPRESS);
      if (t) {
        if (t.revenu !== undefined) revenuEl.value = formaterSaisie(t.revenu);
        if (t.dettes !== undefined) dettesEl.value = formaterSaisie(t.dettes);
        if (t.mise !== undefined)   miseEl.value   = formaterSaisie(t.mise);
        if (t.condo !== undefined)  condoEl.value  = String(Math.round(t.condo));
        if (t.taux !== undefined)   simTauxEl.value = t.taux.toFixed(2);
      }
    } catch { /* stockage indisponible : le simulateur garde ses valeurs par défaut */ }

    simuler();
  });
</script>

