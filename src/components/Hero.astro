---
import { Image } from 'astro:assets';
import stephaniePhoto from '../assets/stephanie.webp';
import { loadSiteConfig } from '../config';
import type { GoogleReviews } from '../services/reviewsService';

interface Props {
  baseRate?: number | null;
  reviews?: GoogleReviews | null;
}

const config = loadSiteConfig();
const { baseRate = null, reviews = null } = Astro.props;
function fmtRate(val: number | null | undefined): string {
  if (val == null) return '—';
  return val.toFixed(2).replace('.', ',') + ' %*';
}

// Note Google réelle (ex. « 4,9 ») — remplace le « 5/5 » codé en dur
const ratingLabel = reviews ? reviews.rating.toFixed(1).replace('.', ',') : null;
---

<section id="hero" class="hero-fixe">
  <div class="hero-inner">
    <div class="hero-left fade-up">
      <p class="hero-lieu" aria-hidden="true">Courtière hypothécaire à {config.region}</p>

      <h1 class="hero-value-prop">
        <span class="sr-only">Courtière hypothécaire à {config.region} — </span>
        Acheter ou renouveler,<br /> c'est stressant.<br /> <em>Pas avec moi.</em>
      </h1>
      
      <p>
        Je magasine parmi une panoplie de prêteurs à votre place et je vous explique tout — sans jargon,
        sans pression. On parle de votre projet quand vous êtes prêt·e.
      </p>

      <div class="hero-btns">
        <a
          href="/rendez-vous/"
          class="btn-tools"
          data-umami-event="cta_booking_hero"
          data-cta-hero
        >Réserver un appel de 15 min</a>
        <a
          href="#outils-teaser"
          class="btn-tools btn-tools--ghost"
          data-umami-event="cta_outils_hero"
        >Calculer ma capacité d'emprunt</a>
      </div>
      
      <div class="hero-stats scale-in">
        <div class="stat-item">
          <div class="stat-num">20+</div>
          <div class="stat-label">Prêteurs</div>
        </div>
        <div class="stat-item">
          <div class="stat-num"><span>0&nbsp;$</span><span class="fee-tooltip-wrap">
              <button
                class="fee-info-btn"
                aria-label="En savoir plus sur les frais de courtage"
                aria-expanded="false"
                type="button"
              >i</button>
              <span class="fee-tooltip" role="tooltip">
                Frais de courtage à 0&nbsp;$ pour la vaste majorité des dossiers. Certains financements alternatifs ou privés peuvent comporter des frais, dont je vous informe avant toute démarche.
              </span>
            </span></div>
          <div class="stat-label">Frais de courtage</div>
        </div>
        <div class="stat-item">
          <div class="stat-num"><span>24&nbsp;h</span><span class="fee-tooltip-wrap">
              <button
                class="fee-info-btn"
                aria-label="En savoir plus sur le délai de réponse"
                aria-expanded="false"
                type="button"
              >i</button>
              <span class="fee-tooltip" role="tooltip">
                Prise en charge de votre dossier sous 24&nbsp;h (jours ouvrables). Le délai d'approbation finale dépend ensuite de l'institution financière choisie.
              </span>
            </span></div>
          <div class="stat-label">Délai de réponse</div>
        </div>
      </div>
    </div>
    
    <div class="hero-right fade-up" style="transition-delay:.2s">
      <div class="photo-container">
        <!-- La photo d'abord. Taux et avis sont deux étiquettes séparées, en coins opposés et
             à cheval sur le bord du cadre : elles ne couvrent plus le bas du portrait. Elles
             formaient un bandeau unique avec le logo, trois blocs de même poids qui se
             disputaient l'attention (novembre 2026). Le logo du cabinet passe sous la photo. -->
        <div class="photo-scene">
          <div class="photo-frame" id="hero-photo">
            <Image
              src={stephaniePhoto}
              alt="Stéphanie Weyman"
              width={600}
              height={750}
              loading="eager"
            />
          </div>

          <div class="hero-blob blob-1"></div>
          <div class="hero-blob blob-2"></div>

          {baseRate != null ? (
            <a class="hero-badge hero-badge--taux" href="#taux-section" aria-label={`Taux variable dès ${fmtRate(baseRate)} — voir le tableau des taux`}>
              <span class="card-sm">Taux variable</span>
              <span class="card-val">Dès {fmtRate(baseRate)}</span>
            </a>
          ) : (
            <div class="hero-badge hero-badge--taux">
              <span class="card-sm">Taux variable</span>
              <a class="card-val card-val--link" href="https://hypotheca.ca/taux-hypothecaires" target="_blank" rel="noopener">hypotheca.ca</a>
            </div>
          )}
          {ratingLabel ? (
            <a class="hero-badge hero-badge--avis" href="#temoignages" aria-label={`${ratingLabel} sur 5 — voir les avis Google`}>
              <span class="card-sm">Avis Google</span>
              <span class="card-val">⭐ {ratingLabel}&nbsp;/&nbsp;5</span>
            </a>
          ) : (
            <div class="hero-badge hero-badge--avis">
              <span class="card-sm">Satisfaction</span>
              <span class="card-val">⭐ 5&nbsp;/&nbsp;5</span>
            </div>
          )}
        </div>

        <img class="hero-cabinet" src="/images/logo-hypotheca.svg" alt="Hypotheca" width="1550" height="883" decoding="async" />
      </div>
    </div>
  </div>
</section>

<style>
  .sr-only {
    position: absolute;
    width: 1px;
    height: 1px;
    padding: 0;
    margin: -1px;
    overflow: hidden;
    clip: rect(0, 0, 0, 0);
    white-space: nowrap;
    border: 0;
  }

  .hero-btns {
    display: flex;
    flex-wrap: wrap;
    gap: 0.75rem;
    max-width: 520px;
  }

  .hero-btns .btn-tools {
    display: flex;
    align-items: center;
    justify-content: center;
    min-height: 54px;
    padding: 0.75rem 1.75rem;
    text-align: center;
    min-width: 0;
    white-space: nowrap;
    line-height: 1.15;
    font-size: 0.95rem;
    font-weight: 600;
    border-radius: 50px;
    background: var(--clay);
    color: #fff;
    text-decoration: none;
    border: 2px solid var(--ink);
    box-shadow: 4px 4px 0 var(--ink);
    transition: transform 0.15s ease, box-shadow 0.15s ease, background 0.2s ease;
  }
  .hero-btns .btn-tools:hover {
    transform: translate(2px, 2px);
    box-shadow: 2px 2px 0 var(--ink);
    background: var(--clay-dk);
  }
  .hero-btns .btn-tools:active {
    transform: translate(4px, 4px);
    box-shadow: 0 0 0 var(--ink);
  }
  @media (prefers-reduced-motion: reduce) {
    .hero-btns .btn-tools { transition: none; }
    .hero-btns .btn-tools:hover, .hero-btns .btn-tools:active { transform: none; }
  }

  /* CTA secondaire (outils) : version outline, hiérarchie visuelle sous le booking */
  .hero-btns .btn-tools--ghost {
    background: transparent;
    color: var(--ink);
    border-color: var(--ink);
    box-shadow: none;
  }
  .hero-btns .btn-tools--ghost:hover {
    background: var(--ink);
    border-color: var(--ink);
    color: #fff;
    transform: translateY(-2px);
    box-shadow: none;
  }
  .hero-btns .btn-tools--ghost:active {
    transform: translate(1px, 1px);
    box-shadow: none;
  }

  /* L'icône ⓘ suit le chiffre (« 0 $ ⓘ ») au lieu du libellé : dans une carte étroite,
     elle tombait seule sur la ligne sous « Frais de courtage » ou « Délai de réponse ».
     Le chiffre ne se coupe pas avant elle, et il tient avec elle dans la carte : « 24 h »
     mesure 1,96 fois la taille du chiffre, l'icône et sa marge 17 px, et 100cqi est la
     largeur intérieure de la carte. Sans ce plafond, l'icône sortait de la carte jaune à
     320 px et en touchait le bord à 375 px. Le chiffre a son propre <span> : seul, il reste
     une unité de traduction (« 24 h »), que linkedom ne découpe pas en « 24 » et « h ». */
  .hero-stats .stat-item {
    container-type: inline-size;
  }
  .hero-stats .stat-num {
    white-space: nowrap;
    font-size: min(2.6rem, calc(50cqi - 9px));
  }
  /* Centrée sur les chiffres : en bloc en ligne, l'enveloppe prenait la hauteur de ligne
     du chiffre et l'icône tombait sous la ligne de base. */
  .stat-num .fee-tooltip-wrap {
    display: inline-flex;
    top: -0.1em;
  }
  /* L'infobulle hérite du chiffre : on lui rend la police, l'interlettrage et le retour à
     la ligne du texte courant. */
  .stat-num .fee-tooltip {
    font-family: "DM Sans", sans-serif;
    letter-spacing: normal;
    white-space: normal;
  }
  @media (max-width: 900px) {
    .hero-stats .stat-item {
      padding-inline: 0.75rem;
    }
    .hero-stats .stat-num {
      font-size: min(2rem, calc(50cqi - 9px));
    }
  }

  /* Texte simple au-dessus du titre : pas de pastille, pas de fond. */
  .hero-left .hero-lieu {
    font-size: 0.95rem;
    font-weight: 600;
    color: var(--clay);
    max-width: none;
    margin: 0 0 1rem;
    line-height: 1.4;
  }

  .hero-blob {
    position: absolute;
    border-radius: 50%;
    pointer-events: none;
    will-change: transform;
  }

  .blob-1 {
    width: 160px;
    height: 160px;
    background: radial-gradient(circle, rgba(109,71,255, 0.15) 0%, transparent 70%);
    bottom: 10%;
    right: 5%;
    animation: appear-blob 0.6s cubic-bezier(0.16, 1, 0.3, 1) both, float-idle 6s ease-in-out 0.6s infinite;
  }

  .blob-2 {
    width: 144px;
    height: 144px;
    background: radial-gradient(circle, rgba(0,107,82, 0.1) 0%, transparent 70%);
    top: 5%;
    right: 8%;
    animation: appear-blob 0.6s cubic-bezier(0.16, 1, 0.3, 1) both, float-idle 8s ease-in-out 2s infinite;
  }

  @keyframes appear-blob {
    from { opacity: 0; }
    to   { opacity: 1; }
  }

  @keyframes float-idle {
    0%, 100% { transform: translateY(0px); }
    50%      { transform: translateY(-8px); }
  }

  @media (max-width: 900px) {
    @keyframes float-idle {
      0%, 100% { transform: translateY(0px); }
      50%      { transform: translateY(-12px); }
    }
  }

  /* --- Taux et avis : deux étiquettes secondaires autour de la photo --- */
  .photo-scene {
    position: relative;
  }

  /* Petites, blanches, sans flottement : la photo flotte, elles non. Le texte et les
     libellés sont ceux de l'ancien bandeau (mêmes clés de traduction). */
  .hero-badge {
    position: absolute;
    z-index: 3;
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: 0.1rem;
    padding: 0.5rem 0.85rem 0.55rem;
    background: #fff;
    border: 1px solid var(--border);
    border-radius: 14px;
    box-shadow: 0 6px 20px rgba(18, 16, 31, 0.1);
    color: var(--ink);
    text-decoration: none;
    line-height: 1.2;
    animation: badge-entree 0.55s cubic-bezier(0.16, 1, 0.3, 1) both;
  }
  /* Coins opposés : le taux en haut à droite, les avis en bas à gauche — loin du visage,
     loin l'un de l'autre. Elles entrent après la photo, qui reste la première vue. */
  .hero-badge--taux {
    top: 9%;
    right: -28px;
    animation-delay: 0.5s;
  }
  .hero-badge--avis {
    bottom: 11%;
    left: -32px;
    animation-delay: 0.7s;
  }

  @keyframes badge-entree {
    from { opacity: 0; transform: translateY(8px); }
    to   { opacity: 1; transform: translateY(0); }
  }

  .hero-badge .card-sm {
    font-size: 0.66rem;
    font-weight: 600;
    letter-spacing: 0.05em;
    text-transform: uppercase;
    color: var(--muted);
  }

  .hero-badge .card-val {
    font-size: 1rem;
    font-weight: 700;
    color: var(--ink);
    white-space: nowrap;
  }

  .hero-badge .card-val--link {
    color: var(--clay);
    text-decoration: none;
    font-weight: 600;
  }
  .hero-badge .card-val--link:hover { text-decoration: underline; }

  /* Étiquettes cliquables (vers les taux, vers les avis) : la bordure le dit au survol. */
  a.hero-badge {
    transition: border-color 0.2s, box-shadow 0.2s;
  }
  a.hero-badge:hover,
  a.hero-badge:focus-visible {
    border-color: var(--clay);
    box-shadow: 0 8px 24px rgba(109, 71, 255, 0.18);
  }

  /* Le cabinet, sous la photo : présent, mais à l'écart des chiffres. La marge franchit
     l'ombre décalée du cadre (18 px). */
  .hero-cabinet {
    display: block;
    width: auto;
    height: 40px;
    margin: 2.6rem auto 0;
  }

  @media (max-width: 900px) {
    #hero {
      padding: 6rem 1.5rem;
      min-height: auto;
    }
    .hero-right {
      display: flex !important;
      justify-content: center;
      max-width: 320px;
      margin: 0 auto;
    }
    .photo-container {
      position: relative;
      width: 100%;
    }
    .hero-blob.blob-1 {
      width: 120px;
      height: 120px;
    }
    .hero-blob.blob-2 {
      width: 108px;
      height: 108px;
    }
    .hero-badge {
      border-radius: 12px;
      padding: 0.45rem 0.7rem 0.5rem;
    }
    .hero-badge--taux { right: -20px; }
    .hero-badge--avis { left: -20px; }
    .hero-badge .card-sm { font-size: 0.62rem; }
    .hero-badge .card-val { font-size: 0.92rem; }
    .hero-cabinet {
      height: 34px;
      margin-top: 2.4rem;
    }
  }

  @media (max-width: 520px) {
    .hero-btns {
      flex-direction: column;
      gap: 0.65rem;
      max-width: 100%;
    }

    .hero-btns .btn-tools {
      width: 100%;
      min-height: 52px;
      font-size: 0.9rem;
      white-space: normal;
      max-width: 100%;
    }

    .hero-right {
      max-width: 260px;
    }
    .hero-blob.blob-1 {
      width: 100px;
      height: 100px;
    }
    .hero-blob.blob-2 {
      width: 88px;
      height: 88px;
    }
    /* À 320 px, il reste 30 px entre le cadre et le bord de l'écran : l'étiquette
       déborde de 14 px au plus, pour ne jamais être rognée. */
    .hero-badge {
      border-radius: 10px;
      padding: 0.35rem 0.6rem 0.4rem;
    }
    .hero-badge--taux { right: -14px; }
    .hero-badge--avis { left: -14px; }
    .hero-badge .card-sm { font-size: 0.58rem; }
    .hero-badge .card-val { font-size: 0.84rem; }
    .hero-cabinet { height: 30px; }
  }



  /* Flottement de la photo (indépendant du scroll) */
  .photo-frame {
    animation: float-photo 6s ease-in-out infinite;
  }

  @keyframes float-photo {
    0%, 100% { transform: translateY(0); }
    50%      { transform: translateY(-10px); }
  }
</style>

<script>
  // Parallaxe subtil : la photo se déplace plus lentement que le texte au scroll.
  // Désactivé sous 900px (layout empilé) pour éviter que la photo remonte sur le texte.
  (function() {
    const photoContainer = document.querySelector<HTMLElement>('.photo-container');
    const hero = document.getElementById('hero');
    if (!photoContainer || !hero) return;

    const mql = window.matchMedia('(max-width: 900px)');
    let ticking = false;

    function onScroll() {
      if (mql.matches) return;
      if (!ticking) {
        requestAnimationFrame(function() {
          const heroRect = hero!.getBoundingClientRect();
          const heroHeight = hero!.offsetHeight;
          const progress = Math.max(0, Math.min(1, -heroRect.top / (heroHeight - window.innerHeight)));
          const offset = progress * 40;
          photoContainer!.style.transform = 'translateY(-' + offset + 'px)';
          ticking = false;
        });
        ticking = true;
      }
    }

    function syncMode() {
      // Sur mobile, on neutralise tout décalage résiduel laissé par le desktop.
      if (mql.matches) photoContainer!.style.transform = '';
    }

    mql.addEventListener('change', syncMode);
    window.addEventListener('scroll', onScroll, { passive: true });
    syncMode();
  })();

  // Easter egg : 5 clics sur la photo → blagues hypothécaires
  (function() {
    const photo = document.getElementById('hero-photo');
    if (!photo) return;

    const blagues = [
      'Pourquoi le taux variable a consulté un psychologue? Parce qu\'il avait trop de hauts et de bas.',
      'Stéphanie m\'a dit : « Votre hypothèque est comme un bon mariage. » J\'ai répondu : « 25 ans, et impossible de partir sans pénalité? »',
      'C\'est quoi le comble pour un emprunteur? Trouver que sa maison vaut une fortune… mais devoir la garder 25 ans pour le prouver.',
      'Pourquoi les premiers acheteurs dorment mal? Parce qu\'ils calculent les moutons à 6,5 % d\'intérêt.',
      'Mon courtier m\'a dit que mon dossier était « solide ». J\'ai compris plus tard que c\'était pour le poids des documents à fournir.',
      'Quelle est la différence entre l\'amour et un taux fixe 5 ans? L\'amour, on espère que ça dure plus longtemps.',
      'Stéphanie dit au client : « Bonne nouvelle, vous êtes pré-approuvé! » Le client : « Et la mauvaise? » Le banquier : « Vous devez maintenant trouver une maison à ce prix-là. »',
      'Pourquoi l\'IRD (différentiel de taux) est le méchant des films d\'horreur hypothécaires? Parce qu\'on ne le voit jamais venir, mais il fait toujours mal à la fin.',
      'C\'est un emprunteur qui dit : « Je veux rembourser au plus vite! » Sa banque, les larmes aux yeux : « Mais pourquoi nous quitter si tôt? »',
      'Comment reconnaître quelqu\'un qui vient de renouveler son hypothèque en 2026? Il sourit beaucoup moins qu\'en 2021.',
    ];

    // Création du toast — en position fixed pour éviter le clipping par overflow:hidden du #hero
    const toast = document.createElement('div');
    toast.className = 'hero-joke-toast';
    toast.setAttribute('aria-live', 'polite');
    toast.style.cssText = 'display:none;position:fixed;z-index:9999;background:var(--ink);color:#fff;padding:.75rem 1.1rem;border-radius:12px;font-size:.82rem;line-height:1.5;max-width:260px;text-align:center;pointer-events:none;white-space:normal;box-shadow:0 8px 24px rgba(0,0,0,.25);';
    document.body.appendChild(toast);

    // Curseur pour indiquer que c'est cliquable
    photo.style.cursor = 'pointer';

    let clicks = 0;
    let jokeIndex = 0;
    let hideTimer: ReturnType<typeof setTimeout> | null = null;
    let resetTimer: ReturnType<typeof setTimeout> | null = null;

    photo.addEventListener('click', () => {
      clicks++;
      if (resetTimer) clearTimeout(resetTimer);
      resetTimer = setTimeout(() => { clicks = 0; }, 3000);

      if (clicks < 5) return;
      clicks = 0;

      if (hideTimer) clearTimeout(hideTimer);
      toast.textContent = blagues[jokeIndex] ?? blagues[0]!;

      // Positionner le toast juste au-dessus de la photo
      const rect = photo.getBoundingClientRect();
      toast.style.left = `${rect.left + rect.width / 2}px`;
      toast.style.top = `${rect.top - 12}px`;
      toast.style.transform = 'translate(-50%, -100%)';
      toast.style.display = 'block';
      jokeIndex = (jokeIndex + 1) % blagues.length;

      hideTimer = setTimeout(() => {
        toast.style.display = 'none';
      }, 5000);
    });
  })();

</script>