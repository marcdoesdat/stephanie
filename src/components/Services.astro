---
// Liste des services. Chaque carte est entièrement cliquable et pointe vers sa sous-page dédiée.
// Sans `href`, on retombe sur l'ancre #contact (parcours de prise de rendez-vous).
import { House, Repeat, Lightbulb, LockKeyholeOpen, Briefcase, Globe } from '@lucide/astro';

interface ServiceItem {
  icon: any;
  title: string;
  description: string;
  /** Une ligne, pour la liste compacte sous 900 px — la description entière y prend trop de place */
  court: string;
  cta: string;
  href?: string;
}

const services: ServiceItem[] = [
  {
    icon: House,
    title: "Premier achat",
    description: "Vous achetez votre première propriété ? Je vous guide à travers la mise de fonds, le test de résistance, et je négocie les meilleures conditions pour vous.",
    court: "Mise de fonds, test de résistance, meilleures conditions",
    cta: "Préparer mon premier achat",
    href: "/services/premier-achat"
  },
  {
    icon: Repeat,
    title: "Renouvellement",
    description: "Votre hypothèque arrive à terme ? C'est le meilleur moment de magasiner. Je compare les offres de 20+ prêteurs pour vous obtenir un meilleur taux que votre banque.",
    court: "20+ prêteurs comparés avant l'offre de votre banque",
    cta: "Comparer les taux",
    href: "/services/renouvellement"
  },
  {
    icon: Lightbulb,
    title: "Refinancement",
    description: "Consolidation de dettes, rénovations, achat locatif — le refinancement peut libérer des liquidités importantes. Analysons ensemble si c'est la bonne décision.",
    court: "Consolider vos dettes, rénover, investir",
    cta: "Découvrir mes options",
    href: "/services/refinancement"
  },
  {
    icon: LockKeyholeOpen,
    title: "Dossier refusé",
    description: "Votre banque vous a dit non ? Un refus bancaire, ce n'est pas une fin. J'ai accès à des prêteurs alternatifs adaptés aux situations complexes.",
    court: "Un non de votre banque n'est pas une fin",
    cta: "Trouver une solution",
    href: "/services/dossier-refuse"
  },
  {
    icon: Briefcase,
    title: "Travailleur autonome",
    description: "Revenus variables, contrats, incorporation — je sais comment présenter votre dossier pour maximiser vos chances.",
    court: "Revenus variables, dossier présenté pour convaincre",
    cta: "Maximiser mon dossier",
    href: "/services/travailleur-autonome"
  },
  {
    icon: Globe,
    title: "Nouveaux arrivants",
    description: "Vous venez d'arriver au Canada ? Il existe des programmes spéciaux pour les résidents permanents et certains détenteurs de permis de travail.",
    court: "Programmes pour résidents permanents et permis de travail",
    cta: "Voir les programmes",
    href: "/services/nouveaux-arrivants"
  }
];
---

<section id="services">
  <div class="section-inner">

    <div class="fade-up">
      <h2 class="section-title">Ce que je peux<br />faire pour <em>vous</em></h2>
      <p class="section-sub">
        Du premier achat au renouvellement, du refinancement au dossier complexe — je vous accompagne à chaque étape, où que vous soyez au Québec.
      </p>
    </div>

    <div class="services-grid stagger-children" id="services-grid">
      {services.map((service) => (
        <a
          href={service.href ?? '#contact'}
          class="service-card"
          aria-label={`${service.cta} — ${service.title}`}
        >
          <div class="service-icon" aria-hidden="true">
            <service.icon size={28} stroke-width={1.8} />
          </div>

          <h3>{service.title}</h3>
          <p class="service-desc">{service.description}</p>
          <p class="service-court">{service.court}</p>

          <span class="learn">
            {service.cta}
          </span>
        </a>
      ))}
    </div>

  </div>
</section>

<style>
  .service-card {
    display: flex;
    flex-direction: column;
    text-decoration: none;
    color: inherit;
    cursor: pointer;
  }
  .service-card:focus-visible {
    outline: 3px solid var(--clay);
    outline-offset: 4px;
  }
  .service-card * {
    text-decoration: none;
  }
  /* Remplacement du radial-gradient par un suivi souris fluide */
  .service-card::before {
    background: radial-gradient(800px circle at var(--mouse-x, 50%) var(--mouse-y, 0%), rgba(196, 122, 82, 0.08), transparent 40%);
  }
  .service-card h3 {
    font-family: "Lora", serif;
    font-size: 1.3rem;
    margin-bottom: 0.8rem;
    font-weight: 600;
    color: var(--ink);
  }
  .service-card .learn {
    margin-top: auto;
    padding-top: 1.2rem;
    color: var(--clay);
  }
  
  .service-court {
    display: none;
  }

  /* Sous 900 px, les cartes empilées occupaient 2,6 écrans de téléphone — entre le
     calculateur et les taux, que le visiteur en renouvellement cherche. On passe à une
     liste compacte : icône, titre, une ligne d'accroche, flèche. La description entière
     reste sur la sous-page du service, où mène chaque ligne. */
  @media (max-width: 900px) {
    .services-grid {
      grid-template-columns: repeat(2, minmax(0, 1fr));
      gap: 0.6rem;
      margin-top: 1.75rem;
    }
    .service-card {
      display: grid;
      grid-template-columns: auto minmax(0, 1fr) auto;
      grid-template-areas:
        "icone titre fleche"
        "icone court fleche";
      align-items: center;
      column-gap: 0.9rem;
      row-gap: 0.1rem;
      padding: 0.85rem 1rem;
      border-radius: var(--radius-sm);
    }
    .service-icon {
      grid-area: icone;
      width: 42px;
      height: 42px;
      margin: 0;
      border-radius: 11px;
    }
    .service-icon :global(svg) {
      width: 22px;
      height: 22px;
    }
    .service-card h3 {
      grid-area: titre;
      align-self: end;
      font-size: 1.05rem;
      margin: 0;
    }
    .service-desc {
      display: none;
    }
    .service-court {
      display: block;
      grid-area: court;
      align-self: start;
      font-size: 0.82rem;
      line-height: 1.45;
    }
    /* Le libellé d'action s'efface au profit de la flèche ; le lien garde son aria-label */
    .service-card .learn {
      grid-area: fleche;
      margin: 0;
      padding: 0;
      font-size: 0;
    }
    .service-card .learn::after {
      font-size: 1.1rem;
    }
  }

  @media (max-width: 600px) {
    .services-grid {
      grid-template-columns: 1fr;
    }
  }
</style>

<script>
  (function() {
    const grid = document.getElementById('services-grid');
    if (!grid) return;
    const cards = grid.querySelectorAll('.service-card');

    // Glow tracking mouse
    grid.addEventListener('mousemove', (e) => {
      for(const card of cards) {
        const rect = (card as HTMLElement).getBoundingClientRect();
        const x = e.clientX - rect.left;
        const y = e.clientY - rect.top;
        (card as HTMLElement).style.setProperty('--mouse-x', `${x}px`);
        (card as HTMLElement).style.setProperty('--mouse-y', `${y}px`);
      }
    });
  })();
</script>