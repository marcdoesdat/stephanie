---
import SEO from '../components/SEO.astro';
import ConsentBanner from '../components/ConsentBanner.astro';
import Polices from '../components/Polices.astro';
import { loadSiteConfig } from '../config';
import { estTraduite } from '../utils/pagesAnglaises';
import '../styles/global.css';

const config = loadSiteConfig();

interface Props {
  title?: string;
  fullTitle?: string;
  description: string;
  ogImage?: string;
  noindex?: boolean;
  /**
   * Retire la barre CTA mobile « Prendre rendez-vous ». À utiliser sur les pages où le
   * visiteur est déjà en train d'accomplir une tâche précise (signer un document, remplir
   * un formulaire de conformité) : la barre y couvre le contenu et propose une action qui
   * entre en concurrence avec celle de la page.
   */
  sansBarreCta?: boolean;
  /**
   * Retire la bannière de consentement et les scripts d'analytique. Pour les écrans
   * internes (cockpit de la courtière) : la bannière fixe couvre le contenu, et il n'y
   * a rien à consentir ni à mesurer sur un outil de travail.
   */
  sansConsentement?: boolean;
  /**
   * Retire la bascule FR/EN. Pour les écrans que la courtière seule utilise, et pour les
   * pages où le texte est un engagement : attestation de signature, formulaire AMF. Ce qui
   * est signé doit être lu dans la langue du document signé (le PDF est en français), et une
   * traduction d'un énoncé juridique n'a pas à s'y substituer.
   */
  sansTraduction?: boolean;
}

const { title, fullTitle, description, ogImage, noindex, sansBarreCta, sansConsentement, sansTraduction } = Astro.props;

// Les deux versions d'une page se déclarent mutuellement (hreflang) — seulement les pages
// indexables qui ont une version anglaise. Voir src/services/traductionPage.ts.
const alternates = !sansTraduction && !noindex && estTraduite(Astro.url.pathname);
---

<!doctype html>
<html lang="fr-CA">
  <head>
    <!-- En tête : l'encodage doit être déclaré dans les 1 024 premiers octets, avant les scripts. -->
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <!-- Google Consent Mode v2 — DOIT précéder GTM.
         Défaut : tout refusé (Loi 25). Si le visiteur a déjà accepté lors d'une
         visite précédente (localStorage sw_consent_v1, géré par /js/consent.js),
         le défaut passe à « granted » avant que GTM ne démarre.
         Les clics Accepter/Refuser envoient ensuite un consent update (consent.js).

         Ce bloc définit aussi le shim window.gtag : les pages qui appellent
         gtag('event', …) avant tout consentement empilent dans dataLayer, et
         GTM traite la file au chargement si le visiteur accepte. -->
    <script is:inline>
      (function () {
        window.dataLayer = window.dataLayer || [];
        window.gtag = window.gtag || function () { window.dataLayer.push(arguments); };

        var granted = false;
        try {
          var raw = localStorage.getItem('sw_consent_v1');
          if (raw) granted = JSON.parse(raw).state === 'accepted';
        } catch (e) {}

        var v = granted ? 'granted' : 'denied';
        window.gtag('consent', 'default', {
          ad_storage: v,
          ad_user_data: v,
          ad_personalization: v,
          analytics_storage: v
        });
        if (!granted) window.gtag('set', 'ads_data_redaction', true);
      })();
    </script>

    <!-- Google Tag Manager : chargé par /js/consent.js UNIQUEMENT après
         consentement, pas ici. Consent Mode « denied » n'empêche pas le
         chargement des tags du container — il ne fait que bloquer les cookies.
         Le container injectait donc ~450 KiB de JS Google (gtm.js + une copie
         complète de gtag/js par compte Ads) chez tous les visiteurs, y compris
         ceux qui n'avaient rien accepté. Voir §5.1 de AUDIT-CONVERSION-2026-07.md. -->

    {!sansTraduction && (
      <script is:inline>
        /* Version anglaise : /en/… (voir public/js/i18n.js). Un visiteur qui a choisi « EN » et
           arrive sur une page française est envoyé vers son équivalent anglais avant tout
           affichage. Un robot, sans localStorage, reste sur la page demandée : c'est ce qui
           laisse chaque version s'indexer à sa propre adresse. ?lang=en|fr force le choix depuis
           un lien, puis disparaît de l'adresse. */
        (function () {
          try {
            var chemin = location.pathname;
            var natif = chemin === '/en' || chemin.indexOf('/en/') === 0;
            var versEn = '/en' + (chemin === '/' ? '/' : chemin);
            var versFr = chemin.replace(/^\/en(?=\/|$)/, '') || '/';
            var p = new URLSearchParams(location.search).get('lang');
            var u = new URL(location.href);
            u.searchParams.delete('lang');
            var reste = u.search + u.hash;
            if (p === 'en' || p === 'fr') {
              localStorage.setItem('sw_lang', p);
              if (p === 'en' && !natif) location.replace(versEn + reste);
              else if (p === 'fr' && natif) location.replace(versFr + reste);
              else history.replaceState(null, '', u.pathname + reste);
              return;
            }
            if (!natif && localStorage.getItem('sw_lang') === 'en') location.replace(versEn + location.search + location.hash);
          } catch (e) {}
        })();
      </script>
    )}
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />

    <SEO title={title} fullTitle={fullTitle} description={description} ogImage={ogImage} noindex={noindex} alternates={alternates} />
    <slot name="head" />

    <Polices />
    <!-- Umami envoie ses évènements vers gateway.umami.is, origine distincte du
         script (cloud.umami.is) : sans ce hint la connexion est ouverte tard. -->
    <link rel="preconnect" href="https://gateway.umami.is" crossorigin />

    {!sansConsentement && (
      <script
        is:inline
        defer
        src="https://cloud.umami.is/script.js"
        data-website-id="9a2bb5e1-afd5-4d94-a89f-5584d5c44b12"
        data-domains={config.site_url.replace(/^https?:\/\//, '')}
      ></script>
    )}

    <!-- Bannière de consentement Loi 25 : gère le chargement conditionnel de Google Ads / Google Analytics (GA4) -->
    {!sansConsentement && <script is:inline defer src="/js/consent.js"></script>}

    <!-- Critical CSS : fondations above-the-fold (variables, reset, nav, hero).
         is:inline est OBLIGATOIRE : sans lui, Astro scope ces sélecteurs (qui visent
         des éléments d'autres composants) et aucune règle ne s'applique.
         Garder les valeurs synchronisées avec global.css. -->
    <style is:inline>
      :root{--sand:#f6f3ff;--warm:#ece6ff;--clay:#6d47ff;--clay-dk:#5b34f0;--forest:#006b52;--ink:#12101f;--muted:#575268;--border:#e2ddf0;--white:#ffffff;--sun:#ffd23f;--mint:#b6f2d3;--rose:#ffc6e0;--sky:#bfe2ff;--lilac:#ddd3ff;--peach:#ffd3bd;--font-display:"Bricolage Grotesque","DM Sans",sans-serif;--rebond:cubic-bezier(.34,1.56,.64,1);--shadow-sm:0 4px 16px rgba(0,0,0,.06);--shadow-clay:0 8px 24px rgba(109,71,255,.4);--radius-sm:14px;--radius-md:24px;--radius-lg:32px}
      *,*::before,*::after{box-sizing:border-box;margin:0;padding:0}
      [hidden]{display:none!important}
      html{scroll-behavior:smooth}body{font-family:"DM Sans",sans-serif;background:var(--white);color:var(--ink);font-size:16px;line-height:1.65;overflow-x:clip;-webkit-font-smoothing:antialiased}
      @media(prefers-reduced-motion:reduce){html{scroll-behavior:auto}*,*::before,*::after{animation-duration:.01ms!important;animation-iteration-count:1!important;transition:none!important}}
      .sr-only{position:absolute;width:1px;height:1px;padding:0;margin:-1px;overflow:hidden;clip:rect(0,0,0,0);white-space:nowrap;border-width:0}
      .skip-link{position:absolute;top:.5rem;left:.5rem;transform:translateY(calc(-100% - 1rem));z-index:10000;padding:.6rem 1rem;background:var(--ink);color:#fff;font-weight:600;border-radius:6px;text-decoration:none;transition:transform .15s ease-in}
      .skip-link:focus,.skip-link:focus-visible{transform:translateY(0);outline:2px solid var(--clay);outline-offset:2px}
      nav#navbar{position:fixed;top:0;left:0;right:0;z-index:200;background:rgba(255,255,255,.95);backdrop-filter:blur(12px);border-bottom:1px solid transparent;padding:0 clamp(1rem,3vw,4rem);display:flex;align-items:center;justify-content:space-between;min-height:68px}
      nav#navbar.scrolled{box-shadow:var(--shadow-sm);border-bottom-color:var(--border)}
      .nav-logo{font-family:var(--font-display);font-size:1.2rem;font-weight:700;letter-spacing:-.02em;color:var(--ink);text-decoration:none}
      .nav-logo span,.nav-logo .cabinet-name{color:var(--clay)}
      .nav-links{display:flex;gap:clamp(1rem,1.8vw,2.5rem);list-style:none;align-items:center;flex-wrap:wrap;min-width:0}
      .nav-links a{font-size:clamp(.8rem,.18vw + .7rem,.9rem);font-weight:500;color:var(--ink);text-decoration:none;white-space:nowrap}
      .nav-cta{display:inline-flex!important;align-items:center;justify-content:center;background:var(--ink);color:#fff!important;padding:.68rem clamp(.95rem,1.4vw,1.4rem);border-radius:50px;white-space:nowrap;line-height:1;text-decoration:none;border:2px solid var(--ink)}
      .nav-cta-compact{display:none}
      .hamburger{display:none;flex-direction:column;align-items:center;justify-content:center;gap:5px;cursor:pointer;background:none;border:none;padding:12px;min-width:44px;min-height:44px}
      .hamburger span{display:block;width:22px;height:2px;background:var(--ink);border-radius:2px}
      #hero{min-height:100vh;background:var(--sand);display:flex;align-items:center;padding:8rem 4rem 4rem;position:relative;overflow:hidden}
      .hero-inner{position:relative;z-index:1;max-width:1100px;margin:0 auto;width:100%;display:grid;grid-template-columns:1fr 1fr;gap:5rem;align-items:center}
      .hero-left .hero-value-prop{font-family:var(--font-display);font-size:4.4rem;font-weight:800;line-height:1.02;color:var(--ink);margin-bottom:1.5rem;letter-spacing:-.04em}
      .hero-left .hero-value-prop em{font-style:normal;color:var(--ink);background:linear-gradient(transparent 58%,var(--sun) 58%,var(--sun) 92%,transparent 92%);padding:0 .08em;margin:0 -.08em;-webkit-box-decoration-break:clone;box-decoration-break:clone}
      .hero-left p{font-size:1.12rem;color:var(--muted);line-height:1.7;max-width:480px;margin-bottom:2.5rem}
      .btn-cta{display:inline-flex;align-items:center;justify-content:center;gap:.55rem;background:var(--ink);color:#fff;padding:1.05rem 1.8rem;border-radius:50px;font-weight:600;text-decoration:none;border:2px solid var(--ink)}
      .btn-secondary{background:transparent;color:var(--ink);padding:.95rem 2rem;border-radius:50px;border:2px solid var(--ink);font-size:.92rem;font-weight:600;text-decoration:none}
      .hero-right{position:relative} .photo-frame{width:100%;aspect-ratio:4/5;border-radius:48px 48px 48px 160px;overflow:hidden;border:0;background:var(--lilac);box-shadow:18px 18px 0 var(--clay)}
      .photo-frame img{width:100%;height:100%;object-fit:cover;object-position:center top}
      .photo-container{will-change:transform}
      .hero-stats{display:flex;gap:1rem;margin-top:3rem;justify-content:flex-start;text-align:left}.hero-stats .stat-item{flex:1;background:var(--lilac);border-radius:var(--radius-md);padding:1.1rem 1.2rem}.hero-stats .stat-item:nth-child(2){background:var(--mint)}.hero-stats .stat-item:nth-child(3){background:var(--sun)}
      .stat-num{font-family:var(--font-display);font-size:2.6rem;font-weight:800;letter-spacing:-.04em;color:var(--ink);line-height:1}
      .stat-label{font-size:.85rem;color:var(--muted);margin-top:.35rem}
      .card-sm{font-size:.75rem;color:var(--muted)}.card-val{font-family:var(--font-display);font-size:1.1rem;font-weight:700;color:var(--ink)}
      @media(max-width:1280px){.nav-links{gap:.85rem}.nav-links a{font-size:.74rem}.nav-cta{padding:.5rem 1rem}}
      @media(max-width:1180px){.nav-links{display:none}.hamburger{display:flex}}
      @media(min-width:901px) and (max-width:1180px){.nav-cta-compact{display:inline-flex}}
      @media(max-width:900px){nav#navbar{padding:0 1.5rem}#hero{padding:6rem 1.5rem 3rem}.hero-inner{grid-template-columns:1fr;gap:2rem}.hero-left .hero-value-prop{font-size:clamp(2.1rem,10.5vw,2.8rem)}.hero-left p{margin-bottom:1.75rem}.hero-right{display:none}}
    </style>
  </head>
  <body>
    <!-- Pas d'iframe GTM <noscript> : sans JavaScript, ni la bannière de
         consentement ni le Consent Mode ne fonctionnent — tracker ces
         visiteurs serait par définition sans consentement (Loi 25). -->

    <a href="#main-content" class="skip-link">Passer au contenu principal</a>
    <slot />
    <!-- Barre CTA mobile : bande + bouton pilule centré. Le bouton Messenger
         (position:fixed, rendu par page) vient se placer dans cette bande à droite. -->
    {!sansBarreCta && (
      <div class="mobile-sticky-cta">
        <a href="/rendez-vous/" class="sticky-btn" data-umami-event="cta_booking_sticky">
          <span class="sticky-label">Prendre rendez-vous</span>
        </a>
      </div>
    )}
    {!sansConsentement && <ConsentBanner />}

    {!sansTraduction && <script is:inline defer src="/js/i18n-core.js"></script>}
    {!sansTraduction && <script is:inline defer src="/js/i18n-regles.js"></script>}
    {!sansTraduction && <script is:inline defer src="/js/i18n.js"></script>}

    <!-- Sticky scroll-aware + état conversion -->
    <script is:inline>
      (function() {
        const sticky = document.querySelector('.mobile-sticky-cta');
        if (!sticky) return;

        // --- Scroll-aware: hide on scroll down, show on scroll up ---
        let lastY = window.scrollY;
        let ticking = false;
        const SCROLL_THRESHOLD = 8; // px minimum pour déclencher

        function onScroll() {
          const y = window.scrollY;
          const delta = y - lastY;
          if (Math.abs(delta) < SCROLL_THRESHOLD) return;

          // La classe vit sur <body> : la barre ET le bouton Messenger (qui n'est
          // pas un enfant de la barre) glissent ensemble.
          if (delta > 0) {
            // scrolling down → hide
            document.body.classList.add('cta-hidden');
          } else {
            // scrolling up → show
            document.body.classList.remove('cta-hidden');
          }
          lastY = y;
        }

        window.addEventListener('scroll', () => {
          if (!ticking) {
            requestAnimationFrame(() => {
              onScroll();
              ticking = false;
            });
            ticking = true;
          }
        }, { passive: true });

        // --- État de conversion /outils/ : discret → plein gaz ---
        // Si l'utilisateur a déjà déverrouillé une simulation (localStorage) ou
        // si un composant a marqué body[data-outils-converted], on passe en mode "converti".
        function checkConverted() {
          if (
            document.body.dataset.outilsConverted === 'true' ||
            localStorage.getItem('calc_email_sent') === '1' ||
            localStorage.getItem('penalite_email_sent') === '1'
          ) {
            sticky.classList.add('sticky-converted');
          }
        }

        // Vérifie au chargement
        checkConverted();

        // Observe les changements d'attribut sur body (quand un composant marque la conversion)
        const observer = new MutationObserver(() => {
          checkConverted();
        });
        observer.observe(document.body, { attributes: true, attributeFilter: ['data-outils-converted'] });

        // Écoute aussi un event custom pour être plus réactif
        window.addEventListener('outils:converted', () => {
          sticky.classList.add('sticky-converted');
        });
      })();
    </script>

    <!-- Le hero reste en place pendant que la section suivante le recouvre (global.css,
         « TRANSITIONS »). Le CSS a besoin de sa hauteur — sur téléphone il dépasse l'écran —
         et de sa distance au haut de la page. On ne pose que les mesures ; le calcul reste
         en CSS. La distance se lit sur ce qui le précède : une fois collé, son propre
         offsetTop suit le défilement. -->
    <script is:inline>
      (function() {
        var hero = document.querySelector('#main-content > .hero-fixe');
        if (!hero || typeof ResizeObserver === 'undefined') return;
        var racine = document.documentElement;
        var avant = hero.previousElementSibling;
        var observateur = new ResizeObserver(function() {
          var haut = avant ? avant.offsetTop + avant.offsetHeight : hero.parentElement.offsetTop;
          racine.style.setProperty('--hero-h', hero.offsetHeight + 'px');
          racine.style.setProperty('--hero-haut', haut + 'px');
          // Chrome ne recalcule pas toujours la plage d'une animation liée au défilement
          // quand ces mesures changent : d'un chargement à l'autre, le hero s'estompait
          // trop tôt. On relance l'animation, qui repart alors des bonnes valeurs.
          var dedans = hero.firstElementChild;
          if (dedans) {
            dedans.style.animationName = 'none';
            void dedans.offsetWidth;
            dedans.style.animationName = '';
          }
        });
        observateur.observe(hero);
        if (avant) observateur.observe(avant);
      })();
    </script>

    <!-- Tooltips frais de courtage (global) -->
    <script is:inline>
      (function() {
        // Centrée sur l'icône, l'infobulle d'une colonne au bord de l'écran en sortirait sur
        // téléphone : on la ramène à 16 px du bord, la flèche restant sur l'icône.
        function recadrer(wrap) {
          var tip = wrap.querySelector('.fee-tooltip');
          if (!tip) return;
          tip.style.setProperty('--decalage', '0px');
          var r = tip.getBoundingClientRect();
          var marge = 16, d = 0;
          if (r.left < marge) d = marge - r.left;
          else if (r.right > window.innerWidth - marge) d = window.innerWidth - marge - r.right;
          tip.style.setProperty('--decalage', d + 'px');
        }
        // Une seule infobulle à la fois : le clic sur une icône ne remonte pas jusqu'au document
        // (sinon elle se refermerait aussitôt), il doit donc fermer lui-même les autres — sans
        // quoi deux icônes voisines (« Frais de courtage », « Délai de réponse ») empilaient
        // leurs bulles. Même chose au survol, sur ordinateur, d'une icône voisine d'une bulle ouverte.
        function fermer(sauf) {
          document.querySelectorAll('.fee-tooltip-wrap.is-open').forEach(function(wrap) {
            if (wrap === sauf) return;
            wrap.classList.remove('is-open');
            var b = wrap.querySelector('.fee-info-btn');
            if (b) b.setAttribute('aria-expanded', 'false');
          });
        }
        function initFeeTooltips() {
          document.querySelectorAll('.fee-tooltip-wrap').forEach(function(wrap) {
            wrap.addEventListener('mouseenter', function() { fermer(wrap); recadrer(wrap); });
          });
          document.querySelectorAll('.fee-info-btn').forEach(function(btn) {
            var wrap = btn.closest('.fee-tooltip-wrap');
            if (!wrap) return;
            btn.addEventListener('click', function(e) {
              e.stopPropagation();
              fermer(wrap);
              var open = wrap.classList.toggle('is-open');
              btn.setAttribute('aria-expanded', String(open));
              if (open) recadrer(wrap);
            });
          });
          document.addEventListener('click', function() { fermer(null); });
          document.addEventListener('keydown', function(e) {
            if (e.key === 'Escape') fermer(null);
          });
        }
        if (document.readyState === 'loading') {
          document.addEventListener('DOMContentLoaded', initFeeTooltips);
        } else {
          initFeeTooltips();
        }
      })();
    </script>

  </body>
</html>

<style is:global>
  /* --- RÉGLAGES GLOBAUX ---
     Les fondations (reset, html/body, .sr-only, .skip-link) vivent dans
     global.css (+ copie critical inline dans <head>). Ne pas les redéfinir ici. */

  /* Focus visible pour l'accessibilité au clavier */
  :focus-visible {
    outline: 2px solid var(--clay, #6d47ff);
    outline-offset: 4px;
  }

  .mobile-sticky-cta {
    display: none;
  }

  @media (max-width: 900px) {
    footer {
      padding-bottom: calc(2rem + var(--cta-bar-h) + env(safe-area-inset-bottom)) !important;
    }

    /* La bande : simple conteneur. Le padding latéral est symétrique pour garder
       la pilule centrée sur la fenêtre tout en réservant la place du bouton
       Messenger, qui se superpose à droite (voir global.css). */
    .mobile-sticky-cta {
      position: fixed;
      display: flex;
      align-items: center;
      justify-content: center;
      left: 0;
      right: 0;
      bottom: 0;
      z-index: 1000;
      height: var(--cta-bar-h);
      background: rgba(255,255,255, 0.97);
      backdrop-filter: blur(12px);
      -webkit-backdrop-filter: blur(12px);
      border-top: 1.5px solid var(--border);
      box-shadow: 0 -2px 16px rgba(0, 0, 0, 0.06);
      transition: transform 0.3s cubic-bezier(0.4, 0, 0.2, 1);
      padding: 0 calc(52px + 0.75rem);
      padding-bottom: env(safe-area-inset-bottom);
      box-sizing: content-box;
    }

    /* La pilule : même vocabulaire visuel que .nav-cta */
    .sticky-btn {
      display: inline-flex;
      align-items: center;
      justify-content: center;
      max-width: 100%;
      height: 46px;
      padding: 0 1.4rem;
      border-radius: 50px;
      background: var(--clay-dk);
      border: 2px solid var(--clay-dk);
      box-shadow: 0 8px 22px rgba(109,71,255,.35);
      color: #fff;
      font-family: "DM Sans", sans-serif;
      font-size: 0.95rem;
      font-weight: 600;
      letter-spacing: 0.01em;
      line-height: 1;
      white-space: nowrap;
      overflow: hidden;
      text-overflow: ellipsis;
      text-decoration: none;
      transition: background 0.2s, box-shadow 0.2s, transform 0.2s;
    }

    .sticky-btn:active {
      background: var(--clay-dk);
      border-color: var(--clay-dk);
      box-shadow: 0 4px 12px rgba(109,71,255,.35);
      transform: scale(.97);
    }

    /* Scroll-aware : la bande descend hors de l'écran (le bouton Messenger
       suit, voir global.css) */
    body.cta-hidden .mobile-sticky-cta {
      transform: translateY(calc(100% + env(safe-area-inset-bottom)));
    }

    /* Menu hamburger ouvert : le menu domine. La bande est déjà recouverte par
       le panneau (voir Nav.astro), on la retire aussi du parcours clavier et
       des clics pour qu'aucun « Prendre rendez-vous » invisible ne traîne. */
    body.menu-open .mobile-sticky-cta {
      visibility: hidden;
    }

    /* --- État converti (après capture courriel sur /outils/) : plein gaz.
       La bande reste neutre, c'est la pilule qui monte en intensité. --- */
    .mobile-sticky-cta.sticky-converted .sticky-btn {
      background: linear-gradient(135deg, var(--clay-dk), #4322c9);
      box-shadow: 0 6px 20px rgba(109,71,255, 0.45);
      font-weight: 700;
    }
    .mobile-sticky-cta.sticky-converted .sticky-btn:active {
      background: linear-gradient(135deg, var(--clay-dk), #4322c9);
      box-shadow: 0 3px 12px rgba(109,71,255, 0.45);
    }
  }

  @media (max-width: 420px) {
    .sticky-btn {
