---
// Finalisation d'un contrat — /finaliser-contrat?d=<dossier>. Réservé à la courtière.
//
// Dernier écran de la chaîne : tous les emprunteurs ont signé et répondu, Stéphanie relit le
// document tel qu'il sera signé, puis appose sa signature mémorisée d'un clic.
//
// L'accès passe par le mot de passe de /contrat, pas par un jeton nominatif : ce serait un
// secret de plus à faire circuler par courriel pour ouvrir exactement la même porte.
export const prerender = false;

import MainLayout from '../layouts/MainLayout.astro';
import BarreCourtiere from '../components/BarreCourtiere.astro';
import ConnexionCourtiere from '../components/ConnexionCourtiere.astro';
import { loadSiteConfig } from '../config';
import { accesConfigure, accesLibreEnDev, requeteAutorisee } from '../services/accesCourtiere';
import { etatFinalisation } from '../services/contratDossierService';
import { lireReglages } from '../services/reglagesCourtiere';
import {
  nomComplet,
  resumerContrat,
  resumerReponsesEmprunteur,
  type ReponsesEmprunteur,
} from '../utils/contratCourtage';
import { formatDateHeureLong } from '../utils/formatters';

const config = loadSiteConfig();
const autorise = await requeteAutorisee(Astro.request);
const configureManquante = !accesConfigure() && !accesLibreEnDev();

const dossierId = Astro.url.searchParams.get('d');
const etat = autorise ? await etatFinalisation(dossierId) : null;
const dossier = etat?.etat === 'pret' ? etat.dossier : null;

const reglages = autorise ? await lireReglages() : null;
const signatureEnregistree = reglages?.signature
  ? `data:image/png;base64,${reglages.signature.tracePngBase64}`
  : null;

const lignes = dossier ? resumerContrat(dossier.donnees) : [];

/**
 * Les réponses qui appellent un geste de sa part avant de signer : une PPV déclarée
 * (formulaire à remettre) ou un refus de transfert. Lues sur les réponses elles-mêmes,
 * jamais sur les libellés affichés. `resumerReponsesEmprunteur` les rend dans cet ordre :
 * PPV d'abord, transfert ensuite.
 */
function reponseAttention(reponses: ReponsesEmprunteur, rang: number): string | null {
  if (rang === 0 && reponses.ppv === 'oui') return 'Formulaire PPV à remettre';
  if (rang === 1 && reponses.transfertCabinet === 'non') return 'Refus de transfert';
  return null;
}

Astro.response.headers.set('Cache-Control', 'no-store');
---

<MainLayout
  sansTraduction
  title="Finaliser un contrat de courtage"
  description="Relecture et signature finale du contrat de courtage."
  noindex={true}
  sansBarreCta={true}
  sansConsentement={true}
>
  <main id="main-content" class="fc-page">
    <section class="fc-shell">
      {/* La barre sans onglet actif : cet écran n'en a pas, on n'y arrive que par un lien
          nominatif. Elle sert ici de sortie, pas de repère. */}
      {autorise && <BarreCourtiere />}
      {
        !autorise ? (
          <ConnexionCourtiere
            titre="Finaliser un contrat"
            configureManquante={configureManquante}
            nom={config.nom}
          />
        ) : !dossier ? (
          <div class="contact-form">
            {etat?.etat === 'en_attente' ? (
              <>
                <h1 class="fc-titre">Ce n’est pas encore votre tour</h1>
                <p class="fc-texte">
                  {etat.corrige
                    ? 'Le contrat a été corrigé : les signatures recueillies avant la correction ont été écartées, et chaque emprunteur doit signer la nouvelle version.'
                    : 'Tous les emprunteurs n’ont pas encore signé.'}{' '}
                  {etat.courant && (
                    <>
                      C’est au tour de <strong>{etat.courant}</strong>.{' '}
                    </>
                  )}
                  Vous serez prévenue par courriel dès que tout le monde aura signé, et ce
                  lien fonctionnera alors.
                </p>
              </>
            ) : etat?.etat === 'gele' ? (
              <>
                <h1 class="fc-titre">Un emprunteur a refusé de signer</h1>
                <p class="fc-texte">
                  {etat.refusePar ? `${etat.refusePar} a signalé un désaccord` : 'Un désaccord a été signalé'} :
                  le dossier est gelé et aucun contrat ne sera produit.
                </p>
              </>
            ) : etat?.etat === 'annule' ? (
              <>
                <h1 class="fc-titre">Ce contrat a été annulé</h1>
                <p class="fc-texte">Il n’y a plus rien à signer pour ce dossier.</p>
              </>
            ) : (
              <>
                <h1 class="fc-titre">Ce dossier n’est plus à finaliser</h1>
                <p class="fc-texte">
                  Il a déjà été signé et envoyé, ou il a expiré. Un contrat finalisé vous
                  parvient par courriel, avec son certificat de signature.
                </p>
              </>
            )}
            <p class="fc-texte">
              <a href="/contrat#ct-suivi">Voir le suivi des contrats</a>
            </p>
          </div>
        ) : (
          <div id="fc-app" class="contact-form" data-dossier={dossier.id}>
            <h1 class="fc-titre">Tout le monde a signé</h1>
            <p class="fc-texte">
              Il ne manque que votre signature. Le contrat ci-dessous porte les réponses des
              emprunteurs — relisez-les, puis signez. Le document n’est produit et envoyé
              qu’à ce moment-là.
            </p>

            <h2 class="fc-sous-titre">Ce qu’ils ont répondu</h2>
            {dossier.emprunteurs.map((entree) => (
              <div class="fc-emprunteur">
                <p class="fc-emprunteur-nom">
                  {nomComplet(entree.emprunteur)}
                  {entree.signature && (
                    <span class="fc-signe">signé le {formatDateHeureLong(entree.signature.signeLe)}</span>
                  )}
                </p>
                <dl class="fc-recap">
                  {(entree.reponses ? resumerReponsesEmprunteur(entree.reponses) : []).map(
                    ([libelle, valeur], rang) => {
                      const attention = entree.reponses ? reponseAttention(entree.reponses, rang) : null;
                      return (
                        <div class="fc-recap-ligne" data-attention={attention ? 'oui' : undefined}>
                          <dt>{libelle}</dt>
                          <dd>
                            {valeur}
                            {attention && <span class="fc-attention">{attention}</span>}
                          </dd>
                        </div>
                      );
                    },
                  )}
                </dl>
              </div>
            ))}

            <h2 class="fc-sous-titre">Le contrat</h2>
            {/* Sur téléphone, le cadre n'affiche souvent qu'une page, voire rien : la carte
                d'ouverture passe avant lui. Le lien sous le cadre reste sur ordinateur. */}
            <a
              href={`/api/contrat-apercu-courtiere?d=${encodeURIComponent(dossier.id)}`}
              target="_blank"
              rel="noopener"
              class="fc-ouvrir-document"
            >
              <span class="fc-ouvrir-icone" aria-hidden="true">📄</span>
              <span class="fc-ouvrir-texte">
                <strong>Relire le contrat au complet</strong>
                <span class="fc-ouvrir-detail">avec les signatures et les réponses — plein écran</span>
              </span>
              <span class="fc-ouvrir-fleche" aria-hidden="true">→</span>
            </a>
            <div class="fc-document">
              <iframe
                src={`/api/contrat-apercu-courtiere?d=${encodeURIComponent(dossier.id)}`}
                title="Contrat de courtage — document complet"
                loading="eager"
              ></iframe>
            </div>
            <p class="fc-texte fc-ouvrir-bureau">
              <a
                href={`/api/contrat-apercu-courtiere?d=${encodeURIComponent(dossier.id)}`}
                target="_blank"
                rel="noopener"
              >
                Ouvrir en plein écran (PDF)
              </a>
            </p>

            <h2 class="fc-sous-titre">Récapitulatif du contrat</h2>
            <dl class="fc-recap">
              {lignes.map(([libelle, valeur]) => (
                <div class="fc-recap-ligne">
                  <dt>{libelle}</dt>
                  <dd>{valeur}</dd>
                </div>
              ))}
            </dl>

            {signatureEnregistree ? (
              <div class="fc-signature">
                <span class="fc-signature-etiquette">Votre signature</span>
                <img src={signatureEnregistree} alt="Votre signature enregistrée" />
              </div>
            ) : (
              <p class="fc-alerte">
                Aucune signature enregistrée. Ouvrez <a href="/contrat">le générateur</a> et
                dessinez la vôtre dans « Ma signature », puis revenez ici.
              </p>
            )}

            <p class="fc-erreur" data-erreur hidden />
            <div class="fc-succes" data-succes role="status" hidden>
              <svg class="fc-succes-coche" viewBox="0 0 24 24" aria-hidden="true">
                <circle cx="12" cy="12" r="11" />
                <path d="M7 12.5l3.2 3.2L17 9" />
              </svg>
              <div>
                <p class="fc-succes-titre">Contrat envoyé</p>
                <p class="fc-succes-texte">
                  Signé et envoyé dans votre boîte courriel. Les emprunteurs ont reçu leur accusé.
                </p>
                <a class="fc-succes-lien" href="/contrat#ct-suivi">Retour au suivi des contrats</a>
              </div>
            </div>

            <button
              type="button"
              class="btn btn-primary fc-bouton"
              data-finaliser
              disabled={signatureEnregistree === null}
            >
              Signer et envoyer le contrat
            </button>
          </div>
        )
      }
    </section>
  </main>
</MainLayout>

<style>
  .fc-page {
    padding: 2rem 1rem 4rem;
  }

  .fc-shell {
    max-width: 760px;
    margin: 0 auto;
  }

  .fc-titre {
    margin: 0 0 0.6rem;
    font-size: 1.5rem;
  }

  .fc-sous-titre {
    margin: 1.8rem 0 0.7rem;
    font-size: 1.05rem;
  }

  .fc-texte {
    margin: 0 0 1rem;
    font-size: 0.93rem;
    line-height: 1.55;
  }

  .fc-emprunteur {
    margin-bottom: 1rem;
  }

  .fc-emprunteur-nom {
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    gap: 0.6rem;
    margin: 0 0 0.4rem;
    font-weight: 700;
    font-size: 0.95rem;
  }

  .fc-signe {
    font-weight: 400;
    font-size: 0.8rem;
    color: var(--muted);
  }

  .fc-recap {
    margin: 0 0 1rem;
    border: 1px solid var(--line, #e3d9cc);
    border-radius: 10px;
    overflow: hidden;
  }

  .fc-recap-ligne {
    display: grid;
    grid-template-columns: minmax(0, 1fr) minmax(0, 1.3fr);
    gap: 0.75rem;
    padding: 0.55rem 0.85rem;
    border-bottom: 1px solid var(--line, #e3d9cc);
    font-size: 0.87rem;
  }

  .fc-recap-ligne:last-child {
    border-bottom: 0;
  }

  .fc-recap dt {
    margin: 0;
    color: var(--muted);
  }

  .fc-recap dd {
    margin: 0;
    font-weight: 600;
    overflow-wrap: anywhere;
  }

  .fc-document {
    margin: 0 0 1rem;
    border: 1px solid var(--line, #e3d9cc);
    border-radius: 10px;
    overflow: hidden;
    background: #f6f2ec;
  }

  .fc-document iframe {
    display: block;
    width: 100%;
    height: 65vh;
    min-height: 400px;
    border: 0;
  }

  .fc-signature {
    display: flex;
    align-items: center;
    gap: 0.8rem;
    margin: 1.4rem 0 0.4rem;
    padding: 0.7rem 0.9rem;
    border: 1px solid var(--line, #e3d9cc);
    border-radius: 10px;
    background: #faf7f2;
  }

  .fc-signature-etiquette {
    font-size: 0.8rem;
    color: var(--muted);
  }

  .fc-signature img {
    height: 34px;
    width: auto;
    max-width: 200px;
  }

  .fc-bouton {
    margin-top: 1rem;
  }

  .fc-erreur,
  .fc-alerte {
    margin: 1rem 0 0;
    padding: 0.7rem 0.85rem;
    border-radius: 8px;
    background: #fdeceb;
    color: #8f2f28;
    font-size: 0.88rem;
    line-height: 1.5;
  }

  .fc-succes {
    display: flex;
    gap: 0.8rem;
    align-items: flex-start;
    margin: 1rem 0 0;
    padding: 0.9rem 1rem;
    border-radius: 8px;
    background: #eaf5ec;
    color: #26603a;
    font-size: 0.88rem;
    line-height: 1.5;
  }

  .fc-succes[hidden] {
    display: none;
  }

  .fc-succes-coche {
    flex: none;
    width: 2rem;
    height: 2rem;
  }

  .fc-succes-coche circle {
    fill: #26603a;
  }

  .fc-succes-coche path {
    fill: none;
    stroke: #fff;
    stroke-width: 2.4;
    stroke-linecap: round;
    stroke-linejoin: round;
  }

  .fc-succes-titre {
    margin: 0;
    font-weight: 600;
    font-size: 1rem;
  }

  .fc-succes-texte {
    margin: 0.15rem 0 0.4rem;
  }

  .fc-succes-lien {
    color: #26603a;
    font-weight: 600;
  }

  /* Ce qui demande un geste avant de signer ressort de la liste. */
  .fc-recap-ligne[data-attention='oui'] {
    background: #fdf2e7;
  }

  .fc-attention {
    display: inline-block;
    margin-left: 0.5rem;
    padding: 0.05rem 0.5rem;
    border-radius: 999px;
    background: #fff;
    color: #8a5320;
    font-size: 0.75rem;
    font-weight: 600;
    white-space: nowrap;
  }

  /* Un <button> n'hérite pas de la police : `.btn-primary` la laissait au système. */
  .fc-shell :global(button.btn-primary) {
    font-family: inherit;
  }

  .fc-ouvrir-document {
    display: none;
  }

  @media (max-width: 560px) {
    /* Page, section et carte empilaient leurs marges : 80 px de chaque côté sur un
       écran de 390, et une colonne de texte de 230 px. */
    .fc-page {
      padding: 0.75rem 0.5rem 2rem;
    }

    .fc-shell {
      padding: 0;
    }

    .fc-shell :global(.contact-form) {
      padding: 1.1rem 1rem;
      border-radius: 18px;
    }

    .fc-titre {
      font-size: 1.3rem;
      line-height: 1.25;
    }

    .fc-recap-ligne {
      grid-template-columns: 1fr;
      gap: 0.15rem;
    }

    .fc-attention {
      margin: 0.25rem 0 0;
    }

    .fc-ouvrir-document {
      display: flex;
      align-items: center;
      gap: 0.8rem;
      margin: 0 0 0.8rem;
      padding: 0.9rem 1rem;
      border: 1.5px solid var(--clay);
      border-radius: 12px;
      background: var(--white);
      color: var(--ink);
      text-decoration: none;
    }

    .fc-ouvrir-icone {
      font-size: 1.4rem;
    }

    .fc-ouvrir-texte {
      display: flex;
      flex: 1;
      flex-direction: column;
      gap: 0.1rem;
    }

    .fc-ouvrir-detail {
      font-size: 0.8rem;
      color: var(--muted);
    }

    .fc-ouvrir-fleche {
      color: var(--clay);
      font-weight: 700;
    }

    .fc-ouvrir-bureau {
      display: none;
    }

    .fc-document iframe {
      height: 60vh;
      min-height: 360px;
    }

    .fc-bouton {
      width: 100%;
      text-align: center;
    }
  }
</style>

<script>
  const app = document.getElementById('fc-app');
  const bouton = app?.querySelector<HTMLButtonElement>('[data-finaliser]');

  bouton?.addEventListener('click', async () => {
    const erreur = app!.querySelector<HTMLElement>('[data-erreur]');
    const succes = app!.querySelector<HTMLElement>('[data-succes]');
    if (erreur) erreur.hidden = true;

    bouton.disabled = true;
    bouton.textContent = 'Signature…';

    try {
      const reponse = await fetch('/api/contrat-finaliser', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({ d: app!.dataset.dossier }),
      });
      const data = (await reponse.json().catch(() => ({}))) as Record<string, unknown>;

      if (!reponse.ok) {
        if (erreur) {
          erreur.textContent = String(data.error ?? 'La finalisation a échoué. Réessayez.');
          erreur.hidden = false;
        }
        bouton.disabled = false;
        bouton.textContent = 'Signer et envoyer le contrat';
        return;
      }

      // Le geste est accompli : un bouton qui ne fait plus rien n'a pas à rester un bouton.
      bouton.remove();
      if (succes) succes.hidden = false;
    } catch {
      if (erreur) {
        erreur.textContent = 'Connexion impossible. Vérifiez votre réseau et réessayez.';
        erreur.hidden = false;
      }
      bouton.disabled = false;
      bouton.textContent = 'Signer et envoyer le contrat';
    }
  });
</script>
