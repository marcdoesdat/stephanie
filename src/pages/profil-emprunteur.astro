---
// Formulaire « Profil des emprunteurs » (Hypotheca / AMF) rempli en tuiles.
//
// Le client ne voit jamais le PDF : il clique des options qui auto-avancent, relit un
// récapitulatif des 8 réponses dans les termes exacts du formulaire, puis signe. Le PDF
// officiel est estampé côté serveur et envoyé à la seule courtière — il n'est ni joint à
// l'accusé du client, ni redescendu au navigateur. L'écran de confirmation ne propose donc
// aucun téléchargement.
//
// Page volontairement sans Nav ni Footer, noindex et hors sitemap : elle n'est pas une
// page de contenu, c'est un document de conformité que Stéphanie envoie à ses clients par
// lien. Voir PLAN-profil-emprunteurs.md.
export const prerender = true;

import { Image } from 'astro:assets';
import stephaniePhoto from '../assets/stephanie.webp';
import MainLayout from '../layouts/MainLayout.astro';
import SignaturePad from '../components/SignaturePad.astro';
import { loadSiteConfig } from '../config';
import {
  AUTRE_MONTANT_MAX,
  AUTRE_MONTANT_MIN,
  MAX_SIGNATAIRES,
  QUESTIONS,
  TEXTE_ATTESTATION,
} from '../utils/profilEmprunteurs';

const config = loadSiteConfig();
const prenom = config.nom.split(' ')[0];

// 8 questions + récapitulatif + nombre d'emprunteurs + signataires + signature.
const TOTAL_ETAPES = QUESTIONS.length + 4;
const ETAPE_RECAP = QUESTIONS.length + 1;
const ETAPE_NOMBRE = QUESTIONS.length + 2;
const ETAPE_SIGNATAIRES = QUESTIONS.length + 3;
const ETAPE_SIGNATURE = QUESTIONS.length + 4;

// Le nombre d'emprunteurs est demandé en tuiles, sans valeur par défaut : la liste des
// signataires s'ouvrait sur une seule carte et un « + Ajouter » discret qu'on pouvait
// traverser sans le voir, et le co-emprunteur se retrouvait absent d'un formulaire pourtant
// signé « notre vision commune ». Une question à laquelle il faut répondre ne s'oublie pas.
// Si MAX_SIGNATAIRES augmente, ajouter ici la ligne correspondante.
const OPTIONS_NOMBRE = [
  {
    nombre: 1,
    label: 'Je suis seul emprunteur',
    precision: 'Personne d’autre ne sera inscrit au prêt.',
  },
  {
    nombre: 2,
    label: 'Nous sommes deux',
    precision: 'Conjoint, conjointe, co-acheteur, parent qui endosse…',
  },
  {
    nombre: 3,
    label: 'Nous sommes trois',
    precision: 'Trois personnes inscrites au même prêt.',
  },
].slice(0, MAX_SIGNATAIRES);
---

<MainLayout
  title="Profil des emprunteurs"
  description="Questionnaire de profil d'emprunteur — quelques questions pour vous recommander le produit hypothécaire adapté à vos objectifs."
  noindex={true}
  sansBarreCta={true}
>
  <main id="main-content" class="profil-page">
    <section class="profil-shell" aria-label="Profil des emprunteurs">
      <div class="contact-form quiz">
        <div class="quiz-trust">
          <Image
            src={stephaniePhoto}
            alt={`${config.nom}, ${config.titre}`}
            width={56}
            height={56}
            class="quiz-trust-photo"
            loading="eager"
          />
          <div class="quiz-trust-text">
            <strong>{config.nom}</strong>
            <span>{config.titre} · {config.organisation} · AMF {config.amf}</span>
          </div>
        </div>

        <div class="quiz-progress" data-progress hidden>
          <div class="quiz-progress-meta">
            <span class="quiz-progress-label">
              Étape <span data-num>1</span> sur {TOTAL_ETAPES}
            </span>
            <button type="button" class="quiz-back" data-retour hidden>← Retour</button>
          </div>
          <div class="quiz-progress-bar">
            <div class="quiz-progress-fill" data-fill style="width:0%"></div>
          </div>
        </div>

        <form data-formulaire novalidate>
          <div class="profil-hp" aria-hidden="true">
            <label for="company">Ne pas remplir</label>
            <input type="text" id="company" name="company" tabindex="-1" autocomplete="off" />
          </div>

          {/* ---------- Écran 0 : introduction ---------- */}
          <div class="quiz-step" data-etape="0">
            <h1 class="profil-titre">Votre profil d'emprunteur</h1>
            <p class="profil-intro">
              Quelques questions pour comprendre vos objectifs et vos préférences. Vos réponses
              seront combinées à vos informations financières pour vous recommander le produit
              hypothécaire le mieux adapté à votre situation — pas seulement le taux le plus bas.
            </p>
            <p class="profil-intro">
              Comptez deux minutes. À la fin, vous relirez vos réponses et vous signerez.
            </p>
            <div class="profil-encadre">
              <strong>Vous êtes plus d'un emprunteur&nbsp;?</strong>
              Le prêt hypothécaire est un engagement conjoint et solidaire : discutez des réponses
              ensemble avant de les soumettre, pour qu'elles reflètent votre vision commune et non
              celle d'une seule personne.
            </div>
            <button type="button" class="btn-cta btn-cta--block" data-demarrer>Commencer</button>
          </div>

          {/* ---------- Écrans 1 à 8 : les questions ---------- */}
          {
            QUESTIONS.map((question, index) => (
              <div class="quiz-step" data-etape={String(index + 1)} hidden>
                <p class="quiz-q" id={`libelle-${question.id}`}>{question.question}</p>
                {question.precision && <p class="quiz-q-sub">{question.precision}</p>}

                <div
                  class={`quiz-options ${question.disposition === 'grille' ? 'profil-grille' : ''}`}
                  role="group"
                  aria-labelledby={`libelle-${question.id}`}
                >
                  {question.options.map((option) => (
                    <button
                      type="button"
                      class="quiz-card"
                      data-choix
                      data-question={question.id}
                      data-valeur={option.cle}
                    >
                      <span class="quiz-card-text"><strong>{option.label}</strong></span>
                    </button>
                  ))}
                </div>

                {question.id === 'absorption' && (
                  <div class="profil-autre" data-autre hidden>
                    <label class="cform-label" for="autre-montant">Quel montant&nbsp;?</label>
                    <div class="profil-autre-champ">
                      <input
                        type="number"
                        id="autre-montant"
                        class="cform-input"
                        inputmode="numeric"
                        min={AUTRE_MONTANT_MIN}
                        max={AUTRE_MONTANT_MAX}
                        step="1"
                        placeholder="325"
                      />
                      <span aria-hidden="true">$</span>
                    </div>
                    <button type="button" class="btn-cta btn-cta--block" data-valider-autre>Continuer</button>
                  </div>
                )}

                <p class="profil-erreur" data-erreur role="alert" hidden></p>
              </div>
            ))
          }

          {/* ---------- Récapitulatif ---------- */}
          <div class="quiz-step" data-etape={String(ETAPE_RECAP)} hidden>
            <p class="quiz-q">Relisez vos réponses</p>
            <p class="quiz-q-sub">
              Ce sont les termes exacts du formulaire que vous allez signer. Touchez une ligne pour
              la corriger.
            </p>
            <ul class="profil-recap" data-recap></ul>
          </div>

          {/* ---------- Nombre d'emprunteurs ---------- */}
          <div class="quiz-step" data-etape={String(ETAPE_NOMBRE)} hidden>
            <p class="quiz-q" id="libelle-nombre">Combien d’emprunteurs seront au prêt&nbsp;?</p>
            <p class="quiz-q-sub">
              Toute personne inscrite à l’hypothèque doit signer ce formulaire — même celle qui ne
              fournit pas la mise de fonds.
            </p>

            {/* Visible seulement quand le lien portait un préremplissage : la réponse est
                pré-sélectionnée, mais la question reste posée — c'est le client qui la valide. */}
            <p class="profil-prepare" data-note-preparation hidden>
              {prenom} a préparé ce formulaire d’avance. Vérifiez que le nombre est exact&nbsp;;
              corrigez-le au besoin.
            </p>

            <div class="quiz-options" role="group" aria-labelledby="libelle-nombre">
              {
                OPTIONS_NOMBRE.map((option) => (
                  <button
                    type="button"
                    class="quiz-card"
                    data-nombre={String(option.nombre)}
                  >
                    <span class="quiz-card-text">
                      <strong>{option.label}</strong>
                      <span>{option.precision}</span>
                    </span>
                  </button>
                ))
              }
            </div>

            <p class="profil-erreur" data-erreur role="alert" hidden></p>
          </div>

          {/* ---------- Signataires ---------- */}
          <div class="quiz-step" data-etape={String(ETAPE_SIGNATAIRES)} hidden>
            <p class="quiz-q" data-titre-signataires>Qui signe&nbsp;?</p>
            <p class="quiz-q-sub" data-sous-signataires>
              Tous les emprunteurs au prêt doivent signer. Chacun a besoin de sa propre adresse
              courriel.
            </p>

            <p class="profil-prepare" data-note-preparation hidden>
              Les coordonnées ci-dessous viennent de {prenom}. Corrigez-les si besoin&nbsp;: c’est
              à ces adresses que partiront les accusés de signature.
            </p>

            <div data-signataires></div>

            <button type="button" class="profil-ajout" data-ajouter>+ Ajouter un autre emprunteur</button>

            {/* Aucune réponse n'est pré-cochée. C'est cette question, et elle seule, qui décide
                si un lien de signature part vers les autres emprunteurs : pré-cocher « ils sont
                avec moi » faisait traverser sans la voir la branche où personne ne reçoit rien,
                et un co-emprunteur pouvait attendre indéfiniment un courriel jamais dû. Même
                raison que l'écran du nombre d'emprunteurs. */}
            <fieldset class="profil-voie" data-voie-groupe hidden>
              <legend class="cform-label">Les autres emprunteurs sont-ils avec vous maintenant&nbsp;?</legend>
              <label class="profil-voie-choix">
                <input type="radio" name="voie" value="presence" />
                <span>
                  <strong>Oui, ils sont avec moi</strong>
                  Chacun signera sur cet appareil, l'un après l'autre. Aucun lien ne sera envoyé.
                </span>
              </label>
              <label class="profil-voie-choix">
                <input type="radio" name="voie" value="distance" />
                <span>
                  <strong>Non, ils signeront de leur côté</strong>
                  Chacun recevra par courriel son propre lien pour lire et signer, à l'adresse
                  indiquée ci-dessus.
                </span>
              </label>
            </fieldset>

            <p class="profil-note">
              Vos renseignements servent uniquement à ce dossier. Voir la
              <a href="/confidentialite">politique de confidentialité</a>.
            </p>

            <p class="profil-erreur" data-erreur role="alert" hidden></p>
            <button type="button" class="btn-cta btn-cta--block" data-vers-signature>Passer à la signature</button>
          </div>

          {/* ---------- Signatures ---------- */}
          <div class="quiz-step" data-etape={String(ETAPE_SIGNATURE)} hidden>
            <p class="quiz-q" data-titre-signature>Votre signature</p>
            <p class="quiz-q-sub" data-sous-signature>
              Signez dans le cadre, comme sur papier.
            </p>

            {
              Array.from({ length: MAX_SIGNATAIRES }).map((_, index) => (
                <div class="profil-bloc-signature" data-bloc-signature={String(index)} hidden>
                  <SignaturePad id={`signature-${index}`} />
                  <label class="profil-attestation">
                    <input type="checkbox" data-attestation={String(index)} />
                    <span>{TEXTE_ATTESTATION}</span>
                  </label>
                </div>
              ))
            }

            <p class="profil-erreur" data-erreur role="alert" hidden></p>
            <button type="button" class="btn-cta btn-cta--block" data-signer>Signer</button>
          </div>

          {/* ---------- Confirmation ---------- */}
          <div class="quiz-step quiz-step--final" data-etape="fin" hidden>
            <h2 class="profil-titre" data-fin-titre>C'est signé</h2>
            <p class="profil-intro" data-fin-texte></p>
            <p class="profil-note">
              Rien reçu d'ici quelques minutes&nbsp;? Regardez dans vos courriels indésirables.
            </p>
            <p class="profil-note">
              Une question&nbsp;? Écrivez à <a href={`mailto:${config.courriel}`}>{config.courriel}</a>
              ou appelez {prenom} au <a href={`tel:+1${config.telephone.replace(/\D/g, '')}`}>{config.telephone}</a>.
            </p>
            {/* Discret, mais la page ne doit pas être un cul-de-sac : le client est arrivé
                par un lien privé, sans navigation. */}
            <a class="profil-retour" href="/">Retour au site de {prenom} →</a>
          </div>
        </form>
      </div>
    </section>
  </main>
</MainLayout>

<style>
  .profil-page {
    background: var(--sand);
    min-height: 100vh;
    padding: clamp(1.25rem, 4vw, 3rem) 1rem 5rem;
  }

  .profil-shell {
    max-width: 640px;
    margin: 0 auto;
  }

  .profil-titre {
    font-family: 'Lora', serif;
    font-size: clamp(1.5rem, 4vw, 1.95rem);
    font-weight: 600;
    line-height: 1.25;
    color: var(--ink);
    margin-bottom: 0.9rem;
  }

  .profil-intro {
    font-size: 0.98rem;
    line-height: 1.7;
    color: var(--muted);
    margin-bottom: 1rem;
  }

  .profil-encadre {
    background: var(--warm);
    border: 1px solid var(--border);
    border-radius: 12px;
    padding: 1rem 1.1rem;
    font-size: 0.9rem;
    line-height: 1.65;
    color: var(--ink);
    margin: 1.2rem 0 1.6rem;
  }

  .profil-encadre strong {
    display: block;
    margin-bottom: 0.25rem;
  }

  /* Options courtes (Très faibles / Faibles / …) : deux colonnes au lieu d'une pile. */
  .profil-grille {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 0.65rem;
  }

  .profil-autre {
    margin-top: 1rem;
  }

  .profil-autre-champ {
    display: flex;
    align-items: center;
    gap: 0.5rem;
    margin-bottom: 0.9rem;
  }

  .profil-autre-champ input {
    flex: 1;
  }

  /* ---- Récapitulatif ---- */

  .profil-recap {
    list-style: none;
    display: flex;
    flex-direction: column;
    gap: 0.5rem;
    margin: 0.4rem 0 1.4rem;
    padding: 0;
  }

  /* Le contenu du récapitulatif est construit en JavaScript : ces éléments ne portent pas
     l'attribut de scope d'Astro, il faut donc les viser en :global sous le parent scopé. */
  .profil-recap :global(.recap-ligne) {
    display: block;
    width: 100%;
    text-align: left;
    background: var(--white);
    border: 1px solid var(--border);
    border-radius: 12px;
    padding: 0.8rem 0.95rem;
    font: inherit;
    cursor: pointer;
  }

  .profil-recap :global(.recap-ligne:hover),
  .profil-recap :global(.recap-ligne:focus-visible) {
    border-color: var(--clay);
  }

  .profil-recap :global(.recap-q) {
    display: block;
    font-size: 0.78rem;
    line-height: 1.45;
    color: var(--muted);
    margin-bottom: 0.25rem;
  }

  .profil-recap :global(.recap-r) {
    display: block;
    font-size: 0.92rem;
    font-weight: 600;
    color: var(--ink);
  }

  .profil-recap :global(.recap-modifier) {
    float: right;
    margin-left: 0.75rem;
    font-size: 0.75rem;
    color: var(--clay-dk);
    text-decoration: underline;
  }

  /* Le liseré dit d'où vient ce qui est déjà dans les champs — sans quoi un formulaire
     pré-rempli ressemble à un formulaire qu'on aurait déjà commencé soi-même. */
  .profil-prepare {
    background: var(--warm);
    border-left: 3px solid var(--clay);
    border-radius: 0 8px 8px 0;
    padding: 0.7rem 0.9rem;
    margin: 0 0 1.1rem;
    font-size: 0.86rem;
    line-height: 1.6;
    color: var(--ink);
  }

  /* ---- Signataires ---- */

  /* Cartes de signataires : également construites en JavaScript, d'où le :global. */
  [data-signataires] :global(.profil-signataire) {
    background: var(--white);
    border: 1px solid var(--border);
    border-radius: 12px;
    padding: 0.9rem 1rem 0.2rem;
    margin-bottom: 0.75rem;
  }

  [data-signataires] :global(.profil-signataire-tete) {
    display: flex;
    justify-content: space-between;
    align-items: baseline;
    gap: 1rem;
    margin-bottom: 0.5rem;
  }

  [data-signataires] :global(.profil-signataire-tete strong) {
    font-size: 0.85rem;
  }

  [data-signataires] :global(.profil-retirer) {
    background: none;
    border: 0;
    padding: 0;
    font: inherit;
    font-size: 0.78rem;
    color: var(--muted);
    text-decoration: underline;
    cursor: pointer;
  }

  [data-signataires] :global(.cform-label) {
    margin-top: 0.6rem;
  }

  /* global.css met margin-bottom:1.2rem sur tout input de .contact-form : trop d'air
     entre deux champs d'une même carte. */
  [data-signataires] :global(input) {
    margin-bottom: 0.7rem;
  }

  .profil-ajout {
    display: block;
    width: 100%;
    background: none;
    border: 1px dashed var(--border);
    border-radius: 12px;
    padding: 0.75rem;
    font: inherit;
    font-size: 0.88rem;
    color: var(--clay-dk);
    cursor: pointer;
    margin-bottom: 1.1rem;
  }

  .profil-ajout:hover {
    border-color: var(--clay);
  }

  .profil-voie {
    border: 0;
    padding: 0;
    margin: 0 0 1.1rem;
  }

  .profil-voie-choix {
    display: flex;
    gap: 0.7rem;
    align-items: flex-start;
    background: var(--white);
    border: 1px solid var(--border);
    border-radius: 12px;
    padding: 0.8rem 0.95rem;
    margin-top: 0.55rem;
    cursor: pointer;
  }

  .profil-voie-choix:has(input:checked) {
    border-color: var(--clay);
    background: var(--warm);
  }

  .profil-voie-choix span {
    font-size: 0.85rem;
    line-height: 1.55;
    color: var(--muted);
  }

  .profil-voie-choix strong {
    display: block;
    font-size: 0.92rem;
    color: var(--ink);
  }

  /* ---- Signature ---- */

  .profil-bloc-signature {
    margin-bottom: 1.6rem;
  }

  .profil-attestation {
    display: flex;
    gap: 0.6rem;
    align-items: flex-start;
    margin-top: 0.8rem;
    font-size: 0.85rem;
    line-height: 1.6;
    color: var(--muted);
    cursor: pointer;
  }

  /* global.css impose width:100% + padding à tout input de .contact-form ; sans ce
     rappel, la case à cocher occupe toute la largeur et éjecte le texte hors de la carte. */
  .profil-attestation input[type='checkbox'],
  .profil-voie-choix input[type='radio'] {
    width: auto;
    flex: 0 0 auto;
    padding: 0;
    margin: 0.3rem 0 0;
  }

  /* ---- Divers ---- */

  .profil-note {
    font-size: 0.8rem;
    line-height: 1.6;
    color: var(--muted);
    margin-top: 1rem;
  }

  .profil-note a {
    color: var(--clay-dk);
  }

  /* Adresses de destination sur l'écran final : construites en JavaScript, d'où le :global.
     `anywhere` plutôt que nowrap — une adresse longue doit se couper, pas déborder du bloc. */
  .profil-intro :global(.profil-adresse) {
    color: var(--ink);
    font-weight: 600;
    overflow-wrap: anywhere;
  }

  .profil-retour {
    align-self: flex-start;
    font-size: 0.86rem;
    color: var(--muted);
    text-decoration: underline;
  }

  .profil-retour:hover {
    color: var(--clay-dk);
  }

  .profil-erreur {
    margin-top: 0.8rem;
    font-size: 0.86rem;
    color: #a8382f;
  }

  .profil-erreur-detail {
    display: block;
    margin-top: 0.35rem;
    font-size: 0.72rem;
    line-height: 1.5;
    color: var(--muted);
    word-break: break-word;
  }

  .profil-hp {
    position: absolute;
    left: -9999px;
    width: 1px;
    height: 1px;
    overflow: hidden;
  }

  @media (max-width: 420px) {
    .profil-grille {
      grid-template-columns: 1fr;
    }
  }
</style>

<script>
  import { QUESTIONS, MAX_SIGNATAIRES, estCourrielValide, resumerReponses } from '../utils/profilEmprunteurs';
  import { PARAM_PREREMPLISSAGE, decoderPreremplissage } from '../utils/profilPreparation';
  import type { SignaturePadElement } from '../scripts/signaturePad';

  const CLE_STOCKAGE = 'sw_profil_emprunteurs_v1';
  const ETAPE_RECAP = QUESTIONS.length + 1;
  const ETAPE_NOMBRE = QUESTIONS.length + 2;
  const ETAPE_SIGNATAIRES = QUESTIONS.length + 3;
  const ETAPE_SIGNATURE = QUESTIONS.length + 4;
  const TOTAL = ETAPE_SIGNATURE;

  interface Signataire {
    nom: string;
    courriel: string;
  }

  /** Ce que /api/profil-submit renvoie quand la soumission a abouti. */
  interface Reponse {
    /** Co-emprunteurs relancés par lien nominatif — voie « à distance » uniquement. */
    enAttente?: Signataire[];
    /** Adresses qui reçoivent (ou recevront) l'accusé de signature. Jamais le PDF. */
    copies?: string[];
  }

  interface Etat {
    reponses: Record<string, string>;
    autreMontant: string;
    /** Nombre d'emprunteurs déclaré à l'écran dédié. `null` tant que rien n'a été choisi. */
    nombre: number | null;
    signataires: Signataire[];
    /**
     * Réponse à « les autres emprunteurs sont-ils avec vous ? ». `null` tant que rien n'a été
     * choisi — cette question n'a pas de défaut, voir `voieSoumise()`.
     */
    voie: 'presence' | 'distance' | null;
    /** Écran affiché au moment de la dernière sauvegarde — pour reprendre après un F5. */
    etape: number;
  }

  const formulaire = document.querySelector<HTMLFormElement>('[data-formulaire]');
  if (formulaire) demarrer(formulaire);

  function demarrer(formulaire: HTMLFormElement): void {
    const ecrans = Array.from(formulaire.querySelectorAll<HTMLElement>('.quiz-step'));
    const barre = document.querySelector<HTMLElement>('[data-progress]');
    const remplissage = document.querySelector<HTMLElement>('[data-fill]');
    const numero = document.querySelector<HTMLElement>('[data-num]');
    const boutonRetour = document.querySelector<HTMLButtonElement>('[data-retour]');
    const listeRecap = formulaire.querySelector<HTMLElement>('[data-recap]');
    const conteneurSignataires = formulaire.querySelector<HTMLElement>('[data-signataires]');
    const titreSignataires = formulaire.querySelector<HTMLElement>('[data-titre-signataires]');
    const sousSignataires = formulaire.querySelector<HTMLElement>('[data-sous-signataires]');
    const boutonAjouter = formulaire.querySelector<HTMLButtonElement>('[data-ajouter]');
    const groupeVoie = formulaire.querySelector<HTMLElement>('[data-voie-groupe]');

    let etape = 0;
    /** Quand on corrige depuis le récapitulatif, on y retourne au lieu d'avancer. */
    let retourAuRecap = false;
    let envoiEnCours = false;
    /** Une fois le dossier parti, plus rien ne doit être réécrit en session. */
    let termine = false;

    const etat: Etat = charger();

    /* ---------------- Préremplissage ---------------- */

    /**
     * Pose dans l'état les coordonnées que la courtière a préparées dans le lien
     * (`/preparer-profil`). Retourne vrai dès que le lien en portait — même si rien n'a été
     * écrit — pour que les deux écrans concernés puissent le dire au client.
     *
     * Trois précautions, dans cet ordre :
     *
     *   • **une saisie déjà commencée l'emporte.** Recharger la page ne doit pas ramener une
     *     adresse que le client venait de corriger : le préremplissage est une proposition,
     *     et une proposition ne se réimpose pas.
     *   • **l'URL est nettoyée aussitôt.** Des noms et des adresses n'ont rien à faire dans la
     *     barre d'adresse, ni dans l'historique d'un appareil parfois partagé.
     *   • **rien n'est verrouillé.** Les champs restent modifiables : la faute de frappe qu'il
     *     faut pouvoir rattraper est justement celle qui vient d'ailleurs.
     */
    function appliquerPreremplissage(): boolean {
      const emprunteurs = decoderPreremplissage(
        new URLSearchParams(window.location.search).get(PARAM_PREREMPLISSAGE),
      );
      if (!emprunteurs) return false;

      try {
        window.history.replaceState(null, '', window.location.pathname);
      } catch {
        // Navigateur qui refuse la réécriture : le formulaire fonctionne quand même.
      }

      const dejaSaisi = etat.signataires.some((s) => s.nom !== '' || s.courriel !== '');
      if (dejaSaisi) return true;

      etat.signataires = emprunteurs.map((emprunteur) => ({
        nom: emprunteur.nom,
        courriel: emprunteur.courriel,
      }));
      // Le nombre reste **demandé** : il est seulement pré-sélectionné à l'écran, que le
      // client doit toujours franchir d'un clic. Une valeur préparée par la courtière n'est
      // pas un nombre deviné par le formulaire.
      etat.nombre = emprunteurs.length;
      sauvegarder();
      return true;
    }

    const prerempli = appliquerPreremplissage();

    /* ---------------- Persistance ---------------- */

    function charger(): Etat {
      const vide: Etat = {
        reponses: {},
        autreMontant: '',
        nombre: null,
        signataires: [{ nom: '', courriel: '' }],
        voie: null,
        etape: 0,
      };
      try {
        const brut = sessionStorage.getItem(CLE_STOCKAGE);
        if (!brut) return vide;
        const lu = JSON.parse(brut) as Partial<Etat>;
        return {
          reponses: lu.reponses ?? {},
          autreMontant: lu.autreMontant ?? '',
          // Une session ouverte avant l'ajout de cet écran n'a pas de nombre : elle repasse
          // par la question plutôt que d'hériter d'un compte qu'on aurait deviné.
          nombre:
            typeof lu.nombre === 'number' &&
            Number.isInteger(lu.nombre) &&
            lu.nombre >= 1 &&
            lu.nombre <= MAX_SIGNATAIRES
              ? lu.nombre
              : null,
          signataires: lu.signataires?.length ? lu.signataires : vide.signataires,
          // Une session ouverte avant que la question cesse d'avoir un défaut peut porter
          // n'importe quoi : tout ce qui n'est pas un choix explicite repasse par la question.
          voie: lu.voie === 'distance' ? 'distance' : lu.voie === 'presence' ? 'presence' : null,
          etape: typeof lu.etape === 'number' && Number.isInteger(lu.etape) ? lu.etape : 0,
        };
      } catch {
        return vide;
      }
    }

    function sauvegarder(): void {
      if (termine) return;
      try {
        // Les tracés de signature ne sont jamais persistés — ils restent en mémoire.
        sessionStorage.setItem(CLE_STOCKAGE, JSON.stringify(etat));
      } catch {
        // Navigation privée ou quota plein : on continue sans reprise possible.
      }
    }

    /* ---------------- Navigation ---------------- */

    function afficher(cible: number | 'fin'): void {
      etape = typeof cible === 'number' ? cible : TOTAL;
      const clef = typeof cible === 'number' ? String(cible) : 'fin';

      for (const ecran of ecrans) {
        const estActif = ecran.dataset.etape === clef;
        ecran.hidden = !estActif;
        if (estActif) {
          const titre = ecran.querySelector<HTMLElement>('.quiz-q, .profil-titre');
          titre?.setAttribute('tabindex', '-1');
          titre?.focus();
        }
      }

      const enCours = typeof cible === 'number' && cible >= 1 && cible <= TOTAL;
      if (barre) barre.hidden = !enCours;
      if (enCours) {
        if (numero) numero.textContent = String(cible);
        if (remplissage) remplissage.style.width = `${Math.round((cible / TOTAL) * 100)}%`;
        if (boutonRetour) boutonRetour.hidden = cible <= 1;
      }

      // L'écran courant fait partie de l'état : sans lui, un rechargement conservait les
      // réponses mais renvoyait à l'introduction — ce qui se vit comme une perte totale.
      // L'écran final n'est jamais mémorisé : le dossier est parti, la session est effacée.
      if (typeof cible === 'number') {
        etat.etape = cible;
        sauvegarder();
      }

      masquerErreurs();
      window.scrollTo({ top: 0, behavior: 'smooth' });
    }

    function masquerErreurs(): void {
      for (const erreur of formulaire.querySelectorAll<HTMLElement>('[data-erreur]')) erreur.hidden = true;
    }

    function erreur(message: string, code?: string, detail?: string): void {
      const ecran = ecrans.find((e) => !e.hidden);
      const cible = ecran?.querySelector<HTMLElement>('[data-erreur]');
      if (!cible) return;
      cible.textContent = message;
      if (code || detail) {
        // Ligne de diagnostic discrète : elle évite un cycle de déploiement complet pour
        // savoir ce qui a réellement échoué.
        const technique = document.createElement('span');
        technique.className = 'profil-erreur-detail';
        technique.textContent = `Détail technique — ${code ?? 'inconnu'} : ${detail ?? 'aucun'}`;
        cible.appendChild(technique);
      }
      cible.hidden = false;
    }

    formulaire.querySelector('[data-demarrer]')?.addEventListener('click', () => afficher(1));

    boutonRetour?.addEventListener('click', () => {
      if (etape > 1) afficher(etape - 1);
    });

    /* ---------------- Questions ---------------- */

    function appliquerSelection(question: string, valeur: string): void {
      for (const carte of formulaire.querySelectorAll<HTMLElement>(`[data-choix][data-question="${question}"]`)) {
        carte.classList.toggle('selected', carte.dataset.valeur === valeur);
      }
    }

    function avancerDepuis(indexQuestion: number): void {
      if (retourAuRecap) {
        retourAuRecap = false;
        construireRecap();
        afficher(ETAPE_RECAP);
        return;
      }
      const suivante = indexQuestion + 2; // les écrans de question commencent à 1
      if (suivante > QUESTIONS.length) {
        construireRecap();
        afficher(ETAPE_RECAP);
      } else {
        afficher(suivante);
      }
    }

    for (const carte of formulaire.querySelectorAll<HTMLElement>('[data-choix]')) {
      carte.addEventListener('click', () => {
        const question = carte.dataset.question!;
        const valeur = carte.dataset.valeur!;
        const index = QUESTIONS.findIndex((q) => q.id === question);

        etat.reponses[question] = valeur;
        if (question === 'absorption' && valeur !== 'autre') etat.autreMontant = '';
        appliquerSelection(question, valeur);
        sauvegarder();

        const champAutre = carte.closest('.quiz-step')?.querySelector<HTMLElement>('[data-autre]');
        if (question === 'absorption') {
          const ouvrir = valeur === 'autre';
          if (champAutre) champAutre.hidden = !ouvrir;
          if (ouvrir) {
            champAutre?.querySelector<HTMLInputElement>('input')?.focus();
            return; // la seule étape qui n'auto-avance pas : il reste un montant à saisir
          }
        }

        // Court délai : la sélection doit être visible avant que l'écran ne change.
        window.setTimeout(() => avancerDepuis(index), 220);
      });
    }

    formulaire.querySelector('[data-valider-autre]')?.addEventListener('click', () => {
      const champ = formulaire.querySelector<HTMLInputElement>('#autre-montant');
      const montant = Number(champ?.value);
      if (!Number.isInteger(montant) || montant < 1 || montant > 100000) {
        erreur('Indiquez un montant entier, entre 1 $ et 100 000 $.');
        return;
      }
      etat.autreMontant = String(montant);
      sauvegarder();
      avancerDepuis(QUESTIONS.findIndex((q) => q.id === 'absorption'));
    });

    /* ---------------- Récapitulatif ---------------- */

    function construireRecap(): void {
      if (!listeRecap) return;
      const montant = etat.autreMontant ? Number(etat.autreMontant) : null;
      const lignes = resumerReponses({ choix: etat.reponses as never, autreMontant: montant });

      listeRecap.textContent = '';
      lignes.forEach(([intitule, valeur], index) => {
        const element = document.createElement('li');
        const bouton = document.createElement('button');
        bouton.type = 'button';
        // Classe dédiée plutôt qu'un sélecteur sur `button` : le bouton « Tout est exact »
        // vit dans la même liste et doit garder son apparence de call-to-action.
        bouton.className = 'recap-ligne';
        bouton.innerHTML =
          '<span class="recap-modifier">Modifier</span>' +
          `<span class="recap-q"></span><span class="recap-r"></span>`;
        bouton.querySelector('.recap-q')!.textContent = intitule;
        bouton.querySelector('.recap-r')!.textContent = valeur;
        bouton.addEventListener('click', () => {
          retourAuRecap = true;
          afficher(index + 1);
        });
        element.appendChild(bouton);
        listeRecap.appendChild(element);
      });

      const continuer = document.createElement('li');
      const bouton = document.createElement('button');
      bouton.type = 'button';
      bouton.className = 'btn-cta btn-cta--block';
      bouton.textContent = 'Tout est exact — continuer';
      bouton.addEventListener('click', () => afficher(ETAPE_NOMBRE));
      continuer.appendChild(bouton);
      listeRecap.appendChild(continuer);
    }

    /* ---------------- Nombre d'emprunteurs ---------------- */

    function appliquerSelectionNombre(): void {
      for (const carte of formulaire.querySelectorAll<HTMLElement>('[data-nombre]')) {
        carte.classList.toggle('selected', Number(carte.dataset.nombre) === etat.nombre);
      }
    }

    /**
     * Aligne la liste des signataires sur le nombre déclaré. Les cartes déjà remplies sont
     * conservées : on n'ajoute que les manquantes, et on ne retire que celles que le client
     * vient lui-même de déclarer inutiles.
     */
    function ajusterSignataires(nombre: number): void {
      while (etat.signataires.length < nombre) etat.signataires.push({ nom: '', courriel: '' });
      if (etat.signataires.length > nombre) etat.signataires.length = nombre;
    }

    for (const carte of formulaire.querySelectorAll<HTMLElement>('[data-nombre]')) {
      carte.addEventListener('click', () => {
        const nombre = Number(carte.dataset.nombre);
        if (!Number.isInteger(nombre) || nombre < 1 || nombre > MAX_SIGNATAIRES) return;

        etat.nombre = nombre;
        ajusterSignataires(nombre);
        appliquerSelectionNombre();
        rendreSignataires();
        sauvegarder();

        // Même délai que les questions : la sélection doit être vue avant que l'écran change.
        window.setTimeout(() => afficher(ETAPE_SIGNATAIRES), 220);
      });
    }

    /* ---------------- Signataires ---------------- */

    function rendreSignataires(): void {
      if (!conteneurSignataires) return;
      conteneurSignataires.textContent = '';

      etat.signataires.forEach((signataire, index) => {
        const carte = document.createElement('div');
        carte.className = 'profil-signataire';

        const tete = document.createElement('div');
        tete.className = 'profil-signataire-tete';
        const titre = document.createElement('strong');
        titre.textContent = index === 0 ? 'Emprunteur 1 (vous)' : `Emprunteur ${index + 1}`;
        tete.appendChild(titre);
        if (index > 0) {
          const retirer = document.createElement('button');
          retirer.type = 'button';
          retirer.className = 'profil-retirer';
          retirer.textContent = 'Retirer';
          retirer.addEventListener('click', () => {
            etat.signataires.splice(index, 1);
            // Le nombre déclaré suit la liste : sans ça, un retour à l'écran précédent
            // rétablirait la carte qu'on vient de retirer.
            etat.nombre = etat.signataires.length;
            appliquerSelectionNombre();
            sauvegarder();
            rendreSignataires();
          });
          tete.appendChild(retirer);
        }
        carte.appendChild(tete);

        carte.appendChild(champ(`Nom complet`, 'text', signataire.nom, `sig-nom-${index}`, (valeur) => {
          etat.signataires[index]!.nom = valeur;
          sauvegarder();
        }));
        carte.appendChild(champ(`Courriel`, 'email', signataire.courriel, `sig-courriel-${index}`, (valeur) => {
          etat.signataires[index]!.courriel = valeur;
          sauvegarder();
        }));

        conteneurSignataires.appendChild(carte);
      });

      if (boutonAjouter) boutonAjouter.hidden = etat.signataires.length >= MAX_SIGNATAIRES;

      // Le choix de la voie n'a de sens qu'à plusieurs. Seul, on la remet à « en présence » :
      // sinon un « ils signeront de leur côté » resté en session après le retrait d'un
      // co-emprunteur enverrait la soumission vers un dossier sans personne à inviter.
      const aPlusieurs = etat.signataires.length >= 2;

      // Écran commun au client seul et au couple : celui qui vient de déclarer être seul
      // ne doit pas lire qu'il lui faut réunir « tous les emprunteurs ».
      if (titreSignataires) {
        titreSignataires.textContent = aPlusieurs ? 'Qui signe ?' : 'Vos coordonnées';
      }
      if (sousSignataires) {
        sousSignataires.textContent = aPlusieurs
          ? 'Tous les emprunteurs au prêt doivent signer. Chacun a besoin de sa propre adresse courriel.'
          : 'C’est à cette adresse que partira votre accusé de signature.';
      }

      // Seul, la question ne se pose pas — `voieSoumise()` s'en charge. On se garde bien de
      // pousser « presence » dans l'état au passage : un client qui déclare être seul, puis
      // ajoute un co-emprunteur, retrouverait une réponse qu'il n'a jamais donnée.
      if (groupeVoie) groupeVoie.hidden = !aPlusieurs;
    }

    /**
     * La voie réellement soumise, ou `null` s'il manque encore la réponse.
     *
     * Un emprunteur seul signe forcément sur cet appareil : la question ne lui est pas posée,
     * et « en présence » est ici un constat, pas un défaut. Dès qu'ils sont deux, en revanche,
     * rien n'est supposé — c'est cette réponse qui décide si un lien part.
     */
    function voieSoumise(): 'presence' | 'distance' | null {
      return etat.signataires.length >= 2 ? etat.voie : 'presence';
    }

    function champ(
      etiquette: string,
      type: string,
      valeur: string,
      id: string,
      surChangement: (valeur: string) => void,
    ): DocumentFragment {
      const fragment = document.createDocumentFragment();
      const label = document.createElement('label');
      label.className = 'cform-label';
      label.htmlFor = id;
      label.textContent = etiquette;
      const entree = document.createElement('input');
      entree.type = type;
      entree.id = id;
      entree.className = 'cform-input';
      entree.value = valeur;
      entree.autocomplete = type === 'email' ? 'email' : 'name';
      entree.maxLength = type === 'email' ? 120 : 60;
      entree.addEventListener('input', () => surChangement(entree.value.trim()));
      fragment.appendChild(label);
      fragment.appendChild(entree);
      return fragment;
    }

    boutonAjouter?.addEventListener('click', () => {
      if (etat.signataires.length >= MAX_SIGNATAIRES) return;
      etat.signataires.push({ nom: '', courriel: '' });
      etat.nombre = etat.signataires.length;
      appliquerSelectionNombre();
      sauvegarder();
      rendreSignataires();
    });

    for (const radio of formulaire.querySelectorAll<HTMLInputElement>('input[name="voie"]')) {
      radio.addEventListener('change', () => {
        if (!radio.checked) return;
        etat.voie = radio.value === 'distance' ? 'distance' : 'presence';
        masquerErreurs();
        sauvegarder();
      });
    }

    /**
     * Premier problème bloquant dans la liste des signataires, ou `null` si elle est bonne.
     * Sert au passage à la signature comme au garde-fou de reprise : un état sauvegardé ne
     * doit jamais rouvrir la page sur un écran que ces données ne permettent pas de tenir.
     */
    function erreurSignataires(): string | null {
      const adresses = new Set<string>();
      for (const [index, signataire] of etat.signataires.entries()) {
        if (signataire.nom.length < 2) return `Indiquez le nom complet de l'emprunteur ${index + 1}.`;
        if (!estCourrielValide(signataire.courriel)) {
          return `L'adresse courriel de l'emprunteur ${index + 1} semble incomplète.`;
        }
        const normalisee = signataire.courriel.toLowerCase();
        if (adresses.has(normalisee)) return 'Chaque emprunteur doit avoir sa propre adresse courriel.';
        adresses.add(normalisee);
      }
      return null;
    }

    formulaire.querySelector('[data-vers-signature]')?.addEventListener('click', () => {
      const probleme = erreurSignataires();
      if (probleme) {
        erreur(probleme);
        return;
      }
      if (voieSoumise() === null) {
        erreur(
          'Dites-moi si les autres emprunteurs sont avec vous : c’est ce qui décide s’ils reçoivent un lien pour signer de leur côté.',
        );
        return;
      }
      preparerSignatures();
      afficher(ETAPE_SIGNATURE);
    });

    /* ---------------- Signatures ---------------- */

    function blocsActifs(): number {
      return voieSoumise() === 'distance' ? 1 : etat.signataires.length;
    }

    function preparerSignatures(): void {
      const actifs = blocsActifs();
      for (let index = 0; index < MAX_SIGNATAIRES; index += 1) {
        const bloc = formulaire.querySelector<HTMLElement>(`[data-bloc-signature="${index}"]`);
        if (!bloc) continue;
        bloc.hidden = index >= actifs;
        const rappel = bloc.querySelector<HTMLElement>('[data-sig-qui]');
        const nom = etat.signataires[index]?.nom ?? '';
        if (rappel) rappel.textContent = nom ? `Signature de ${nom}` : '';
      }

      const titre = formulaire.querySelector<HTMLElement>('[data-titre-signature]');
      const sous = formulaire.querySelector<HTMLElement>('[data-sous-signature]');
      if (titre) titre.textContent = actifs > 1 ? 'Vos signatures' : 'Votre signature';
      if (sous) {
        sous.textContent =
          voieSoumise() === 'distance'
            ? 'Signez votre partie. Les autres emprunteurs recevront leur propre lien par courriel.'
            : actifs > 1
              ? 'Chacun signe dans son cadre — passez l’appareil quand c’est fait.'
              : 'Signez dans le cadre, comme sur papier.';
      }
    }

    formulaire.querySelector('[data-signer]')?.addEventListener('click', async (evenement) => {
      const bouton = evenement.currentTarget as HTMLButtonElement;
      if (envoiEnCours) return;

      const actifs = blocsActifs();
      const signatures: Record<string, string> = {};

      for (let index = 0; index < actifs; index += 1) {
        const pad = formulaire.querySelector<SignaturePadElement>(`#signature-${index}`);
        const attestation = formulaire.querySelector<HTMLInputElement>(`[data-attestation="${index}"]`);
        const nom = etat.signataires[index]?.nom ?? `l'emprunteur ${index + 1}`;

        const png = pad?.versPng() ?? null;
        if (!png) {
          erreur(`La signature de ${nom} est vide ou trop courte pour valoir signature.`);
          return;
        }
        if (!attestation?.checked) {
          erreur(`${nom} doit cocher la case d'attestation.`);
          return;
        }
        signatures[String(index)] = png;
      }

      envoiEnCours = true;
      bouton.disabled = true;
      bouton.textContent = 'Envoi en cours…';
      masquerErreurs();

      try {
        const reponse = await fetch('/api/profil-submit', {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({
            company: (formulaire.querySelector<HTMLInputElement>('#company')?.value ?? '').trim(),
            reponses: {
              ...etat.reponses,
              ...(etat.autreMontant ? { autre_montant: Number(etat.autreMontant) } : {}),
            },
            signataires: etat.signataires,
            voie: voieSoumise(),
            attestation: true,
            signatures,
          }),
        });

        const donnees = (await reponse.json()) as Reponse & { ok?: boolean; error?: string; code?: string; detail?: string };

        if (!reponse.ok || !donnees.ok) {
          // L'étape et le détail amont identifient où la soumission a lâché sans obliger
          // à ouvrir les journaux du serveur.
          if (donnees.code) console.error('[profil] échec à l’étape :', donnees.code, donnees.detail ?? '');
          erreur(donnees.error ?? "L'envoi a échoué. Veuillez réessayer.", donnees.code, donnees.detail);
          return;
        }

        termine = true;
        try {
          sessionStorage.removeItem(CLE_STOCKAGE);
        } catch {
          // Sans importance : le dossier est déjà parti.
        }
        terminer(donnees);
      } catch {
        erreur("L'envoi a échoué. Vérifiez votre connexion et réessayez.");
      } finally {
        envoiEnCours = false;
        bouton.disabled = false;
        bouton.textContent = 'Signer';
      }
    });

    /* ---------------- Confirmation ---------------- */

    /**
     * Une adresse mise en évidence dans une phrase. Élément construit à la main plutôt
     * qu'injecté en HTML : l'adresse vient de ce que le client a tapé.
     */
    function adresse(courriel: string): HTMLElement {
      const element = document.createElement('strong');
      element.className = 'profil-adresse';
      element.textContent = courriel;
      return element;
    }

    /** « a@x.ca », « a@x.ca et b@y.ca », « a@x.ca, b@y.ca et c@z.ca ». */
    function listeAdresses(courriels: readonly string[]): DocumentFragment {
      const fragment = document.createDocumentFragment();
      courriels.forEach((courriel, index) => {
        if (index > 0) fragment.append(index === courriels.length - 1 ? ' et ' : ', ');
        fragment.appendChild(adresse(courriel));
      });
      return fragment;
    }

    function ecrire(cible: HTMLElement | null, morceaux: ReadonlyArray<string | Node>): void {
      if (!cible) return;
      cible.textContent = '';
      for (const morceau of morceaux) cible.append(morceau);
    }

    function terminer(donnees: Reponse): void {
      const titre = formulaire.querySelector<HTMLElement>('[data-fin-titre]');
      const texte = formulaire.querySelector<HTMLElement>('[data-fin-texte]');
      // Les adresses renvoyées par le serveur, jamais celles restées en mémoire : ce sont
      // elles qui ont réellement reçu (ou recevront) l'accusé de signature.
      const copies = donnees.copies ?? [];

      if (donnees.enAttente?.length) {
        const attendus = donnees.enAttente;
        if (titre) titre.textContent = 'Votre partie est signée';

        const phrase: Array<string | Node> = ["Un lien de signature vient d'être envoyé à "];
        attendus.forEach((personne, index) => {
          if (index > 0) phrase.push(index === attendus.length - 1 ? ' et ' : ', ');
          phrase.push(`${personne.nom} (`, adresse(personne.courriel), ')');
        });
        phrase.push(
          attendus.length === 1
            ? '. Le formulaire sera transmis à Stéphanie dès sa signature, et vous recevrez une confirmation'
            : '. Le formulaire sera transmis à Stéphanie dès les dernières signatures, et vous recevrez une confirmation',
        );
        // copies[0] est l'emprunteur qui vient de remplir : c'est son adresse à lui qu'on
        // lui confirme, pas celle de tout le monde.
        if (copies[0]) phrase.push(' à ', adresse(copies[0]));
        phrase.push('.');
        ecrire(texte, phrase);
      } else {
        if (titre) titre.textContent = 'C’est signé';
        // Aucune copie du document ne part au client : le dire ici évite qu'il cherche une
        // pièce jointe qui n'existe pas.
        ecrire(
          texte,
          copies.length
            ? [
                'Le formulaire est transmis à Stéphanie, qui le conserve à votre dossier. Une confirmation vient d’être envoyée à ',
                listeAdresses(copies),
                '.',
              ]
            : [
                'Le formulaire est transmis à Stéphanie, qui le conserve à votre dossier. Une confirmation vient de vous être envoyée par courriel.',
              ],
        );
      }

      afficher('fin');
    }

    /* ---------------- Reprise ---------------- */

    for (const [question, valeur] of Object.entries(etat.reponses)) appliquerSelection(question, valeur);
    if (etat.autreMontant) {
      const champMontant = formulaire.querySelector<HTMLInputElement>('#autre-montant');
      if (champMontant) champMontant.value = etat.autreMontant;
      const zone = formulaire.querySelector<HTMLElement>('[data-autre]');
      if (zone && etat.reponses.absorption === 'autre') zone.hidden = false;
    }
    for (const radio of formulaire.querySelectorAll<HTMLInputElement>('input[name="voie"]')) {
      radio.checked = etat.voie !== null && radio.value === etat.voie;
    }
    if (etat.nombre !== null) ajusterSignataires(etat.nombre);
    appliquerSelectionNombre();
    rendreSignataires();

    if (prerempli) {
      for (const note of formulaire.querySelectorAll<HTMLElement>('[data-note-preparation]')) {
        note.hidden = false;
      }
    }

    /**
     * Jusqu'où l'écran mémorisé peut être rouvert. On ne fait jamais confiance au numéro
     * seul : on le ramène au dernier écran que les données sauvegardées permettent
     * réellement de reconstruire, sinon un état tronqué ouvrirait un récapitulatif à trous
     * ou une signature sans signataires valides.
     */
    function etapeReprise(): number {
      const voulue = etat.etape;
      if (voulue < 1) return 0;

      const sansReponse = QUESTIONS.findIndex((q) => !etat.reponses[q.id]);
      if (sansReponse !== -1) return Math.min(voulue, sansReponse + 1);

      if (etat.reponses.absorption === 'autre' && !etat.autreMontant) {
        return Math.min(voulue, QUESTIONS.findIndex((q) => q.id === 'absorption') + 1);
      }

      // Sans nombre déclaré, la liste des signataires n'a pas de sens : c'est justement
      // l'écran qu'on ne veut voir personne franchir sans y répondre.
      if (voulue >= ETAPE_SIGNATAIRES && etat.nombre === null) return ETAPE_NOMBRE;

      // Sans réponse à la question de la voie, l'écran de signature ne sait pas combien de
      // cadres ouvrir : c'est exactement l'écran qu'on ne veut voir personne franchir.
      if (voulue >= ETAPE_SIGNATURE && (erreurSignataires() !== null || voieSoumise() === null)) {
        return ETAPE_SIGNATAIRES;
      }

      return Math.min(voulue, TOTAL);
    }

    // Reprise après un rechargement. Les tracés de signature, eux, ne survivent pas : celui
    // qui recharge depuis l'écran de signature retrouve ses réponses et resigne.
    const reprise = etapeReprise();
    if (reprise >= 1) {
      if (reprise >= ETAPE_RECAP) construireRecap();
      if (reprise >= ETAPE_SIGNATURE) preparerSignatures();
      afficher(reprise);
    }
  }
</script>
