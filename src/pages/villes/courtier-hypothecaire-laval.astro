---
// SSR : la page lit les avis Google et le taux du jour à chaque requête (voir CLAUDE.md,
// « Le défaut est le statique ») — le cache CDN ci-dessous évite de les relire à chaque visite.
export const prerender = false;

import MainLayout from '../../layouts/MainLayout.astro';
import Nav from '../../components/Nav.astro';
import Footer from '../../components/Footer.astro';
import Contact from '../../components/Contact.astro';
import MessengerBtn from '../../components/MessengerBtn.astro';
import { Image } from 'astro:assets';
import stephaniePhoto from '../../assets/stephanie.webp';
import { loadSiteConfig } from '../../config';
import PhoneLink from '../../components/PhoneLink.astro';
import RappelCTA from '../../components/RappelCTA.astro';
import VillesVoisines from '../../components/VillesVoisines.astro';
import SecteursVille from '../../components/SecteursVille.astro';
import FilArianeVille from '../../components/FilArianeVille.astro';
import AvisVille from '../../components/AvisVille.astro';
import CalculVille from '../../components/CalculVille.astro';
import stephaniePortrait from '../../assets/stephanie.jpg';
import { getReviews } from '../../services/reviewsService';
import { fetchHypothecaRates, rateCacheControl } from '../../services/ratesService';
import { schemasVille } from '../../utils/schemaVille';

const config = loadSiteConfig();

// Les secteurs de la ville (section « Secteur par secteur ») — voir SecteursVille.astro.
const secteurs: { nom: string; texte: string }[] = [
  {
    nom: "Chomedey",
    texte: `Plex, maisons et tours de condos, dans une communauté très diversifiée. Sur un plex que vous habitez, une partie des <strong>loyers</strong> peut compter pour vous qualifier ; pour un acheteur arrivé récemment au pays, des prêteurs offrent des programmes <strong>nouveaux arrivants</strong>.`
  },
  {
    nom: "Pont-Viau et Laval-des-Rapides",
    texte: `Plex, maisons d'après-guerre et condos autour des stations <strong>Cartier</strong> et <strong>De La Concorde</strong>. Pour un premier achat, le <strong>RAP</strong> et le <strong>CELIAPP</strong> peuvent se combiner pour la mise de fonds — et près du métro, une voiture en moins allège aussi vos ratios.`
  },
  {
    nom: "Duvernay",
    texte: `Beaucoup de bungalows et de cottages des années 60 et 70, parfois vendus par une <strong>succession</strong>, souvent <strong>sans garantie légale</strong>. Faites inspecter : vous ne pourrez pas vous retourner contre le vendeur, et votre mise de fonds doit laisser place aux travaux à prévoir.`
  },
  {
    nom: "Vimont, Auteuil et Fabreville",
    texte: `Des unifamiliales de banlieue et des développements plus récents, prisés des familles. Pour une <strong>construction neuve</strong> bâtie sur votre terrain, le prêt est versé par <strong>déboursés progressifs</strong>, à chaque étape inspectée ; achetée d'un promoteur, la maison se finance plutôt à la livraison.`
  },
  {
    nom: "Sainte-Rose",
    texte: `Le Vieux-Sainte-Rose garde ses maisons anciennes près de la rivière des Mille Îles. Elles se financent bien, à condition d'être <strong>assurables</strong> : chauffage au mazout, filage ancien ou réservoir enfoui peuvent compliquer l'assurance habitation, que le prêteur exige avant le déboursé.`
  },
  {
    nom: "Sainte-Dorothée et Laval-sur-le-Lac",
    texte: `À l'ouest de l'île, de grandes propriétés sur de vastes terrains. Au-delà de <strong>1,5 M$</strong>, l'assurance SCHL n'est plus offerte : la <strong>mise de fonds minimale passe à 20 %</strong>, et la valeur du terrain pèse davantage dans l'évaluation du prêteur.`
  }
];
const prenom = config.nom.split(' ')[0];

const PAGE_URL = `${config.site_url}/villes/courtier-hypothecaire-laval/`;
// L'adresse de la photo telle que le build la produit : un nom de fichier haché écrit à la main
// (stephanie.Cm30Blgc.jpg) ne survivait pas au build suivant, et le schéma pointait sur une 404.
const STEPHANIE_IMAGE = new URL(stephaniePhoto.src, config.site_url).toString();

const faq = [
  {
    q: "Combien coûte un courtier hypothécaire à Laval ?",
    a: `Pour la vaste majorité des dossiers, rien : mon service est <strong>gratuit</strong>. C'est le prêteur qui finance votre dossier qui me rémunère, au moment du déboursé. Certains <a href="/services/dossier-refuse/">financements alternatifs ou privés</a> comportent des frais : si c'est votre cas, je vous le dis <strong>avant toute démarche</strong>, et vous ne vous engagez à rien tant qu'on n'a pas trouvé la bonne solution.`
  },
  {
    q: "Quelle mise de fonds pour acheter une maison à Laval ?",
    a: `La règle canadienne s'applique : <strong>5 %</strong> de <a href="/outils/#simulateur">mise de fonds minimale</a> sur la première tranche de 500 000 $, puis <strong>10 %</strong> entre 500 000 $ et 1,5 M$. Avec moins de 20 % de mise de fonds, une prime d'assurance SCHL s'ajoute à votre prêt. On calcule ensemble le scénario le plus avantageux selon votre situation.`
  },
  {
    q: "Comment financer un condo près du métro Montmorency ?",
    a: `Un condo se finance comme une maison, avec deux différences qui comptent. D'abord, une partie de vos <strong>frais de copropriété</strong> entre dans le calcul de vos ratios d'endettement : à prix égal, ils réduisent votre capacité d'emprunt. Ensuite, la santé du syndicat compte — <strong>fonds de prévoyance</strong>, procès-verbaux, travaux majeurs à venir. Mieux vaut obtenir ces documents avant de lever vos conditions, pour éviter une cotisation spéciale que personne n'avait vue venir.`
  },
  {
    q: "Peut-on financer l'achat d'un bungalow à rénover à Laval ?",
    a: `Oui, grâce au <strong>financement achat-rénovation</strong> : le coût des travaux s'ajoute au prêt hypothécaire, sur la base de soumissions d'entrepreneurs, et le prêteur évalue la propriété selon sa valeur <strong>après travaux</strong>. Les sommes prévues pour les rénovations sont généralement retenues chez le notaire et versées une fois les travaux terminés — il faut donc prévoir comment payer l'entrepreneur entre-temps. Les conditions varient d'un prêteur à l'autre : c'est un dossier qui se magasine.`
  },
  {
    q: "Les prix sont-ils les mêmes dans tous les quartiers de Laval ?",
    a: `Non — un condo du <strong>centre-ville</strong> près du métro, un bungalow à rafraîchir à <strong>Duvernay</strong> ou <strong>Pont-Viau</strong>, un plex de <strong>Chomedey</strong> et une unifamiliale récente à <strong>Fabreville</strong> ou <strong>Auteuil</strong> n'ont pas la même réalité de prix. Plutôt qu'un chiffre qui se périme, je vous propose d'<a href="/outils/#simulateur">évaluer votre capacité d'emprunt</a> par rapport au quartier que vous visez, gratuitement.`
  },
  {
    q: "J'achète au bord de la rivière des Mille Îles ou des Prairies : la zone inondable change-t-elle quelque chose ?",
    a: `Oui, et mieux vaut le savoir avant l'offre. Laval étant une île, plusieurs rues riveraines se trouvent en <strong>zone inondable</strong> : vérifiez la cartographie auprès de la Ville et posez la question au vendeur. Le prêteur exige une <strong>assurance habitation</strong> en vigueur au déboursé, et la protection contre les inondations n'est pas offerte partout ni au même prix. Certains prêteurs ajoutent leurs propres conditions sur ces propriétés : on obtient la soumission d'assurance pendant le délai de vos conditions, pas la veille du notaire.`
  },
  {
    q: "En combien de temps puis-je être pré-approuvé ?",
    a: `Dès que votre dossier est complet (documents de revenus et de mise de fonds fournis), je vous donne moi-même un premier retour, <strong>habituellement le jour ouvrable même</strong> ; la réponse du prêteur suit selon ses propres délais. La pré-approbation reste ensuite valide jusqu'à 120 jours — le temps de magasiner à Laval sans pression.`
  },
  {
    q: "Puis-je aménager un logement intergénérationnel dans ma maison à Laval ?",
    a: `C'est possible, à condition que la <strong>réglementation municipale</strong> le permette pour votre adresse : vérifiez auprès de la Ville avant de signer quoi que ce soit. Côté financement, les travaux peuvent passer par un <a href="/services/refinancement/"><strong>refinancement</strong></a>, jusqu'à 80 % de la valeur de la propriété, ou par un financement achat-rénovation si vous achetez la maison pour l'aménager. Attention : un logement occupé par vos parents ne compte comme <strong>revenu de location</strong> que s'il y a un bail et un loyer réellement payé — et chaque prêteur le traite à sa façon.`
  }
];

// === Schemas JSON-LD === — voir src/utils/schemaVille.ts
const [schemaService, schemaPerson, schemaFil] = schemasVille({
  config,
  ville: "Laval",
  pageUrl: PAGE_URL,
  secteurs: ["Chomedey", "Sainte-Rose", "Laval-des-Rapides", "Vimont", "Sainte-Dorothée"],
  image: STEPHANIE_IMAGE,
});


// Le FAQPage est généré à partir du tableau `faq` ci-dessus.
const schemaFAQ = {
  "@context": "https://schema.org",
  "@type": "FAQPage",
  "mainEntity": faq.map((item) => ({
    "@type": "Question",
    "name": item.q,
    "acceptedAnswer": {
      "@type": "Answer",
      // On retire le HTML pour la version texte du schema.
      "text": item.a.replace(/<[^>]+>/g, '')
    }
  }))
};

// Lectures en séquence, jamais en parallèle (voir CLAUDE.md, « ficheUnifiee »).
const tauxDuJour = await fetchHypothecaRates();
const avis = await getReviews();
// Cache CDN : 6 h, raccourci quand les taux manquent (même règle que l'accueil).
Astro.response.headers.set('Cache-Control', rateCacheControl(tauxDuJour));
---

<MainLayout
  title="Courtier hypothécaire Laval"
  description="Courtière hypothécaire à Laval : 20+ prêteurs comparés pour votre achat, renouvellement ou refinancement. Appel de 15 min sans engagement."
>
  <Fragment slot="head">
    <script type="application/ld+json" set:html={JSON.stringify(schemaService)} is:inline />
    <script type="application/ld+json" set:html={JSON.stringify(schemaPerson)} is:inline />
    <script type="application/ld+json" set:html={JSON.stringify(schemaFil)} is:inline />
    <script type="application/ld+json" set:html={JSON.stringify(schemaFAQ)} is:inline />
  </Fragment>

  <MessengerBtn />
  <Nav />

  <main id="main-content">

    <!-- ============ SECTION 1 — HÉRO ============ -->
    <section class="rep-hero">
      <div class="rep-inner">
        <div class="rep-hero-grid">
          <div class="rep-hero-text">
            <FilArianeVille ville="Laval" />
            <div class="rep-eyebrow">Laval · Rive-Nord</div>
            <h1 class="rep-h1">Courtière hypothécaire à Laval</h1>
            <p class="rep-subtitle">
              Pré-approbation rapide. Accès à 20+ prêteurs. Frais de courtage&nbsp;: 0&nbsp;$.<span class="fee-tooltip-wrap"><button class="fee-info-btn" aria-label="En savoir plus sur les frais de courtage" aria-expanded="false" type="button">i</button><span class="fee-tooltip" role="tooltip">Frais de courtage à 0&nbsp;$ pour la vaste majorité des dossiers. Certains financements alternatifs ou privés peuvent comporter des frais, dont je vous informe avant toute démarche.</span></span>
            </p>

            <ul class="rep-trust-list" aria-label="Garanties de service">
              <li>
                <span class="rep-trust-icon" aria-hidden="true">💰</span>
                <span>Gratuit pour la vaste majorité des dossiers<a class="rep-asterisque" href="#note-frais" aria-label="Voir la note sur les frais">*</a> (rémunérée par le prêteur)</span>
              </li>
              <li>
                <span class="rep-trust-icon" aria-hidden="true">⏱️</span>
                <span>Je vous réponds moi-même, <strong>habituellement le jour ouvrable même</strong></span>
              </li>
            </ul>

            <div class="rep-hero-ctas">
              <a href="#contact" class="btn-cta rep-cta-primary">
                <span>Faire évaluer mon dossier</span>
                <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><line x1="5" y1="12" x2="19" y2="12"/><polyline points="12 5 19 12 12 19"/></svg>
              </a>
              <span class="rep-cta-secondary">
                ou appelez le <PhoneLink variant="text" trackId="tel_click_laval" aria-label={`Appeler ${prenom} au ${config.telephone}`} />
              </span>
            </div>
          </div>

          <aside class="rep-hero-photo" aria-label="Votre courtière">
            <Image
              src={stephaniePortrait}
              alt={`${config.nom}, courtière hypothécaire à Laval`}
              width={400}
              height={400}
              loading="eager"
              decoding="async"
              class="rep-photo"
            />
            <div class="rep-photo-caption">
              <strong>{prenom} Weyman</strong>
              <span>Courtière hypothécaire · Hypotheca</span>
            </div>
          </aside>
        </div>
      </div>
    </section>

    <!-- ============ AVIS GOOGLE ============ -->
    <AvisVille reviews={avis} />

    <!-- ============ SECTION 2 — POUR QUI ============ -->
    <section class="rep-services">
      <div class="rep-inner">
        <div class="rep-section-tag">Pour qui je travaille à Laval</div>
        <h2 class="rep-section-title">Six parcours, une seule personne pour vous accompagner.</h2>

        <div class="rep-cards-grid">
          <a href="/services/premier-achat/" class="rep-card">
            <span class="rep-card-icon" aria-hidden="true">🏠</span>
            <h3 class="rep-card-title">Premier achat à Laval</h3>
            <p class="rep-card-text">Pré-approbation, RAP, CELIAPP, mise de fonds optimale.</p>
            <span class="rep-card-cta">En savoir plus →</span>
          </a>
          <a href="/services/renouvellement/" class="rep-card">
            <span class="rep-card-icon" aria-hidden="true">🔄</span>
            <h3 class="rep-card-title">Renouvellement hypothécaire</h3>
            <p class="rep-card-text">Comparer avant de signer l'offre de votre banque actuelle.</p>
            <span class="rep-card-cta">En savoir plus →</span>
          </a>
          <a href="/services/refinancement/" class="rep-card">
            <span class="rep-card-icon" aria-hidden="true">💰</span>
            <h3 class="rep-card-title">Refinancement</h3>
            <p class="rep-card-text">Libérer de l'équité pour rénover, consolider ou investir.</p>
            <span class="rep-card-cta">En savoir plus →</span>
          </a>
          <a href="/services/travailleur-autonome/" class="rep-card">
            <span class="rep-card-icon" aria-hidden="true">💼</span>
            <h3 class="rep-card-title">Travailleur autonome</h3>
            <p class="rep-card-text">Revenus non traditionnels ? Des prêteurs comprennent votre réalité.</p>
            <span class="rep-card-cta">En savoir plus →</span>
          </a>
          <a href="/services/dossier-refuse/" class="rep-card">
            <span class="rep-card-icon" aria-hidden="true">🚫</span>
            <h3 class="rep-card-title">Dossier refusé</h3>
            <p class="rep-card-text">Un refus bancaire n'est pas une fin — des solutions alternatives existent.</p>
            <span class="rep-card-cta">En savoir plus →</span>
          </a>
          <a href="/services/nouveaux-arrivants/" class="rep-card">
            <span class="rep-card-icon" aria-hidden="true">🌍</span>
            <h3 class="rep-card-title">Nouveaux arrivants</h3>
            <p class="rep-card-text">Résidence permanente ou permis de travail ? Des prêteurs s'adaptent à votre profil.</p>
            <span class="rep-card-cta">En savoir plus →</span>
          </a>
        </div>
      </div>
    </section>

    <!-- ============ RAPPEL RENOUVELLEMENT ============ -->
    <section class="rep-rappel" aria-label="Rappel de renouvellement">
      <div class="rep-inner">
        <RappelCTA
          titre="Votre hypothèque arrive à échéance ?"
          texte="Le meilleur moment pour magasiner se situe 4 à 6 mois avant la fin de votre terme — avant que votre banque n'envoie son offre de renouvellement. Laissez vos coordonnées : je vous rappelle personnellement au bon moment."
          cta="Être rappelé·e au bon moment"
        />
      </div>
    </section>

    <!-- ============ SECTION 3 — MARCHÉ LOCAL ============ -->
    <section class="rep-market">
      <div class="rep-inner rep-inner--narrow">
        <div class="rep-section-tag">Le marché immobilier</div>
        <h2 class="rep-section-title">Acheter ou refinancer une propriété à Laval</h2>

        <p>
          Vous cherchez un courtier hypothécaire à Laval ? Voici ce qu'il faut savoir du marché,
          quartier par quartier, avant de faire une offre. Troisième ville du Québec, Laval occupe toute l'île Jésus, entre la rivière des Prairies et
          la rivière des Mille Îles — et chacun de ses quartiers a sa propre réalité de marché. Autour
          de la station <strong>Montmorency</strong>, le centre-ville aligne des tours de
          <strong>condos</strong> prisées des premiers acheteurs et des navetteurs. <strong>Chomedey</strong>,
          <strong>Laval-des-Rapides</strong>, <strong>Pont-Viau</strong> et <strong>Duvernay</strong>
          comptent beaucoup de <strong>bungalows des années 60 et 70</strong>, souvent à rénover, et
          des plex. Plus au nord et à l'ouest, <strong>Vimont</strong>, <strong>Auteuil</strong>,
          <strong>Fabreville</strong> et <strong>Sainte-Dorothée</strong> offrent surtout des
          unifamiliales, tandis que le Vieux-Sainte-Rose et <strong>Laval-Ouest</strong> gardent leur
          caractère de bord de rivière.
        </p>

        <p>
          Chaque type de propriété change le montage du financement. Pour un condo, une partie des
          <strong>frais de copropriété</strong> entre dans vos ratios d'endettement, et la santé du
          syndicat (fonds de prévoyance, travaux à venir) mérite d'être vérifiée avant de lever vos
          conditions. Pour un bungalow à moderniser, le <strong>financement achat-rénovation</strong>
          permet d'intégrer le coût des travaux au prêt, sur soumissions. Pour un plex, une partie des
          <strong>revenus de location</strong> peut aider à vous qualifier. Dans tous les cas, la
          <strong>pré-approbation</strong> fixe votre budget réel en intégrant le
          <strong>stress test fédéral</strong> et, sous 20 % de mise, la prime SCHL ajoutée au prêt.
        </p>

        <p>
          Je suis basée à Repentigny, sur la Rive-Nord, comme Laval. On se parle sur Teams, par téléphone ou par texto, selon ce qui vous
          convient, et vos documents se transmettent et se signent en ligne. Laval touche
          <a href="/villes/courtier-hypothecaire-terrebonne/">Terrebonne</a> de l'autre côté de la
          rivière des Mille Îles, ainsi que <strong>Bois-des-Filion et Rosemère</strong> ;
          au sud, <a href="/villes/courtier-hypothecaire-montreal/">Montréal</a> est à un pont de
          distance. Avec les autoroutes <strong>15, 13 et 440</strong>, la ligne orange du métro et le
          train de banlieue vers Saint-Jérôme, beaucoup de Lavallois travaillent à Montréal — un
          profil de navetteur que les prêteurs connaissent bien. Quand les taux bougent, je suis le
          marché en continu pour saisir la bonne fenêtre à votre place.
        </p>
        <VillesVoisines actuelle="laval" />
      </div>
    </section>

    <!-- ============ SECTEURS ============ -->
    <SecteursVille ville="Laval" secteurs={secteurs} />

    <!-- ============ CALCUL RAPIDE ============ -->
    <CalculVille slug="laval" ville="Laval" taux={tauxDuJour?.fixe_5ans ?? null} />

    <!-- ============ SECTION 4 — BANQUE VS COURTIÈRE ============ -->
    <section class="rep-compare">
      <div class="rep-inner">
        <div class="rep-section-tag">Banque vs courtière</div>
        <h2 class="rep-section-title">Votre banque vous connaît. <em>Moi, je vous défends.</em></h2>

        <div class="rep-compare-cards">
          <div class="rep-compare-card rep-compare-card--bad">
            <div class="rep-compare-card-icon" aria-hidden="true">🏦</div>
            <h3 class="rep-compare-card-title">Avec votre banque</h3>
            <ul class="rep-compare-list">
              <li><span class="rep-x" aria-hidden="true">✕</span> Une seule offre : la leur</li>
              <li><span class="rep-x" aria-hidden="true">✕</span> Le conseiller travaille pour la banque, pas pour vous</li>
              <li><span class="rep-x" aria-hidden="true">✕</span> Heures d'ouverture restrictives</li>
              <li><span class="rep-x" aria-hidden="true">✕</span> Pas de magasinage de taux pour vous</li>
              <li><span class="rep-x" aria-hidden="true">✕</span> Un refus = fin de la discussion</li>
            </ul>
          </div>

          <div class="rep-compare-card rep-compare-card--good">
            <div class="rep-compare-card-icon" aria-hidden="true">🤝</div>
            <h3 class="rep-compare-card-title">Avec {prenom} Weyman</h3>
            <ul class="rep-compare-list">
              <li><span class="rep-check" aria-hidden="true">✓</span> 20+ prêteurs comparés pour vous</li>
              <li><span class="rep-check" aria-hidden="true">✓</span> Je travaille pour <strong>vous,</strong> pas pour un prêteur</li>
              <li><span class="rep-check" aria-hidden="true">✓</span> Dispo soirs et fins de semaine</li>
              <li><span class="rep-check" aria-hidden="true">✓</span> Je négocie les taux et les conditions</li>
              <li><span class="rep-check" aria-hidden="true">✓</span> Un refus bancaire ? J'ai des solutions alternatives</li>
            </ul>
            <p class="rep-compare-bonus">💰 <strong>Gratuit pour la vaste majorité des dossiers<a class="rep-asterisque" href="#note-frais" aria-label="Voir la note sur les frais">*</a></strong> — rémunérée par le prêteur, pas par vous.</p>
          </div>
        </div>
      </div>
    </section>

    <!-- ============ SECTION 5 — PROCESSUS ============ -->
    <section class="rep-process">
      <div class="rep-inner">
        <div class="rep-section-tag">Comment ça se passe</div>
        <h2 class="rep-section-title">Trois étapes, zéro stress.</h2>

        <ol class="rep-steps">
          <li class="rep-step">
            <div class="rep-step-num" aria-hidden="true">1</div>
            <h3 class="rep-step-title">Vous remplissez le formulaire</h3>
            <p class="rep-step-text">Deux minutes. Aucun pointage de crédit, aucun engagement.</p>
          </li>
          <li class="rep-step">
            <div class="rep-step-num" aria-hidden="true">2</div>
            <h3 class="rep-step-title">On se parle 15 minutes</h3>
            <p class="rep-step-text">J'analyse votre dossier et je vous explique vos vraies options.</p>
          </li>
          <li class="rep-step">
            <div class="rep-step-num" aria-hidden="true">3</div>
            <h3 class="rep-step-title">Vous recevez vos options</h3>
            <p class="rep-step-text">Vous choisissez celle qui vous convient — sans pression.</p>
          </li>
        </ol>
      </div>
    </section>

    <!-- ============ SECTION 6 — FAQ ============ -->
    <section class="rep-faq">
      <div class="rep-inner rep-inner--narrow">
        <div class="rep-section-tag">FAQ — Laval</div>
        <h2 class="rep-section-title">Les questions qu'on me pose le plus souvent.</h2>

        <div class="faq-list">
          {faq.map((item, i) => (
            <div class={`faq-item${i === 0 ? ' open' : ''}`} id={`faq-ville-${i}`}>
              <h3>
                <button
                  class="faq-q"
                  id={`faq-question-ville-${i}`}
                  aria-expanded={i === 0 ? 'true' : 'false'}
                  aria-controls={`faq-answer-ville-${i}`}
                >
                  <span class="faq-q-text">{item.q}</span>
                  <span class="faq-icon" aria-hidden="true">
                    <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
                      <line x1="12" y1="5" x2="12" y2="19"/><line x1="5" y1="12" x2="19" y2="12"/>
                    </svg>
                  </span>
                </button>
              </h3>
              <div
                class="faq-a"
                role="region"
                id={`faq-answer-ville-${i}`}
                aria-labelledby={`faq-question-ville-${i}`}
                aria-hidden={i === 0 ? 'false' : 'true'}
              >
                <div class="faq-a-inner" set:html={item.a} />
              </div>
            </div>
          ))}
        </div>
      </div>
    </section>

    <!-- ============ SECTION 8 — CTA FINAL + FORMULAIRE ============ -->
    <section class="rep-final-cta">
      <div class="rep-inner">
        <div class="rep-final-header">
          <h2 class="rep-section-title rep-section-title--center">Prêt à obtenir votre pré-approbation à Laval ?</h2>
          <p class="rep-final-sub">Aucun engagement. Gratuit pour la vaste majorité des dossiers<a class="rep-asterisque" href="#note-frais" aria-label="Voir la note sur les frais">*</a>. Je vous réponds moi-même, habituellement le jour ouvrable même.</p>
        </div>
      </div>
      <Contact ville="laval" />
      <div class="rep-inner">
        <p class="rep-note-frais" id="note-frais">* Frais de courtage à 0&nbsp;$ pour la vaste majorité des dossiers. Certains financements alternatifs ou privés peuvent comporter des frais, dont je vous informe avant toute démarche.</p>
      </div>
    </section>

  </main>

  <Footer />
</MainLayout>

