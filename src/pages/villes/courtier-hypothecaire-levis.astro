---
// SSR : la page lit les avis Google et le taux du jour à chaque requête (voir CLAUDE.md,
// « Le défaut est le statique ») — le cache CDN ci-dessous évite de les relire à chaque visite.
export const prerender = false;

import MainLayout from '../../layouts/MainLayout.astro';
import Nav from '../../components/Nav.astro';
import Footer from '../../components/Footer.astro';
import Contact from '../../components/Contact.astro';
import MessengerBtn from '../../components/MessengerBtn.astro';
import { Image } from 'astro:assets';
import stephaniePhoto from '../../assets/stephanie.webp';
import { loadSiteConfig } from '../../config';
import PhoneLink from '../../components/PhoneLink.astro';
import RappelCTA from '../../components/RappelCTA.astro';
import VillesVoisines from '../../components/VillesVoisines.astro';
import SecteursVille from '../../components/SecteursVille.astro';
import FilArianeVille from '../../components/FilArianeVille.astro';
import AvisVille from '../../components/AvisVille.astro';
import CalculVille from '../../components/CalculVille.astro';
import stephaniePortrait from '../../assets/stephanie.jpg';
import { getReviews } from '../../services/reviewsService';
import { fetchHypothecaRates, rateCacheControl } from '../../services/ratesService';
import { schemasVille } from '../../utils/schemaVille';

const config = loadSiteConfig();

// Les secteurs de la ville (section « Secteur par secteur ») — voir SecteursVille.astro.
const secteurs: { nom: string; texte: string }[] = [
  {
    nom: "Vieux-Lévis",
    texte: `Maisons anciennes et plex, souvent avec vue sur le fleuve. Ce cachet a son revers : fondations, toiture et électricité d'origine se vérifient à l'<strong>inspection</strong>, et l'<strong>assureur habitation</strong> peut poser ses conditions — à connaître avant le passage chez le notaire.`
  },
  {
    nom: "Lauzon",
    texte: `Ancien quartier ouvrier, riche en <strong>duplex</strong> et en <strong>triplex</strong>. Sur un plex que vous habitez, la mise de fonds minimale dépend du <strong>nombre de logements</strong>, et les loyers retenus s'appuient sur des baux en règle : on les réunit dès la pré-approbation.`
  },
  {
    nom: "Saint-Romuald",
    texte: `Un mélange de <strong>condos</strong> et d'unifamiliales, près des grands axes vers Québec. Pour un condo, les <strong>frais de copropriété</strong> entrent dans vos ratios d'endettement ; le procès-verbal des assemblées et le fonds de prévoyance disent si une cotisation spéciale se prépare.`
  },
  {
    nom: "Saint-Nicolas",
    texte: `Unifamiliales, parfois sur de grands terrains près du fleuve. Passé de <strong>500 000 $</strong>, la mise de fonds minimale passe à 10 % sur la portion excédentaire.`
  },
  {
    nom: "Saint-Jean-Chrysostome et Charny",
    texte: `Quartiers familiaux établis, où l'on achète souvent sa première ou sa deuxième maison. Déjà propriétaire ? Un <strong>refinancement</strong>, jusqu'à 80 % de la valeur, peut payer un agrandissement ; on le compare d'abord à la <strong>pénalité</strong> de rupture de votre prêt actuel.`
  },
  {
    nom: "Pintendre et Breakeyville",
    texte: `Cadre champêtre et grands terrains, parfois desservis par un <strong>puits</strong> et une <strong>fosse septique</strong> : le prêteur peut demander une analyse d'eau et la conformité de l'installation.`
  }
];
const prenom = config.nom.split(' ')[0];

const PAGE_URL = `${config.site_url}/villes/courtier-hypothecaire-levis/`;
// L'adresse de la photo telle que le build la produit : un nom de fichier haché écrit à la main
// (stephanie.Cm30Blgc.jpg) ne survivait pas au build suivant, et le schéma pointait sur une 404.
const STEPHANIE_IMAGE = new URL(stephaniePhoto.src, config.site_url).toString();

const faq = [
  {
    q: "Combien coûte un courtier hypothécaire à Lévis ?",
    a: `Pour la vaste majorité des dossiers, rien : mon service est <strong>gratuit</strong>. C'est le prêteur qui finance votre dossier qui me rémunère, au moment du déboursé. Certains financements alternatifs ou privés comportent des frais : si c'est votre cas, je vous le dis <strong>avant toute démarche</strong>, et vous ne vous engagez à rien tant qu'on n'a pas trouvé la bonne solution.`
  },
  {
    q: "Vous êtes basée à Repentigny : pouvez-vous m'accompagner à Lévis ?",
    a: `Oui, et je vous le dis franchement : je vous accompagne <strong>à distance</strong>. Mon permis de l'AMF couvre tout le Québec, et le courtage hypothécaire se fait très bien sans bureau à côté de chez vous : on se parle sur <strong>Teams</strong>, au téléphone ou par texto, vous me transmettez vos documents en ligne et les signatures se font électroniquement. Le notaire et l'inspecteur, eux, vous les choisissez près de chez vous.`
  },
  {
    q: "Quelle mise de fonds pour acheter une maison à Lévis ?",
    a: `La règle canadienne s'applique : <strong>5 %</strong> de <a href="/outils/#simulateur">mise de fonds minimale</a> sur la première tranche de 500 000 $, puis <strong>10 %</strong> entre 500 000 $ et 1,5 M$. Avec moins de 20 % de mise de fonds, une prime d'assurance SCHL s'ajoute à votre prêt. On calcule ensemble le scénario le plus avantageux selon votre situation.`
  },
  {
    q: "Les prix sont-ils les mêmes dans tous les secteurs de Lévis ?",
    a: `Non — le <strong>Vieux-Lévis</strong> (maisons anciennes, plex), <strong>Saint-Romuald</strong> et <strong>Saint-Nicolas</strong> (près des ponts), <strong>Saint-Jean-Chrysostome</strong>, <strong>Charny</strong> et <strong>Saint-Rédempteur</strong> (quartiers résidentiels familiaux) ou <strong>Pintendre</strong> (plus champêtre) ont chacun leur réalité de prix, sans compter les constructions neuves. Plutôt qu'un chiffre qui se périme, je vous propose d'évaluer votre <a href="/outils/#simulateur">capacité d'emprunt</a> par rapport au secteur que vous visez, gratuitement.`
  },
  {
    q: "J'habite Lévis mais je travaille à Québec : est-ce que ça change mon financement ?",
    a: `Pas en soi : le prêteur analyse vos <strong>revenus</strong> et vos <strong>dettes</strong>, pas la longueur de votre trajet. Ce qui compte, c'est ce que le trajet entraîne : un deuxième véhicule financé, par exemple, entre dans vos ratios d'endettement et réduit votre capacité d'emprunt. On en tient compte dès la pré-approbation pour viser un budget qui reste confortable une fois les ponts ou le traversier ajoutés à votre quotidien.`
  },
  {
    q: "Je vends ma maison à Québec pour acheter à Lévis : comment arrimer les deux transactions ?",
    a: `Tout dépend des dates. Si l'achat se conclut <strong>avant</strong> la vente, un <strong>prêt-relais</strong> peut avancer la mise de fonds que la vente doit libérer, à condition que celle-ci soit ferme. Votre hypothèque actuelle, elle, peut parfois être <strong>transférée</strong> vers la nouvelle propriété plutôt que remboursée, ce qui évite une <a href="/outils/calculateur-penalite-hypothecaire/">pénalité</a>. On compare les scénarios avant que vous signiez quoi que ce soit.`
  },
  {
    q: "En combien de temps puis-je être pré-approuvé ?",
    a: `Dès que votre dossier est complet (documents de revenus et de mise de fonds fournis), je vous donne moi-même un premier retour, <strong>habituellement le jour ouvrable même</strong> ; la réponse du prêteur suit selon ses propres délais. La <a href="/services/premier-achat/">pré-approbation</a> reste ensuite valide jusqu'à 120 jours — le temps de magasiner à Lévis sans pression.`
  },
  {
    q: "Je fais construire à Lévis avec un entrepreneur : quand demander mon financement ?",
    a: `Avant de signer le contrat. Une construction neuve se finance soit par <strong>déboursés progressifs</strong>, versés par étapes sur inspection de l'avancement, soit en un seul versement à la livraison quand l'entrepreneur porte le chantier : deux formules très différentes pour votre budget. Vérifiez aussi que la maison est couverte par la <strong>garantie de construction résidentielle</strong> (GCR). Et comme la livraison dépasse souvent la durée d'une pré-approbation, on planifie le calendrier ensemble.`
  }
];

// === Schemas JSON-LD === — voir src/utils/schemaVille.ts
const [schemaService, schemaPerson, schemaFil] = schemasVille({
  config,
  ville: "Lévis",
  pageUrl: PAGE_URL,
  secteurs: ["Saint-Nicolas", "Saint-Romuald", "Saint-Jean-Chrysostome", "Charny", "Pintendre"],
  image: STEPHANIE_IMAGE,
});


// Le FAQPage est généré à partir du tableau `faq` ci-dessus.
const schemaFAQ = {
  "@context": "https://schema.org",
  "@type": "FAQPage",
  "mainEntity": faq.map((item) => ({
    "@type": "Question",
    "name": item.q,
    "acceptedAnswer": {
      "@type": "Answer",
      // On retire le HTML pour la version texte du schema.
      "text": item.a.replace(/<[^>]+>/g, '')
    }
  }))
};

// Lectures en séquence, jamais en parallèle (voir CLAUDE.md, « ficheUnifiee »).
const tauxDuJour = await fetchHypothecaRates();
const avis = await getReviews();
// Cache CDN : 6 h, raccourci quand les taux manquent (même règle que l'accueil).
Astro.response.headers.set('Cache-Control', rateCacheControl(tauxDuJour));
---

<MainLayout
  title="Courtier hypothécaire Lévis"
  description="Courtière hypothécaire à Lévis : 20+ prêteurs comparés pour votre achat, renouvellement ou refinancement. Appel de 15 min sans engagement."
>
  <Fragment slot="head">
    <script type="application/ld+json" set:html={JSON.stringify(schemaService)} is:inline />
    <script type="application/ld+json" set:html={JSON.stringify(schemaPerson)} is:inline />
    <script type="application/ld+json" set:html={JSON.stringify(schemaFil)} is:inline />
    <script type="application/ld+json" set:html={JSON.stringify(schemaFAQ)} is:inline />
  </Fragment>

  <MessengerBtn />
  <Nav />

  <main id="main-content">

    <!-- ============ SECTION 1 — HÉRO ============ -->
    <section class="rep-hero">
      <div class="rep-inner">
        <div class="rep-hero-grid">
          <div class="rep-hero-text">
            <FilArianeVille ville="Lévis" />
            <div class="rep-eyebrow">Lévis · Chaudière-Appalaches</div>
            <h1 class="rep-h1">Courtière hypothécaire à Lévis</h1>
            <p class="rep-subtitle">
              Pré-approbation rapide. Accès à 20+ prêteurs. Frais de courtage&nbsp;: 0&nbsp;$.<span class="fee-tooltip-wrap"><button class="fee-info-btn" aria-label="En savoir plus sur les frais de courtage" aria-expanded="false" type="button">i</button><span class="fee-tooltip" role="tooltip">Frais de courtage à 0&nbsp;$ pour la vaste majorité des dossiers. Certains financements alternatifs ou privés peuvent comporter des frais, dont je vous informe avant toute démarche.</span></span>
            </p>

            <ul class="rep-trust-list" aria-label="Garanties de service">
              <li>
                <span class="rep-trust-icon" aria-hidden="true">💰</span>
                <span>Gratuit pour la vaste majorité des dossiers<a class="rep-asterisque" href="#note-frais" aria-label="Voir la note sur les frais">*</a> (rémunérée par le prêteur)</span>
              </li>
              <li>
                <span class="rep-trust-icon" aria-hidden="true">⏱️</span>
                <span>Je vous réponds moi-même, <strong>habituellement le jour ouvrable même</strong></span>
              </li>
            </ul>

            <div class="rep-hero-ctas">
              <a href="#contact" class="btn-cta rep-cta-primary" aria-label="Obtenir ma pré-approbation gratuite">
                <span>Obtenir ma pré-approbation gratuite</span>
                <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><line x1="5" y1="12" x2="19" y2="12"/><polyline points="12 5 19 12 12 19"/></svg>
              </a>
              <span class="rep-cta-secondary">
                ou appelez le <PhoneLink variant="text" trackId="tel_click_levis" aria-label={`Appeler ${prenom} au ${config.telephone}`} />
              </span>
            </div>
          </div>

          <aside class="rep-hero-photo" aria-label="Votre courtière">
            <Image
              src={stephaniePortrait}
              alt={`${config.nom}, courtière hypothécaire à Lévis`}
              width={400}
              height={400}
              loading="eager"
              decoding="async"
              class="rep-photo"
            />
            <div class="rep-photo-caption">
              <strong>{prenom} Weyman</strong>
              <span>Courtière hypothécaire · Hypotheca</span>
            </div>
          </aside>
        </div>
      </div>
    </section>

    <!-- ============ AVIS GOOGLE ============ -->
    <AvisVille reviews={avis} />

    <!-- ============ SECTION 2 — POUR QUI ============ -->
    <section class="rep-services">
      <div class="rep-inner">
        <div class="rep-section-tag">Pour qui je travaille à Lévis</div>
        <h2 class="rep-section-title">Six parcours, une seule personne pour vous accompagner.</h2>

        <div class="rep-cards-grid">
          <a href="/services/premier-achat/" class="rep-card">
            <span class="rep-card-icon" aria-hidden="true">🏠</span>
            <h3 class="rep-card-title">Premier achat à Lévis</h3>
            <p class="rep-card-text">Pré-approbation, RAP, CELIAPP, mise de fonds optimale.</p>
            <span class="rep-card-cta">En savoir plus →</span>
          </a>
          <a href="/services/renouvellement/" class="rep-card">
            <span class="rep-card-icon" aria-hidden="true">🔄</span>
            <h3 class="rep-card-title">Renouvellement hypothécaire</h3>
            <p class="rep-card-text">Comparer avant de signer l'offre de votre banque actuelle.</p>
            <span class="rep-card-cta">En savoir plus →</span>
          </a>
          <a href="/services/refinancement/" class="rep-card">
            <span class="rep-card-icon" aria-hidden="true">💰</span>
            <h3 class="rep-card-title">Refinancement</h3>
            <p class="rep-card-text">Libérer de l'équité pour rénover, consolider ou investir.</p>
            <span class="rep-card-cta">En savoir plus →</span>
          </a>
          <a href="/services/travailleur-autonome/" class="rep-card">
            <span class="rep-card-icon" aria-hidden="true">💼</span>
            <h3 class="rep-card-title">Travailleur autonome</h3>
            <p class="rep-card-text">Revenus non traditionnels ? Des prêteurs comprennent votre réalité.</p>
            <span class="rep-card-cta">En savoir plus →</span>
          </a>
          <a href="/services/dossier-refuse/" class="rep-card">
            <span class="rep-card-icon" aria-hidden="true">🚫</span>
            <h3 class="rep-card-title">Dossier refusé</h3>
            <p class="rep-card-text">Un refus bancaire n'est pas une fin — des solutions alternatives existent.</p>
            <span class="rep-card-cta">En savoir plus →</span>
          </a>
          <a href="/services/nouveaux-arrivants/" class="rep-card">
            <span class="rep-card-icon" aria-hidden="true">🌍</span>
            <h3 class="rep-card-title">Nouveaux arrivants</h3>
            <p class="rep-card-text">Résidence permanente ou permis de travail ? Des prêteurs s'adaptent à votre profil.</p>
            <span class="rep-card-cta">En savoir plus →</span>
          </a>
        </div>
      </div>
    </section>

    <!-- ============ RAPPEL RENOUVELLEMENT ============ -->
    <section class="rep-rappel" aria-label="Rappel de renouvellement">
      <div class="rep-inner">
        <RappelCTA
          titre="Votre hypothèque arrive à échéance ?"
          texte="Le meilleur moment pour magasiner se situe 4 à 6 mois avant la fin de votre terme — avant que votre banque n'envoie son offre de renouvellement. Laissez vos coordonnées : je vous rappelle personnellement au bon moment."
          cta="Être rappelé·e au bon moment"
        />
      </div>
    </section>

    <!-- ============ SECTION 3 — MARCHÉ LOCAL ============ -->
    <section class="rep-market">
      <div class="rep-inner rep-inner--narrow">
        <div class="rep-section-tag">Le marché immobilier</div>
        <h2 class="rep-section-title">Acheter ou refinancer une propriété à Lévis</h2>

        <p>
          Vous cherchez un courtier hypothécaire à Lévis ? Voici ce qu'il faut savoir du marché de la rive sud avant de faire une offre.
          Issue du regroupement municipal de 2002, Lévis réunit d'anciennes villes qui ont gardé
          chacune leur caractère — et leur réalité de marché. Le <strong>Vieux-Lévis</strong>, face au
          Vieux-Québec, et <strong>Lauzon</strong> concentrent maisons anciennes et <strong>plex</strong>,
          dont les revenus de location peuvent compter dans votre qualification ;
          <strong>Saint-Romuald</strong> et <strong>Saint-Nicolas</strong>, en bordure du fleuve,
          sont à la tête des ponts ; <strong>Saint-Jean-Chrysostome</strong>, <strong>Charny</strong>
          et <strong>Saint-Rédempteur</strong> alignent des quartiers résidentiels très prisés des
          jeunes familles, tandis que <strong>Pintendre</strong> offre un cadre plus champêtre. Plusieurs
          secteurs accueillent aussi des <strong>constructions neuves</strong>, dont le financement obéit
          à ses propres règles : déboursés progressifs, délais de livraison, conditions du constructeur.
        </p>

        <p>
          Beaucoup d'acheteurs de Lévis travaillent à Québec — fonction publique, santé,
          enseignement — et franchissent chaque jour le <strong>pont Pierre-Laporte</strong>, le
          <strong>pont de Québec</strong> ou prennent le <strong>traversier Québec-Lévis</strong>.
          D'autres travaillent sur la rive sud même, dans le secteur financier, le chantier maritime ou
          l'industrie, avec souvent des <strong>heures supplémentaires</strong>, des primes ou un
          horaire sur projets : des revenus que les prêteurs ne traitent pas tous de la même façon.
          C'est là qu'une courtière fait la différence. Vous faites peut-être affaire avec la même
          institution depuis toujours ; je compare plusieurs prêteurs, y compris celle où vous êtes déjà
          client, pour que vous sachiez que l'offre retenue est vraiment la bonne. Et dans tous
          les cas, la <strong>pré-approbation</strong> reste l'étape numéro un : elle fixe votre budget
          réel en intégrant le <strong>stress test fédéral</strong>, la mise de fonds minimale et, sous
          20 % de mise, la prime SCHL ajoutée au prêt.
        </p>

        <p>
          Je vous accompagne <strong>à distance</strong> : je suis basée à Repentigny, mais mon permis
          de l'AMF couvre tout le Québec. Rencontres sur Teams, appels ou textos, documents et signatures en
          ligne — vous avancez à votre rythme, le soir ou la fin de semaine s'il le faut. Je dessers
          tous les secteurs de Lévis, de Saint-Nicolas à Pintendre, ainsi que les municipalités
          voisines comme <strong>Saint-Lambert-de-Lauzon, Saint-Henri</strong> et
          <strong>Beaumont</strong>, et bien sûr, de l'autre côté du fleuve,
          <a href="/villes/courtier-hypothecaire-quebec/">Québec</a>. Quand les taux bougent, je suis
          le marché en continu pour saisir la bonne fenêtre à votre place.
        </p>
        <VillesVoisines actuelle="levis" />
      </div>
    </section>

    <!-- ============ SECTEURS ============ -->
    <SecteursVille ville="Lévis" secteurs={secteurs} />

    <!-- ============ CALCUL RAPIDE ============ -->
    <CalculVille slug="levis" ville="Lévis" taux={tauxDuJour?.fixe_5ans ?? null} />

    <!-- ============ SECTION 4 — BANQUE VS COURTIÈRE ============ -->
    <section class="rep-compare">
      <div class="rep-inner">
        <div class="rep-section-tag">Banque vs courtière</div>
        <h2 class="rep-section-title">Votre banque vous connaît. <em>Moi, je vous défends.</em></h2>

        <div class="rep-compare-cards">
          <div class="rep-compare-card rep-compare-card--bad">
            <div class="rep-compare-card-icon" aria-hidden="true">🏦</div>
            <h3 class="rep-compare-card-title">Avec votre banque</h3>
            <ul class="rep-compare-list">
              <li><span class="rep-x" aria-hidden="true">✕</span> Une seule offre : la leur</li>
              <li><span class="rep-x" aria-hidden="true">✕</span> Le conseiller travaille pour la banque, pas pour vous</li>
              <li><span class="rep-x" aria-hidden="true">✕</span> Heures d'ouverture restrictives</li>
              <li><span class="rep-x" aria-hidden="true">✕</span> Pas de magasinage de taux pour vous</li>
              <li><span class="rep-x" aria-hidden="true">✕</span> Un refus = fin de la discussion</li>
            </ul>
          </div>

          <div class="rep-compare-card rep-compare-card--good">
            <div class="rep-compare-card-icon" aria-hidden="true">🤝</div>
            <h3 class="rep-compare-card-title">Avec {prenom} Weyman</h3>
            <ul class="rep-compare-list">
              <li><span class="rep-check" aria-hidden="true">✓</span> 20+ prêteurs comparés pour vous</li>
              <li><span class="rep-check" aria-hidden="true">✓</span> Je travaille pour <strong>vous,</strong> pas pour un prêteur</li>
              <li><span class="rep-check" aria-hidden="true">✓</span> Dispo soirs et fins de semaine</li>
              <li><span class="rep-check" aria-hidden="true">✓</span> Je négocie les taux et les conditions</li>
              <li><span class="rep-check" aria-hidden="true">✓</span> Un refus bancaire ? J'ai des solutions alternatives</li>
            </ul>
            <p class="rep-compare-bonus">💰 <strong>Gratuit pour la vaste majorité des dossiers<a class="rep-asterisque" href="#note-frais" aria-label="Voir la note sur les frais">*</a></strong> — rémunérée par le prêteur, pas par vous.</p>
          </div>
        </div>
      </div>
    </section>

    <!-- ============ SECTION 5 — PROCESSUS ============ -->
    <section class="rep-process">
      <div class="rep-inner">
        <div class="rep-section-tag">Comment ça se passe</div>
        <h2 class="rep-section-title">Trois étapes, zéro stress.</h2>

        <ol class="rep-steps">
          <li class="rep-step">
            <div class="rep-step-num" aria-hidden="true">1</div>
            <h3 class="rep-step-title">Vous remplissez le formulaire</h3>
            <p class="rep-step-text">Deux minutes. Aucun pointage de crédit, aucun engagement.</p>
          </li>
          <li class="rep-step">
            <div class="rep-step-num" aria-hidden="true">2</div>
            <h3 class="rep-step-title">On se parle 15 minutes</h3>
            <p class="rep-step-text">J'analyse votre dossier et je vous explique vos vraies options.</p>
          </li>
          <li class="rep-step">
            <div class="rep-step-num" aria-hidden="true">3</div>
            <h3 class="rep-step-title">Vous recevez vos options</h3>
            <p class="rep-step-text">Vous choisissez celle qui vous convient — sans pression.</p>
          </li>
        </ol>
      </div>
    </section>

    <!-- ============ SECTION 6 — FAQ ============ -->
    <section class="rep-faq">
      <div class="rep-inner rep-inner--narrow">
        <div class="rep-section-tag">FAQ — Lévis</div>
        <h2 class="rep-section-title">Les questions qu'on me pose le plus souvent.</h2>

        <div class="faq-list">
          {faq.map((item, i) => (
            <div class={`faq-item${i === 0 ? ' open' : ''}`} id={`faq-ville-${i}`}>
              <h3>
                <button
                  class="faq-q"
                  id={`faq-question-ville-${i}`}
                  aria-expanded={i === 0 ? 'true' : 'false'}
                  aria-controls={`faq-answer-ville-${i}`}
                >
                  <span class="faq-q-text">{item.q}</span>
                  <span class="faq-icon" aria-hidden="true">
                    <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
