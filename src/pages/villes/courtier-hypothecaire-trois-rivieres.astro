---
export const prerender = true;

import MainLayout from '../../layouts/MainLayout.astro';
import Nav from '../../components/Nav.astro';
import Footer from '../../components/Footer.astro';
import Contact from '../../components/Contact.astro';
import MessengerBtn from '../../components/MessengerBtn.astro';
import { Image } from 'astro:assets';
import stephaniePhoto from '../../assets/stephanie.webp';
import { loadSiteConfig } from '../../config';
import PhoneLink from '../../components/PhoneLink.astro';
import RappelCTA from '../../components/RappelCTA.astro';
import VillesVoisines from '../../components/VillesVoisines.astro';
import SecteursVille from '../../components/SecteursVille.astro';

const config = loadSiteConfig();

// Les secteurs de la ville (section « Secteur par secteur ») — voir SecteursVille.astro.
const secteurs: { nom: string; texte: string }[] = [
  {
    nom: "Centre-ville et Vieux-Trois-Rivières",
    texte: `Maisons anciennes, plex et condos aménagés dans des bâtiments d'époque. Dans une vieille copropriété, lisez le <strong>fonds de prévoyance</strong> et les procès-verbaux : une <strong>cotisation spéciale</strong> à venir change votre budget, et le prêteur peut en tenir compte.`
  },
  {
    nom: "Cap-de-la-Madeleine",
    texte: `Plex et unifamiliales, parfois avec des travaux à prévoir. Un prêt <strong>achat-rénovation</strong> ajoute le coût des rénovations à l'hypothèque, sur la base de la <strong>valeur après travaux</strong> ; les fonds sont versés une fois les travaux faits.`
  },
  {
    nom: "Trois-Rivières-Ouest",
    texte: `Quartiers résidentiels plus récents, unifamiliales familiales. Vous y montez en gamme ? Avant de rompre votre hypothèque actuelle, on compare la <strong>pénalité</strong> au <strong>transfert</strong> de votre prêt vers la nouvelle maison : selon le prêteur, l'écart peut être important.`
  },
  {
    nom: "Pointe-du-Lac",
    texte: `Terrains plus grands, en bordure du lac Saint-Pierre. Sur un terrain plus vaste que la moyenne, certains prêteurs ne financent que la maison et une partie du terrain : on le vérifie avant l'offre, pas après.`
  },
  {
    nom: "Sainte-Marthe-du-Cap",
    texte: `Maisons de campagne et terrains le long du fleuve. Là où il n'y a pas d'aqueduc, le prêteur demande souvent un <strong>test d'eau du puits</strong> et la conformité de l'<strong>installation septique</strong> : prévoyez-les dans les conditions de votre offre.`
  },
  {
    nom: "Saint-Louis-de-France",
    texte: `Développements plus récents et terrains boisés. Faire construire, c'est un financement en <strong>déboursés progressifs</strong> : le prêteur verse par étapes, et vous payez les intérêts sur les sommes versées pendant le chantier.`
  }
];
const prenom = config.nom.split(' ')[0];

const PAGE_URL = `${config.site_url}/villes/courtier-hypothecaire-trois-rivieres/`;
// L'adresse de la photo telle que le build la produit : un nom de fichier haché écrit à la main
// (stephanie.Cm30Blgc.jpg) ne survivait pas au build suivant, et le schéma pointait sur une 404.
const STEPHANIE_IMAGE = new URL(stephaniePhoto.src, config.site_url).toString();

const faq = [
  {
    q: "Combien coûte un courtier hypothécaire à Trois-Rivières ?",
    a: `Rien pour vous : mon service est <strong>gratuit</strong>. C'est le prêteur qui finance votre dossier qui me rémunère, au moment du déboursé. Vous ne recevez aucune facture et vous ne vous engagez à rien tant qu'on n'a pas trouvé la bonne solution.`
  },
  {
    q: "Vous êtes à Montréal : pouvez-vous vraiment m'accompagner à Trois-Rivières ?",
    a: `Oui, et franchement. Mon permis de l'AMF couvre <strong>tout le Québec</strong>, et je travaille à Trois-Rivières <strong>à distance</strong> : premier appel au téléphone, rencontres sur <strong>Teams</strong>, questions par texto, documents transmis en ligne et <strong>signature électronique</strong>. Je n'ai pas de bureau en Mauricie et je ne prétends pas en avoir un — ce qui ne change rien à l'accès aux prêteurs ni au suivi de votre dossier, de la pré-approbation jusqu'au notaire.`
  },
  {
    q: "Quelle mise de fonds pour acheter une maison à Trois-Rivières ?",
    a: `La règle canadienne s'applique : <strong>5 %</strong> de mise de fonds minimale sur la première tranche de 500 000 $, puis <strong>10 %</strong> entre 500 000 $ et 1,5 M$. Avec moins de 20 % de mise de fonds, une prime d'assurance SCHL s'ajoute à votre prêt. On calcule ensemble le scénario le plus avantageux selon votre situation.`
  },
  {
    q: "Puis-je acheter un duplex ou un triplex au centre-ville ou au Cap pour l'habiter ?",
    a: `Oui, et c'est une façon courante d'accéder à la propriété à Trois-Rivières. Quand vous habitez l'un des logements, plusieurs prêteurs tiennent compte d'<strong>une partie des loyers</strong> des autres dans le calcul de votre capacité d'emprunt. La mise de fonds minimale et la façon de compter les revenus de location varient toutefois selon le <strong>nombre de logements</strong> et le prêteur — baux en vigueur, état de l'immeuble et évaluation pèsent aussi dans la balance. C'est un dossier où comparer les prêteurs change vraiment le résultat.`
  },
  {
    q: "Je déménage de Montréal ou de Québec en télétravail : comment se présente mon dossier ?",
    a: `Les prêteurs regardent surtout la <strong>stabilité de votre emploi</strong> et de vos revenus, pas la distance avec le bureau. Une lettre d'emploi qui confirme votre poste — et, idéalement, l'entente de télétravail — renforce le dossier. Si vous vendez une propriété ailleurs pour acheter à Trois-Rivières, on planifie aussi l'enchaînement des deux transactions (prêt-relais, dates de notaire) pour éviter d'être coincé entre les deux.`
  },
  {
    q: "Je travaille par quarts en usine, ici ou à Bécancour : mes heures supplémentaires comptent-elles ?",
    a: `Elles peuvent compter, à condition d'être régulières et documentées. La plupart des prêteurs retiennent le <strong>salaire de base</strong> sans difficulté, et les <strong>heures supplémentaires</strong>, primes de quart ou de soir sur une moyenne d'environ deux ans, appuyée par vos <strong>avis de cotisation</strong> et une lettre d'emploi. Un emploi saisonnier ou des mises à pied temporaires se documentent aussi. Les prêteurs ne font pas tous la même moyenne : le montant accordé peut varier sensiblement de l'un à l'autre.`
  },
  {
    q: "En combien de temps puis-je être pré-approuvé ?",
    a: `Dès que votre dossier est complet (documents de revenus et de mise de fonds fournis), je vise une <strong>réponse dans les meilleurs délais</strong>. La pré-approbation reste ensuite valide jusqu'à 120 jours — le temps de magasiner à Trois-Rivières sans pression. Tout se fait à distance : vous transmettez vos documents en ligne, sans déplacement.`
  },
  {
    q: "Je prends ma retraite et je veux m'installer à Trois-Rivières : puis-je encore obtenir une hypothèque ?",
    a: `Oui. L'âge n'est pas un motif de refus : ce sont vos <strong>revenus de retraite</strong> qui comptent — rentes du Régime de rentes du Québec et de la Sécurité de la vieillesse, régime de retraite d'employeur, retraits planifiés de vos placements. On documente chaque source, et on choisit l'<strong>amortissement</strong> et la mise de fonds qui laissent un versement confortable. Si vous vendez une maison ailleurs, une bonne partie du produit de la vente peut servir de mise de fonds.`
  }
];

// === Schemas JSON-LD ===
// Le service offert dans cette ville, rattaché à l'entreprise que déclare chaque page (SEO.astro,
// `#business`). Une seconde entité FinancialService — sans @id, sous un autre nom et une autre
// adresse web — se présentait à Google comme une deuxième entreprise.
const schemaService = {
  "@context": "https://schema.org",
  "@type": "Service",
  "serviceType": "Courtage hypothécaire",
  "name": "Courtière hypothécaire à Trois-Rivières",
  "url": PAGE_URL,
  "provider": { "@id": `${config.site_url}#business` },
  "areaServed": [
    { "@type": "City", "name": "Trois-Rivières" },
    { "@type": "City", "name": "Cap-de-la-Madeleine" },
    { "@type": "City", "name": "Trois-Rivières-Ouest" },
    { "@type": "City", "name": "Pointe-du-Lac" },
    { "@type": "City", "name": "Bécancour" },
    { "@type": "City", "name": "Shawinigan" }
  ]
};

const schemaPerson = {
  "@context": "https://schema.org",
  "@type": "Person",
  "@id": `${config.site_url}#stephanie`,
  "name": "Stéphanie Weyman",
  "jobTitle": "Courtière hypothécaire",
  "worksFor": { "@type": "Organization", "name": "Hypotheca" },
  "image": STEPHANIE_IMAGE,
  "url": config.site_url,
  "identifier": `AMF ${config.amf}`
};

// Le FAQPage est généré à partir du tableau `faq` ci-dessus.
const schemaFAQ = {
  "@context": "https://schema.org",
  "@type": "FAQPage",
  "mainEntity": faq.map((item) => ({
    "@type": "Question",
    "name": item.q,
    "acceptedAnswer": {
      "@type": "Answer",
      // On retire le HTML pour la version texte du schema.
      "text": item.a.replace(/<[^>]+>/g, '')
    }
  }))
};

// Cache CDN — page éditoriale, change rarement.
Astro.response.headers.set('Cache-Control', 's-maxage=21600, stale-while-revalidate=3600');
---

<MainLayout
  fullTitle="Courtière hypothécaire à Trois-Rivières – Stéphanie Weyman"
  description="Courtière hypothécaire à Trois-Rivières (Cap-de-la-Madeleine, Trois-Rivières-Ouest, Pointe-du-Lac), à distance. Achat, plex, renouvellement. Gratuit."
>
  <Fragment slot="head">
    <script type="application/ld+json" set:html={JSON.stringify(schemaService)} is:inline />
    <script type="application/ld+json" set:html={JSON.stringify(schemaPerson)} is:inline />
    <script type="application/ld+json" set:html={JSON.stringify(schemaFAQ)} is:inline />
  </Fragment>

  <MessengerBtn />
  <Nav />

  <main id="main-content">

    <!-- ============ SECTION 1 — HÉRO ============ -->
    <section class="rep-hero">
      <div class="rep-inner">
        <div class="rep-hero-grid">
          <div class="rep-hero-text">
            <div class="rep-eyebrow">Trois-Rivières · Mauricie</div>
            <h1 class="rep-h1">Courtière hypothécaire à Trois-Rivières</h1>
            <p class="rep-subtitle">
              Pré-approbation rapide. Accès à 20+ prêteurs. Frais de courtage&nbsp;: 0&nbsp;$<span class="fee-tooltip-wrap"><button class="fee-info-btn" aria-label="En savoir plus sur les frais de courtage" aria-expanded="false" type="button">i</button><span class="fee-tooltip" role="tooltip">Frais de courtage à 0&nbsp;$ pour la vaste majorité des dossiers. Certains financements alternatifs ou privés peuvent comporter des frais, dont je vous informe avant toute démarche.</span></span>.
            </p>

            <ul class="rep-trust-list" aria-label="Garanties de service">
              <li>
                <span class="rep-trust-icon" aria-hidden="true">💰</span>
                <span>Service gratuit (rémunérée par le prêteur)</span>
              </li>
              <li>
                <span class="rep-trust-icon" aria-hidden="true">⏱️</span>
                <span>Premier contact <strong>dans les meilleurs délais</strong></span>
              </li>
            </ul>

            <div class="rep-hero-ctas">
              <a href="#contact" class="btn-cta rep-cta-primary" aria-label="Obtenir ma pré-approbation gratuite">
                <span>Obtenir ma pré-approbation gratuite</span>
                <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><line x1="5" y1="12" x2="19" y2="12"/><polyline points="12 5 19 12 12 19"/></svg>
              </a>
              <span class="rep-cta-secondary">
                ou appelez le <PhoneLink variant="text" trackId="tel_click_trois_rivieres" aria-label={`Appeler ${prenom} au ${config.telephone}`} />
              </span>
            </div>
          </div>

          <aside class="rep-hero-photo" aria-label="Votre courtière">
            <Image
              src={stephaniePhoto}
              alt={`${config.nom}, courtière hypothécaire à Trois-Rivières`}
              width={320}
              height={400}
              loading="eager"
              decoding="async"
              class="rep-photo"
            />
            <div class="rep-photo-caption">
              <strong>{prenom} Weyman</strong>
              <span>Courtière hypothécaire · Hypotheca</span>
            </div>
          </aside>
        </div>
      </div>
    </section>

    <!-- ============ SECTION 2 — POUR QUI ============ -->
    <section class="rep-services">
      <div class="rep-inner">
        <div class="rep-section-tag">Pour qui je travaille à Trois-Rivières</div>
        <h2 class="rep-section-title">Six parcours, une seule personne pour vous accompagner.</h2>

        <div class="rep-cards-grid">
          <a href="/services/premier-achat/" class="rep-card">
            <span class="rep-card-icon" aria-hidden="true">🏠</span>
            <h3 class="rep-card-title">Premier achat à Trois-Rivières</h3>
            <p class="rep-card-text">Pré-approbation, RAP, CELIAPP, mise de fonds optimale — même pour un plex que vous habitez.</p>
            <span class="rep-card-cta">En savoir plus →</span>
          </a>
          <a href="/services/renouvellement/" class="rep-card">
            <span class="rep-card-icon" aria-hidden="true">🔄</span>
            <h3 class="rep-card-title">Renouvellement hypothécaire</h3>
            <p class="rep-card-text">Comparer avant de signer l'offre de votre banque actuelle.</p>
            <span class="rep-card-cta">En savoir plus →</span>
          </a>
          <a href="/services/refinancement/" class="rep-card">
            <span class="rep-card-icon" aria-hidden="true">💰</span>
            <h3 class="rep-card-title">Refinancement</h3>
            <p class="rep-card-text">Libérer de l'équité pour rénover, consolider ou investir.</p>
            <span class="rep-card-cta">En savoir plus →</span>
          </a>
          <a href="/services/travailleur-autonome/" class="rep-card">
            <span class="rep-card-icon" aria-hidden="true">💼</span>
            <h3 class="rep-card-title">Travailleur autonome</h3>
            <p class="rep-card-text">Revenus non traditionnels ? Des prêteurs comprennent votre réalité.</p>
            <span class="rep-card-cta">En savoir plus →</span>
          </a>
          <a href="/services/dossier-refuse/" class="rep-card">
            <span class="rep-card-icon" aria-hidden="true">🚫</span>
            <h3 class="rep-card-title">Dossier refusé</h3>
            <p class="rep-card-text">Un refus bancaire n'est pas une fin — des solutions alternatives existent.</p>
            <span class="rep-card-cta">En savoir plus →</span>
          </a>
          <a href="/services/nouveaux-arrivants/" class="rep-card">
            <span class="rep-card-icon" aria-hidden="true">🌍</span>
            <h3 class="rep-card-title">Nouveaux arrivants</h3>
            <p class="rep-card-text">Résidence permanente ou permis de travail ? Des prêteurs s'adaptent à votre profil.</p>
            <span class="rep-card-cta">En savoir plus →</span>
          </a>
        </div>
      </div>
    </section>

    <!-- ============ RAPPEL RENOUVELLEMENT ============ -->
    <section class="rep-rappel" aria-label="Rappel de renouvellement">
      <div class="rep-inner">
        <RappelCTA
          titre="Votre hypothèque arrive à échéance ?"
          texte="Le meilleur moment pour magasiner se situe 4 à 6 mois avant la fin de votre terme — avant que votre banque n'envoie son offre de renouvellement. Laissez vos coordonnées : je vous rappelle personnellement au bon moment."
          cta="Être rappelé·e au bon moment"
        />
      </div>
    </section>

    <!-- ============ SECTION 3 — MARCHÉ LOCAL ============ -->
    <section class="rep-market">
      <div class="rep-inner rep-inner--narrow">
        <div class="rep-section-tag">Le marché immobilier</div>
        <h2 class="rep-section-title">Acheter ou refinancer une propriété à Trois-Rivières</h2>

        <p>
          Vous cherchez un courtier hypothécaire à Trois-Rivières ? Avant de faire une offre, voici ce que le marché trifluvien a de particulier.
          Depuis la fusion de 2002, Trois-Rivières réunit plusieurs anciennes municipalités — et
          autant de réalités de marché. Le <strong>centre-ville</strong> et ses quartiers anciens,
          autour du Vieux-Trois-Rivières, comptent beaucoup de <strong>plex</strong> et de maisons de
          caractère, souvent loués à la population étudiante de l'<strong>UQTR</strong> et du cégep ;
          <strong>Cap-de-la-Madeleine</strong>, sur la rive est du Saint-Maurice, mêle plex et
          unifamiliales ; <strong>Trois-Rivières-Ouest</strong> aligne des quartiers résidentiels
          plus récents ; <strong>Pointe-du-Lac</strong>, <strong>Sainte-Marthe-du-Cap</strong> et
          <strong>Saint-Louis-de-France</strong> offrent des terrains plus grands, en bordure du lac
          Saint-Pierre, du fleuve ou de la campagne.
        </p>

        <p>
          Beaucoup de premiers acheteurs y entrent par un <strong>duplex ou un triplex</strong> qu'ils
          habitent : les loyers des autres logements peuvent alors compter, en partie, dans la
          capacité d'emprunt — selon le nombre de logements, les baux en vigueur et les règles du
          prêteur. S'ajoutent les acheteurs qui arrivent de Montréal ou de Québec en
          <strong>télétravail</strong>, dont le dossier repose sur la stabilité d'un emploi exercé
          ailleurs. Dans tous les cas, la <strong>pré-approbation</strong> reste l'étape numéro un :
          elle fixe votre budget réel en intégrant le <strong>stress test fédéral</strong>, la mise
          de fonds minimale et, sous 20 % de mise, la prime SCHL ajoutée au prêt.
        </p>

        <p>
          Je suis basée à Montréal et j'accompagne Trois-Rivières <strong>à distance</strong> :
          rencontres sur Teams, appels ou textos, documents et signatures en ligne. Le même service
          s'étend aux villes voisines — <strong>Shawinigan</strong>, et, par le
          <strong>pont Laviolette</strong> et l'autoroute 55, <strong>Bécancour</strong> et
          <strong>Nicolet</strong> sur la rive sud. À mi-chemin entre Montréal et Québec par
          l'autoroute 40, Trois-Rivières attire aussi des acheteurs de
          <a href="/villes/courtier-hypothecaire-montreal/">Montréal</a> et de
          <a href="/villes/courtier-hypothecaire-quebec/">Québec</a>, et plus près de chez moi, de
          <a href="/villes/courtier-hypothecaire-repentigny/">Repentigny</a>. Quand les taux bougent,
          je suis le marché en continu pour saisir la bonne fenêtre à votre place.
        </p>
        <VillesVoisines actuelle="trois-rivieres" />
      </div>
    </section>

    <!-- ============ SECTEURS ============ -->
    <SecteursVille ville="Trois-Rivières" secteurs={secteurs} />

    <!-- ============ SECTION 4 — BANQUE VS COURTIÈRE ============ -->
    <section class="rep-compare">
      <div class="rep-inner">
        <div class="rep-section-tag">Banque vs courtière</div>
        <h2 class="rep-section-title">Ta banque te connaît. <em>Moi, je te défends.</em></h2>

        <div class="rep-compare-cards">
          <div class="rep-compare-card rep-compare-card--bad">
            <div class="rep-compare-card-icon" aria-hidden="true">🏦</div>
            <h3 class="rep-compare-card-title">Avec votre banque</h3>
            <ul class="rep-compare-list">
              <li><span class="rep-x" aria-hidden="true">✕</span> Une seule offre : la leur</li>
              <li><span class="rep-x" aria-hidden="true">✕</span> Le conseiller travaille pour la banque, pas pour vous</li>
              <li><span class="rep-x" aria-hidden="true">✕</span> Heures d'ouverture restrictives</li>
              <li><span class="rep-x" aria-hidden="true">✕</span> Pas de magasinage de taux pour vous</li>
              <li><span class="rep-x" aria-hidden="true">✕</span> Un refus = fin de la discussion</li>
            </ul>
          </div>

          <div class="rep-compare-card rep-compare-card--good">
            <div class="rep-compare-card-icon" aria-hidden="true">🤝</div>
            <h3 class="rep-compare-card-title">Avec {prenom} Weyman</h3>
            <ul class="rep-compare-list">
              <li><span class="rep-check" aria-hidden="true">✓</span> 20+ prêteurs comparés pour vous</li>
              <li><span class="rep-check" aria-hidden="true">✓</span> Je travaille pour <strong>vous,</strong> pas pour un prêteur</li>
              <li><span class="rep-check" aria-hidden="true">✓</span> Dispo soirs et fins de semaine</li>
              <li><span class="rep-check" aria-hidden="true">✓</span> Je négocie les taux et les conditions</li>
              <li><span class="rep-check" aria-hidden="true">✓</span> Un refus bancaire ? J'ai des solutions alternatives</li>
            </ul>
            <p class="rep-compare-bonus">💰 <strong>Service gratuit</strong> — rémunérée par le prêteur, pas par vous.</p>
          </div>
        </div>
      </div>
    </section>

    <!-- ============ SECTION 5 — PROCESSUS ============ -->
    <section class="rep-process">
      <div class="rep-inner">
        <div class="rep-section-tag">Comment ça se passe</div>
        <h2 class="rep-section-title">Trois étapes, zéro stress.</h2>

        <ol class="rep-steps">
          <li class="rep-step">
            <div class="rep-step-num" aria-hidden="true">1</div>
            <h3 class="rep-step-title">Vous remplissez le formulaire</h3>
            <p class="rep-step-text">Deux minutes. Aucun pointage de crédit, aucun engagement.</p>
          </li>
          <li class="rep-step">
            <div class="rep-step-num" aria-hidden="true">2</div>
            <h3 class="rep-step-title">On se parle 15 minutes</h3>
            <p class="rep-step-text">J'analyse votre dossier et je vous explique vos vraies options.</p>
          </li>
          <li class="rep-step">
            <div class="rep-step-num" aria-hidden="true">3</div>
            <h3 class="rep-step-title">Vous recevez vos options</h3>
            <p class="rep-step-text">Vous choisissez celle qui vous convient — sans pression.</p>
          </li>
        </ol>
      </div>
    </section>

    <!-- ============ SECTION 6 — FAQ ============ -->
    <section class="rep-faq">
      <div class="rep-inner rep-inner--narrow">
        <div class="rep-section-tag">FAQ — Trois-Rivières</div>
        <h2 class="rep-section-title">Les questions qu'on me pose le plus souvent.</h2>

        <div class="faq-list">
          {faq.map((item, i) => (
            <div class={`faq-item${i === 0 ? ' open' : ''}`} id={`faq-ville-${i}`}>
              <h3>
                <button
                  class="faq-q"
                  id={`faq-question-ville-${i}`}
                  aria-expanded={i === 0 ? 'true' : 'false'}
                  aria-controls={`faq-answer-ville-${i}`}
                >
                  <span class="faq-q-text">{item.q}</span>
                  <span class="faq-icon" aria-hidden="true">
                    <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
                      <line x1="12" y1="5" x2="12" y2="19"/><line x1="5" y1="12" x2="19" y2="12"/>
                    </svg>
                  </span>
                </button>
              </h3>
              <div
                class="faq-a"
                role="region"
