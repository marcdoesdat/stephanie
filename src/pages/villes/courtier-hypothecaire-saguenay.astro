---
export const prerender = true;

import MainLayout from '../../layouts/MainLayout.astro';
import Nav from '../../components/Nav.astro';
import Footer from '../../components/Footer.astro';
import Contact from '../../components/Contact.astro';
import MessengerBtn from '../../components/MessengerBtn.astro';
import { Image } from 'astro:assets';
import stephaniePhoto from '../../assets/stephanie.webp';
import { loadSiteConfig } from '../../config';
import PhoneLink from '../../components/PhoneLink.astro';
import RappelCTA from '../../components/RappelCTA.astro';
import VillesVoisines from '../../components/VillesVoisines.astro';
import SecteursVille from '../../components/SecteursVille.astro';

const config = loadSiteConfig();

// Les secteurs de la ville (section « Secteur par secteur ») — voir SecteursVille.astro.
const secteurs: { nom: string; texte: string }[] = [
  {
    nom: "Chicoutimi, centre-ville et UQAC",
    texte: `Duplex, triplex et petits immeubles, souvent loués à des étudiants. Les loyers comptent dans votre qualification s'ils sont appuyés par des <strong>baux</strong>, mais les prêteurs en retiennent rarement la totalité : on bâtit votre budget sur la part retenue, pas sur le <strong>loyer affiché</strong>.`
  },
  {
    nom: "Jonquière et Kénogami",
    texte: `Quartiers résidentiels bien établis, où l'unifamiliale reste à la portée d'un <strong>premier achat</strong>. Avec 5 % de mise de fonds, la prime SCHL s'ajoute au prêt ; le <strong>RAP</strong> et le <strong>CELIAPP</strong> peuvent financer cette mise. Les frais de notaire se prévoient à part.`
  },
  {
    nom: "Arvida",
    texte: `Maisons d'époque à l'architecture homogène, certaines rénovées, d'autres encore d'origine. Elles se financent bien, mais se lisent avec une <strong>inspection</strong> : isolation, fenêtres, plomberie. Si des travaux s'imposent, l'<strong>achat-rénovation</strong> les intègre au prêt dès l'achat.`
  },
  {
    nom: "La Baie",
    texte: `Maisons avec vue sur la baie des Ha! Ha! et propriétés près de l'eau. Près d'une rivière ou de la rive, on vérifie avant l'offre si la propriété est en <strong>zone inondable</strong> : l'assureur et le prêteur le demanderont.`
  },
  {
    nom: "Laterrière",
    texte: `Secteur champêtre au sud de Chicoutimi, avec de grands terrains. Certaines propriétés y ont un <strong>puits</strong> et une <strong>installation septique</strong> : le prêteur peut demander une analyse d'eau potable et une preuve de conformité, à obtenir avant la levée des conditions de l'offre.`
  },
  {
    nom: "Shipshaw et Canton Tremblay",
    texte: `Grands terrains sur la rive nord du Saguenay, dont certains se prêtent à la construction. Faire bâtir se finance par <strong>déboursés progressifs</strong>, versés selon l'avancement : le <strong>terrain</strong> se paie souvent d'abord, et votre loyer actuel court pendant le chantier.`
  }
];
const prenom = config.nom.split(' ')[0];

const PAGE_URL = `${config.site_url}/villes/courtier-hypothecaire-saguenay/`;
// L'adresse de la photo telle que le build la produit : un nom de fichier haché écrit à la main
// (stephanie.Cm30Blgc.jpg) ne survivait pas au build suivant, et le schéma pointait sur une 404.
const STEPHANIE_IMAGE = new URL(stephaniePhoto.src, config.site_url).toString();

const faq = [
  {
    q: "Combien coûte un courtier hypothécaire à Saguenay ?",
    a: `Rien pour vous : mon service est <strong>gratuit</strong>. C'est le prêteur qui finance votre dossier qui me rémunère, au moment du déboursé. Vous ne recevez aucune facture et vous ne vous engagez à rien tant qu'on n'a pas trouvé la bonne solution.`
  },
  {
    q: "Quelle mise de fonds pour acheter une maison à Saguenay ?",
    a: `La règle canadienne s'applique : <strong>5 %</strong> de mise de fonds minimale sur la première tranche de 500 000 $, puis <strong>10 %</strong> entre 500 000 $ et 1,5 M$. Avec moins de 20 % de mise de fonds, une prime d'assurance SCHL s'ajoute à votre prêt. On calcule ensemble le scénario le plus avantageux selon votre situation.`
  },
  {
    q: "Vous êtes à Montréal : comment m'accompagnez-vous à Saguenay ?",
    a: `Entièrement <strong>à distance</strong>, et sans rien perdre en accompagnement. On se parle au téléphone ou en <strong>visioconférence</strong>, vous transmettez vos documents en ligne et vous signez <strong>électroniquement</strong>. Mon permis de l'AMF couvre tout le Québec, et les prêteurs avec qui je travaille financent les propriétés de Chicoutimi, de Jonquière ou de La Baie comme partout ailleurs. Votre notaire, lui, peut tout à fait être de la région.`
  },
  {
    q: "Je travaille sur des quarts avec des heures supplémentaires et des primes : comment les prêteurs comptent-ils mes revenus ?",
    a: `Votre <strong>salaire de base</strong> est retenu sans difficulté. La partie variable — <strong>heures supplémentaires, primes de quart, primes diverses</strong> — est généralement acceptée quand elle est régulière, le plus souvent en faisant la <strong>moyenne des deux dernières années</strong> à partir de vos T4 ou avis de cotisation. Chaque prêteur a sa façon de la traiter : c'est justement là qu'un dossier bien monté fait une différence sur le montant que vous pouvez emprunter.`
  },
  {
    q: "Peut-on financer un chalet au bord du fjord ou d'un lac ?",
    a: `Oui, mais un chalet ne se finance pas toujours comme une maison en ville. Les prêteurs regardent notamment l'<strong>accès à l'année</strong>, le chauffage, l'alimentation en eau (puits) et l'installation septique. Un chalet habitable en toute saison se finance souvent comme une résidence secondaire ; un chalet saisonnier ou plus rustique peut exiger une mise de fonds plus importante, et certains prêteurs ne le financent pas du tout. On vérifie ces points avant votre offre d'achat, pas après.`
  },
  {
    q: "Je suis militaire à la Base de Bagotville : que se passe-t-il si je suis muté ?",
    a: `On le prévoit dès le départ plutôt que de le subir. Trois options s'offrent généralement à vous : <strong>vendre</strong>, en tenant compte de la pénalité de remboursement anticipé ; <strong>transférer</strong> votre prêt vers la propriété de votre nouvelle affectation, si le prêteur le permet ; ou <strong>louer</strong> la maison, en avisant votre prêteur. Le choix du prêteur, du terme et du type de taux change le coût de chacun de ces scénarios.`
  },
  {
    q: "En combien de temps puis-je être pré-approuvé ?",
    a: `Dès que votre dossier est complet (documents de revenus et de mise de fonds fournis), je vise une <strong>réponse dans les meilleurs délais</strong>. La pré-approbation reste ensuite valide jusqu'à 120 jours — le temps de magasiner à Saguenay sans pression.`
  },
  {
    q: "Je viens d'obtenir un emploi permanent dans la région, encore en probation : puis-je acheter ?",
    a: `Souvent, oui. Certains prêteurs acceptent un emploi en <strong>période de probation</strong>, surtout si vous restez dans le même domaine qu'avant ou si vous sortez d'une formation qui y mène, à l'UQAC ou au cégep par exemple. On présente une <strong>lettre d'emploi</strong> qui précise le poste, le salaire et le statut, et on cible les prêteurs dont les critères correspondent à votre situation.`
  }
];

// === Schemas JSON-LD ===
// Le service offert dans cette ville, rattaché à l'entreprise que déclare chaque page (SEO.astro,
// `#business`). Une seconde entité FinancialService — sans @id, sous un autre nom et une autre
// adresse web — se présentait à Google comme une deuxième entreprise.
const schemaService = {
  "@context": "https://schema.org",
  "@type": "Service",
  "serviceType": "Courtage hypothécaire",
  "name": "Courtière hypothécaire à Saguenay",
  "url": PAGE_URL,
  "provider": { "@id": `${config.site_url}#business` },
  "areaServed": [
    { "@type": "City", "name": "Saguenay" },
    { "@type": "City", "name": "Chicoutimi" },
    { "@type": "City", "name": "Jonquière" },
    { "@type": "City", "name": "La Baie" },
    { "@type": "City", "name": "Saint-Honoré" }
  ]
};

const schemaPerson = {
  "@context": "https://schema.org",
  "@type": "Person",
  "@id": `${config.site_url}#stephanie`,
  "name": "Stéphanie Weyman",
  "jobTitle": "Courtière hypothécaire",
  "worksFor": { "@type": "Organization", "name": "Hypotheca" },
  "image": STEPHANIE_IMAGE,
  "url": config.site_url,
  "identifier": `AMF ${config.amf}`
};

// Le FAQPage est généré à partir du tableau `faq` ci-dessus.
const schemaFAQ = {
  "@context": "https://schema.org",
  "@type": "FAQPage",
  "mainEntity": faq.map((item) => ({
    "@type": "Question",
    "name": item.q,
    "acceptedAnswer": {
      "@type": "Answer",
      // On retire le HTML pour la version texte du schema.
      "text": item.a.replace(/<[^>]+>/g, '')
    }
  }))
};

// Cache CDN — page éditoriale, change rarement.
Astro.response.headers.set('Cache-Control', 's-maxage=21600, stale-while-revalidate=3600');
---

<MainLayout
  fullTitle="Courtière hypothécaire à Saguenay – Stéphanie Weyman"
  description="Courtière hypothécaire à Saguenay (Chicoutimi, Jonquière, La Baie), à distance. Pré-approbation, achat, chalet, renouvellement. 20+ prêteurs. Gratuit."
>
  <Fragment slot="head">
    <script type="application/ld+json" set:html={JSON.stringify(schemaService)} is:inline />
    <script type="application/ld+json" set:html={JSON.stringify(schemaPerson)} is:inline />
    <script type="application/ld+json" set:html={JSON.stringify(schemaFAQ)} is:inline />
  </Fragment>

  <MessengerBtn />
  <Nav />

  <main id="main-content">

    <!-- ============ SECTION 1 — HÉRO ============ -->
    <section class="rep-hero">
      <div class="rep-inner">
        <div class="rep-hero-grid">
          <div class="rep-hero-text">
            <div class="rep-eyebrow">Saguenay · Saguenay–Lac-Saint-Jean</div>
            <h1 class="rep-h1">Courtière hypothécaire à Saguenay</h1>
            <p class="rep-subtitle">
              Pré-approbation rapide, entièrement à distance. Accès à 20+ prêteurs. Frais de courtage&nbsp;: 0&nbsp;$<span class="fee-tooltip-wrap"><button class="fee-info-btn" aria-label="En savoir plus sur les frais de courtage" aria-expanded="false" type="button">i</button><span class="fee-tooltip" role="tooltip">Frais de courtage à 0&nbsp;$ pour la vaste majorité des dossiers. Certains financements alternatifs ou privés peuvent comporter des frais, dont je vous informe avant toute démarche.</span></span>.
            </p>

            <ul class="rep-trust-list" aria-label="Garanties de service">
              <li>
                <span class="rep-trust-icon" aria-hidden="true">💰</span>
                <span>Service gratuit (rémunérée par le prêteur)</span>
              </li>
              <li>
                <span class="rep-trust-icon" aria-hidden="true">⏱️</span>
                <span>Premier contact <strong>dans les meilleurs délais</strong></span>
              </li>
            </ul>

            <div class="rep-hero-ctas">
              <a href="#contact" class="btn-cta rep-cta-primary" aria-label="Obtenir ma pré-approbation gratuite">
                <span>Obtenir ma pré-approbation gratuite</span>
                <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><line x1="5" y1="12" x2="19" y2="12"/><polyline points="12 5 19 12 12 19"/></svg>
              </a>
              <span class="rep-cta-secondary">
                ou appelez le <PhoneLink variant="text" trackId="tel_click_saguenay" aria-label={`Appeler ${prenom} au ${config.telephone}`} />
              </span>
            </div>
          </div>

          <aside class="rep-hero-photo" aria-label="Votre courtière">
            <Image
              src={stephaniePhoto}
              alt={`${config.nom}, courtière hypothécaire à Saguenay`}
              width={320}
              height={400}
              loading="eager"
              decoding="async"
              class="rep-photo"
            />
            <div class="rep-photo-caption">
              <strong>{prenom} Weyman</strong>
              <span>Courtière hypothécaire · Hypotheca</span>
            </div>
          </aside>
        </div>
      </div>
    </section>

    <!-- ============ SECTION 2 — POUR QUI ============ -->
    <section class="rep-services">
      <div class="rep-inner">
        <div class="rep-section-tag">Pour qui je travaille à Saguenay</div>
        <h2 class="rep-section-title">Six parcours, une seule personne pour vous accompagner.</h2>

        <div class="rep-cards-grid">
          <a href="/services/premier-achat/" class="rep-card">
            <span class="rep-card-icon" aria-hidden="true">🏠</span>
            <h3 class="rep-card-title">Premier achat à Saguenay</h3>
            <p class="rep-card-text">Pré-approbation, RAP, CELIAPP, mise de fonds optimale.</p>
            <span class="rep-card-cta">En savoir plus →</span>
          </a>
          <a href="/services/renouvellement/" class="rep-card">
            <span class="rep-card-icon" aria-hidden="true">🔄</span>
            <h3 class="rep-card-title">Renouvellement hypothécaire</h3>
            <p class="rep-card-text">Comparer avant de signer l'offre de votre banque actuelle.</p>
            <span class="rep-card-cta">En savoir plus →</span>
          </a>
          <a href="/services/refinancement/" class="rep-card">
            <span class="rep-card-icon" aria-hidden="true">💰</span>
            <h3 class="rep-card-title">Refinancement</h3>
            <p class="rep-card-text">Libérer de l'équité pour rénover, consolider ou acheter un chalet.</p>
            <span class="rep-card-cta">En savoir plus →</span>
          </a>
          <a href="/services/travailleur-autonome/" class="rep-card">
            <span class="rep-card-icon" aria-hidden="true">💼</span>
            <h3 class="rep-card-title">Travailleur autonome</h3>
            <p class="rep-card-text">Revenus non traditionnels ? Des prêteurs comprennent votre réalité.</p>
            <span class="rep-card-cta">En savoir plus →</span>
          </a>
          <a href="/services/dossier-refuse/" class="rep-card">
            <span class="rep-card-icon" aria-hidden="true">🚫</span>
            <h3 class="rep-card-title">Dossier refusé</h3>
            <p class="rep-card-text">Un refus bancaire n'est pas une fin — des solutions alternatives existent.</p>
            <span class="rep-card-cta">En savoir plus →</span>
          </a>
          <a href="/services/nouveaux-arrivants/" class="rep-card">
            <span class="rep-card-icon" aria-hidden="true">🌍</span>
            <h3 class="rep-card-title">Nouveaux arrivants</h3>
            <p class="rep-card-text">Résidence permanente ou permis de travail ? Des prêteurs s'adaptent à votre profil.</p>
            <span class="rep-card-cta">En savoir plus →</span>
          </a>
        </div>
      </div>
    </section>

    <!-- ============ RAPPEL RENOUVELLEMENT ============ -->
    <section class="rep-rappel" aria-label="Rappel de renouvellement">
      <div class="rep-inner">
        <RappelCTA
          titre="Votre hypothèque arrive à échéance ?"
          texte="Le meilleur moment pour magasiner se situe 4 à 6 mois avant la fin de votre terme — avant que votre banque n'envoie son offre de renouvellement. Laissez vos coordonnées : je vous rappelle personnellement au bon moment."
          cta="Être rappelé·e au bon moment"
        />
      </div>
    </section>

    <!-- ============ SECTION 3 — MARCHÉ LOCAL ============ -->
    <section class="rep-market">
      <div class="rep-inner rep-inner--narrow">
        <div class="rep-section-tag">Le marché immobilier</div>
        <h2 class="rep-section-title">Acheter ou refinancer une propriété à Saguenay</h2>

        <p>
          Vous cherchez un courtier hypothécaire à Saguenay ? Voici ce qu'il faut savoir du marché avant de faire une offre.
          Née du regroupement de Chicoutimi, de Jonquière, de La Baie et de plusieurs municipalités
          voisines, Saguenay se vit en trois arrondissements — et en autant de réalités de marché.
          <strong>Chicoutimi</strong>, ville de services et d'université autour de l'<strong>UQAC</strong>,
          mêle condos, duplex et triplex près du centre-ville et unifamiliales dans les quartiers plus
          récents ; <strong>Jonquière</strong>, avec <strong>Arvida</strong> et ses maisons bâties pour
          les travailleurs de l'aluminium, et <strong>Kénogami</strong>, aligne des quartiers
          résidentiels bien établis ; <strong>La Baie</strong>, au fond de la baie des Ha! Ha!, vit au
          rythme du fjord. Plus loin des centres, <strong>Laterrière</strong>, <strong>Shipshaw</strong>
          et <strong>Canton Tremblay</strong> offrent de grands terrains et un cadre plus champêtre. Ici,
          l'<strong>unifamiliale</strong> reste plus accessible que dans la grande région de Montréal,
          et beaucoup d'acheteurs y ajoutent un projet de <strong>chalet</strong> au bord du fjord ou
          d'un lac comme le lac Kénogami — un achat que les prêteurs n'évaluent pas comme une maison en
          ville (accès à l'année, puits, installation septique).
        </p>

        <p>
          L'économie de la région repose en bonne partie sur l'<strong>industrie de l'aluminium</strong>
          et l'<strong>industrie forestière</strong>, où l'on travaille souvent sur des quarts, avec des
          <strong>heures supplémentaires</strong> et des <strong>primes</strong>. Pour un prêteur, cette
          partie variable n'est pas automatique : elle est généralement retenue quand elle est régulière,
          le plus souvent en moyenne sur deux ans — d'où l'importance de présenter vos revenus de la
          bonne façon. La <strong>Base de Bagotville</strong> amène aussi son lot de militaires, pour qui
          une mutation future fait partie de l'équation : acheter en sachant qu'on pourrait devoir louer
          la propriété plus tard se planifie dès le financement. Ajoutez le personnel et les étudiants de
          l'UQAC, et les <strong>revenus de location</strong> d'un duplex ou d'un triplex, qu'une partie
          des prêteurs intègre au calcul de votre capacité d'emprunt. Dans tous les cas, la
          <strong>pré-approbation</strong> reste l'étape numéro un : elle fixe votre budget réel en
          intégrant le <strong>stress test fédéral</strong>, la mise de fonds minimale et, sous 20 % de
          mise, la prime SCHL ajoutée au prêt.
        </p>

        <p>
          Je suis basée à Montréal et je vous accompagne à Saguenay <strong>entièrement à
          distance</strong> : rencontres en visioconférence ou au téléphone, documents transmis en ligne,
          <strong>signature électronique</strong>. Mon permis de l'AMF couvre tout le Québec, et je
          dessers aussi les villes voisines — <strong>Saint-Honoré, Saint-Fulgence, Larouche,
          Saint-David-de-Falardeau</strong> et, côté Lac-Saint-Jean, <strong>Alma</strong>. Si votre
          projet vous mène plutôt vers la capitale par la route 175, voyez aussi la page
          <a href="/villes/courtier-hypothecaire-quebec/">Québec</a>. Quand les taux bougent, je suis le
          marché en continu pour saisir la bonne fenêtre à votre place.
        </p>
        <VillesVoisines actuelle="saguenay" />
      </div>
    </section>

    <!-- ============ SECTEURS ============ -->
    <SecteursVille ville="Saguenay" secteurs={secteurs} />

    <!-- ============ SECTION 4 — BANQUE VS COURTIÈRE ============ -->
    <section class="rep-compare">
      <div class="rep-inner">
        <div class="rep-section-tag">Banque vs courtière</div>
        <h2 class="rep-section-title">Ta banque te connaît. <em>Moi, je te défends.</em></h2>

        <div class="rep-compare-cards">
          <div class="rep-compare-card rep-compare-card--bad">
            <div class="rep-compare-card-icon" aria-hidden="true">🏦</div>
            <h3 class="rep-compare-card-title">Avec votre banque</h3>
            <ul class="rep-compare-list">
              <li><span class="rep-x" aria-hidden="true">✕</span> Une seule offre : la leur</li>
              <li><span class="rep-x" aria-hidden="true">✕</span> Le conseiller travaille pour la banque, pas pour vous</li>
              <li><span class="rep-x" aria-hidden="true">✕</span> Heures d'ouverture restrictives</li>
              <li><span class="rep-x" aria-hidden="true">✕</span> Pas de magasinage de taux pour vous</li>
              <li><span class="rep-x" aria-hidden="true">✕</span> Un refus = fin de la discussion</li>
            </ul>
          </div>

          <div class="rep-compare-card rep-compare-card--good">
            <div class="rep-compare-card-icon" aria-hidden="true">🤝</div>
            <h3 class="rep-compare-card-title">Avec {prenom} Weyman</h3>
            <ul class="rep-compare-list">
              <li><span class="rep-check" aria-hidden="true">✓</span> 20+ prêteurs comparés pour vous</li>
              <li><span class="rep-check" aria-hidden="true">✓</span> Je travaille pour <strong>vous,</strong> pas pour un prêteur</li>
              <li><span class="rep-check" aria-hidden="true">✓</span> Dispo soirs et fins de semaine</li>
              <li><span class="rep-check" aria-hidden="true">✓</span> Je négocie les taux et les conditions</li>
              <li><span class="rep-check" aria-hidden="true">✓</span> Un refus bancaire ? J'ai des solutions alternatives</li>
            </ul>
            <p class="rep-compare-bonus">💰 <strong>Service gratuit</strong> — rémunérée par le prêteur, pas par vous.</p>
          </div>
        </div>
      </div>
    </section>

    <!-- ============ SECTION 5 — PROCESSUS ============ -->
    <section class="rep-process">
      <div class="rep-inner">
        <div class="rep-section-tag">Comment ça se passe</div>
        <h2 class="rep-section-title">Trois étapes, zéro stress.</h2>

        <ol class="rep-steps">
          <li class="rep-step">
            <div class="rep-step-num" aria-hidden="true">1</div>
            <h3 class="rep-step-title">Vous remplissez le formulaire</h3>
            <p class="rep-step-text">Deux minutes. Aucun pointage de crédit, aucun engagement.</p>
          </li>
          <li class="rep-step">
            <div class="rep-step-num" aria-hidden="true">2</div>
            <h3 class="rep-step-title">On se parle 15 minutes</h3>
            <p class="rep-step-text">J'analyse votre dossier et je vous explique vos vraies options.</p>
          </li>
          <li class="rep-step">
            <div class="rep-step-num" aria-hidden="true">3</div>
            <h3 class="rep-step-title">Vous recevez vos options</h3>
            <p class="rep-step-text">Vous choisissez celle qui vous convient — sans pression.</p>
          </li>
        </ol>
      </div>
    </section>

    <!-- ============ SECTION 6 — FAQ ============ -->
    <section class="rep-faq">
      <div class="rep-inner rep-inner--narrow">
        <div class="rep-section-tag">FAQ — Saguenay</div>
        <h2 class="rep-section-title">Les questions qu'on me pose le plus souvent.</h2>

        <div class="faq-list">
          {faq.map((item, i) => (
            <div class={`faq-item${i === 0 ? ' open' : ''}`} id={`faq-ville-${i}`}>
              <h3>
                <button
                  class="faq-q"
                  id={`faq-question-ville-${i}`}
                  aria-expanded={i === 0 ? 'true' : 'false'}
                  aria-controls={`faq-answer-ville-${i}`}
                >
                  <span class="faq-q-text">{item.q}</span>
                  <span class="faq-icon" aria-hidden="true">
                    <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
