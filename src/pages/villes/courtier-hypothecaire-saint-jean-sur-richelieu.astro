---
export const prerender = true;

import MainLayout from '../../layouts/MainLayout.astro';
import Nav from '../../components/Nav.astro';
import Footer from '../../components/Footer.astro';
import Contact from '../../components/Contact.astro';
import MessengerBtn from '../../components/MessengerBtn.astro';
import { Image } from 'astro:assets';
import stephaniePhoto from '../../assets/stephanie.webp';
import { loadSiteConfig } from '../../config';
import PhoneLink from '../../components/PhoneLink.astro';
import RappelCTA from '../../components/RappelCTA.astro';
import VillesVoisines from '../../components/VillesVoisines.astro';
import SecteursVille from '../../components/SecteursVille.astro';

const config = loadSiteConfig();

// Les secteurs de la ville (section « Secteur par secteur ») — voir SecteursVille.astro.
const secteurs: { nom: string; texte: string }[] = [
  {
    nom: "Vieux-Saint-Jean",
    texte: "Autour du centre-ville, on achète surtout des <strong>plex</strong> et des maisons anciennes. Si vous habitez l'un des logements, une partie des <strong>loyers</strong> peut compter dans vos revenus de qualification — à condition de documenter les baux en vigueur."
  },
  {
    nom: "Iberville",
    texte: "Sur la rive est, des quartiers établis où bien des maisons attendent une mise à jour. Un <strong>financement achat-rénovation</strong> peut intégrer le coût des travaux au prêt, sur la foi de soumissions et de la valeur estimée après travaux."
  },
  {
    nom: "Saint-Luc",
    texte: "Des unifamiliales plus récentes, recherchées par les familles et souvent par les premiers acheteurs. Le <strong>RAP</strong> et le <strong>CELIAPP</strong> peuvent se combiner pour la mise de fonds ; sous 20 %, la prime <strong>SCHL</strong> s'ajoute au prêt — un calcul à faire d'avance."
  },
  {
    nom: "L'Acadie",
    texte: "Un caractère agricole : maisons sur grands terrains, parfois de petites fermettes. Hors réseau, le prêteur peut exiger une analyse de l'<strong>eau du puits</strong> et la conformité de la <strong>fosse septique</strong> ; sur une très grande superficie, il ne finance parfois qu'une partie du terrain."
  },
  {
    nom: "Saint-Athanase",
    texte: "Sur la rive est, entre quartiers résidentiels et terres agricoles, certains y font <strong>construire</strong>. Le prêt construction se verse par <strong>déboursés progressifs</strong>, et le terrain, acheté d'abord, se finance souvent à part, avec une mise de fonds plus élevée."
  }
];
const prenom = config.nom.split(' ')[0];

const PAGE_URL = `${config.site_url}/villes/courtier-hypothecaire-saint-jean-sur-richelieu/`;
// L'adresse de la photo telle que le build la produit : un nom de fichier haché écrit à la main
// (stephanie.Cm30Blgc.jpg) ne survivait pas au build suivant, et le schéma pointait sur une 404.
const STEPHANIE_IMAGE = new URL(stephaniePhoto.src, config.site_url).toString();

const faq = [
  {
    q: "Combien coûte un courtier hypothécaire à Saint-Jean-sur-Richelieu ?",
    a: `Rien pour vous : mon service est <strong>gratuit</strong>. C'est le prêteur qui finance votre dossier qui me rémunère, au moment du déboursé. Vous ne recevez aucune facture et vous ne vous engagez à rien tant qu'on n'a pas trouvé la bonne solution.`
  },
  {
    q: "Vous êtes à Montréal : pouvez-vous m'accompagner à Saint-Jean-sur-Richelieu ?",
    a: `Oui. Mon permis de l'AMF couvre tout le Québec, et j'accompagne mes clients de Saint-Jean-sur-Richelieu <strong>à distance</strong> : appels, rencontres en <strong>visioconférence</strong>, documents transmis et signés en ligne. Le prêteur, l'évaluateur et le notaire, eux, sont choisis en fonction de votre propriété — la distance ne change rien à l'accès aux prêteurs ni aux conditions que je négocie pour vous.`
  },
  {
    q: "Quelle mise de fonds pour acheter une maison à Saint-Jean-sur-Richelieu ?",
    a: `La règle canadienne s'applique : <strong>5 %</strong> de mise de fonds minimale sur la première tranche de 500 000 $, puis <strong>10 %</strong> entre 500 000 $ et 1,5 M$. Avec moins de 20 % de mise de fonds, une prime d'assurance SCHL s'ajoute à votre prêt. On calcule ensemble le scénario le plus avantageux selon votre situation.`
  },
  {
    q: "Je suis militaire et muté à la Garnison Saint-Jean : comment financer mon achat ?",
    a: `Une mutation impose souvent un <strong>calendrier serré</strong> : acheter avant d'arriver, parfois vendre ailleurs en même temps. On peut obtenir votre pré-approbation à distance, prévoir un <strong>prêt-relais</strong> au besoin et vérifier comment le prêteur traite vos primes et indemnités. Si une nouvelle affectation est possible avant la fin du terme, une hypothèque <strong>transférable</strong> ou une pénalité raisonnable peut valoir davantage qu'un taux à peine plus bas.`
  },
  {
    q: "Acheter une propriété au bord du Richelieu : le financement est-il différent ?",
    a: `Il peut l'être. Pour une propriété située en <strong>zone inondable</strong>, certains prêteurs et assureurs se montrent plus prudents : l'assurance contre les inondations peut être plus coûteuse ou plus difficile à obtenir, et le prêteur voudra s'assurer que la propriété est bien assurable. Le bon réflexe : consulter la cartographie des zones inondables et obtenir une soumission d'assurance <strong>avant</strong> de lever vos conditions. Je présente ensuite le dossier aux prêteurs à l'aise avec ce type de propriété.`
  },
  {
    q: "Une deuxième voiture pour faire la navette change-t-elle mon budget d'achat à Saint-Jean-sur-Richelieu ?",
    a: `Elle peut le changer beaucoup. Le paiement d'un prêt ou d'une location auto entre dans votre <strong>ratio d'endettement total</strong> : chaque dollar versé chaque mois pour le véhicule réduit le montant que les prêteurs vous accorderont. Le bon ordre : obtenir votre <strong>pré-approbation</strong> avant de financer la voiture, et ne contracter aucun nouveau crédit d'ici la signature chez le notaire — le prêteur peut revérifier votre dossier avant le déboursé.`
  },
  {
    q: "En combien de temps puis-je être pré-approuvé ?",
    a: `Dès que votre dossier est complet (documents de revenus et de mise de fonds fournis), je vise une <strong>réponse dans les meilleurs délais</strong>. La pré-approbation reste ensuite valide jusqu'à 120 jours — le temps de magasiner à Saint-Jean-sur-Richelieu sans pression.`
  },
  {
    q: "Je change d'emploi en déménageant à Saint-Jean-sur-Richelieu : est-ce un problème pour mon financement ?",
    a: `Pas forcément — tout dépend du type d'emploi et du moment. Un poste <strong>permanent</strong> dans le même domaine est souvent accepté, parfois même pendant la <strong>période de probation</strong>, avec une lettre d'emploi ; un contrat, des commissions ou des heures variables demandent en général plus d'historique. Le plus sûr : m'en parler <strong>avant</strong> de démissionner, car l'ordre des démarches peut changer ce que les prêteurs accepteront.`
  }
];

// === Schemas JSON-LD ===
// Le service offert dans cette ville, rattaché à l'entreprise que déclare chaque page (SEO.astro,
// `#business`). Une seconde entité FinancialService — sans @id, sous un autre nom et une autre
// adresse web — se présentait à Google comme une deuxième entreprise.
const schemaService = {
  "@context": "https://schema.org",
  "@type": "Service",
  "serviceType": "Courtage hypothécaire",
  "name": "Courtière hypothécaire à Saint-Jean-sur-Richelieu",
  "url": PAGE_URL,
  "provider": { "@id": `${config.site_url}#business` },
  "areaServed": [
    { "@type": "City", "name": "Saint-Jean-sur-Richelieu" },
    { "@type": "Place", "name": "Iberville" },
    { "@type": "Place", "name": "Saint-Luc" },
    { "@type": "Place", "name": "L'Acadie" },
    { "@type": "City", "name": "Chambly" },
    { "@type": "City", "name": "Carignan" }
  ]
};

const schemaPerson = {
  "@context": "https://schema.org",
  "@type": "Person",
  "@id": `${config.site_url}#stephanie`,
  "name": "Stéphanie Weyman",
  "jobTitle": "Courtière hypothécaire",
  "worksFor": { "@type": "Organization", "name": "Hypotheca" },
  "image": STEPHANIE_IMAGE,
  "url": config.site_url,
  "identifier": `AMF ${config.amf}`
};

// Le FAQPage est généré à partir du tableau `faq` ci-dessus.
const schemaFAQ = {
  "@context": "https://schema.org",
  "@type": "FAQPage",
  "mainEntity": faq.map((item) => ({
    "@type": "Question",
    "name": item.q,
    "acceptedAnswer": {
      "@type": "Answer",
      // On retire le HTML pour la version texte du schema.
      "text": item.a.replace(/<[^>]+>/g, '')
    }
  }))
};

// Cache CDN — page éditoriale, change rarement.
Astro.response.headers.set('Cache-Control', 's-maxage=21600, stale-while-revalidate=3600');
---

<MainLayout
  fullTitle="Courtière hypothécaire à Saint-Jean-sur-Richelieu"
  description="Courtière hypothécaire à Saint-Jean-sur-Richelieu (Iberville, Saint-Luc, L'Acadie). Accompagnement à distance, 20+ prêteurs. Service gratuit."
>
  <Fragment slot="head">
    <script type="application/ld+json" set:html={JSON.stringify(schemaService)} is:inline />
    <script type="application/ld+json" set:html={JSON.stringify(schemaPerson)} is:inline />
    <script type="application/ld+json" set:html={JSON.stringify(schemaFAQ)} is:inline />
  </Fragment>

  <MessengerBtn />
  <Nav />

  <main id="main-content">

    <!-- ============ SECTION 1 — HÉRO ============ -->
    <section class="rep-hero">
      <div class="rep-inner">
        <div class="rep-hero-grid">
          <div class="rep-hero-text">
            <div class="rep-eyebrow">Saint-Jean-sur-Richelieu · Montérégie</div>
            <h1 class="rep-h1">Courtière hypothécaire à Saint-Jean-sur-Richelieu</h1>
            <p class="rep-subtitle">
              Pré-approbation rapide. Accès à 20+ prêteurs. Frais de courtage&nbsp;: 0&nbsp;$<span class="fee-tooltip-wrap"><button class="fee-info-btn" aria-label="En savoir plus sur les frais de courtage" aria-expanded="false" type="button">i</button><span class="fee-tooltip" role="tooltip">Frais de courtage à 0&nbsp;$ pour la vaste majorité des dossiers. Certains financements alternatifs ou privés peuvent comporter des frais, dont je vous informe avant toute démarche.</span></span>.
            </p>

            <ul class="rep-trust-list" aria-label="Garanties de service">
              <li>
                <span class="rep-trust-icon" aria-hidden="true">💰</span>
                <span>Service gratuit (rémunérée par le prêteur)</span>
              </li>
              <li>
                <span class="rep-trust-icon" aria-hidden="true">⏱️</span>
                <span>Premier contact <strong>dans les meilleurs délais</strong></span>
              </li>
            </ul>

            <div class="rep-hero-ctas">
              <a href="#contact" class="btn-cta rep-cta-primary" aria-label="Obtenir ma pré-approbation gratuite">
                <span>Obtenir ma pré-approbation gratuite</span>
                <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><line x1="5" y1="12" x2="19" y2="12"/><polyline points="12 5 19 12 12 19"/></svg>
              </a>
              <span class="rep-cta-secondary">
                ou appelez le <PhoneLink variant="text" trackId="tel_click_saint_jean_sur_richelieu" aria-label={`Appeler ${prenom} au ${config.telephone}`} />
              </span>
            </div>
          </div>

          <aside class="rep-hero-photo" aria-label="Votre courtière">
            <Image
              src={stephaniePhoto}
              alt={`${config.nom}, courtière hypothécaire à Saint-Jean-sur-Richelieu`}
              width={320}
              height={400}
              loading="eager"
              decoding="async"
              class="rep-photo"
            />
            <div class="rep-photo-caption">
              <strong>{prenom} Weyman</strong>
              <span>Courtière hypothécaire · Hypotheca</span>
            </div>
          </aside>
        </div>
      </div>
    </section>

    <!-- ============ SECTION 2 — POUR QUI ============ -->
    <section class="rep-services">
      <div class="rep-inner">
        <div class="rep-section-tag">Pour qui je travaille à Saint-Jean-sur-Richelieu</div>
        <h2 class="rep-section-title">Six parcours, une seule personne pour vous accompagner.</h2>

        <div class="rep-cards-grid">
          <a href="/services/premier-achat/" class="rep-card">
            <span class="rep-card-icon" aria-hidden="true">🏠</span>
            <h3 class="rep-card-title">Premier achat à Saint-Jean-sur-Richelieu</h3>
            <p class="rep-card-text">Pré-approbation, RAP, CELIAPP, mise de fonds optimale.</p>
            <span class="rep-card-cta">En savoir plus →</span>
          </a>
          <a href="/services/renouvellement/" class="rep-card">
            <span class="rep-card-icon" aria-hidden="true">🔄</span>
            <h3 class="rep-card-title">Renouvellement hypothécaire</h3>
            <p class="rep-card-text">Comparer avant de signer l'offre de votre banque — ou avant une mutation qui changera vos plans.</p>
            <span class="rep-card-cta">En savoir plus →</span>
          </a>
          <a href="/services/refinancement/" class="rep-card">
            <span class="rep-card-icon" aria-hidden="true">💰</span>
            <h3 class="rep-card-title">Refinancement</h3>
            <p class="rep-card-text">Libérer de l'équité pour rénover, consolider ou investir.</p>
            <span class="rep-card-cta">En savoir plus →</span>
          </a>
          <a href="/services/travailleur-autonome/" class="rep-card">
            <span class="rep-card-icon" aria-hidden="true">💼</span>
            <h3 class="rep-card-title">Travailleur autonome</h3>
            <p class="rep-card-text">Revenus non traditionnels ? Des prêteurs comprennent votre réalité.</p>
            <span class="rep-card-cta">En savoir plus →</span>
          </a>
          <a href="/services/dossier-refuse/" class="rep-card">
            <span class="rep-card-icon" aria-hidden="true">🚫</span>
            <h3 class="rep-card-title">Dossier refusé</h3>
            <p class="rep-card-text">Un refus bancaire n'est pas une fin — des solutions alternatives existent.</p>
            <span class="rep-card-cta">En savoir plus →</span>
          </a>
          <a href="/services/nouveaux-arrivants/" class="rep-card">
            <span class="rep-card-icon" aria-hidden="true">🌍</span>
            <h3 class="rep-card-title">Nouveaux arrivants</h3>
            <p class="rep-card-text">Résidence permanente ou permis de travail ? Des prêteurs s'adaptent à votre profil.</p>
            <span class="rep-card-cta">En savoir plus →</span>
          </a>
        </div>
      </div>
    </section>

    <!-- ============ RAPPEL RENOUVELLEMENT ============ -->
    <section class="rep-rappel" aria-label="Rappel de renouvellement">
      <div class="rep-inner">
        <RappelCTA
          titre="Votre hypothèque arrive à échéance ?"
          texte="Le meilleur moment pour magasiner se situe 4 à 6 mois avant la fin de votre terme — avant que votre banque n'envoie son offre de renouvellement. Laissez vos coordonnées : je vous rappelle personnellement au bon moment."
          cta="Être rappelé·e au bon moment"
        />
      </div>
    </section>

    <!-- ============ SECTION 3 — MARCHÉ LOCAL ============ -->
    <section class="rep-market">
      <div class="rep-inner rep-inner--narrow">
        <div class="rep-section-tag">Le marché immobilier</div>
        <h2 class="rep-section-title">Acheter ou refinancer une propriété à Saint-Jean-sur-Richelieu</h2>

        <p>
          Vous cherchez un courtier hypothécaire à Saint-Jean-sur-Richelieu ? Je vous accompagne à
          distance ; voici d'abord ce qu'il faut savoir du marché avant de faire une offre.
          Chef-lieu du Haut-Richelieu, Saint-Jean-sur-Richelieu s'étend des deux côtés de la
          rivière — et chaque secteur a sa propre réalité. Le <strong>Vieux-Saint-Jean</strong>,
          près du centre-ville, concentre maisons anciennes, <strong>plex</strong> et condos ;
          <strong>Iberville</strong>, sur la rive est, offre un tissu résidentiel bien établi ;
          <strong>Saint-Luc</strong> aligne des quartiers d'unifamiliales plus récentes prisés des
          familles ; <strong>L'Acadie</strong> et <strong>Saint-Athanase</strong> gardent un
          caractère plus champêtre, avec de grands terrains. Le long du Richelieu, les
          <strong>propriétés riveraines</strong> demandent une vérification de plus : en
          <strong>zone inondable</strong>, certains prêteurs et assureurs sont plus prudents, et
          l'assurabilité se valide avant de lever ses conditions.
        </p>

        <p>
          L'économie locale a aussi ses particularités. La <strong>Garnison Saint-Jean</strong> et
          le <strong>Collège militaire royal</strong> amènent des militaires qui achètent au rythme
          des <strong>mutations</strong> : calendrier serré, vente ailleurs, parfois un
          <strong>prêt-relais</strong>, et une hypothèque qu'on voudra peut-être transférer à la
          prochaine affectation. Beaucoup de résidents font aussi la navette vers Montréal par
          l'<strong>autoroute 35</strong> et l'<strong>autoroute 10</strong> ; leurs revenus sont
          souvent stables, mais heures supplémentaires, primes et indemnités ne sont pas traitées
          de la même façon d'un prêteur à l'autre. Dans tous les cas, la
          <strong>pré-approbation</strong> reste l'étape numéro un : elle fixe votre budget réel en
          intégrant le <strong>stress test fédéral</strong>, la mise de fonds minimale et, sous
          20 % de mise, la prime SCHL ajoutée au prêt.
        </p>

        <p>
          Je suis basée à Montréal, et j'accompagne mes clients de Saint-Jean-sur-Richelieu
          <strong>à distance</strong> : appels, rencontres en visioconférence, documents et
          signatures en ligne. Le service est le même à Iberville, Saint-Luc et L'Acadie que dans
          les villes voisines — <strong>Chambly, Carignan, Mont-Saint-Grégoire</strong> — et, plus
          près de Montréal, à <a href="/villes/courtier-hypothecaire-longueuil/">Longueuil</a>.
          Quand les taux bougent, je suis le marché en continu pour saisir la bonne fenêtre à
          votre place.
        </p>
        <VillesVoisines actuelle="saint-jean-sur-richelieu" />
      </div>
    </section>

    <!-- ============ SECTEURS ============ -->
    <SecteursVille ville="Saint-Jean-sur-Richelieu" secteurs={secteurs} />

    <!-- ============ SECTION 4 — BANQUE VS COURTIÈRE ============ -->
    <section class="rep-compare">
      <div class="rep-inner">
        <div class="rep-section-tag">Banque vs courtière</div>
        <h2 class="rep-section-title">Ta banque te connaît. <em>Moi, je te défends.</em></h2>

        <div class="rep-compare-cards">
          <div class="rep-compare-card rep-compare-card--bad">
            <div class="rep-compare-card-icon" aria-hidden="true">🏦</div>
            <h3 class="rep-compare-card-title">Avec votre banque</h3>
            <ul class="rep-compare-list">
              <li><span class="rep-x" aria-hidden="true">✕</span> Une seule offre : la leur</li>
              <li><span class="rep-x" aria-hidden="true">✕</span> Le conseiller travaille pour la banque, pas pour vous</li>
              <li><span class="rep-x" aria-hidden="true">✕</span> Heures d'ouverture restrictives</li>
              <li><span class="rep-x" aria-hidden="true">✕</span> Pas de magasinage de taux pour vous</li>
              <li><span class="rep-x" aria-hidden="true">✕</span> Un refus = fin de la discussion</li>
            </ul>
          </div>

          <div class="rep-compare-card rep-compare-card--good">
            <div class="rep-compare-card-icon" aria-hidden="true">🤝</div>
            <h3 class="rep-compare-card-title">Avec {prenom} Weyman</h3>
            <ul class="rep-compare-list">
              <li><span class="rep-check" aria-hidden="true">✓</span> 20+ prêteurs comparés pour vous</li>
              <li><span class="rep-check" aria-hidden="true">✓</span> Je travaille pour <strong>vous,</strong> pas pour un prêteur</li>
              <li><span class="rep-check" aria-hidden="true">✓</span> Dispo soirs et fins de semaine</li>
              <li><span class="rep-check" aria-hidden="true">✓</span> Je négocie les taux et les conditions</li>
              <li><span class="rep-check" aria-hidden="true">✓</span> Un refus bancaire ? J'ai des solutions alternatives</li>
            </ul>
            <p class="rep-compare-bonus">💰 <strong>Service gratuit</strong> — rémunérée par le prêteur, pas par vous.</p>
          </div>
        </div>
      </div>
    </section>

    <!-- ============ SECTION 5 — PROCESSUS ============ -->
    <section class="rep-process">
      <div class="rep-inner">
        <div class="rep-section-tag">Comment ça se passe</div>
        <h2 class="rep-section-title">Trois étapes, zéro stress.</h2>

        <ol class="rep-steps">
          <li class="rep-step">
            <div class="rep-step-num" aria-hidden="true">1</div>
            <h3 class="rep-step-title">Vous remplissez le formulaire</h3>
            <p class="rep-step-text">Deux minutes. Aucun pointage de crédit, aucun engagement.</p>
          </li>
          <li class="rep-step">
            <div class="rep-step-num" aria-hidden="true">2</div>
            <h3 class="rep-step-title">On se parle 15 minutes</h3>
            <p class="rep-step-text">J'analyse votre dossier et je vous explique vos vraies options.</p>
          </li>
          <li class="rep-step">
            <div class="rep-step-num" aria-hidden="true">3</div>
            <h3 class="rep-step-title">Vous recevez vos options</h3>
            <p class="rep-step-text">Vous choisissez celle qui vous convient — sans pression.</p>
          </li>
        </ol>
      </div>
    </section>

    <!-- ============ SECTION 6 — FAQ ============ -->
    <section class="rep-faq">
      <div class="rep-inner rep-inner--narrow">
        <div class="rep-section-tag">FAQ — Saint-Jean-sur-Richelieu</div>
        <h2 class="rep-section-title">Les questions qu'on me pose le plus souvent.</h2>

        <div class="faq-list">
          {faq.map((item, i) => (
            <div class={`faq-item${i === 0 ? ' open' : ''}`} id={`faq-ville-${i}`}>
              <h3>
                <button
                  class="faq-q"
                  id={`faq-question-ville-${i}`}
                  aria-expanded={i === 0 ? 'true' : 'false'}
                  aria-controls={`faq-answer-ville-${i}`}
                >
                  <span class="faq-q-text">{item.q}</span>
                  <span class="faq-icon" aria-hidden="true">
                    <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
                      <line x1="12" y1="5" x2="12" y2="19"/><line x1="5" y1="12" x2="19" y2="12"/>
                    </svg>
                  </span>
                </button>
              </h3>
              <div
                class="faq-a"
                role="region"
                id={`faq-answer-ville-${i}`}
                aria-labelledby={`faq-question-ville-${i}`}
                aria-hidden={i === 0 ? 'false' : 'true'}
              >
                <div class="faq-a-inner" set:html={item.a} />
              </div>
            </div>
          ))}
        </div>
      </div>
    </section>

    <!-- ============ SECTION 8 — CTA FINAL + FORMULAIRE ============ -->
    <section class="rep-final-cta">
      <div class="rep-inner">
        <div class="rep-final-header">
