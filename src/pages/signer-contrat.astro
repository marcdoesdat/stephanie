---
// Signature à distance du contrat de courtage — /signer-contrat?d=<dossier>&j=<jeton>.
//
// Rendu à l'exécution : la page doit ouvrir le dossier avec le jeton pour afficher le
// contrat **en lecture seule**. C'est le cœur de la conformité — on ne demande à personne
// de signer un document qu'il n'a pas lu. L'emprunteur ne peut rien modifier ; s'il n'est
// pas d'accord, il le signale et le dossier est gelé.
export const prerender = false;

import { Image } from 'astro:assets';
import stephaniePhoto from '../assets/stephanie.webp';
import MainLayout from '../layouts/MainLayout.astro';
import SignaturePad from '../components/SignaturePad.astro';
import { loadSiteConfig } from '../config';
import { ouvrirParJeton } from '../services/contratDossierService';
import { TEXTE_ATTESTATION, nomComplet, resumerContrat } from '../utils/contratCourtage';

const config = loadSiteConfig();
const prenomCourtiere = config.nom.split(' ')[0];

const dossierId = Astro.url.searchParams.get('d');
const jeton = Astro.url.searchParams.get('j');
const ouvert = await ouvrirParJeton(dossierId, jeton);

const entree = ouvert ? ouvert.dossier.emprunteurs[ouvert.index] : null;
const lignes = ouvert ? resumerContrat(ouvert.dossier.donnees) : [];
// La dernière correction de la courtière, s'il y en a eu une : celui qui a lu (ou signé)
// l'ancien texte doit voir ce qui a changé, plutôt que de tout relire pour le deviner.
const derniereCorrection = ouvert?.dossier.corrections?.at(-1) ?? null;
const dejaSignes = ouvert
  ? ouvert.dossier.emprunteurs.filter((e) => e.signature !== null).map((e) => nomComplet(e.emprunteur))
  : [];
// Pour la frise de l'écran de fin : qui signe, dans quel ordre, qui l'a déjà fait. Rien de
// plus que ce que le récapitulatif montre déjà — des noms, jamais un courriel ni un tracé.
const signatairesFrise = ouvert
  ? ouvert.dossier.emprunteurs.map((e) => ({ nom: nomComplet(e.emprunteur), signe: e.signature !== null }))
  : [];
const telephoneLien = `tel:+1${config.telephone.replace(/\D/g, '')}`;

// Un lien de signature ne doit jamais être mis en cache par un intermédiaire.
Astro.response.headers.set('Cache-Control', 'no-store');
---

<MainLayout
  title="Signer le contrat de courtage"
  description="Signature du contrat de courtage hypothécaire."
  noindex={true}
  sansBarreCta={true}
  sansConsentement={true}
>
  <main id="main-content" class="signer-page">
    <section class="signer-shell">
      <div class="contact-form quiz">
        <div class="quiz-trust">
          <Image
            src={stephaniePhoto}
            alt={`${config.nom}, ${config.titre}`}
            width={56}
            height={56}
            class="quiz-trust-photo"
            loading="eager"
          />
          <div>
            <p class="quiz-trust-nom">{config.nom}</p>
            {/* Le numéro de permis ne se coupe pas : « AMF » seul en fin de ligne et
                le numéro sur la suivante se lisaient comme deux choses. */}
            <p class="quiz-trust-titre">
              {config.titre} — <span class="sc-insecable">AMF {config.amf}</span>
            </p>
          </div>
        </div>

        {
          !ouvert || !entree ? (
            <div class="sc-etat">
              <h1 class="sc-titre">Ce lien n’est plus valide</h1>
              <p class="sc-texte">
                Il a peut-être déjà servi — un lien de signature ne fonctionne qu’une fois —
                ou le contrat a expiré, ou un autre emprunteur a signalé un désaccord.
              </p>
              <p class="sc-texte">
                Écrivez-lui ou appelez-la : {prenomCourtiere} vous en renverra un.
              </p>
              {/* Même impasse que l'écran de fin : sans Nav ni pied de page, il n'y avait
                  aucune sortie depuis ici. */}
              <div class="sc-fin">
                <div class="sc-contacts">
                  <a class="sc-contact" href={telephoneLien}>
                    Appeler {prenomCourtiere}
                    <span class="sc-contact-valeur">{config.telephone}</span>
                  </a>
                  <a class="sc-contact" href={`mailto:${config.courriel}`}>
                    Écrire à {prenomCourtiere}
                    <span class="sc-contact-valeur">{config.courriel}</span>
                  </a>
                </div>
                <p class="sc-note sc-site">
                  <a href="/">Visiter le site de {prenomCourtiere} →</a>
                </p>
              </div>
            </div>
          ) : (
            <div
              id="sc-app"
              data-dossier={dossierId}
              data-jeton={jeton}
              data-nom={nomComplet(entree.emprunteur)}
              data-prenom-courtiere={prenomCourtiere}
              data-courriel-signataire={entree.emprunteur.courriel}
              data-courriel-courtiere={config.courriel}
              data-index={ouvert.index}
              data-signataires={JSON.stringify(signatairesFrise)}
            >
              <div data-ecran="lecture">
                <h1 class="sc-titre">Votre contrat de courtage</h1>
                <p class="sc-texte">
                  Bonjour {entree.emprunteur.prenom}, {prenomCourtiere} a préparé votre contrat
                  de courtage hypothécaire. Relisez-le en entier, puis signez au bas de la page.
                </p>

                {derniereCorrection && (
                  <div class="sc-note sc-correction">
                    <p>
                      {prenomCourtiere} a corrigé ce contrat. Les signatures données sur
                      l’ancien texte ont été écartées. Ce qui a changé :
                    </p>
                    <ul>
                      {derniereCorrection.changements.map((changement) => (
                        <li>{changement}</li>
                      ))}
                    </ul>
                  </div>
                )}

                {dejaSignes.length > 0 && (
                  <p class="sc-note">Déjà signé par : {dejaSignes.join(', ')}.</p>
                )}

                <h2 class="sc-sous-titre">Ce que vous vous apprêtez à signer</h2>
                {/* Une erreur se repère ici, en haut : c'est donc ici qu'elle se corrige. Tant
                    que les champs vivaient au bas de la page, sous le contrat intégral, il
                    fallait tout faire défiler pour réparer une lettre de son nom. Chaque ligne
                    est son propre <dl> pour que le panneau puisse s'insérer entre deux. */}
                <div class="sc-recap">
                  {lignes.map(([libelle, valeur], i) => (
                    i === ouvert.index ? (
                      <>
                        <dl class="sc-recap-ligne sc-recap-moi">
                          <dt>{libelle} <span class="sc-moi">(vous)</span></dt>
                          <dd>
                            <span data-recap-moi>{valeur}</span>
                            <span class="sc-modifie" data-recap-modifie hidden>modifié</span>
                            <button
                              type="button"
                              class="sc-modifier"
                              data-modifier
                              aria-expanded="false"
                              aria-controls="sc-edition"
                            >
                              Modifier
                            </button>
                          </dd>
                        </dl>

                        <div class="sc-edition" id="sc-edition" data-edition hidden>
                          <div class="sc-coordonnees">
                            <div>
                              <label class="cform-label" for="sc-prenom">Votre prénom</label>
                              <input
                                type="text"
                                id="sc-prenom"
                                class="cform-input"
                                maxlength="60"
                                autocomplete="given-name"
                                required
                                value={entree.emprunteur.prenom}
                              />
                            </div>
                            <div>
                              <label class="cform-label" for="sc-nom">Votre nom de famille</label>
                              <input
                                type="text"
                                id="sc-nom"
                                class="cform-input"
                                maxlength="60"
                                autocomplete="family-name"
                                required
                                value={entree.emprunteur.nom}
                              />
                            </div>
                            <div>
                              <label class="cform-label" for="sc-courriel">Votre courriel</label>
                              <input
                                type="email"
                                id="sc-courriel"
                                class="cform-input"
                                maxlength="120"
                                autocomplete="email"
                                required
                                value={entree.emprunteur.courriel}
                              />
                            </div>
                            <div>
                              <label class="cform-label" for="sc-telephone">Votre téléphone</label>
                              <input
                                type="tel"
                                id="sc-telephone"
                                class="cform-input"
                                maxlength="40"
                                value={entree.emprunteur.telephone}
                              />
                            </div>
                            <div class="sc-coordonnees-large">
                              <label class="cform-label" for="sc-adresse">Votre adresse</label>
                              <input
                                type="text"
                                id="sc-adresse"
                                class="cform-input"
                                maxlength="160"
                                value={entree.emprunteur.adresse}
                              />
                            </div>
                            <p class="sc-precision">
                              C’est ce qui figurera sur le contrat, et c’est à cette adresse
                              courriel que vous le recevrez. Le document plus bas se met à jour
                              dès que vous enregistrez.
                            </p>
                          </div>
                          <p class="sc-erreur" data-erreur-edition hidden></p>
                          <button type="button" class="btn btn-primary sc-bouton-petit" data-edition-ok>
                            Enregistrer
                          </button>
                        </div>
                      </>
                    ) : (
                      <dl class="sc-recap-ligne">
                        <dt>{libelle}</dt>
                        <dd>{valeur}</dd>
                      </dl>
                    )
                  ))}
                </div>
                <p class="sc-note">
                  Une erreur ailleurs — montant, taux, adresse du projet ? Seule {prenomCourtiere}
                  peut la corriger :
                  {' '}<button type="button" class="sc-refus-lien" data-vers-refus>signalez-la-lui</button>,
                  rien ne sera signé.
                </p>

                <h2 class="sc-sous-titre">Le contrat au complet</h2>
                <p class="sc-texte">
                  Voici le document intégral — les 4 pages du contrat officiel d’Hypotheca, rempli
                  par {prenomCourtiere}. Prenez le temps de le lire ; si une clause vous préoccupe,
                  ne signez pas et utilisez « Je ne suis pas d’accord » plus bas.
                  {prenomCourtiere} le signera à son tour une fois que tous les emprunteurs auront
                  signé.
                </p>

                {/* Sur téléphone, le cadre n'affiche souvent qu'une page, voire rien : le bouton
                    d'ouverture passe alors avant lui, là où l'œil arrive. Le même lien reste
                    sous le cadre sur ordinateur. */}
                <a
                  href={`/api/contrat-apercu?d=${encodeURIComponent(dossierId ?? '')}&j=${encodeURIComponent(jeton ?? '')}`}
                  target="_blank"
                  data-ouvrir-document
                  rel="noopener"
                  class="sc-ouvrir-document"
                >
                  <span class="sc-ouvrir-icone" aria-hidden="true">📄</span>
                  <span class="sc-ouvrir-texte">
                    <strong>Lire le contrat au complet</strong>
                    <span class="sc-ouvrir-detail">4 pages — s’ouvre en plein écran</span>
                  </span>
                  <span class="sc-ouvrir-fleche" aria-hidden="true">→</span>
                </a>

                <div class="sc-document">
                  <iframe
                    data-document
                    src={`/api/contrat-apercu?d=${encodeURIComponent(dossierId ?? '')}&j=${encodeURIComponent(jeton ?? '')}`}
                    title="Contrat de courtage hypothécaire — document complet"
                    loading="eager"
                  ></iframe>
                </div>

                {/* Une fois les coordonnées corrigées, « plein écran » doit montrer la version
                    corrigée : le contrat est alors posté vers un nouvel onglet — jamais mis
                    dans l'adresse, où un nom et une adresse resteraient dans l'historique. */}
                <form method="post" action="/api/contrat-apercu" target="_blank" data-form-document hidden>
                  <input type="hidden" name="d" value={dossierId ?? ''} />
                  <input type="hidden" name="j" value={jeton ?? ''} />
                  <input type="hidden" name="coordonnees" value="" />
                </form>

                {/* Les navigateurs mobiles affichent mal un PDF encadré : le lien direct est
                    le seul moyen fiable de lire le contrat sur téléphone. */}
                <p class="sc-texte sc-ouvrir-bureau">
                  <a
                    href={`/api/contrat-apercu?d=${encodeURIComponent(dossierId ?? '')}&j=${encodeURIComponent(jeton ?? '')}`}
                    target="_blank"
                    data-ouvrir-document
                    rel="noopener"
                    class="sc-lien-document"
                  >
                    Ouvrir le contrat en plein écran (PDF)
                  </a>
                </p>

                <h2 class="sc-sous-titre">Deux questions</h2>
                <p class="sc-texte">
                  Ces réponses vous appartiennent — {prenomCourtiere} ne peut pas y répondre à
                  votre place. Elles seront inscrites sur le contrat.
                </p>

                <fieldset class="sc-questions">
                  <legend>
                    Occupez-vous, ou avez-vous occupé, une fonction politiquement vulnérable ?
                  </legend>
                  <p class="sc-precision">
                    Une fonction publique importante — au fédéral, au provincial, dans une
                    municipalité, dans un État étranger ou une organisation internationale —
                    au cours des cinq dernières années. Ou être le conjoint, l’enfant, le parent,
                    le frère ou la sœur d’une telle personne. Dans le doute, répondez « Oui » :
                    {prenomCourtiere} vous remettra le formulaire prévu.
                  </p>
                  <label class="sc-choix">
                    <input type="radio" name="sc-ppv" value="non" checked />
                    <span>Non</span>
                  </label>
                  <label class="sc-choix">
                    <input type="radio" name="sc-ppv" value="oui" />
                    <span>Oui</span>
                  </label>
                </fieldset>

                <fieldset class="sc-questions">
                  <legend>
                    Si {prenomCourtiere} changeait de cabinet, acceptez-vous que votre dossier
                    la suive ?
                  </legend>
                  <p class="sc-precision">
                    Vos renseignements seraient alors communiqués à son nouveau cabinet, pour
                    qu’elle puisse continuer à vous servir.
                  </p>
                  <label class="sc-choix">
                    <input type="radio" name="sc-transfert" value="oui" checked />
                    <span>Oui</span>
                  </label>
                  <label class="sc-choix">
                    <input type="radio" name="sc-transfert" value="non" />
                    <span>Non</span>
                  </label>
                </fieldset>

                <label class="sc-attestation">
                  <input type="checkbox" data-attestation />
                  <span>{TEXTE_ATTESTATION}</span>
                </label>

                <SignaturePad id="sc-signature" nom={nomComplet(entree.emprunteur)} />

                <p class="sc-erreur" data-erreur hidden></p>

                <div class="sc-actions">
                  <button type="button" class="btn btn-primary" data-signer>
                    Signer le contrat
                  </button>
                  <button type="button" class="sc-refus-lien" data-vers-refus>
                    Je ne suis pas d’accord
                  </button>
                </div>
              </div>

              <div data-ecran="refus" hidden>
                <h1 class="sc-titre">Qu’est-ce qui ne va pas ?</h1>
                <p class="sc-texte">
                  Rien ne sera signé. {prenomCourtiere} sera prévenue, corrigera le contrat et
                  vous en renverra un. Dites-lui en deux mots ce qui cloche — c’est facultatif.
                </p>
                <label class="cform-label" for="sc-motif">Ce qui ne correspond pas</label>
                <textarea
                  id="sc-motif"
                  class="cform-input"
                  rows="4"
                  maxlength="500"
                  placeholder="Par exemple : le montant du prêt n’est pas celui dont nous avions parlé."
                ></textarea>
                <p class="sc-erreur" data-erreur-refus hidden></p>
                <div class="sc-actions">
                  <button type="button" class="btn btn-primary" data-envoyer-refus>
                    Envoyer à {prenomCourtiere}
                  </button>
                  <button type="button" class="sc-refus-lien" data-retour>Revenir au contrat</button>
                </div>
              </div>

              {/* Fin de parcours. Sans Nav ni pied de page, cet écran était un cul-de-sac :
                  il disait merci et ne menait nulle part. Il porte maintenant ce qui suit,
                  de quoi joindre la courtière, et la sortie vers le site. */}
              <div data-ecran="merci" hidden>
                {/* Le crochet sur la ligne du titre : seul sur la sienne, il coûtait une
                    ligne d'écran de téléphone pour ne rien dire de plus que le titre. */}
                <div class="sc-entete-fin">
                  <p class="sc-marque" data-merci-marque aria-hidden="true">✓</p>
                  <h1 class="sc-titre" data-merci-titre>Merci, c’est signé</h1>
                </div>
                <p class="sc-texte" data-merci-texte></p>
                <p class="sc-texte" data-merci-suivant hidden></p>

                {/* La frise dit où en est le contrat ; la liste simple sert au désaccord,
                    où il n'y a pas de séquence à montrer. */}
                <ol class="sc-frise" data-merci-frise hidden></ol>
                <ol class="sc-suite" data-merci-suite hidden></ol>

                {/* Masqué pendant le relais en présentiel : l'appareil appartient alors à la
                    courtière, et rien ne doit inviter à s'en aller visiter le site. */}
                {/* Deux vrais boutons au pouce plutôt qu'une phrase à deux liens ; la visite
                    du site, geste le moins utile ici, passe en dernier et en simple lien. */}
                <div class="sc-fin" data-merci-fin>
                  <p class="sc-fin-titre">Une question ?</p>
                  <div class="sc-contacts">
                    <a class="sc-contact" href={telephoneLien}>
                      Appeler {prenomCourtiere}
                      <span class="sc-contact-valeur">{config.telephone}</span>
                    </a>
                    <a class="sc-contact" href={`mailto:${config.courriel}`}>
                      Écrire à {prenomCourtiere}
                      <span class="sc-contact-valeur">{config.courriel}</span>
                    </a>
                  </div>
                  <p class="sc-note sc-fermer">Vous pouvez fermer cette page.</p>
                  <p class="sc-note sc-site">
                    <a href="/">Visiter le site de {prenomCourtiere} →</a>
                    <span class="sc-site-detail">Taux du jour, calculateurs et prise de rendez-vous.</span>
                  </p>
                </div>
              </div>
            </div>
          )
        }
      </div>
    </section>
  </main>
</MainLayout>

<style>
  .signer-page {
    padding: 2rem 1rem 4rem;
  }

  .signer-shell {
    max-width: 720px;
    margin: 0 auto;
  }

  .sc-titre {
    margin: 0 0 0.6rem;
    font-size: 1.5rem;
  }

  .sc-sous-titre {
    margin: 1.8rem 0 0.6rem;
    font-size: 1.05rem;
  }

  .sc-texte {
    margin: 0 0 0.9rem;
    font-size: 0.95rem;
    line-height: 1.55;
  }

  .sc-note {
    margin: 0 0 1rem;
    font-size: 0.85rem;
    color: var(--muted);
  }

  /* Sans cette règle, les liens du texte gardaient le bleu souligné du navigateur — le seul
     élément de l'écran étranger au site. :global pour ceux que le script écrit. */
  #sc-app :global(a:not([class])),
  .sc-etat a:not([class]) {
    color: var(--clay-dk);
    text-decoration: underline;
    text-decoration-thickness: 1px;
    text-underline-offset: 0.18em;
  }

  #sc-app :global(a:not([class]):hover),
  .sc-etat a:not([class]):hover {
    color: var(--ink);
  }

  .sc-correction {
    padding: 0.7rem 0.85rem;
    border-left: 3px solid var(--clay, #c47a52);
    border-radius: 6px;
    background: #fbf3ea;
    color: var(--ink);
  }

  .sc-correction p {
    margin: 0 0 0.35rem;
  }

  .sc-correction ul {
    margin: 0;
    padding-left: 1.2rem;
  }

  /* Le récapitulatif est la pièce maîtresse : il doit se lire, pas se survoler. */
  .sc-recap {
    margin: 0 0 1.4rem;
    border: 1px solid var(--line, #e3d9cc);
    border-radius: 10px;
    overflow: hidden;
  }

  .sc-recap-ligne {
    margin: 0;
    display: grid;
    grid-template-columns: minmax(0, 1fr) minmax(0, 1.3fr);
    gap: 0.75rem;
    padding: 0.6rem 0.85rem;
    border-bottom: 1px solid var(--line, #e3d9cc);
    font-size: 0.88rem;
  }

  .sc-recap-ligne:last-child {
    border-bottom: 0;
  }

  .sc-recap dt {
    margin: 0;
    color: var(--muted);
  }

  .sc-recap dd {
    margin: 0;
    font-weight: 600;
    overflow-wrap: anywhere;
  }

  /* Sa propre ligne : la seule qu'il peut corriger, donc la seule qui se distingue. */
  .sc-recap-moi {
    background: var(--warm, #fbf4ec);
  }

  .sc-recap-moi dd {
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    gap: 0.35rem 0.6rem;
  }

  .sc-moi {
    font-weight: 400;
    font-size: 0.8rem;
  }

  .sc-modifier {
    margin-left: auto;
    padding: 0.25rem 0.75rem;
    border: 1.5px solid var(--clay, #a85f38);
    border-radius: 999px;
    background: var(--white, #fff);
    color: var(--clay, #a85f38);
    font: inherit;
    font-size: 0.8rem;
    font-weight: 600;
    cursor: pointer;
  }

  .sc-modifier:hover {
    background: var(--clay, #a85f38);
    color: var(--white, #fff);
  }

  .sc-modifier:focus-visible {
    outline: 3px solid var(--clay, #a85f38);
    outline-offset: 2px;
  }

  .sc-modifie {
    padding: 0.05rem 0.45rem;
    border-radius: 999px;
    background: #eaf5ec;
    color: #26603a;
    font-size: 0.72rem;
    font-weight: 600;
  }

  .sc-edition {
    padding: 0.9rem 0.85rem 1rem;
    border-bottom: 1px solid var(--line, #e3d9cc);
    background: var(--warm, #fbf4ec);
  }

  .sc-edition .sc-coordonnees {
    margin-bottom: 0.4rem;
  }

  .sc-edition .sc-erreur {
    margin: 0.4rem 0 0;
  }

  .sc-bouton-petit {
    margin-top: 0.7rem;
  }

  .sc-coordonnees-large {
    grid-column: 1 / -1;
  }

  /* Le contrat lui-même : assez haut pour qu'on lise vraiment, pas une vignette. */
  .sc-document {
    margin: 0 0 1rem;
    border: 1px solid var(--line, #e3d9cc);
    border-radius: 10px;
    overflow: hidden;
    background: #f6f2ec;
  }

  .sc-document iframe {
    display: block;
    width: 100%;
    height: 70vh;
    min-height: 420px;
    border: 0;
  }

  .sc-lien-document {
    font-weight: 600;
  }

  .sc-questions {
    margin: 0 0 1.2rem;
    padding: 0.9rem 1rem 1rem;
    border: 1px solid var(--line, #e3d9cc);
    border-radius: 10px;
  }

  .sc-questions legend {
    padding: 0 0.35rem;
    font-size: 0.92rem;
    font-weight: 700;
  }

  .sc-precision {
    margin: 0 0 0.7rem;
    font-size: 0.82rem;
    line-height: 1.5;
    color: var(--muted);
  }

  .sc-choix {
    display: flex;
    align-items: center;
    gap: 0.7rem;
    padding: 0.7rem 0.9rem;
    margin: 0.3rem 0;
    font-size: 0.95rem;
    line-height: 1.35;
    color: var(--ink);
    border: 1.5px solid var(--border);
    border-radius: var(--radius-sm);
    background: var(--white);
    cursor: pointer;
    transition: background 0.15s, border-color 0.15s;
  }

  .sc-choix:hover {
    background: var(--sand);
  }

  .sc-choix:has(input:checked) {
    background: var(--warm);
    border-color: var(--clay);
  }

  /* Au clavier, c'est le libellé entier qui porte le focus visible, pas la seule pastille. */
  .sc-choix:has(input:focus-visible) {
    outline: 3px solid var(--clay);
    outline-offset: 2px;
  }

  .sc-choix input[type='radio'] {
    flex: 0 0 auto;
    width: 1.1rem;
    height: 1.1rem;
    margin: 0;
    accent-color: var(--clay);
  }

  .sc-coordonnees {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(220px, 1fr));
    gap: 0.75rem 1rem;
    margin: 0 0 1.3rem;
  }

  .sc-coordonnees .sc-precision {
    grid-column: 1 / -1;
    margin: 0;
  }

  .sc-attestation {
    display: flex;
    gap: 0.6rem;
    align-items: flex-start;
    margin: 0 0 1.2rem;
    font-size: 0.9rem;
    line-height: 1.45;
    cursor: pointer;
  }

  .sc-attestation input {
    margin-top: 0.2rem;
    flex: 0 0 auto;
    width: 1.05rem;
    height: 1.05rem;
  }

  .sc-actions {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0.75rem 1.25rem;
    margin-top: 1.4rem;
  }

  .sc-refus-lien {
    background: none;
    border: 0;
    padding: 0.2rem 0;
    font: inherit;
    font-size: 0.85rem;
    color: var(--muted);
    text-decoration: underline;
    cursor: pointer;
  }

  .sc-refus-lien:hover {
    color: var(--ink, #1f1e1c);
  }

  .sc-erreur {
    margin: 1rem 0 0;
    padding: 0.7rem 0.85rem;
    border-radius: 8px;
    background: #fdeceb;
    color: #8f2f28;
    font-size: 0.88rem;
  }

  .sc-etat {
    padding: 0.5rem 0;
  }

  /* ---------- Écran de fin ---------- */

  .sc-entete-fin {
    display: flex;
    align-items: center;
    gap: 0.75rem;
    margin: 0 0 0.6rem;
  }

  .sc-entete-fin .sc-titre {
    margin: 0;
  }

  .sc-marque {
    display: flex;
    flex: 0 0 auto;
    align-items: center;
    justify-content: center;
    width: 2.2rem;
    height: 2.2rem;
    margin: 0;
    border-radius: 50%;
    background: #eaf5ec;
    color: #26603a;
    font-size: 1.3rem;
    line-height: 1;
  }

  /* Un désaccord n'est pas un échec — le message est bien parti — mais ce n'est pas
     davantage une signature. Ni le vert de la réussite, ni le rouge de l'erreur. */
  .sc-marque[data-ton='attention'] {
    background: #fdf2e7;
    color: #8a5320;
  }

  .sc-suite {
    margin: 0 0 1.6rem;
    padding-left: 1.2rem;
    font-size: 0.95rem;
    line-height: 1.55;
    color: var(--muted);
  }

  /* Les étapes sont écrites en JavaScript : sans :global, la règle scopée ne les
     atteindrait pas — Astro n'estampe sa portée que sur ce qu'il rend lui-même. */
  .sc-suite :global(li) {
    margin-bottom: 0.45rem;
    padding-left: 0.2rem;
  }

  /* ---------- Frise : où en est le contrat ----------
     Écrite par le script, d'où les :global. Une pastille par étape, reliées par un trait :
     ce qui est fait en vert, ce qui attend quelqu'un en argile, le reste en creux. */
  .sc-frise {
    list-style: none;
    margin: 1.2rem 0 1.6rem;
    padding: 0;
  }

  .sc-frise :global(li) {
    position: relative;
    display: grid;
    grid-template-columns: 1.6rem 1fr;
    column-gap: 0.75rem;
    padding-bottom: 1.1rem;
  }

  .sc-frise :global(li:last-child) {
    padding-bottom: 0;
  }

  /* Le trait qui relie une pastille à la suivante. */
  .sc-frise :global(li:not(:last-child))::before {
    content: '';
    position: absolute;
    top: 1.6rem;
    bottom: 0;
    left: calc(0.8rem - 1px);
    width: 2px;
    background: var(--border);
  }

  .sc-frise :global(li[data-etat='fait']:not(:last-child))::before {
    background: #b9dcc3;
  }

  .sc-frise :global(.sc-frise-point) {
    display: flex;
    align-items: center;
    justify-content: center;
    width: 1.6rem;
    height: 1.6rem;
    border-radius: 50%;
    border: 2px solid var(--border);
    background: var(--white);
    color: transparent;
    font-size: 0.8rem;
    line-height: 1;
  }

  .sc-frise :global(li[data-etat='fait'] .sc-frise-point) {
    border-color: #26603a;
    background: #26603a;
    color: #fff;
  }

  .sc-frise :global(li[data-etat='courant'] .sc-frise-point) {
    border-color: var(--clay);
    box-shadow: inset 0 0 0 4px var(--white);
    background: var(--clay);
  }

  .sc-frise :global(.sc-frise-texte) {
    margin: 0.15rem 0 0;
    font-size: 0.95rem;
    line-height: 1.45;
    color: var(--muted);
  }

  .sc-frise :global(li[data-etat='fait'] .sc-frise-texte) {
    color: var(--ink);
  }

  .sc-frise :global(li[data-etat='courant'] .sc-frise-texte) {
    color: var(--ink);
    font-weight: 600;
  }

  .sc-frise :global(.sc-frise-badge) {
    display: inline-block;
    margin-left: 0.4rem;
    padding: 0.05rem 0.5rem;
    border-radius: 50px;
    background: #f6e6dc;
    color: var(--clay-dk);
    font-size: 0.72rem;
    font-weight: 600;
    vertical-align: 0.1em;
    white-space: nowrap;
  }

  .sc-frise :global(.sc-frise-detail) {
    grid-column: 2;
    margin: 0.2rem 0 0;
    font-size: 0.85rem;
    color: var(--muted);
  }

  /* L'adresse de réception, lisible d'un coup d'œil : c'est là qu'une faute se repère. */
  .sc-frise :global(.sc-pastille) {
    display: inline-block;
    max-width: 100%;
    margin: 0.35rem 0 0.3rem;
    padding: 0.3rem 0.65rem;
    border: 1px solid var(--border);
    border-radius: 8px;
    background: var(--white);
    color: var(--ink);
    font-size: 0.9rem;
    font-weight: 600;
    overflow-wrap: anywhere;
  }

  .sc-frise :global(.sc-frise-correction) {
    display: block;
    font-size: 0.85rem;
    color: var(--clay-dk);
    text-decoration: underline;
    text-underline-offset: 0.18em;
  }

  .sc-fin {
    margin-top: 1.8rem;
    padding-top: 1.4rem;
    border-top: 1px solid var(--border);
  }

  .sc-fin-titre {
    margin: 0 0 0.7rem;
    font-size: 0.95rem;
    font-weight: 600;
  }

  .sc-contacts {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(200px, 1fr));
    gap: 0.6rem;
    margin: 0 0 1rem;
  }

  .sc-contact {
    display: flex;
    flex-direction: column;
    justify-content: center;
    min-height: 44px;
    padding: 0.7rem 1rem;
    border: 2px solid var(--border);
    border-radius: var(--radius-sm);
    background: var(--white);
    color: var(--ink);
    font-size: 0.95rem;
    font-weight: 600;
    text-decoration: none;
    transition: border-color 0.2s;
  }

  .sc-contact:hover {
    border-color: var(--clay);
  }

  .sc-contact:focus-visible {
    outline: 3px solid var(--clay);
    outline-offset: 2px;
  }

  .sc-contact-valeur {
    margin-top: 0.1rem;
    font-size: 0.82rem;
    font-weight: 400;
    color: var(--muted);
    overflow-wrap: anywhere;
  }

  .sc-fermer {
    margin: 0 0 0.4rem;
  }

  .sc-site {
    margin: 0;
  }

  .sc-site-detail {
    display: block;
    margin-top: 0.15rem;
  }

  /* Un titre de plusieurs lignes dans la bordure d'un fieldset la coupe en deux et
     chevauche le cadre. Flottant, il passe à l'intérieur, comme un titre ordinaire. */
  .sc-questions legend {
    float: left;
    width: 100%;
    margin: 0 0 0.5rem;
    padding: 0;
    line-height: 1.4;
  }

  .sc-questions legend + * {
    clear: both;
  }

  .sc-attestation input {
    accent-color: var(--clay);
  }

  .sc-ouvrir-document {
    display: none;
  }

  .sc-insecable {
    white-space: nowrap;
  }

  /* Un <button> n'hérite pas de la police : `.btn-primary` la laissait au système
     (Arial), au milieu d'une page en DM Sans. */
  .signer-shell :global(button.btn-primary) {
    font-family: inherit;
  }

  @media (max-width: 560px) {
    /* Trois marges s'empilaient (page, section, carte) : 60 px de chaque côté sur un
       écran de 390. Le contenu en regagne près de 70. */
    .signer-page {
      padding: 0.75rem 0.5rem 2rem;
    }

    .signer-shell {
      padding: 0;
    }

    .signer-shell :global(.contact-form.quiz) {
      padding: 1rem;
    }

    .sc-titre {
      font-size: 1.3rem;
      line-height: 1.25;
    }

    .sc-sous-titre {
      line-height: 1.3;
    }

    /* 16 px : sous ce seuil, Safari sur iPhone zoome sur la case touchée. */
    .signer-shell :global(.cform-input),
    .signer-shell :global([data-sig-nom]) {
      font-size: 1rem;
    }

    .sc-recap-ligne {
      grid-template-columns: 1fr;
      gap: 0.15rem;
    }

    .sc-modifier {
      min-height: 40px;
      padding: 0.35rem 1rem;
    }

    .sc-questions {
      padding: 0.85rem 0.8rem 0.9rem;
    }

    /* Le contrat intégral, en carte franche avant le cadre : sur téléphone, c'est par là
       qu'on le lit vraiment. */
    .sc-ouvrir-document {
      display: flex;
      align-items: center;
      gap: 0.8rem;
      margin: 0 0 0.8rem;
      padding: 0.9rem 1rem;
      border: 1.5px solid var(--clay);
      border-radius: 12px;
      background: var(--white);
      color: var(--ink);
      text-decoration: none;
    }

    .sc-ouvrir-icone {
      font-size: 1.4rem;
    }

    .sc-ouvrir-texte {
      display: flex;
      flex: 1;
      flex-direction: column;
      gap: 0.1rem;
    }

    .sc-ouvrir-detail {
      font-size: 0.8rem;
      color: var(--muted);
    }

    .sc-ouvrir-fleche {
      color: var(--clay);
      font-weight: 700;
    }

    .sc-ouvrir-bureau {
      display: none;
    }

    .sc-document iframe {
      height: 60vh;
      min-height: 360px;
    }

    /* L'action principale au pouce, pleine largeur ; le désaccord reste à portée, centré
       dessous, sur une cible de 44 px. */
    .sc-actions {
      flex-direction: column;
      align-items: stretch;
      gap: 0.4rem;
    }

    .sc-actions .btn-primary {
      width: 100%;
      text-align: center;
    }

    .sc-actions .sc-refus-lien {
      min-height: 44px;
    }
  }
</style>

<script>
  import type { SignaturePadElement } from '../scripts/signaturePad';
  import {
    composerFrise,
    lienCorrectionAdresse,
    type EtapeFrise,
    type SignataireFrise,
  } from '../utils/friseSignature';

  const app = document.getElementById('sc-app');
  if (app) {
    const ecran = (nom: string) => app.querySelector<HTMLElement>(`[data-ecran="${nom}"]`);
    const pad = document.getElementById('sc-signature') as SignaturePadElement | null;
    const attestation = app.querySelector<HTMLInputElement>('[data-attestation]');
    const erreur = app.querySelector<HTMLElement>('[data-erreur]');
    const erreurRefus = app.querySelector<HTMLElement>('[data-erreur-refus]');

    const dossier = app.dataset.dossier ?? '';
    const jeton = app.dataset.jeton ?? '';
    const prenomCourtiere = app.dataset.prenomCourtiere ?? 'votre courtière';
    let courrielSignataire = app.dataset.courrielSignataire ?? '';
    let nomSignataire = app.dataset.nom ?? '';
    const courrielCourtiere = app.dataset.courrielCourtiere ?? '';
    const indexSignataire = Number(app.dataset.index ?? '0');
    const signataires = ((): SignataireFrise[] => {
      try {
        const brut: unknown = JSON.parse(app.dataset.signataires ?? '[]');
        return Array.isArray(brut) ? (brut as SignataireFrise[]) : [];
      } catch {
        return [];
      }
    })();
    const valeurChamp = (id: string): string =>
      app.querySelector<HTMLInputElement>(`#${id}`)?.value.trim() ?? '';

    /* ---------- Correction des coordonnées, sur place ---------- */

    const boutonModifier = app.querySelector<HTMLButtonElement>('[data-modifier]');
    const edition = app.querySelector<HTMLElement>('[data-edition]');
    const erreurEdition = app.querySelector<HTMLElement>('[data-erreur-edition]');
    const recapMoi = app.querySelector<HTMLElement>('[data-recap-moi]');
    const recapModifie = app.querySelector<HTMLElement>('[data-recap-modifie]');
    const IDS_COORDONNEES = ['sc-prenom', 'sc-nom', 'sc-courriel', 'sc-telephone', 'sc-adresse'];
    const origine = Object.fromEntries(IDS_COORDONNEES.map((id) => [id, valeurChamp(id)]));

    /** Le message à montrer, ou `null` si l'identité tient — même règle qu'à la signature. */
    function verifierIdentite(): { message: string; champ: string } | null {
      if (valeurChamp('sc-prenom').length < 2) {
        return { message: 'Vérifiez votre prénom : il doit figurer correctement sur le contrat.', champ: 'sc-prenom' };
      }
      if (valeurChamp('sc-nom').length < 2) {
        return { message: 'Vérifiez votre nom : il doit figurer correctement sur le contrat.', champ: 'sc-nom' };
      }
      if (!/^[^\s@]+@(?:[^\s@.]+\.)+[a-z]{2,}$/i.test(valeurChamp('sc-courriel'))) {
        return { message: 'Vérifiez votre courriel : l’adresse saisie ne semble pas valide.', champ: 'sc-courriel' };
      }
      return null;
    }

    /* ---------- Le document suit la correction ---------- */

    const cadreDocument = app.querySelector<HTMLIFrameElement>('[data-document]');
    const formDocument = app.querySelector<HTMLFormElement>('[data-form-document]');
    const srcOrigine = cadreDocument?.getAttribute('src') ?? '';
    let urlDocument: string | null = null;
    let documentCorrige = false;

    function coordonneesSaisies(): Record<string, string> {
      return {
        prenom: valeurChamp('sc-prenom'),
        nom: valeurChamp('sc-nom'),
        courriel: valeurChamp('sc-courriel'),
        telephone: valeurChamp('sc-telephone'),
        adresse: valeurChamp('sc-adresse'),
      };
    }

    /**
     * Recharge le contrat avec la correction posée sur sa ligne — rien n'est enregistré, c'est
     * la signature qui l'inscrit. Sans correction, on revient au document tel qu'il est.
     */
    async function rafraichirDocument(modifie: boolean): Promise<void> {
      documentCorrige = modifie;
      if (!cadreDocument) return;
      if (!modifie) {
        cadreDocument.src = srcOrigine;
      } else {
        try {
          const reponse = await fetch('/api/contrat-apercu', {
            method: 'POST',
            headers: { 'Content-Type': 'application/json' },
            body: JSON.stringify({ d: dossier, j: jeton, coordonnees: coordonneesSaisies() }),
          });
          if (!reponse.ok) return; // le cadre garde la dernière version qu'il a pu montrer
          cadreDocument.src = URL.createObjectURL(await reponse.blob());
        } catch {
          return;
        }
      }
      if (urlDocument) URL.revokeObjectURL(urlDocument);
      urlDocument = cadreDocument.src.startsWith('blob:') ? cadreDocument.src : null;
    }

    for (const lien of app.querySelectorAll<HTMLAnchorElement>('[data-ouvrir-document]')) {
      lien.addEventListener('click', (evenement) => {
        if (!documentCorrige || !formDocument) return;
        evenement.preventDefault();
        const champ = formDocument.querySelector<HTMLInputElement>('input[name="coordonnees"]');
        if (champ) champ.value = JSON.stringify(coordonneesSaisies());
        formDocument.submit();
      });
    }

    function ouvrirEdition(champ = 'sc-prenom'): void {
      if (!edition) return;
      edition.hidden = false;
      boutonModifier?.setAttribute('aria-expanded', 'true');
      if (boutonModifier) boutonModifier.hidden = true;
      edition.scrollIntoView({ behavior: 'smooth', block: 'center' });
      app!.querySelector<HTMLInputElement>(`#${champ}`)?.focus({ preventScroll: true });
    }

    /** Ferme le panneau et réécrit sa ligne du récapitulatif avec ce qu'il vient de saisir. */
    function fermerEdition(): void {
      masquerErreur(erreurEdition);
      const probleme = verifierIdentite();
      if (probleme) {
        montrerErreur(erreurEdition, probleme.message);
        app!.querySelector<HTMLInputElement>(`#${probleme.champ}`)?.focus();
        return;
      }

      const nom = `${valeurChamp('sc-prenom')} ${valeurChamp('sc-nom')}`;
      const telephone = valeurChamp('sc-telephone');
      if (recapMoi) {
        recapMoi.textContent = `${nom} — ${valeurChamp('sc-courriel')}${telephone ? ` — ${telephone}` : ''}`;
      }
      const modifie = !IDS_COORDONNEES.every((id) => valeurChamp(id) === origine[id]);
      if (recapModifie) recapModifie.hidden = !modifie;
      void rafraichirDocument(modifie);

      // Le cadre de signature annonce le nom de celui qui signe : il suit la correction.
      const qui = app!.querySelector<HTMLElement>('[data-sig-qui]');
      if (qui) qui.textContent = `Signature de ${nom}`;

      if (edition) edition.hidden = true;
      if (boutonModifier) {
        boutonModifier.hidden = false;
        boutonModifier.setAttribute('aria-expanded', 'false');
        boutonModifier.focus({ preventScroll: true });
      }
    }

    boutonModifier?.addEventListener('click', () => ouvrirEdition());
    app.querySelector('[data-edition-ok]')?.addEventListener('click', fermerEdition);
    // Entrée dans un champ enregistre, comme dans un formulaire — sans rien soumettre.
    edition?.addEventListener('keydown', (evenement) => {
      if (evenement.key === 'Enter' && evenement.target instanceof HTMLInputElement) {
        evenement.preventDefault();
        fermerEdition();
      }
    });

    /**
     * Compose l'écran de fin. Les étapes doivent rester vraies de ce que le système fait
     * vraiment : le seul courriel qu'un emprunteur reçoit après avoir signé est celui du
     * contrat complet, une fois la courtière passée. Promettre un accusé immédiat ferait
     * attendre pour rien — et douter du reste.
     */
    function composerFin(options: {
      titre: string;
      texte: string;
      etapes?: string[];
      frise?: EtapeFrise[];
      ton?: 'succes' | 'attention';
    }): void {
      const titre = app!.querySelector<HTMLElement>('[data-merci-titre]');
      const texte = app!.querySelector<HTMLElement>('[data-merci-texte]');
      const suite = app!.querySelector<HTMLElement>('[data-merci-suite]');
      const frise = app!.querySelector<HTMLElement>('[data-merci-frise]');
      const marque = app!.querySelector<HTMLElement>('[data-merci-marque]');

      if (titre) titre.textContent = options.titre;
      if (texte) texte.textContent = options.texte;
      if (marque) {
        if (options.ton === 'attention') marque.dataset.ton = 'attention';
        else delete marque.dataset.ton;
      }

      if (suite) {
        suite.innerHTML = '';
        const etapes = options.etapes ?? [];
        for (const etape of etapes) {
          const li = document.createElement('li');
          li.textContent = etape;
          suite.append(li);
        }
        suite.hidden = etapes.length === 0;
      }

      if (frise) {
        frise.innerHTML = '';
        const etapes = options.frise ?? [];
        for (const etape of etapes) frise.append(etapeFrise(etape));
        frise.hidden = etapes.length === 0;
      }
    }

    /** Une étape de la frise. `textContent` partout : les noms viennent du dossier. */
    function etapeFrise(etape: EtapeFrise): HTMLLIElement {
      const li = document.createElement('li');
      li.dataset.etat = etape.etat;
      if (etape.etat === 'courant') li.setAttribute('aria-current', 'step');

      const point = document.createElement('span');
      point.className = 'sc-frise-point';
      point.setAttribute('aria-hidden', 'true');
      if (etape.etat === 'fait') point.textContent = '✓';

      const texte = document.createElement('p');
      texte.className = 'sc-frise-texte';
      texte.textContent = etape.texte;
      if (etape.etat === 'courant') {
        const badge = document.createElement('span');
        badge.className = 'sc-frise-badge';
        badge.textContent = 'prochaine étape';
        texte.append(badge);
      }
      li.append(point, texte);

      if (etape.detail) {
        const detail = document.createElement('p');
        detail.className = 'sc-frise-detail';
        detail.textContent = etape.detail;
        li.append(detail);
      }

      // L'adresse de réception, et de quoi la corriger d'un geste — « prévenez-la » ne
      // donnait pas le moyen de le faire.
      if (etape.reception && courrielSignataire) {
        const detail = document.createElement('div');
        detail.className = 'sc-frise-detail';
        const pastille = document.createElement('span');
        pastille.className = 'sc-pastille';
        pastille.textContent = courrielSignataire;
        detail.append(pastille);
        if (courrielCourtiere) {
          const correction = document.createElement('a');
          correction.className = 'sc-frise-correction';
          correction.href = lienCorrectionAdresse({
            courrielCourtiere,
            prenomCourtiere,
            nom: nomSignataire,
            courriel: courrielSignataire,
          });
          correction.textContent = 'Ce n’est pas la bonne adresse ?';
          detail.append(correction);
        }
        li.append(detail);
      }
      return li;
    }

    /** Où en est le contrat, à partir de ce que la page savait au chargement. */
    function friseApresSignature(signeLe: unknown): EtapeFrise[] {
      return composerFrise({
        signataires,
        index: indexSignataire,
        prenomCourtiere,
        signeLe: typeof signeLe === 'string' ? signeLe : null,
      });
    }

    function afficher(nom: string): void {
      for (const cle of ['lecture', 'refus', 'merci']) {
        const bloc = ecran(cle);
        if (bloc) bloc.hidden = cle !== nom;
      }
      window.scrollTo({ top: 0, behavior: 'smooth' });
    }

    function montrerErreur(cible: HTMLElement | null, message: string): void {
      if (!cible) return;
      cible.textContent = message;
      cible.hidden = false;
    }

    function masquerErreur(cible: HTMLElement | null): void {
      if (cible) cible.hidden = true;
    }

    async function envoyer(corps: Record<string, unknown>): Promise<{ ok: boolean; data: Record<string, unknown> }> {
      const reponse = await fetch('/api/contrat-signer', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({ d: dossier, j: jeton, ...corps }),
      });
      const data = (await reponse.json().catch(() => ({}))) as Record<string, unknown>;
      return { ok: reponse.ok, data };
    }

    /* ---------- Signature ---------- */

    const boutonSigner = app.querySelector<HTMLButtonElement>('[data-signer]');
    boutonSigner?.addEventListener('click', async () => {
      masquerErreur(erreur);

      if (!attestation?.checked) {
        montrerErreur(erreur, 'Cochez la case de confirmation avant de signer.');
        return;
      }
      if (!pad?.estRempli()) {
        montrerErreur(erreur, 'Signez dans le cadre — ou utilisez « signer en tapant mon nom ».');
        return;
      }

      const identite = {
        prenom: valeurChamp('sc-prenom'),
        nom: valeurChamp('sc-nom'),
        courriel: valeurChamp('sc-courriel'),
      };
      // Les champs vivent en haut, dans le récapitulatif : on y ramène plutôt que de
      // laisser un message au bas de la page désigner un champ qu'on ne voit pas.
      const probleme = verifierIdentite();
      if (probleme) {
        montrerErreur(erreur, `${probleme.message} Corrigez-le dans le récapitulatif, en haut.`);
        ouvrirEdition(probleme.champ);
        montrerErreur(erreurEdition, probleme.message);
        return;
      }

      boutonSigner.disabled = true;
      const libelleOrigine = boutonSigner.textContent;
      boutonSigner.textContent = 'Envoi…';

      try {
        const choix = (nom: string): string =>
          app!.querySelector<HTMLInputElement>(`input[name="${nom}"]:checked`)?.value ?? '';

        const { ok, data } = await envoyer({
          action: 'signature',
          attestation: true,
          signature: pad.versPng(),
          identite,
          reponses: {
            ppv: choix('sc-ppv'),
            transfertCabinet: choix('sc-transfert'),
            telephone: app.querySelector<HTMLInputElement>('#sc-telephone')?.value ?? '',
            adresse: app.querySelector<HTMLInputElement>('#sc-adresse')?.value ?? '',
          },
        });

        if (!ok) {
          montrerErreur(erreur, String(data.error ?? 'L’envoi a échoué. Réessayez.'));
          boutonSigner.disabled = false;
          boutonSigner.textContent = libelleOrigine;
          return;
        }

        courrielSignataire = identite.courriel.toLowerCase();
        nomSignataire = `${identite.prenom} ${identite.nom}`.trim() || nomSignataire;
        const suivant = app.querySelector<HTMLElement>('[data-merci-suivant]');
        const nomSuivant = String(data.suivant ?? 'le signataire suivant');

        if (data.complet) {
          composerFin({
            titre: 'Merci, votre signature est enregistrée',
            texte: `Tous les emprunteurs ont signé. Il ne manque plus que ${prenomCourtiere}.`,
            frise: friseApresSignature(data.signeLe),
          });
        } else {
          composerFin({
            titre: 'Merci, votre signature est enregistrée',
            texte: `Le contrat passe maintenant à ${nomSuivant}, qui recevra son lien par courriel.`,
            frise: friseApresSignature(data.signeLe),
          });
        }

        // En présentiel seulement, le serveur renvoie le lien du suivant : on affiche le
        // relais pour que la courtière tende l'appareil, sans repasser par un courriel.
        if (!data.complet && typeof data.lien === 'string' && suivant) {
          composerFin({
            titre: 'Merci, votre signature est enregistrée',
            texte: 'Remettez l’appareil au signataire suivant.',
          });
          suivant.innerHTML = '';
          const bouton = document.createElement('a');
          bouton.href = data.lien;
          bouton.className = 'btn btn-primary';
          bouton.textContent = `Passer à ${nomSuivant} →`;
          suivant.append(bouton);
          suivant.hidden = false;

          // L'appareil n'est pas le sien : ni coordonnées, ni sortie vers le site.
          const fin = app.querySelector<HTMLElement>('[data-merci-fin]');
          if (fin) fin.hidden = true;
        }

        afficher('merci');
      } catch {
        montrerErreur(erreur, 'Connexion impossible. Vérifiez votre réseau et réessayez.');
        boutonSigner.disabled = false;
        boutonSigner.textContent = libelleOrigine;
      }
    });

    /* ---------- Désaccord ---------- */

    // Deux portes : la note sous le récapitulatif et le lien au bas du contrat.
    for (const lien of app.querySelectorAll('[data-vers-refus]')) {
      lien.addEventListener('click', () => afficher('refus'));
    }
    app.querySelector('[data-retour]')?.addEventListener('click', () => afficher('lecture'));

    const boutonRefus = app.querySelector<HTMLButtonElement>('[data-envoyer-refus]');
    boutonRefus?.addEventListener('click', async () => {
      masquerErreur(erreurRefus);
      boutonRefus.disabled = true;
      const libelleOrigine = boutonRefus.textContent;
      boutonRefus.textContent = 'Envoi…';

      const motif = app.querySelector<HTMLTextAreaElement>('#sc-motif')?.value ?? '';

      try {
        const { ok, data } = await envoyer({ action: 'refus', motif });
        if (!ok) {
          montrerErreur(erreurRefus, String(data.error ?? 'L’envoi a échoué. Réessayez.'));
          boutonRefus.disabled = false;
          boutonRefus.textContent = libelleOrigine;
          return;
        }
        composerFin({
          titre: 'C’est noté, rien n’a été signé',
          texte: `${prenomCourtiere} a été prévenue à l’instant. Aucun contrat ne sera produit d’ici là.`,
          etapes: [
            `${prenomCourtiere} vous rappelle pour comprendre ce qui ne va pas.`,
            'Elle corrige le contrat et vous en envoie un nouveau à signer.',
          ],
          ton: 'attention',
        });
        afficher('merci');
      } catch {
        montrerErreur(erreurRefus, 'Connexion impossible. Vérifiez votre réseau et réessayez.');
        boutonRefus.disabled = false;
        boutonRefus.textContent = libelleOrigine;
      }
    });
  }
</script>
