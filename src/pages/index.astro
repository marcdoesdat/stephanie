---
import MainLayout from '../layouts/MainLayout.astro';
import Nav from '../components/Nav.astro';
import Hero from '../components/Hero.astro';
import About from '../components/About.astro';
import Services from '../components/Services.astro';
import TauxSection from '../components/TauxSection.astro';
import RappelCTA from '../components/RappelCTA.astro';
import Faq from '../components/Faq.astro';
import Testimonials from '../components/Testimonials.astro';
import Contact from '../components/Contact.astro';
import Footer from '../components/Footer.astro';
import MessengerBtn from '../components/MessengerBtn.astro';
import CapaciteExpress from '../components/CapaciteExpress.astro';
import { fetchHypothecaRates, rateCacheControl } from '../services/ratesService';
import { getReviews } from '../services/reviewsService';
import { loadSiteConfig } from '../config';
import { Calculator, ClipboardList, Receipt, RefreshCw, Scale } from '@lucide/astro';

// SSR obligatoire : les taux sont récupérés à chaque requête. Sans cette ligne,
// Astro prérend la page au build et fige les taux du jour du déploiement
// (ou « taux indisponibles » si le scraping échoue pendant le build).
export const prerender = false;

const config = loadSiteConfig();

const hypothecaRates = await fetchHypothecaRates();
const hypothecaVariable = hypothecaRates?.variable ?? null;

const googleReviews = await getReviews();

// CDN cache: serve cached HTML for 6 h, revalidate in background for 1 h after expiry.
// Durée réduite quand les taux manquent, pour ne pas figer la page dégradée.
Astro.response.headers.set('Cache-Control', rateCacheControl(hypothecaRates));

// Sous le calculateur express : les cinq autres outils de /outils (le simulateur complet
// est déjà proposé par « Affiner » dans le calculateur).
const autresOutils = [
  { href: '/outils#calculateur', titre: 'Calculateur de versement', sous: 'Vos mensualités selon le taux et l’amortissement', Icone: Calculator },
  { href: '/outils#comparateur', titre: 'Comparateur de taux', sous: 'Banque ou courtier : l’écart en dollars', Icone: Scale },
  { href: '/outils#penalite', titre: 'Calculateur de pénalité', sous: 'IRD ou 3 mois d’intérêts', Icone: ClipboardList },
  { href: '/outils#refinancement', titre: 'Simulateur de refinancement', sous: 'Consolider ses dettes, dégager de l’équité', Icone: RefreshCw },
  { href: '/outils#droits-mutation', titre: 'Droits de mutation', sous: 'La taxe de bienvenue, calculée d’avance', Icone: Receipt },
];

---

<MainLayout
  fullTitle="Courtière hypothécaire Repentigny & Rive-Nord | Stéphanie Weyman"
  description="Pré-approbation hypothécaire à Repentigny, dans Lanaudière et sur la Rive-Nord. Achat, renouvellement, refinancement, travailleurs autonomes. Réponse rapide – Stéphanie Weyman, AMF."
>
  <!-- JSON-LD : AggregateRating (émis seulement si les avis sont live/cache, pas fallback) -->
  {googleReviews.source !== 'fallback' && (
    <Fragment slot="head">
      <script type="application/ld+json" is:inline set:html={JSON.stringify({
        '@context': 'https://schema.org',
        '@type': 'FinancialService',
        '@id': `${config.site_url}#business`,
        'name': `${config.nom} — ${config.titre}`,
        'telephone': '+1' + config.telephone.replace(/\D/g, '').replace(/^1/, ''),
        'email': config.courriel,
        'url': config.site_url,
        'areaServed': config.region,
        'aggregateRating': {
          '@type': 'AggregateRating',
          'ratingValue': googleReviews.rating,
          'reviewCount': googleReviews.totalReviews,
          'bestRating': '5',
          'worstRating': '1'
        }
      })} />
    </Fragment>
  )}

  <MessengerBtn />
  <Nav />
  <main id="main-content">
    <!-- Ordre de l'accueil : la promesse, puis ce qui donne quelque chose avant de demander
         (le calculateur, que le 2e bouton du hero vise), puis « est-ce pour moi » (services),
         le renouvellement d'un seul tenant (taux + rappel), la preuve juste avant la
         demande de contact (à propos + avis), et enfin FAQ et contact. -->
    <Hero baseRate={hypothecaVariable} reviews={googleReviews} />

    <section id="outils-teaser" aria-labelledby="outils-teaser-titre">
      <div class="section-inner">
        <div class="fade-up">
          <h2 class="section-title" id="outils-teaser-titre">Combien pouvez-vous<br /><em>emprunter ?</em></h2>
          <p class="section-sub">
            Trois chiffres suffisent pour une première estimation, calculée comme le ferait un
            prêteur, test de résistance compris.
          </p>
          <p class="outils-trust">Sans inscription · Résultat instantané</p>
        </div>

        <CapaciteExpress taux={hypothecaRates?.fixe_5ans ?? null} />

        <nav class="outils-autres fade-up" aria-labelledby="outils-autres-titre">
          <div class="outils-autres-tete">
            <h3 id="outils-autres-titre">Allez plus loin avec mes autres outils</h3>
            <a href="/outils" class="outils-autres-tous">Voir tous les outils →</a>
          </div>
          <ul>
            {autresOutils.map(({ href, titre, sous, Icone }) => (
              <li>
                <a href={href}>
                  <span class="outils-autres-icone" aria-hidden="true"><Icone size={20} stroke-width={1.8} /></span>
                  <span class="outils-autres-texte">
                    <strong>{titre}</strong>
                    <span>{sous}</span>
                  </span>
                </a>
              </li>
            ))}
          </ul>
        </nav>
      </div>
    </section>

    <Services />

    <TauxSection hypothecaRates={hypothecaRates} />

    <!-- Capture basse-friction des renouvellements : juste sous les taux,
         là où le visiteur pense déjà à son échéance -->
    <section id="rappel-teaser" aria-label="Rappel de renouvellement">
      <div class="section-inner">
        <RappelCTA
          titre="Votre hypothèque arrive à échéance ?"
          texte="Le meilleur moment pour magasiner se situe 4 à 6 mois avant la fin de votre terme — avant que votre banque n'envoie son offre de renouvellement. Laissez vos coordonnées : je vous rappelle personnellement au bon moment."
          cta="Être rappelé·e au bon moment"
        />
      </div>
    </section>

    <section id="apropos">
      <About />
      <Testimonials reviews={googleReviews} />
    </section>

    <Faq />
    <Contact />
  </main>
  <Footer />

  <style>
    /* Bloc rappel : la section taux au-dessus fournit déjà l'espacement vertical */
    #rappel-teaser {
      padding-top: 0;
    }
    #rappel-teaser :global(.rappel-cta) {
      margin: 0;
    }

    .outils-trust {
      margin: 0.25rem 0 0;
      font-size: 0.78rem;
      color: var(--clay, #c47a52);
      font-weight: 500;
    }

    /* Les autres outils — une rangée discrète sous le calculateur, qui reste la vedette */
    .outils-autres {
      margin-top: 2.5rem;
    }
    .outils-autres-tete {
      display: flex;
      align-items: baseline;
      justify-content: space-between;
      gap: 0.5rem 1.5rem;
      flex-wrap: wrap;
      margin-bottom: 1rem;
    }
    .outils-autres h3 {
      font-family: "Lora", serif;
      font-size: 1.25rem;
      font-weight: 600;
      color: var(--ink);
    }
    .outils-autres-tous {
      font-size: 0.9rem;
      font-weight: 600;
      color: var(--clay-dk);
      text-decoration: none;
    }
    .outils-autres-tous:hover {
      text-decoration: underline;
      text-underline-offset: 3px;
    }
    .outils-autres ul {
      list-style: none;
      display: grid;
      grid-template-columns: repeat(auto-fill, minmax(200px, 1fr));
      gap: 0.75rem;
    }
    .outils-autres li a {
      display: flex;
      align-items: flex-start;
      gap: 0.75rem;
      height: 100%;
      padding: 0.9rem 1rem;
      background: var(--white);
      border: 1px solid var(--border);
      border-radius: var(--radius-sm);
      color: inherit;
      text-decoration: none;
      transition: border-color 0.2s, transform 0.2s, box-shadow 0.2s;
    }
    .outils-autres li a:hover {
      border-color: var(--clay);
      transform: translateY(-2px);
      box-shadow: var(--shadow-sm);
    }
    .outils-autres li a:focus-visible {
      outline: 3px solid var(--clay);
      outline-offset: 2px;
    }
    .outils-autres-icone {
      display: inline-flex;
      align-items: center;
      justify-content: center;
      flex-shrink: 0;
      width: 2.25rem;
      height: 2.25rem;
      border-radius: 10px;
      background: var(--sand);
      color: var(--clay-dk);
    }
    .outils-autres-texte {
      display: flex;
      flex-direction: column;
      gap: 0.15rem;
      min-width: 0;
    }
    .outils-autres-texte strong {
      font-size: 0.92rem;
      font-weight: 600;
      color: var(--ink);
    }
    .outils-autres-texte span {
      font-size: 0.8rem;
      line-height: 1.45;
      color: var(--muted);
    }
    @media (max-width: 580px) {
      .outils-autres {
        margin-top: 2rem;
      }
      .outils-autres ul {
        grid-template-columns: 1fr;
        gap: 0.5rem;
      }
    }
  </style>

  <script>
    document.documentElement.classList.add('js-enabled');

    const animClasses = ['.fade-up', '.fade-left', '.fade-right', '.scale-in', '.stagger-children'];
    const animEls = document.querySelectorAll(animClasses.join(','));
    const obs = new IntersectionObserver(
      (entries) =>
        entries.forEach((x) => {
          if (x.isIntersecting) {
            x.target.classList.add('visible');
            obs.unobserve(x.target);
          }
        }),
      { threshold: 0.12 }
    );
    animEls.forEach((el) => obs.observe(el));

    // Fallback: si l'observer ne déclenche pas (p. ex. éléments hors-fold avec layout figé),
    // forcer la visibilité après 1.2 s.
    window.setTimeout(() => {
      animEls.forEach((el) => el.classList.add('visible'));
    }, 1200);
  </script>
</MainLayout>
