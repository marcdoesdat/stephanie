---
export const prerender = true;

import MainLayout from '../../layouts/MainLayout.astro';
import Nav from '../../components/Nav.astro';
import Footer from '../../components/Footer.astro';
import MessengerBtn from '../../components/MessengerBtn.astro';
import { Image } from 'astro:assets';
import stephaniePhoto from '../../assets/stephanie.webp';
import { BadgeCheck, House, KeyRound, PenLine, PiggyBank, SearchCheck, Wallet } from '@lucide/astro';
import { loadSiteConfig } from '../../config';
import { cheminGuide, guideParSlug, moisRevision } from '../../data/guides';
import { schemaCourtiere } from '../../utils/schemaVille';

const config = loadSiteConfig();
const guide = guideParSlug('premier-achat');
const site = config.site_url.replace(/\/$/, '');
const pageUrl = `${site}${cheminGuide(guide.slug)}`;
const revision = moisRevision(guide.revise);

const titre = 'Guide du premier achat au Québec';
const description =
  "Premier achat au Québec, étape par étape : budget, mise de fonds, RAP et CELIAPP, pré-approbation, frais à prévoir et signature chez le notaire.";

// L'autrice est le même nœud `#stephanie` que sur les pages villes ; l'entreprise, le
// `#business` déclaré par SEO.astro. En anglais, traductionPage.ts ne garde que ce dernier.
const schemas = [
  {
    '@context': 'https://schema.org',
    '@type': 'Article',
    headline: titre,
    description,
    inLanguage: 'fr-CA',
    datePublished: guide.revise,
    dateModified: guide.revise,
    mainEntityOfPage: pageUrl,
    author: { '@id': `${site}#stephanie` },
    publisher: { '@id': `${site}#business` },
  },
  schemaCourtiere(config, `${site}${stephaniePhoto.src}`),
  {
    '@context': 'https://schema.org',
    '@type': 'BreadcrumbList',
    itemListElement: [
      { '@type': 'ListItem', position: 1, name: 'Accueil', item: `${site}/` },
      { '@type': 'ListItem', position: 2, name: 'Guides', item: `${site}/guides/` },
      { '@type': 'ListItem', position: 3, name: titre, item: pageUrl },
    ],
  },
];

// L'infographie : les sept étapes, en trois temps. Chaque étape mène à sa section.
const PHASES = {
  preparer: 'Se préparer',
  acheter: 'Acheter',
  apres: "Après l'achat",
} as const;

const JALONS = [
  { ancre: 'finances', phase: 'preparer', quand: 'Avant de magasiner', titre: 'Faire le point sur vos finances', texte: 'Revenus, dettes et dossier de crédit : ce que les prêteurs regarderont.', Icone: Wallet },
  { ancre: 'mise-de-fonds', phase: 'preparer', quand: 'Avant de magasiner', titre: 'Bâtir votre mise de fonds', texte: "Épargne, RAP, CELIAPP ou don : d'où viendra chaque dollar.", Icone: PiggyBank },
  { ancre: 'pre-approbation', phase: 'preparer', quand: 'Avant les visites', titre: 'Obtenir votre pré-approbation', texte: 'Un montant à viser et un taux réservé pendant vos recherches.', Icone: BadgeCheck },
  { ancre: 'promesse', phase: 'acheter', quand: 'Pendant les visites', titre: "Faire une promesse d'achat", texte: 'Avec des conditions qui vous protègent : financement et inspection.', Icone: House },
  { ancre: 'approbation', phase: 'acheter', quand: "Après l'acceptation", titre: 'Inspection et approbation finale', texte: 'Le prêteur analyse la propriété et confirme le financement.', Icone: SearchCheck },
  { ancre: 'notaire', phase: 'acheter', quand: 'Le jour de la signature', titre: 'Signer chez le notaire', texte: 'La vente et le prêt sont signés, les sommes versées : la maison est à vous.', Icone: PenLine },
  { ancre: 'apres', phase: 'apres', quand: 'Les mois suivants', titre: "Après l'achat", texte: "Taxe de bienvenue, crédits d'impôt, et un premier renouvellement à prévoir.", Icone: KeyRound },
] as const;
---

<MainLayout title={titre} description={description}>
  <Fragment slot="head">
    {schemas.map((schema) => (
      <script type="application/ld+json" is:inline set:html={JSON.stringify(schema)} />
    ))}
  </Fragment>

  <MessengerBtn />
  <Nav />

  <main id="main-content">

    <!-- ============ EN-TÊTE ============ -->
    <section class="sp-hero gd-hero">
      <div class="sp-inner">
        <div class="sp-hero-grid">
          <div class="sp-hero-text">
            <nav aria-label="Fil d'Ariane" class="gd-fil">
              <a href="/">Accueil</a> <span aria-hidden="true">›</span> <a href="/guides/">Guides</a>
            </nav>

            <h1 class="sp-h1">
              <span class="sp-h1-sujet">Guide du premier achat au Québec</span>
              Votre première maison, <em>étape par étape</em>.
            </h1>

            <p class="sp-h2">
              Combien emprunter, d'où viendra la mise de fonds, quels frais prévoir, ce qui se passe chez
              le notaire : tout le parcours d'un premier achat, dans l'ordre où il se présente — sans jargon.
            </p>

            <p class="gd-signature">
              Par <a href="/#apropos">{config.nom}</a>, courtière hypothécaire chez {config.organisation}
              · Mis à jour en {revision} · Lecture : {guide.minutes} min
            </p>
          </div>

          <aside class="gd-bref" aria-labelledby="gd-bref-titre">
            <h2 id="gd-bref-titre" class="gd-bref-titre">L'essentiel en 30 secondes</h2>
            <ul>
              <li>Commencez par la <strong>pré-approbation</strong>, pas par les visites : vous saurez quoi viser, et votre taux sera réservé.</li>
              <li>La mise de fonds minimale est de <strong>5&nbsp;%</strong> jusqu'à 500&nbsp;000&nbsp;$ ; sous 20&nbsp;%, une assurance prêt hypothécaire s'ajoute.</li>
              <li>Le <strong>RAP</strong> et le <strong>CELIAPP</strong> se combinent pour bâtir la mise de fonds.</li>
              <li>Prévoyez au moins <strong>1,5&nbsp;% du prix</strong> pour les frais, en plus de la mise de fonds.</li>
              <li>Entre la pré-approbation et la signature, <strong>aucun nouveau crédit</strong>.</li>
            </ul>
          </aside>
        </div>
      </div>
    </section>

    <div class="sp-inner gd-layout">
      <!-- ============ SOMMAIRE ============ -->
      <aside class="gd-cote">
        <nav class="gd-sommaire" aria-labelledby="gd-sommaire-titre">
          <p id="gd-sommaire-titre" class="gd-sommaire-titre">Dans ce guide</p>
          <ol>
            <li><a href="#parcours">Le parcours en un coup d'œil</a></li>
            <li><a href="#chiffres">Les chiffres à connaître</a></li>
            {JALONS.map((j, i) => (
              <li><a href={`#${j.ancre}`}>{i + 1}. {j.titre}</a></li>
            ))}
            <li><a href="#frais">Les frais à prévoir</a></li>
            <li><a href="#erreurs">Cinq erreurs fréquentes</a></li>
          </ol>
        </nav>
      </aside>

      <article class="gd-article">

        <!-- ============ L'INFOGRAPHIE ============ -->
        <section class="gd-section" aria-labelledby="parcours">
          <h2 id="parcours" class="sp-section-title">Le parcours <em>en un coup d'œil</em></h2>
          <p class="gd-intro">Sept étapes, de la première question à la remise des clés.</p>

          <ul class="gd-legende" aria-label="Les trois temps du parcours">
            {Object.entries(PHASES).map(([cle, nom]) => (
              <li data-phase={cle}><span class="gd-pastille" aria-hidden="true"></span>{nom}</li>
            ))}
          </ul>

          <ol class="gd-parcours">
            {JALONS.map((j, i) => (
              <li class="gd-jalon" data-phase={j.phase}>
                <span class="gd-jalon-num" aria-hidden="true">{i + 1}</span>
                <div class="gd-jalon-carte">
                  <span class="gd-jalon-icone" aria-hidden="true"><j.Icone size={22} stroke-width={1.8} /></span>
                  <span class="gd-jalon-quand">{j.quand}</span>
                  <a class="gd-jalon-titre" href={`#${j.ancre}`}>{j.titre}</a>
                  <p>{j.texte}</p>
                </div>
              </li>
            ))}
          </ol>
        </section>

        <!-- ============ CHIFFRES CLÉS ============ -->
        <section class="gd-section" aria-labelledby="chiffres">
          <h2 id="chiffres" class="sp-section-title">Les chiffres <em>à connaître</em></h2>
          <dl class="gd-chiffres">
            <div><dt>de mise de fonds minimale, jusqu'à 500&nbsp;000&nbsp;$</dt><dd>5&nbsp;%</dd></div>
            <div><dt>de mise de fonds pour éviter l'assurance prêt hypothécaire</dt><dd>20&nbsp;%</dd></div>
            <div><dt>de retrait maximal du RAP, par personne</dt><dd>60&nbsp;000&nbsp;$</dd></div>
            <div><dt>de cotisation par année au CELIAPP (40&nbsp;000&nbsp;$ à vie)</dt><dd>8&nbsp;000&nbsp;$</dd></div>
            <div><dt>du prix d'achat, au minimum, pour les frais de clôture</dt><dd>1,5&nbsp;%</dd></div>
            <div><dt>de taux plancher au test de résistance</dt><dd>5,25&nbsp;%</dd></div>
          </dl>
          <p class="gd-note">Règles générales en vigueur en {revision}.</p>
        </section>

        <!-- ============ 1. FINANCES ============ -->
        <section class="gd-section" aria-labelledby="finances">
          <h2 id="finances" class="gd-h2"><span class="gd-num" data-phase="preparer">1</span> Faire le point sur vos finances</h2>
          <p>
            Avant de regarder des maisons, regardez ce que les prêteurs regarderont : vos revenus, vos dettes
            et la façon dont vous les remboursez.
          </p>

          <h3>Les deux ratios qui décident de votre capacité d'emprunt</h3>
          <p>
            Un prêteur calcule quelle part de vos revenus bruts irait à vos obligations. L'<strong>ABD</strong>
            (amortissement brut de la dette) ne compte que le logement : paiement hypothécaire, taxes municipales
            et scolaires, chauffage et la moitié des frais de copropriété, s'il y a lieu. L'<strong>ATD</strong>
            (amortissement total de la dette) y ajoute vos autres paiements : auto, cartes de crédit, marges,
            prêt étudiant. Pour un prêt assuré, on vise généralement un maximum de 39&nbsp;% et de 44&nbsp;%.
          </p>

          <h3>Le test de résistance</h3>
          <p>
            Ces ratios ne sont pas calculés à votre taux, mais au plus élevé de deux taux : votre taux plus
            2&nbsp;points de pourcentage, ou 5,25&nbsp;%. C'est le test de résistance fédéral : il vérifie que vous
            pourriez encore payer si les taux montaient.
          </p>

          <h3>Votre dossier de crédit</h3>
          <p>
            Le prêteur consulte aussi votre dossier de crédit : il veut voir des paiements faits à temps et des
            limites de crédit qui ne sont pas toutes utilisées. Vous pouvez consulter votre propre dossier
            gratuitement auprès d'Equifax et de TransUnion.
          </p>

          <p class="gd-astuce">
            <strong>Bon à savoir :</strong> rembourser une auto ou une carte avant l'achat peut augmenter votre
            capacité d'emprunt plus qu'une augmentation de salaire.
          </p>

          <p class="gd-outil">
            <a href="/#outils-teaser">Estimez votre capacité d'emprunt →</a>
            <span>Le calculateur applique le test de résistance et les mêmes ratios.</span>
          </p>
        </section>

        <!-- ============ 2. MISE DE FONDS ============ -->
        <section class="gd-section" aria-labelledby="mise-de-fonds">
          <h2 id="mise-de-fonds" class="gd-h2"><span class="gd-num" data-phase="preparer">2</span> Bâtir votre mise de fonds</h2>

          <h3>Le minimum exigé</h3>
          <div class="gd-table-wrap">
            <table class="gd-table">
              <thead>
                <tr><th scope="col">Prix de la propriété</th><th scope="col">Mise de fonds minimale</th></tr>
              </thead>
              <tbody>
                <tr><td>Jusqu'à 500&nbsp;000&nbsp;$</td><td>5&nbsp;% du prix</td></tr>
                <tr><td>De 500&nbsp;000&nbsp;$ à 1&nbsp;500&nbsp;000&nbsp;$</td><td>5&nbsp;% des premiers 500&nbsp;000&nbsp;$, puis 10&nbsp;% du reste</td></tr>
                <tr><td>1&nbsp;500&nbsp;000&nbsp;$ et plus</td><td>20&nbsp;% du prix</td></tr>
              </tbody>
            </table>
          </div>
          <p>
            Par exemple, pour une propriété de 600&nbsp;000&nbsp;$ : 5&nbsp;% de 500&nbsp;000&nbsp;$ (25&nbsp;000&nbsp;$), plus 10&nbsp;% des
            100&nbsp;000&nbsp;$ suivants (10&nbsp;000&nbsp;$), soit <strong>35&nbsp;000&nbsp;$</strong>.
          </p>

          <h3>Sous 20&nbsp;% : l'assurance prêt hypothécaire</h3>
          <p>
            Avec moins de 20&nbsp;% de mise de fonds, le prêt doit être assuré (SCHL, Sagen ou Canada Guaranty).
            La prime s'ajoute au montant emprunté ; elle dépend de votre mise de fonds.
          </p>
          <div class="gd-table-wrap">
            <table class="gd-table">
              <thead>
                <tr><th scope="col">Mise de fonds</th><th scope="col">Prime, en % du prêt</th></tr>
              </thead>
              <tbody>
                <tr><td>5&nbsp;% à 9,99&nbsp;%</td><td>4,00&nbsp;%</td></tr>
                <tr><td>10&nbsp;% à 14,99&nbsp;%</td><td>3,10&nbsp;%</td></tr>
                <tr><td>15&nbsp;% à 19,99&nbsp;%</td><td>2,80&nbsp;%</td></tr>
              </tbody>
            </table>
          </div>
          <p>
            Au Québec, la taxe de 9&nbsp;% sur cette prime ne peut pas être ajoutée au prêt : elle se paie comptant,
            chez le notaire. Depuis décembre 2024, un premier acheteur peut aussi amortir un prêt assuré sur
            30&nbsp;ans plutôt que 25 : le versement baisse, mais le total des intérêts augmente, et la prime
            d'assurance est un peu plus élevée.
          </p>

          <h3>D'où peut venir l'argent</h3>
          <ul class="gd-liste">
            <li>
              <strong>Votre épargne.</strong> Les prêteurs veulent voir les relevés des 90 derniers jours : un gros
              dépôt récent devra être expliqué, preuve à l'appui.
            </li>
            <li>
              <strong>Le RAP</strong> (Régime d'accession à la propriété). Vous pouvez retirer jusqu'à 60&nbsp;000&nbsp;$
              de vos REER — 120&nbsp;000&nbsp;$ pour un couple — sans impôt immédiat. La somme se rembourse dans votre
              REER sur 15&nbsp;ans.
            </li>
            <li>
              <strong>Le CELIAPP.</strong> Les cotisations sont déductibles d'impôt, comme au REER, et le retrait
              pour l'achat d'une première habitation n'est pas imposé, comme au CELI : jusqu'à 8&nbsp;000&nbsp;$ par année,
              40&nbsp;000&nbsp;$ à vie. Ouvrez-le tôt : vos droits de cotisation ne s'accumulent qu'à partir de son ouverture.
            </li>
            <li>
              <strong>Un don d'un membre de votre famille immédiate</strong>, accompagné d'une lettre de don signée
              qui confirme que la somme n'a pas à être remboursée.
            </li>
          </ul>
          <p>
            Le RAP et le CELIAPP se combinent. Pour y avoir droit, il faut en règle générale être « premier
            acheteur » : ne pas avoir habité, cette année ni au cours des quatre années précédentes, une
            propriété dont vous ou votre conjoint·e étiez propriétaire. Les conditions exactes se vérifient
            auprès de votre institution financière ou de votre fiscaliste.
          </p>

          <p class="gd-outil">
            <a href="/outils/#rap-celiapp">Comparez le RAP et le CELIAPP →</a>
            <span>Une estimation simplifiée de l'avantage fiscal de chacun, selon votre revenu et votre épargne.</span>
          </p>
        </section>

        <!-- ============ 3. PRÉ-APPROBATION ============ -->
        <section class="gd-section" aria-labelledby="pre-approbation">
          <h2 id="pre-approbation" class="gd-h2"><span class="gd-num" data-phase="preparer">3</span> Obtenir votre pré-approbation</h2>
          <p>
            La pré-approbation, c'est l'analyse de votre dossier par un prêteur : elle vous donne un montant à
            viser et réserve un taux, généralement de 90 à 120 jours. Si les taux montent pendant vos
            recherches, le taux réservé vous protège.
          </p>
          <p>
            Ce n'est pas encore une approbation : le prêteur confirmera le financement une fois la propriété
            trouvée et ses vérifications faites (étape 5). Mais vous visitez en connaissant votre budget, et
            vous faites une offre avec un dossier déjà monté.
          </p>

          <h3>Les documents à réunir</h3>
          <ul class="gd-liste gd-liste--coches">
            <li>Une pièce d'identité avec photo</li>
            <li>Une lettre d'emploi récente et vos deux derniers talons de paie</li>
            <li>Vos avis de cotisation fédéral et provincial des deux dernières années — essentiels pour un travailleur autonome</li>
            <li>Les relevés bancaires des 90 derniers jours, pour la provenance de la mise de fonds</li>
            <li>Les relevés de vos REER, CELIAPP ou CELI, s'ils financent la mise de fonds</li>
            <li>La lettre de don signée, s'il y a lieu</li>
          </ul>
          <p>
            Avec une courtière, votre dossier est présenté aux prêteurs qui conviennent à votre situation — plus
            de 20 prêteurs, plutôt qu'une seule institution.
          </p>
          <p class="gd-outil">
            <a href="/demande/">Commencer ma demande en ligne →</a>
            <span>À votre rythme : vous pouvez l'envoyer à tout moment, même incomplète.</span>
          </p>
        </section>

        <!-- ============ FRAIS ============ -->
        <section class="gd-section gd-encadre" aria-labelledby="frais">
          <h2 id="frais" class="gd-h2">Les frais à prévoir en plus de la mise de fonds</h2>
          <p>
            C'est l'oubli le plus fréquent d'un premier budget. Les prêteurs demandent de démontrer au moins
            1,5&nbsp;% du prix d'achat pour couvrir les frais de clôture :
          </p>
          <ul class="gd-liste">
            <li>
              <strong>La taxe de bienvenue</strong> (droits de mutation), souvent le plus gros montant. Elle varie
              selon la ville et sa facture arrive quelques mois après l'achat.
              <a href="/outils/#droits-mutation">Calculez-la d'avance</a>.
            </li>
            <li><strong>Le notaire</strong> : acte de vente, acte d'hypothèque et vérifications.</li>
            <li><strong>L'inspection</strong> préachat.</li>
            <li><strong>La taxe de 9&nbsp;%</strong> sur la prime d'assurance prêt hypothécaire, s'il y a lieu.</li>
            <li>
              <strong>Les ajustements de taxes</strong> municipales et scolaires : vous remboursez au vendeur la
              part déjà payée pour la période où vous serez propriétaire.
            </li>
            <li><strong>L'assurance habitation</strong>, exigée par le prêteur dès la signature.</li>
            <li><strong>Le déménagement</strong> et les premiers achats pour la maison.</li>
          </ul>
        </section>

        <!-- ============ 4. PROMESSE D'ACHAT ============ -->
        <section class="gd-section" aria-labelledby="promesse">
          <h2 id="promesse" class="gd-h2"><span class="gd-num" data-phase="acheter">4</span> Faire une promesse d'achat</h2>
          <p>
            Visitez dans les limites de votre pré-approbation — idéalement un peu en deçà : le montant maximal
            n'est pas un objectif.
          </p>

          <h3>Des conditions qui vous protègent</h3>
          <p>Une promesse d'achat prévoit habituellement des conditions, chacune avec son délai :</p>
          <ul class="gd-liste">
            <li>
              <strong>Le financement</strong> : si votre prêt n'est pas confirmé dans le délai prévu, vous pouvez
              vous retirer selon les termes de la promesse.
            </li>
            <li>
              <strong>L'inspection</strong> : un inspecteur examine la propriété ; selon son rapport, vous pouvez
              renégocier ou vous retirer, dans le délai prévu.
            </li>
          </ul>
          <p>
            Dès que la promesse est acceptée, transmettez-la à votre courtière hypothécaire : le délai de
            financement commence à courir.
          </p>

          <p class="gd-attention">
            <strong>Entre la pré-approbation et la signature, ne changez rien</strong> : pas de nouvel emprunt
            (auto, meubles financés), pas de changement d'emploi, pas de gros mouvement d'argent inexpliqué. Le
            prêteur peut revérifier votre dossier avant de verser les fonds.
          </p>
        </section>

        <!-- ============ 5. APPROBATION FINALE ============ -->
        <section class="gd-section" aria-labelledby="approbation">
          <h2 id="approbation" class="gd-h2"><span class="gd-num" data-phase="acheter">5</span> Inspection et approbation finale</h2>
          <p>
            Une fois la promesse acceptée, deux choses se font en parallèle. L'inspecteur examine la propriété
            pour vous. Le prêteur, lui, analyse la propriété et votre dossier à jour ; il peut demander une
            évaluation pour confirmer la valeur.
          </p>
          <p>
            Documents habituellement demandés pour la propriété : la promesse d'achat acceptée, la fiche
            descriptive, la déclaration du vendeur, les comptes de taxes municipales et scolaires — et, pour un
            condo, les documents de la copropriété.
          </p>
          <p>
            Quand le prêteur confirme, vous recevez la <strong>lettre d'engagement</strong> : les conditions du
            prêt, à relire avec votre courtière avant de la signer. Il reste à aviser le vendeur par écrit que
            la condition de financement est remplie, dans le délai prévu.
          </p>
          <p class="gd-astuce">
            <strong>Si l'évaluation est plus basse que le prix :</strong> le prêteur finance sur la valeur la plus
            basse. La différence doit venir de votre poche, ou se renégocier — une raison de plus de ne pas viser
            le maximum.
          </p>
        </section>

        <!-- ============ 6. NOTAIRE ============ -->
        <section class="gd-section" aria-labelledby="notaire">
          <h2 id="notaire" class="gd-h2"><span class="gd-num" data-phase="acheter">6</span> Signer chez le notaire</h2>
          <p>
            Au Québec, c'est le notaire qui officialise l'achat. Il vous fait signer deux actes :
            l'<strong>acte de vente</strong>, qui vous rend propriétaire, et l'<strong>acte d'hypothèque</strong>,
            qui garantit le prêt. Il vérifie aussi que la propriété est libre des dettes du vendeur, puis publie
            les actes au registre foncier.
          </p>
          <p>
            Quelques jours avant, il vous indique la somme à lui verser — mise de fonds, frais et ajustements — et
            la façon de la verser. Prévoyez votre preuve d'assurance habitation. Le prêteur verse le prêt au
            notaire, qui paie le vendeur : il ne vous reste qu'à recevoir les clés, à la date d'occupation prévue.
          </p>
        </section>

        <!-- ============ 7. APRÈS L'ACHAT ============ -->
        <section class="gd-section" aria-labelledby="apres">
          <h2 id="apres" class="gd-h2"><span class="gd-num" data-phase="apres">7</span> Après l'achat</h2>
          <ul class="gd-liste">
            <li>
              <strong>La taxe de bienvenue</strong> : la facture de la municipalité arrive habituellement quelques
              mois après l'achat. Mettez la somme de côté dès la signature.
            </li>
            <li>
              <strong>Deux crédits d'impôt</strong> pour l'achat d'une première habitation, un fédéral et un
