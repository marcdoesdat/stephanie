    cursor: default;
  }

  .demande-nas-info {
    font-size: .78rem;
    color: var(--muted);
    background: var(--warm);
    border-radius: var(--radius-sm);
    padding: .65rem 1rem;
    line-height: 1.55;
  }

  /* --- RADIO GROUPS --- */
  .demande-radio-group {
    display: flex;
    flex-direction: column;
    gap: .55rem;
