    font-size: .85rem;
    line-height: 1.45;
    color: var(--ink);
    cursor: pointer;
    padding: .35rem 0;
  }
  .demande-check-label input[type="checkbox"] {
    accent-color: var(--clay);
    width: 1rem;
    height: 1rem;
    margin-top: .1rem;
    flex-shrink: 0;
  }
  .demande-check-label--box {
    padding: .75rem 1rem;
    border-radius: var(--radius-sm);
    border: 1.5px solid var(--border);
    background: var(--sand);
    font-size: .82rem;
  }
  .demande-check-label--box:has(input:checked) {
