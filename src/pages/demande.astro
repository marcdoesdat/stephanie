  }

  /* --- CALLOUT --- */
  .demande-callout {
    background: #fef3e4;
    border: 1px solid var(--clay);
    border-radius: var(--radius-sm);
    padding: 1rem 1.2rem;
    margin-bottom: 1.25rem;
  }
  .demande-callout strong {
    display: block;
    font-size: .88rem;
    color: var(--clay-dk);
    margin-bottom: .35rem;
  }
  .demande-callout p {
    font-size: .8rem;
    color: var(--muted);
    line-height: 1.55;
    margin: 0;
  }

  /* --- CONSENT --- */
  .demande-consent {
    display: flex;
    gap: .6rem;
    align-items: flex-start;
    margin: 1rem 0 1.5rem;
    font-size: .82rem;
    line-height: 1.55;
    color: var(--ink);
    border-radius: var(--radius-sm);
  }
  .demande-consent[data-invalide] {
    box-shadow: 0 0 0 2px var(--clay-dk);
    padding: .6rem .75rem;
  }
  .demande-consent input[type="checkbox"] {
    margin-top: .15rem;
    flex: 0 0 auto;
    width: 1.05rem;
    height: 1.05rem;
    accent-color: var(--clay);
  }
  .demande-consent a { color: var(--clay); text-decoration: underline; }

  /* --- NAVIGATION ENTRE LES ÉTAPES --- */
  .demande-nav {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1rem;
    margin-top: .5rem;
  }
  .demande-nav .btn-cta { margin-left: auto; }
  .demande-precedent,
  .demande-lien {
    background: none;
    border: none;
    padding: .75rem .25rem;
    font-family: "DM Sans", sans-serif;
    font-size: .95rem;
    font-weight: 600;
    color: var(--muted);
    cursor: pointer;
  }
  .demande-precedent:hover,
  .demande-lien:hover { color: var(--ink); text-decoration: underline; text-underline-offset: 3px; }
  .demande-precedent:focus-visible,
  .demande-lien:focus-visible,
  .demande-sortie-btn:focus-visible { outline: 2px solid var(--clay); outline-offset: 3px; border-radius: 4px; }

  #demande-submit[disabled],
  #demande-partiel-envoyer[disabled] { opacity: .65; cursor: not-allowed; }

  /* --- LA SORTIE : ENVOYER AVANT LA FIN --- */
  .demande-sortie {
    margin-top: 1.75rem;
    padding-top: 1.25rem;
    border-top: 1px dashed var(--border);
    text-align: center;
  }
  .demande-sortie p {
    font-size: .85rem;
    line-height: 1.55;
    color: var(--muted);
    margin-bottom: .35rem;
  }
  .demande-sortie-btn {
    background: none;
    border: none;
    padding: .6rem .5rem;
    font-family: "DM Sans", sans-serif;
    font-size: .95rem;
    font-weight: 700;
    color: var(--clay-dk);
    text-decoration: underline;
    text-underline-offset: 3px;
    cursor: pointer;
  }
  .demande-sortie-btn:hover { color: #8e4f30; }

  .demande-partiel {
    margin-top: 1.25rem;
    padding: 1.25rem 1.35rem;
    background: var(--sand);
    border: 1.5px solid var(--clay);
    border-radius: var(--radius-sm);
  }
  .demande-partiel-titre {
    font-family: "Lora", serif;
    font-size: 1.15rem;
    font-weight: 600;
    color: var(--ink);
    margin-bottom: .4rem;
  }
  .demande-partiel-titre:focus { outline: none; }
  .demande-partiel-texte {
    font-size: .88rem;
    line-height: 1.6;
    color: var(--ink);
  }
  .demande-partiel .demande-consent { margin: 1rem 0 1.1rem; }
  .demande-partiel-actions {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: .75rem 1.25rem;
  }

  .demande-note {
    text-align: center;
    font-size: .76rem;
    color: var(--muted);
    margin-top: 1.25rem;
  }
  .demande-note--next { margin-top: 0; }

  /* --- STATUS & SUCCESS --- */
  .demande-status {
    margin-top: 1.25rem;
    padding: .85rem 1.1rem;
    border-radius: var(--radius-sm);
    font-size: .88rem;
    line-height: 1.5;
  }
  #demande-erreur { margin: 0 0 1rem; }
  .demande-status[data-state="error"] {
    background: #fbeae3;
    border: 1px solid var(--clay-dk);
    color: var(--clay-dk);
  }
  .demande-status[data-state="sending"] {
    background: var(--warm);
    border: 1px solid var(--border);
    color: var(--muted);
  }

  .demande-success {
    text-align: center;
    padding: 1rem 0;
  }
  .demande-success-check { font-size: 2.2rem; display: block; margin-bottom: .5rem; }
  .demande-success strong {
    font-family: "Lora", serif;
    font-size: 1.4rem;
    color: var(--forest);
    display: block;
    margin-bottom: .5rem;
  }
  .demande-success strong:focus { outline: none; }
  .demande-success p { color: var(--muted); line-height: 1.7; font-size: .95rem; }
  .demande-success .demande-success-rdv { margin-top: 1.25rem; color: var(--ink); font-weight: 500; }
  .demande-success-actions {
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    align-items: center;
    gap: 1rem 1.25rem;
    margin-top: 1rem;
  }

  @media (max-width: 700px) {
    .demande-row,
    .demande-row--3col { grid-template-columns: 1fr; gap: 0; }
    .demande-row .demande-field,
    .demande-row--3col .demande-field { margin-bottom: 1.25rem; }
    .demande-legend { font-size: 1.15rem; }
  }
  @media (max-width: 420px) {
    .demande-nav .btn-cta { padding-left: 1.2rem; padding-right: 1.2rem; }
  }
</style>

<script>
  import {
    CLE_REPRISE,
    ETAPES,
    decoderReprise,
    encoderReprise,
    etapeParCle,
    etapeReprise,
    etapesApplicables,
    indexDansParcours,
    requisManquants,
    type CleEtape,
    type EtapeDemande,
    type Lecture,
  } from '../utils/demandeFinancement';

  type Champ = HTMLInputElement | HTMLSelectElement | HTMLTextAreaElement;

  function suivre(nom: string, donnees?: Record<string, string | boolean>): void {
    const umami = (window as unknown as { umami?: { track?: (n: string, d?: unknown) => void } }).umami;
    if (typeof umami?.track === 'function') umami.track(nom, donnees);
  }

  /**
   * La conversion, comme au formulaire de contact : GA4 reçoit `generate_lead`, Google Ads
   * l'importe depuis GA4. Sans consentement, `gtag` n'est que la file d'attente posée par
   * MainLayout — Google n'est jamais chargé et l'événement ne part pas.
   */
  function convertir(parametres: Record<string, string>): void {
    const gtag = (window as unknown as { gtag?: (...args: unknown[]) => void }).gtag;
    if (typeof gtag === 'function') gtag('event', 'generate_lead', parametres);
    suivre('generate_lead', parametres);
  }

  const form = document.getElementById('demande-form') as HTMLFormElement | null;
  if (form) initialiser(form);

  function initialiser(form: HTMLFormElement): void {
    const $ = <T extends HTMLElement>(id: string) => document.getElementById(id) as T | null;
    const carte = $('demande-card');
    const progression = $('demande-progress');
    const num = progression?.querySelector<HTMLElement>('[data-etape-num]') ?? null;
    const total = progression?.querySelector<HTMLElement>('[data-etape-total]') ?? null;
    const jauge = progression?.querySelector<HTMLElement>('[data-etape-fill]') ?? null;
    const boutonPrecedent = $<HTMLButtonElement>('demande-precedent');
    const boutonPrincipal = $<HTMLButtonElement>('demande-submit');
    const erreurEtape = $('demande-erreur');
    const sortie = $('demande-sortie');
    const boutonSortie = $<HTMLButtonElement>('demande-sortie-ouvrir');
    const panneauPartiel = $('demande-partiel');
    const titrePartiel = $('demande-partiel-titre');
    const consentPartiel = $<HTMLInputElement>('demande-consent-partiel');
    const consentFinal = $<HTMLInputElement>('demande-consent-final');
    const boutonPartiel = $<HTMLButtonElement>('demande-partiel-envoyer');
    const boutonAnnuler = $<HTMLButtonElement>('demande-partiel-annuler');
    const statut = $('demande-status');
    const succes = $('demande-success');
    const avisReprise = $('demande-reprise');
    const boutonEffacer = $<HTMLButtonElement>('demande-reprise-effacer');

    const fieldsets = new Map<CleEtape, HTMLFieldSetElement>();
    for (const etape of ETAPES) {
      const fs = form.querySelector<HTMLFieldSetElement>(`fieldset[data-etape="${etape.cle}"]`);
      if (fs) fieldsets.set(etape.cle, fs);
    }

    let courante: CleEtape = ETAPES[0]!.cle;
    let envoiEnCours = false;
    let envoye = false;

    /* ---------- Lecture du formulaire ---------- */

    const elements = (champ: string) => form.querySelectorAll<Champ>(`[name="${champ}"]`);

    const lire: Lecture = (champ) => {
      const valeurs: string[] = [];
      elements(champ).forEach((el) => {
        if (el instanceof HTMLInputElement && (el.type === 'radio' || el.type === 'checkbox')) {
          if (el.checked) valeurs.push(el.value);
        } else if (el.value.trim()) {
          valeurs.push(el.value.trim());
        }
      });
      return valeurs.join(', ');
    };

    const parcours = (): EtapeDemande[] => etapesApplicables(lire);

    /* ---------- Blocs conditionnels ---------- */

    function basculer(id: string, visible: boolean): void {
      const bloc = document.getElementById(id);
      if (bloc) bloc.style.display = visible ? '' : 'none';
    }

    function majBlocs(): void {
      const refi = lire('type_demande') === 'refinancement';
      basculer('demande-co-block', lire('co_emprunteur') === 'deux');
      basculer('demande-proprio-block', lire('situation_logement') === 'proprietaire');
      basculer('demande-adresse-prev-group', lire('adresse_3ans') === 'non');
      basculer('demande-promesse-question', !refi);
      basculer('demande-promesse-oui', !refi && lire('promesse_achat') === 'oui');
      basculer('demande-condo-block', lire('type_propriete') === 'condo');
      basculer('demande-plex-block', lire('type_propriete') === 'plex');
    }

    /* ---------- Erreurs ---------- */

    function marquer(champ: string, invalide: boolean): void {
      const premier = elements(champ)[0];
      if (!premier) return;
      const groupe = premier instanceof HTMLInputElement && (premier.type === 'radio' || premier.type === 'checkbox');
      if (groupe) premier.closest('.demande-field')?.toggleAttribute('data-invalide', invalide);
      else if (invalide) premier.setAttribute('aria-invalid', 'true');
      else premier.removeAttribute('aria-invalid');
      // Un format refusé (courriel, téléphone) dit pourquoi ; un champ vide se voit assez.
      const aide = form.querySelector<HTMLElement>(`[data-erreur-pour="${champ}"]`);
      if (aide) aide.hidden = !(invalide && lire(champ) !== '');
    }

    function effacerErreurs(): void {
      form.querySelectorAll('[aria-invalid]').forEach((el) => el.removeAttribute('aria-invalid'));
      form.querySelectorAll('[data-invalide]').forEach((el) => el.removeAttribute('data-invalide'));
      form.querySelectorAll<HTMLElement>('[data-erreur-pour]').forEach((el) => { el.hidden = true; });
      if (erreurEtape) erreurEtape.hidden = true;
    }

    function premierInvalide(): HTMLElement | null {
      const fs = fieldsets.get(courante);
      const cible = fs?.querySelector<HTMLElement>('[aria-invalid="true"], [data-invalide] input, .demande-consent[data-invalide] input');
      return cible ?? null;
    }

    /** Marque ce qui manque à l'étape ; `true` si elle est complète. */
    function valider(etape: EtapeDemande): boolean {
      const manquants = requisManquants(etape, lire);
      for (const r of etape.requis) marquer(r.champ, manquants.includes(r));
      if (manquants.length === 0) return true;
      if (erreurEtape) erreurEtape.hidden = false;
      premierInvalide()?.focus();
      return false;
    }

    // Une réponse corrigée efface sa propre marque, pas celles des autres.
    form.addEventListener('input', (e) => {
      effacerMarque(e.target);
      planifierSauvegarde();
    });
    form.addEventListener('change', (e) => {
      effacerMarque(e.target);
      majBlocs();
      majCompte();
      planifierSauvegarde();
    });

    /* ---------- Reprise après un rechargement (sessionStorage) ---------- */

    let minuterie: number | undefined;

    function sauvegarder(): void {
      if (envoye) return;
      const champs: Record<string, string[]> = {};
      new FormData(form).forEach((valeur, nom) => {
        if (typeof valeur !== 'string') return;
        (champs[nom] ??= []).push(valeur);
      });
      const maintenant = Date.now();
      const brut = encoderReprise(courante, champs, maintenant);
      try {
        // Rien qui vaille d'être repris (formulaire vierge, ou tout effacé) : rien n'est gardé.
        if (decoderReprise(brut, maintenant)) sessionStorage.setItem(CLE_REPRISE, brut);
        else sessionStorage.removeItem(CLE_REPRISE);
      } catch {
        // Navigation privée, stockage plein ou bloqué : le formulaire marche sans.
      }
    }

    function planifierSauvegarde(): void {
      window.clearTimeout(minuterie);
      minuterie = window.setTimeout(sauvegarder, 300);
    }

    function effacerReprise(): void {
      window.clearTimeout(minuterie);
      try { sessionStorage.removeItem(CLE_REPRISE); } catch { /* rien à effacer */ }
    }

    /** Remet dans le formulaire ce que l'onglet avait gardé. Rend l'étape où l'on en était. */
    function restaurer(): CleEtape | null {
      let brut: string | null = null;
      try { brut = sessionStorage.getItem(CLE_REPRISE); } catch { return null; }
      const reprise = decoderReprise(brut, Date.now());
      if (!reprise) {
        effacerReprise();
        return null;
      }
      for (const [nom, valeurs] of Object.entries(reprise.champs)) {
        elements(nom).forEach((el) => {
          if (el instanceof HTMLInputElement && (el.type === 'radio' || el.type === 'checkbox')) {
            el.checked = valeurs.includes(el.value);
          } else if (!(el instanceof HTMLInputElement && el.readOnly)) {
            el.value = valeurs[0] ?? '';
          }
        });
      }
      return reprise.etape;
    }

    boutonEffacer?.addEventListener('click', () => {
      effacerReprise();
      form.reset();
      if (avisReprise) avisReprise.hidden = true;
      history.replaceState({ ...(history.state ?? {}), demandeEtape: ETAPES[0]!.cle }, '');
      afficher(ETAPES[0]!.cle, true);
    });

    function effacerMarque(cible: EventTarget | null): void {
      if (!(cible instanceof HTMLInputElement || cible instanceof HTMLSelectElement || cible instanceof HTMLTextAreaElement)) return;
      if (cible === consentPartiel || cible === consentFinal) {
        cible.closest('.demande-consent')?.removeAttribute('data-invalide');
        return;
      }
      if (!cible.name) return;
      const etape = ETAPES.find((e) => e.cle === courante);
      const requis = etape?.requis.find((r) => r.champ === cible.name);
      const encoreManquant = !!etape && !!requis && requisManquants(etape, lire).includes(requis);
      if (!encoreManquant) marquer(cible.name, false);
    }

    /* ---------- Affichage d'une étape ---------- */

    function majCompte(): void {
      const liste = parcours();
      const index = indexDansParcours(courante, liste);
      if (num) num.textContent = String(index + 1);
      if (total) total.textContent = String(liste.length);
      if (jauge) jauge.style.width = `${((index + 1) / liste.length) * 100}%`;
    }

    function libelle(bouton: HTMLButtonElement | null, nom: string): void {
      bouton?.querySelectorAll<HTMLElement>('[data-libelle]').forEach((s) => { s.hidden = s.dataset.libelle !== nom; });
    }

    function afficher(cle: CleEtape, deplacer: boolean): void {
      const liste = parcours();
      const index = indexDansParcours(cle, liste);
      const etape = liste[index]!;
      courante = etape.cle;
      fieldsets.forEach((fs, k) => { fs.hidden = k !== etape.cle; });

      const derniere = index === liste.length - 1;
      if (boutonPrecedent) boutonPrecedent.hidden = index === 0;
      libelle(boutonPrincipal, derniere ? 'envoyer' : 'suivant');
      if (sortie) sortie.hidden = index === 0 || derniere;
      fermerPartiel();
      effacerErreurs();
      majBlocs();
      majCompte();

      if (deplacer) {
        if (avisReprise) avisReprise.hidden = true;
        sauvegarder();
        const reduit = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
        carte?.scrollIntoView({ behavior: reduit ? 'auto' : 'smooth', block: 'start' });
        fieldsets.get(etape.cle)?.querySelector<HTMLElement>('.demande-legend')?.focus({ preventScroll: true });
      }
    }

    /** Montre une autre étape en laissant une trace dans l'historique (pour « Précédent »). */
    function aller(cle: CleEtape): void {
      history.pushState({ ...(history.state ?? {}), demandeEtape: cle }, '');
      afficher(cle, true);
    }

    function suivant(): void {
      const liste = parcours();
      const index = indexDansParcours(courante, liste);
      const etape = liste[index]!;
      if (!valider(etape)) return;
      const prochaine = liste[index + 1];
      if (!prochaine) {
        void envoyer(false);
        return;
      }
      aller(prochaine.cle);
      suivre('demande_etape', { etape: prochaine.cle });
    }

    // Reprise : les réponses gardées par l'onglet, puis l'étape. Celle de l'historique passe
    // en premier (un rechargement la conserve, et c'est la plus récente) ; elle est ramenée au
    // premier trou s'il manque une réponse avant elle.
    const etapeGardee = restaurer();
    if (etapeGardee && avisReprise) avisReprise.hidden = false;
    const etapeHistoire = etapeParCle(String((history.state as { demandeEtape?: unknown } | null)?.demandeEtape ?? ''))?.cle;
    majBlocs();
    courante = etapeReprise(lire, etapeHistoire ?? etapeGardee ?? ETAPES[0]!.cle);

    // « Précédent » passe par l'historique, et le bouton retour du téléphone aussi : revenir
    // en arrière ramène à l'étape d'avant au lieu de quitter la page avec tout ce qui est rempli.
    history.replaceState({ ...(history.state ?? {}), demandeEtape: courante }, '');
    window.addEventListener('popstate', (e) => {
      if (envoye) return;
      // Une entrée sans étape (un lien d'ancre, comme « Passer au contenu ») ne change rien.
      const cle = (e.state as { demandeEtape?: string } | null)?.demandeEtape;
      const connue = ETAPES.find((et) => et.cle === cle);
      if (connue) afficher(connue.cle, true);
    });
    boutonPrecedent?.addEventListener('click', () => history.back());

    form.addEventListener('submit', (e) => {
      e.preventDefault();
      if (envoiEnCours || envoye) return;
      suivant();
    });

    /* ---------- La sortie : envoyer avant la fin ---------- */

    function ouvrirPartiel(): void {
      if (!panneauPartiel) return;
      panneauPartiel.hidden = false;
      boutonSortie?.setAttribute('aria-expanded', 'true');
      titrePartiel?.focus({ preventScroll: true });
      panneauPartiel.scrollIntoView({ behavior: 'smooth', block: 'nearest' });
    }

    function fermerPartiel(): void {
      if (!panneauPartiel || panneauPartiel.hidden) return;
      panneauPartiel.hidden = true;
      boutonSortie?.setAttribute('aria-expanded', 'false');
      consentPartiel?.closest('.demande-consent')?.removeAttribute('data-invalide');
    }

    boutonSortie?.addEventListener('click', () => {
      if (panneauPartiel?.hidden) ouvrirPartiel();
      else fermerPartiel();
    });
    boutonAnnuler?.addEventListener('click', () => {
      fermerPartiel();
      boutonSortie?.focus();
    });
    boutonPartiel?.addEventListener('click', () => void envoyer(true));

    /* ---------- Envoi ---------- */

    function afficherStatut(etat: 'sending' | 'error' | null, message = ''): void {
      if (!statut) return;
      if (!etat) {
        statut.hidden = true;
        statut.removeAttribute('data-state');
        statut.textContent = '';
        return;
      }
      statut.hidden = false;
      statut.setAttribute('data-state', etat);
      statut.textContent = message;
    }

    function enCours(actif: boolean, partiel: boolean): void {
      envoiEnCours = actif;
      if (boutonPrincipal) boutonPrincipal.disabled = actif;
      if (boutonPartiel) boutonPartiel.disabled = actif;
      if (partiel) libelle(boutonPartiel, actif ? 'envoi' : 'partiel');
      else libelle(boutonPrincipal, actif ? 'envoi' : 'envoyer');
    }

    async function envoyer(partiel: boolean): Promise<void> {
      if (envoiEnCours || envoye) return;

      // Le minimum, dans tous les cas : de quoi joindre le client.
      const projet = ETAPES[0]!;
      if (requisManquants(projet, lire).length > 0) {
        if (courante !== projet.cle) aller(projet.cle);
        valider(projet);
        return;
      }

      if (partiel) {
        if (!consentPartiel?.checked) {
          consentPartiel?.closest('.demande-consent')?.setAttribute('data-invalide', '');
          consentPartiel?.focus();
          return;
        }
      } else {
        // « Envoyer ma demande » veut dire complète : une étape sautée (par le bouton
        // « suivant » du navigateur) est rouverte plutôt que de partir à moitié vide.
        const lacune = parcours().find((e) => requisManquants(e, lire).length > 0);
        if (lacune) {
          if (lacune.cle !== courante) aller(lacune.cle);
          valider(lacune);
          return;
        }
        if (!consentFinal?.checked) {
          consentFinal?.closest('.demande-consent')?.setAttribute('data-invalide', '');
          if (erreurEtape) erreurEtape.hidden = false;
          consentFinal?.focus();
          return;
        }
      }

      const charge: Record<string, unknown> = {};
      new FormData(form).forEach((valeur, cle) => {
        const v = typeof valeur === 'string' ? valeur : '';
        const deja = charge[cle];
        if (deja === undefined) charge[cle] = v;
        else if (Array.isArray(deja)) deja.push(v);
        else charge[cle] = [deja, v];
      });
      charge.consentement = true;
      charge.envoi_partiel = partiel;
      charge.etape_atteinte = courante;

      enCours(true, partiel);
      afficherStatut('sending', 'Envoi de votre demande…');

      try {
        const reponse = await fetch('/api/demande-submit', {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify(charge),
        });
        if (!reponse.ok) throw new Error(`Erreur ${reponse.status}`);
      } catch {
        enCours(false, partiel);
        afficherStatut('error', "Une erreur est survenue lors de l'envoi. Veuillez vérifier votre connexion et réessayer.");
        return;
      }

      envoye = true;
      effacerReprise();
      // `envoi` distingue dans GA4 et Google Ads une demande complète d'une demande partielle ;
      // ni nom ni réponse n'y figurent — seulement des clés du catalogue.
      convertir({
        form_name: 'demande',
        envoi: partiel ? 'partiel' : 'complet',
        type_demande: lire('type_demande'),
        etape: courante,
      });
      form.reset();
      form.hidden = true;
      if (progression) progression.hidden = true;
      afficherStatut(null);
      if (succes) {
        succes.querySelectorAll<HTMLElement>('[data-succes]').forEach((p) => {
          p.hidden = p.dataset.succes !== (partiel ? 'partiel' : 'complet');
        });
        succes.hidden = false;
        // Saut immédiat (« instant » l'emporte sur le scroll-behavior: smooth de global.css) :
        // le formulaire vient de disparaître, la page a raccourci d'autant et un défilement
        // animé partirait du pied de page.
        carte?.scrollIntoView({ behavior: 'instant', block: 'start' });
        document.getElementById('demande-success-titre')?.focus({ preventScroll: true });
      }
    }

    afficher(courante, false);
  }
</script>
