    color: var(--ink, #1f1e1c);
    text-overflow: ellipsis;
    white-space: nowrap;
  }

  /* L'étiquette par case ne sert qu'une fois les colonnes empilées. */
  .ct-identite-qui-case {
    display: none;
  }

  /* ---------- Suivi des contrats en cours ---------- */

  /* Le compte reste discret tant qu'il n'y a rien à faire, et devient une pastille
     lisible dès qu'un dossier attend la courtière : c'est le seul signal visible
     quand la section est repliée. */
  .ct-repliable-note[data-ton='action'] {
    padding: 0.12rem 0.55rem;
    border-radius: 999px;
    background: #eaf5ec;
    color: #26603a;
    font-weight: 700;
  }

  .ct-repliable-note[data-ton='alerte'] {
    padding: 0.12rem 0.55rem;
    border-radius: 999px;
    background: #fdeceb;
    color: #8f2f28;
    font-weight: 700;
  }

  .ct-suivi[open] {
    border-color: #d8cbb8;
  }

  .ct-suivi-pied {
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    gap: 0.3rem 0.8rem;
    margin-top: 0.2rem;
  }

  .ct-suivi-horodatage {
    font-size: 0.78rem;
    color: var(--muted);
  }

  /* Les cartes de dossier, elles, sont bâties en JavaScript : leurs règles vivent dans le
     bloc `is:global` plus bas — le style scopé d'Astro ne les atteindrait pas. */

  .ct-etapes {
    margin: 0 0 0.5rem;
    padding-left: 1.2rem;
    font-size: 0.9rem;
    line-height: 1.6;
  }

  .ct-etapes li {
    margin-bottom: 0.4rem;
  }

  .ct-memoriser {
    display: flex;
    align-items: center;
    gap: 0.8rem;
    margin-top: 1.1rem;
  }

  .ct-memoriser-etat {
    font-size: 0.82rem;
    color: #26603a;
  }

  /* `.btn` seul n'a aucune règle dans global.css : sans celles-ci, « Aperçu » s'affichait
     en bouton brut du navigateur, collé au bouton principal. Même gabarit que lui. */
  .ct-bouton-secondaire {
    padding: 0.9rem 1.4rem;
    border: 2px solid var(--border, #c9bba8);
    border-radius: 50px;
    background: #fff;
    color: var(--ink, #1f1e1c);
