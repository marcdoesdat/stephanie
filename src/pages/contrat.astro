  }

  /* Des cases à la taille du doigt, aux couleurs du site. */
  .ct-case input {
    width: 1.15rem;
    height: 1.15rem;
    margin-top: 0.05rem;
    flex: 0 0 auto;
    accent-color: var(--clay, #a85f38);
  }

  .ct-case-large {
    padding: 0.6rem 0;
  }

  .ct-identite-ligne {
    display: grid;
