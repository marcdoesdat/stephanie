<script>
  import type { SignaturePadElement } from '../scripts/signaturePad';
  import { ErreurImport, importerSignature } from '../scripts/importSignature';
  import { comparerContrats, motifUrgenceContrat, type ResumeEcran } from '../utils/tableauDeBord';
  import { aujourdhuiIso, depuisTexteContrat, versTexteContrat } from '../utils/dateContrat';
  import { estCourrielValide, NOM_MIN } from '../utils/contratCourtage';

  /* ---------------- Formulaire ---------------- */

  const form = document.getElementById('ct-form') as HTMLFormElement | null;
  if (form) {
    // Alias non nullable : les fonctions déclarées plus bas capturent le formulaire, et
    // TypeScript ne conserve pas l'affinage de `form` à travers une déclaration de fonction.
    const formulaire: HTMLFormElement = form;
    let signatureEnregistree = formulaire.dataset.signatureEnregistree === 'oui';
    const courrielCourtiere = formulaire.dataset.courrielCourtiere ?? '';

    /* ---------------- Cases de date ----------------
     * Le calendrier parle ISO ; le contrat porte « 30 avril 2027 ». On convertit ici, dans les
     * deux sens, et le serveur continue de recevoir le texte qu'il a toujours reçu.
     * Un ancien texte qu'on ne sait pas relire comme une date (« fin avril ») n'est pas effacé
     * en silence : il est gardé tel quel et affiché sous la case jusqu'à ce qu'une date soit
     * choisie.
     */
    const noteAncienne = (champ: HTMLInputElement) =>
      champ.parentElement?.querySelector<HTMLElement>('[data-date-ancienne]') ?? null;

    function lireChamp(champ: HTMLInputElement | HTMLTextAreaElement | HTMLSelectElement): string {
      if (!(champ instanceof HTMLInputElement) || !('dateContrat' in champ.dataset)) return champ.value.trim();
      if (champ.value) return versTexteContrat(champ.value);
      return champ.dataset.texteAncien ?? '';
    }

    function poserChamp(champ: HTMLInputElement | HTMLTextAreaElement | HTMLSelectElement, texte: string): void {
      if (!(champ instanceof HTMLInputElement) || !('dateContrat' in champ.dataset)) {
        champ.value = texte;
        return;
      }
      const iso = depuisTexteContrat(texte);
      champ.value = iso ?? '';
      const note = noteAncienne(champ);
      if (iso === null && texte.trim() !== '') {
        champ.dataset.texteAncien = texte.trim();
        if (note) {
          note.textContent = `Valeur actuelle : « ${texte.trim()} » — choisissez la date dans le calendrier.`;
          note.hidden = false;
        }
      } else {
        delete champ.dataset.texteAncien;
        if (note) note.hidden = true;
      }
    }

    for (const champ of document.querySelectorAll<HTMLInputElement>('[data-date-contrat]')) {
      champ.addEventListener('input', () => {
        delete champ.dataset.texteAncien;
        const note = noteAncienne(champ);
        if (note) note.hidden = true;
      });
    }

    for (const bouton of document.querySelectorAll<HTMLButtonElement>('[data-date-aujourdhui]')) {
      bouton.addEventListener('click', () => {
        const champ = document.getElementById(bouton.dataset.dateAujourdhui ?? '') as HTMLInputElement | null;
        if (!champ) return;
        champ.value = aujourdhuiIso();
        champ.dispatchEvent(new Event('input', { bubbles: true }));
      });
    }

    const valeur = (id: string): string => {
      const champ = document.getElementById(id) as HTMLInputElement | HTMLTextAreaElement | HTMLSelectElement | null;
      return champ ? lireChamp(champ) : '';
    };

    const blocs = () => [...formulaire.querySelectorAll<HTMLElement>('[data-emprunteur]')];
    const visibles = () => blocs().filter((bloc) => !bloc.hidden);

    /* ---------------- Signature de la courtière ---------------- */

    const barreSignature = formulaire.querySelector<HTMLElement>('.ct-signature-barre');
    const saisieSignature = formulaire.querySelector<HTMLElement>('.ct-signature-saisie');
    const erreurSignature = formulaire.querySelector<HTMLElement>('[data-erreur-signature]');

    formulaire.querySelector('[data-remplacer-signature]')?.addEventListener('click', () => {
      if (saisieSignature) saisieSignature.hidden = false;
    });
    formulaire.querySelector('[data-annuler-signature]')?.addEventListener('click', () => {
      if (saisieSignature) saisieSignature.hidden = true;
    });

    // Une signature importée prend le pas sur le canevas : c'est le dernier geste posé
    // qui compte, et l'aperçu montre laquelle sera enregistrée.
    let signatureImportee: string | null = null;

    formulaire.querySelector<HTMLInputElement>('[data-fichier-signature]')?.addEventListener('change', async (evenement) => {
      const entree = evenement.currentTarget as HTMLInputElement;
      const fichier = entree.files?.[0];
      if (!fichier) return;
      if (erreurSignature) erreurSignature.hidden = true;

      try {
        signatureImportee = await importerSignature(fichier);
        const bloc = formulaire.querySelector<HTMLElement>('[data-import-apercu]');
        const image = formulaire.querySelector<HTMLImageElement>('[data-import-image]');
        if (image) image.src = signatureImportee;
        if (bloc) bloc.hidden = false;
      } catch (err) {
        signatureImportee = null;
        if (erreurSignature) {
          erreurSignature.textContent =
            err instanceof ErreurImport ? err.message : 'Image illisible. Essayez une autre photo.';
          erreurSignature.hidden = false;
        }
      } finally {
        // Permet de reprendre le même fichier après une correction.
        entree.value = '';
      }
    });

    formulaire.querySelector('[data-enregistrer-signature]')?.addEventListener('click', async (evenement) => {
      const bouton = evenement.currentTarget as HTMLButtonElement;
      if (erreurSignature) erreurSignature.hidden = true;

      const pad = document.getElementById('ct-signature') as SignaturePadElement | null;
      const png = signatureImportee ?? pad?.versPng();
      if (!png) {
        if (erreurSignature) {
          erreurSignature.textContent =
            'Dessinez votre signature dans le cadre, ou importez-en une photo.';
          erreurSignature.hidden = false;
        }
        return;
      }

      bouton.disabled = true;
      const libelle = bouton.textContent;
      bouton.textContent = 'Enregistrement…';

      try {
        const reponse = await fetch('/api/contrat-reglages', {
          method: 'PUT',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({ signature: png }),
        });
        if (!reponse.ok) {
          const data = (await reponse.json().catch(() => ({}))) as { error?: string };
          if (erreurSignature) {
            erreurSignature.textContent = data.error ?? 'Enregistrement impossible.';
            erreurSignature.hidden = false;
          }
          bouton.disabled = false;
          bouton.textContent = libelle;
          return;
        }
        signatureEnregistree = true;
        // Recharger montre l'aperçu de la signature servie par le serveur — la preuve
        // qu'elle est bien enregistrée, et non seulement dessinée à l'écran.
        window.location.reload();
      } catch {
        if (erreurSignature) {
          erreurSignature.textContent = 'Connexion impossible. Réessayez.';
          erreurSignature.hidden = false;
        }
        bouton.disabled = false;
        bouton.textContent = libelle;
      }
    });

    /* ---------------- Emprunteurs et signatures en présence ---------------- */

    function rafraichir(): void {
      // Le bouton « Ajouter » disparaît quand les trois blocs du modèle sont utilisés.
      const ajouter = formulaire.querySelector<HTMLElement>('[data-ajouter]');
      if (ajouter) ajouter.hidden = visibles().length >= blocs().length;
      majColonnesIdentite();
      majResume();
      majBouton();
    }

    /**
     * Le bouton dit à qui part le contrat, et comment : « Créer et envoyer » ne disait ni
     * l'un ni l'autre, et le même libellé couvrait un courriel et une signature sur place.
     * Lit l'état dans la page plutôt que dans `bouton` / `correction`, déclarés plus bas :
     * `rafraichir` s'exécute avant eux.
     */
    function majBouton(): void {
      const cible = formulaire.querySelector<HTMLButtonElement>('[data-envoyer]');
      // Désactivé : un envoi est en cours ou terminé, son libellé lui appartient.
      if (!cible || cible.disabled) return;
      if (formulaire.querySelector<HTMLElement>('[data-correction]')?.hidden === false) {
        cible.textContent = 'Enregistrer la correction';
        return;
      }
      const mode = formulaire.querySelector<HTMLInputElement>('input[name="ct-mode"]:checked')?.value;
      if (mode === 'presence') {
        cible.textContent = 'Faire signer sur place';
        return;
      }
      const premier = visibles()[0];
      const prenom = premier ? valeur(`ct-prenom-${premier.dataset.emprunteur}`) : '';
      cible.textContent = prenom ? `Envoyer à ${prenom}` : 'Envoyer le contrat';
    }

    /**
     * Le tableau d'identité n'offre une colonne qu'aux emprunteurs affichés, sous leur
     * prénom. Trente cases dont vingt inutiles, sans nom au-dessus, se remplissaient au
     * jugé — et, sur téléphone, rien ne disait quelle case empilée était à qui.
     */
    function majColonnesIdentite(): void {
      const table = formulaire.querySelector<HTMLElement>('[data-identite-table]');
      if (!table) return;
      const affiches = new Set(visibles().map((bloc) => bloc.dataset.emprunteur));
      table.style.setProperty('--ct-colonnes', String(Math.max(affiches.size, 1)));
      table.dataset.colonnes = affiches.size > 1 ? 'multi' : 'une';

      for (const element of table.querySelectorAll<HTMLElement>('.ct-identite-cellule, .ct-identite-entete [data-colonne]')) {
        element.hidden = !affiches.has(element.dataset.colonne);
      }
      for (const etiquette of table.querySelectorAll<HTMLElement>('[data-identite-qui]')) {
        const rang = etiquette.dataset.identiteQui ?? '0';
        const prenom = valeur(`ct-prenom-${rang}`);
        etiquette.textContent = prenom || `Emprunteur ${Number(rang) + 1}`;
        etiquette.hidden = !affiches.has(rang);
      }
    }

    /** Rappelle, sans remonter la page, ce qui partira réellement. */
    function majResume(): void {
      const cible = formulaire.querySelector<HTMLElement>('[data-resume]');
      if (!cible) return;

      const noms = visibles()
        .map((bloc) => `${valeur(`ct-prenom-${bloc.dataset.emprunteur}`)} ${valeur(`ct-nom-${bloc.dataset.emprunteur}`)}`.trim())
        .filter((nom) => nom !== '');

      const types = [...formulaire.querySelectorAll<HTMLInputElement>('[data-type-financement]')]
        .filter((entree) => entree.checked)
        .map((entree) => entree.closest('label')?.querySelector('span')?.textContent?.trim() ?? '');

      const morceaux: string[] = [];
      morceaux.push(noms.length ? noms.join(', ') : 'Aucun emprunteur saisi');
      if (types.length) morceaux.push(types.join(', '));
      const montant = valeur('ct-montant');
      if (montant) morceaux.push(`${montant} $`);

      cible.textContent = morceaux.join(' · ');
    }

    formulaire.querySelector('[data-ajouter]')?.addEventListener('click', () => {
      const suivant = blocs().find((bloc) => bloc.hidden);
      if (suivant) suivant.hidden = false;
      rafraichir();
    });

    for (const bouton of formulaire.querySelectorAll<HTMLButtonElement>('[data-retirer]')) {
      bouton.addEventListener('click', () => {
        const bloc = formulaire.querySelector<HTMLElement>(`[data-emprunteur="${bouton.dataset.retirer}"]`);
        if (!bloc) return;
        bloc.hidden = true;
        for (const champ of bloc.querySelectorAll<HTMLInputElement>('input')) champ.value = '';
        // Sa colonne du tableau d'identité part avec lui : ses pièces, restées en place,
        // reviendraient sous le nom du prochain emprunteur ajouté à ce rang.
        for (const champ of formulaire.querySelectorAll<HTMLInputElement>(
          `[data-identite][data-colonne="${bouton.dataset.retirer}"]`,
        )) {
          poserChamp(champ, '');
        }
        rafraichir();
      });
    }

    // Entrée dans un champ ne doit pas envoyer le contrat : la soumission implicite d'un
    // formulaire HTML expédierait un lien de signature au client au milieu de la saisie.
    // Seul le bouton envoie. Les zones de texte gardent leur retour à la ligne.
    formulaire.addEventListener('keydown', (evenement) => {
      if (evenement.key === 'Enter' && evenement.target instanceof HTMLInputElement) evenement.preventDefault();
    });

    formulaire.addEventListener('input', () => rafraichir());
    formulaire.addEventListener('change', () => rafraichir());
    rafraichir();

    /* ---------------- Mémorisation des valeurs habituelles ---------------- */

    formulaire.querySelector('[data-memoriser]')?.addEventListener('click', async (evenement) => {
      const bouton = evenement.currentTarget as HTMLButtonElement;
      const etat = formulaire.querySelector<HTMLElement>('[data-memoriser-etat]');
      const defauts: Record<string, string> = {};
      for (const champ of formulaire.querySelectorAll<HTMLInputElement | HTMLSelectElement>('[data-defaut]')) {
        defauts[champ.dataset.defaut ?? ''] = champ.value.trim();
      }

      bouton.disabled = true;
      try {
        const reponse = await fetch('/api/contrat-reglages', {
          method: 'PUT',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({ defauts }),
        });
        if (etat) {
          etat.textContent = reponse.ok ? 'Enregistré ✓' : 'Échec de l’enregistrement';
          etat.hidden = false;
        }
      } catch {
        if (etat) {
          etat.textContent = 'Échec de l’enregistrement';
          etat.hidden = false;
        }
      } finally {
        bouton.disabled = false;
      }
    });

    /* ---------------- Suivi des contrats en cours ---------------- */

    /** Ce que /api/contrat-dossiers rend, enrichi de ce que le suivi affiche. */
    interface ResumeDossier extends ResumeEcran {
      readonly creeLe: string;
      readonly mode: string;
      readonly emprunteurs: Array<{ nom: string; courriel: string; signeLe: string | null }>;
      readonly courant: { nom: string; courriel: string } | null;
      readonly corrigeLe: string | null;
      readonly refuseCourriel?: string | null;
    }

    const suivi = document.getElementById('ct-suivi') as HTMLDetailsElement | null;
    let suiviCharge = false;
    let suiviOuvertAuto = false;

    const RELATIF = new Intl.RelativeTimeFormat('fr-CA', { numeric: 'auto' });
    const DATE_COMPLETE = new Intl.DateTimeFormat('fr-CA', { dateStyle: 'long', timeStyle: 'short' });

    /**
     * « hier », « dans 6 jours » — au grain qui parle : l'heure sous une journée, le jour
     * au-delà. Un horodatage exact demande un calcul mental que « expire demain » épargne.
     */
    function relatif(iso: string): string {
      const cible = Date.parse(iso);
      if (Number.isNaN(cible)) return '';
      const ecart = cible - Date.now();

      const minutes = Math.round(ecart / 60000);
      if (Math.abs(minutes) < 1) return 'à l’instant';
      if (Math.abs(minutes) < 60) return RELATIF.format(minutes, 'minute');

      const heures = Math.round(ecart / 3600000);
      if (Math.abs(heures) < 24) return RELATIF.format(heures, 'hour');
      return RELATIF.format(Math.round(ecart / 86400000), 'day');
    }

    function dateComplete(iso: string): string {
      const instant = Date.parse(iso);
      return Number.isNaN(instant) ? '' : DATE_COMPLETE.format(new Date(instant));
    }

    /**
     * Un dossier qui attend un geste d'elle — ce sont ceux qui font ouvrir la section.
     * La règle n'a qu'un exemplaire : `motifUrgenceContrat`, partagé avec le tableau de
     * bord. Y compris pour le seuil d'expiration : il vit dans `tableauDeBord.ts`, pas ici.
     */
    function reclameSonAttention(dossier: ResumeDossier): boolean {
      return motifUrgenceContrat(dossier) !== null;
    }

    function texteEtat(dossier: ResumeDossier): string {
      if (dossier.statut === 'a_finaliser') return 'à signer par vous';
      if (dossier.statut === 'gele') return 'refusé';
      if (dossier.statut === 'annule') return 'annulé';
      return dossier.mode === 'presence' ? 'à faire signer' : 'en attente';
    }

    /** Une ligne de contexte : depuis quand, où en est la séquence, jusqu'à quand. */
    function construireMeta(dossier: ResumeDossier): HTMLParagraphElement {
      const meta = document.createElement('p');
      meta.className = 'ct-dossier-meta';

      const total = dossier.emprunteurs.length;
      const signes = dossier.emprunteurs.filter((e) => e.signeLe).length;
      const progression =
        total === 1
          ? signes === 1
            ? 'signé'
            : 'pas encore signé'
          : `${signes} signature${signes > 1 ? 's' : ''} sur ${total}`;
      const depart = dossier.mode === 'presence' ? 'Créé' : 'Envoyé';

      const debut = document.createElement('span');
      debut.textContent = `${depart} ${relatif(dossier.creeLe)} · ${progression}`;
      debut.title = `Créé le ${dateComplete(dossier.creeLe)}`;
      meta.append(debut);

      // Une correction relance la séquence : sans cette mention, « 0 signature sur 2 » sur un
      // dossier envoyé il y a une semaine aurait l'air d'un dossier qui dort.
      if (dossier.corrigeLe) {
        const corrige = document.createElement('span');
        corrige.textContent = ` · corrigé ${relatif(dossier.corrigeLe)}`;
        corrige.title = `Corrigé le ${dateComplete(dossier.corrigeLe)}`;
        meta.append(corrige);
      }

      if (dossier.statut !== 'gele' && dossier.statut !== 'annule') {
        const echeance = document.createElement('span');
        if (motifUrgenceContrat(dossier)?.type === 'bientot_perime') echeance.className = 'ct-urgent';
        echeance.textContent = ` · expire ${relatif(dossier.expireLe)}`;
        echeance.title = `Les liens cessent de valoir le ${dateComplete(dossier.expireLe)}.`;
        meta.append(echeance);
      }

      return meta;
    }

    /**
     * La séquence de signature, un signataire par ligne. Le tour de chacun se lit d'un
     * coup d'œil : c'est la question qu'on se pose en ouvrant cet écran.
     */
    function construireSignataires(dossier: ResumeDossier): HTMLOListElement {
      const signataires = document.createElement('ol');
      signataires.className = 'ct-dossier-signataires';

      for (const emprunteur of dossier.emprunteurs) {
        const ligne = document.createElement('li');
        const estCourant =
          dossier.statut === 'en_attente' && dossier.courant?.courriel === emprunteur.courriel;
        const aRefuse =
          dossier.statut === 'gele' &&
          (dossier.refuseCourriel
            ? emprunteur.courriel === dossier.refuseCourriel
            : emprunteur.nom === dossier.refusePar);
        ligne.dataset.etape = emprunteur.signeLe
          ? 'signe'
          : aRefuse
            ? 'refus'
            : estCourant
              ? 'courant'
              : 'attente';

        const puce = document.createElement('span');
        puce.className = 'ct-puce';
        puce.setAttribute('aria-hidden', 'true');
        puce.textContent = emprunteur.signeLe ? '✓' : aRefuse ? '✕' : estCourant ? '▸' : '○';
        ligne.append(puce);

        // Nom et note dans une même colonne : sur un écran étroit, la note qui déborde
        // revient sous le nom plutôt que sous la puce.
        const corps = document.createElement('span');
        corps.className = 'ct-etape-corps';
        ligne.append(corps);

        const nom = document.createElement('span');
        nom.textContent = emprunteur.nom;
        corps.append(nom);

        const note = document.createElement('span');
        note.className = 'ct-etape-note';
        if (emprunteur.signeLe) {
          note.textContent = `signé ${relatif(emprunteur.signeLe)}`;
          note.title = dateComplete(emprunteur.signeLe);
        } else if (dossier.statut === 'gele') {
          note.textContent = aRefuse ? 'a refusé de signer' : 'n’a pas signé';
        } else if (estCourant) {
          // L'adresse est montrée là où elle compte. Une faute de frappe ne se manifeste
          // autrement que par un silence qu'on prend pour de la lenteur.
          note.textContent =
            dossier.mode === 'presence' ? 'c’est son tour — sur place' : `c’est son tour — ${emprunteur.courriel}`;
        } else {
          note.textContent = 'recevra son lien à son tour';
        }
        corps.append(note);

        signataires.append(ligne);
      }

      return signataires;
    }

    function construireActions(dossier: ResumeDossier): HTMLDivElement {
      const actions = document.createElement('div');
      actions.className = 'ct-dossier-actions';

      if (dossier.statut === 'a_finaliser') {
        const finaliser = document.createElement('a');
        finaliser.href = `/finaliser-contrat?d=${encodeURIComponent(dossier.id)}`;
        finaliser.className = 'btn btn-primary ct-bouton-petit';
        finaliser.textContent = 'Relire et signer →';
        actions.append(finaliser);
        actions.append(boutonCorriger(dossier));
        actions.append(boutonAnnuler(dossier));
      } else if (dossier.statut === 'en_attente' && dossier.courant) {
        const relancer = document.createElement('button');
        relancer.type = 'button';
        relancer.className = 'ct-lien';
        relancer.textContent =
          dossier.mode === 'presence'
            ? `Rouvrir le lien de ${dossier.courant.nom}`
            : `Renvoyer le lien à ${dossier.courant.nom}`;
        relancer.title = 'L’ancien lien cesse aussitôt de fonctionner.';
        relancer.addEventListener('click', () => relancerLien(dossier.id, relancer, actions));
        actions.append(relancer);

        const corriger = document.createElement('button');
        corriger.type = 'button';
        corriger.className = 'ct-lien';
        corriger.textContent = 'Corriger le courriel';
        corriger.title = 'Le lien partira vers la nouvelle adresse.';
        corriger.addEventListener('click', () => corrigerCourriel(dossier, corriger, actions));
        actions.append(corriger);

        actions.append(boutonCorriger(dossier));
        actions.append(boutonAnnuler(dossier));
      } else if (dossier.refusePar) {
        const note = document.createElement('span');
        note.className = 'ct-note-action';
        note.textContent = `Refusé par ${dossier.refusePar} — aucun contrat ne sera produit. Préparez-en un nouveau.`;
        actions.append(note);
      } else if (dossier.statut === 'annule') {
        const note = document.createElement('span');
        note.className = 'ct-note-action';
        note.textContent = 'Annulé — aucun contrat ne sera produit à partir de ce dossier.';
        actions.append(note);
      }

      return actions;
    }

    /**
     * « Corriger le contrat » — remplit le formulaire avec le dossier, pour une coquille ou un
     * montant. Les signatures déjà recueillies tomberont à l'enregistrement : le titre le dit
     * dès le survol, et le bandeau de correction le redit avant qu'elle n'enregistre.
     */
    function boutonCorriger(dossier: ResumeDossier): HTMLButtonElement {
      const corriger = document.createElement('button');
      corriger.type = 'button';
      corriger.className = 'ct-lien';
      corriger.textContent = 'Corriger le contrat';
      corriger.title = dossier.emprunteurs.some((e) => e.signeLe)
        ? 'Sans rien ressaisir. Les signatures déjà recueillies seront écartées : chacun signera le texte corrigé.'
        : 'Sans rien ressaisir. Le lien déjà envoyé sera remplacé.';
      corriger.addEventListener('click', () => ouvrirCorrection(dossier, corriger));
      return corriger;
    }

    /** « Annuler le contrat » — tuera tous les liens et préviendra les emprunteurs. */
    function boutonAnnuler(dossier: ResumeDossier): HTMLButtonElement {
      const annuler = document.createElement('button');
      annuler.type = 'button';
      annuler.className = 'ct-lien ct-lien-danger';
      annuler.textContent = 'Annuler le contrat';
      annuler.title = 'Tous les liens cesseront de fonctionner et les emprunteurs seront prévenus.';
      annuler.addEventListener('click', () => annulerContrat(dossier, annuler));
      return annuler;
    }

    /** Le compte replié : discret quand tout suit son cours, pastille quand elle est attendue. */
    function resumerEnTete(compte: HTMLElement | null, dossiers: ResumeDossier[]): void {
      if (!compte) return;

      const aFinaliser = dossiers.filter((d) => d.statut === 'a_finaliser').length;
      const refuses = dossiers.filter((d) => d.statut === 'gele').length;
      const annules = dossiers.filter((d) => d.statut === 'annule').length;
      const attendus = dossiers.length - aFinaliser - refuses - annules;

      const parties: string[] = [];
      if (aFinaliser > 0) parties.push(`${aFinaliser} à signer par vous`);
      if (refuses > 0) parties.push(refuses > 1 ? `${refuses} refusés` : '1 refusé');
      if (attendus > 0) parties.push(`${attendus} en attente de signature`);
      if (annules > 0) parties.push(annules > 1 ? `${annules} annulés` : '1 annulé');

      if (aFinaliser > 0) compte.dataset.ton = 'action';
      else if (refuses > 0) compte.dataset.ton = 'alerte';
      else delete compte.dataset.ton;

      compte.textContent = parties.length === 0 ? 'aucun' : parties.join(' · ');
    }

    async function chargerSuivi(): Promise<void> {
      const etat = formulaire.querySelector<HTMLElement>('[data-suivi-etat]');
      const liste = formulaire.querySelector<HTMLElement>('[data-suivi-liste]');
      const compte = formulaire.querySelector<HTMLElement>('[data-suivi-compte]');
      const pied = formulaire.querySelector<HTMLElement>('[data-suivi-pied]');
      const horodatage = formulaire.querySelector<HTMLElement>('[data-suivi-horodatage]');
      if (!liste || !etat) return;

      etat.textContent = 'Chargement…';
      etat.hidden = false;
      liste.innerHTML = '';

      try {
        const reponse = await fetch('/api/contrat-dossiers');
        const data = (await reponse.json().catch(() => ({}))) as Record<string, unknown>;
        if (!reponse.ok) {
          suiviCharge = false; // Un échec ne doit pas figer la section sur son message d'erreur.
          if (compte) {
            compte.dataset.ton = 'alerte';
            compte.textContent = 'indisponible';
          }
          etat.textContent =
            data.code === 'acces'
              ? 'Votre session a expiré. Rechargez la page pour vous reconnecter.'
              : String(data.error ?? 'Chargement impossible.');
          if (pied) pied.hidden = false;
          return;
        }

        const dossiers = (data.dossiers ?? []) as ResumeDossier[];

        // Le serveur trie du plus récent au plus ancien. Ici, c'est l'ordre commun au
        // tableau de bord : refus d'abord, puis finalisation, puis expiration proche, et
        // ce qui expire le plus tôt à rang égal. La règle vit dans `tableauDeBord.ts` —
        // les deux écrans doivent nommer la même urgence.
        dossiers.sort(comparerContrats);

        resumerEnTete(compte, dossiers);

        if (pied) pied.hidden = false;
        if (horodatage) {
          horodatage.textContent = `à jour à ${new Intl.DateTimeFormat('fr-CA', { timeStyle: 'short' }).format(new Date())}`;
        }

        if (dossiers.length === 0) {
          etat.textContent =
            'Aucun contrat en cours. Ceux qui sont signés et envoyés sont retirés d’ici automatiquement.';
          return;
        }
        etat.hidden = true;

        for (const dossier of dossiers) {
          const bloc = document.createElement('div');
          bloc.className = 'ct-dossier';
          bloc.dataset.statut = dossier.statut;

          const titre = document.createElement('p');
          titre.className = 'ct-dossier-titre';
          titre.append(dossier.emprunteurs.map((e) => e.nom).join(', '));
          const etiquette = document.createElement('span');
          etiquette.className = 'ct-etat';
          etiquette.dataset.etat = dossier.statut;
          etiquette.textContent = texteEtat(dossier);
          titre.append(etiquette);

          bloc.append(titre, construireMeta(dossier), construireSignataires(dossier), construireActions(dossier));
          liste.append(bloc);
        }

        // S'ouvrir d'elle-même quand un dossier lui revient : le seul cas où l'écran de
        // suivi est plus urgent que le formulaire qu'elle est venue remplir.
        if (suivi && !suivi.open && !suiviOuvertAuto && dossiers.some(reclameSonAttention)) {
          suiviOuvertAuto = true;
          suivi.open = true;
        }
      } catch {
        suiviCharge = false;
        etat.textContent = 'Connexion impossible. Vérifiez votre réseau, puis actualisez.';
        if (pied) pied.hidden = false;
      }
    }

    /**
     * Affiche un lien de signature en présentiel. C'est le seul endroit où ce jeton
     * apparaît — il doit se voir, et pouvoir partir par texto sans être recopié à la main.
     */
    function ajouterLienPresence(hote: HTMLElement, url: string, nom: string): void {
      const lien = document.createElement('a');
      lien.href = url;
      lien.className = 'ct-lien-signature';
      lien.textContent = `Faire signer ${nom} →`;
      hote.append(lien);

      if (!navigator.clipboard) return;
      const copier = document.createElement('button');
      copier.type = 'button';
      copier.className = 'ct-lien';
      copier.textContent = 'copier le lien';
      copier.addEventListener('click', async () => {
        try {
          await navigator.clipboard.writeText(new URL(url, location.origin).href);
          copier.textContent = 'lien copié ✓';
        } catch {
          copier.textContent = 'copie impossible — ouvrez le lien';
        }
      });
      hote.append(copier);
    }

    /**
     * Une erreur réseau ne doit pas passer pour rien : le bouton qui revient seul laissait
     * croire que le geste avait abouti. Le message précédent est remplacé, pas empilé.
     */
    function noterEchec(actions: HTMLElement, message: string): void {
      actions.querySelector('.ct-note-echec')?.remove();
      const echec = document.createElement('span');
      echec.className = 'ct-note-echec';
      echec.textContent = message;
      actions.append(echec);
    }

    /** Réémet le lien du signataire courant ; l'ancien cesse aussitôt de valoir. */
    async function relancerLien(id: string, bouton: HTMLButtonElement, actions: HTMLElement): Promise<void> {
      bouton.disabled = true;
      const libelle = bouton.textContent;
      bouton.textContent = 'Envoi…';

      try {
        const reponse = await fetch('/api/contrat-relancer', {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({ d: id }),
        });
        const data = (await reponse.json().catch(() => ({}))) as Record<string, unknown>;

        if (!reponse.ok) {
          const echec = document.createElement('span');
          echec.className = 'ct-note-echec';
          echec.textContent = String(data.error ?? 'La relance a échoué.');
          actions.append(echec);
          bouton.disabled = false;
          bouton.textContent = libelle;
          return;
        }

        // Le bouton disparaît : le lien qu'il vient de produire est le seul valide, et
        // relancer une seconde fois le périmerait aussitôt.
        bouton.remove();

        if (data.mode === 'presence' && typeof data.lien === 'string') {
          ajouterLienPresence(actions, data.lien, String(data.nom ?? 'l’emprunteur'));
        } else {
          const succes = document.createElement('span');
          succes.className = 'ct-note-succes';
          succes.textContent = `Nouveau lien envoyé à ${String(data.courriel ?? data.nom ?? '')}. L’ancien ne fonctionne plus.`;
          actions.append(succes);
        }
      } catch {
        bouton.disabled = false;
        bouton.textContent = libelle;
        noterEchec(actions, 'Connexion impossible : aucun lien n’a été renvoyé. Réessayez.');
      }
    }

    /** Corrige le courriel du signataire courant, puis renvoie le lien à la bonne adresse. */
    async function corrigerCourriel(
      dossier: ResumeDossier,
      bouton: HTMLButtonElement,
      actions: HTMLElement,
    ): Promise<void> {
      const actuel = dossier.courant?.courriel ?? '';
      const saisi = window.prompt('Nouvelle adresse courriel du signataire :', actuel);
      if (saisi === null) return; // geste annulé
      const courriel = saisi.trim();
      if (!courriel) return;

      bouton.disabled = true;
      const libelle = bouton.textContent;
      bouton.textContent = 'Envoi…';

      try {
        const reponse = await fetch('/api/contrat-relancer', {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({ d: dossier.id, courriel }),
        });
        const data = (await reponse.json().catch(() => ({}))) as Record<string, unknown>;

        if (!reponse.ok) {
          const echec = document.createElement('span');
          echec.className = 'ct-note-echec';
          echec.textContent = String(data.error ?? 'La correction a échoué.');
          actions.append(echec);
          bouton.disabled = false;
          bouton.textContent = libelle;
          return;
        }

        // L'ancien lien est mort. En présentiel, le nouveau n'est montré que maintenant :
        // relire le suivi tout de suite l'effacerait, et il faudrait le réémettre une fois de
        // plus pour l'obtenir. Il reste affiché ; « Actualiser » remettra la carte à jour.
        bouton.remove();
        if (data.mode === 'presence' && typeof data.lien === 'string') {
          ajouterLienPresence(actions, data.lien, String(data.nom ?? 'l’emprunteur'));
          return;
        }
        // L'écran doit relire l'état : la nouvelle adresse s'affiche sous le nom.
        void chargerSuivi();
      } catch {
        bouton.disabled = false;
        bouton.textContent = libelle;
        noterEchec(actions, 'Connexion impossible : l’adresse n’a pas été corrigée. Réessayez.');
      }
    }

    /** Annule le contrat : tous les liens meurent et les emprunteurs sont prévenus. */
    async function annulerContrat(dossier: ResumeDossier, bouton: HTMLButtonElement): Promise<void> {
      const noms = dossier.emprunteurs.map((e) => e.nom).join(', ');
      const confirme = window.confirm(
        `Annuler ce contrat pour ${noms} ? Tous les liens cesseront de fonctionner et les emprunteurs seront prévenus.`,
      );
      if (!confirme) return;

      bouton.disabled = true;
      bouton.textContent = 'Annulation…';

      try {
        const reponse = await fetch('/api/contrat-annuler', {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({ d: dossier.id }),
        });
        const data = (await reponse.json().catch(() => ({}))) as Record<string, unknown>;

        if (!reponse.ok) {
          bouton.disabled = false;
          bouton.textContent = 'Annuler le contrat';
          const echec = document.createElement('span');
          echec.className = 'ct-note-echec';
          echec.textContent = String(data.error ?? 'L’annulation a échoué.');
          bouton.after(echec);
          return;
        }

        void chargerSuivi();
      } catch {
        bouton.disabled = false;
        bouton.textContent = 'Annuler le contrat';
        const echec = document.createElement('span');
        echec.className = 'ct-note-echec';
        echec.textContent = 'Connexion impossible : le contrat n’a pas été annulé. Réessayez.';
        bouton.after(echec);
      }
    }

    if (suivi) {
      // Un lien du tableau de bord vise `#ct-suivi` : la section doit alors s'ouvrir, qu'un
      // dossier presse ou non — un `<details>` ne réagit pas seul à un fragment d'URL.
      if (location.hash === '#ct-suivi') {
        suivi.open = true;
        suivi.scrollIntoView({ behavior: 'smooth', block: 'start' });
      }

      // Chargé d'emblée. Attendre qu'elle pense à ouvrir la section économisait une lecture
      // du stockage par visite, au prix de ne rien savoir : un contrat prêt à finaliser
      // pouvait dormir là des jours sans que rien ne le laisse voir depuis la page repliée.
      suiviCharge = true;
      void chargerSuivi();

      // Filet : si le chargement automatique a échoué, l'ouvrir réessaie.
      suivi.addEventListener('toggle', () => {
        if (suivi.open && !suiviCharge) {
          suiviCharge = true;
          void chargerSuivi();
        }
      });

      formulaire.querySelector('[data-suivi-actualiser]')?.addEventListener('click', () => {
        suiviCharge = true;
        void chargerSuivi();
      });
    }

    /* ---------------- Collecte ---------------- */

    /**
     * Les champs libres du contrat, par identifiant de champ. Une seule liste sert à la
     * collecte et au préremplissage d'une correction : un champ ajouté à l'une seulement
     * serait perdu à la première correction, sans que rien ne le signale.
     */
    const CHAMPS_TEXTE: ReadonlyArray<readonly [string, string]> = [
      ['ct-retribution-entite', 'retributionAutreEntite'],
      ['ct-partage-retribution', 'partageRetribution'],
      ['ct-autre-cabinet', 'autreCabinet'],
      ['ct-nb-cabinet', 'nbPreteursCabinet'],
      ['ct-nb-courtier', 'nbPreteursCourtier'],
      ['ct-preteur-majoritaire', 'preteurMajoritaire'],
      ['ct-autres-logiciels', 'autresLogiciels'],
      ['ct-collaborateur', 'collaborateur'],
      ['ct-adresse-projet', 'adresseProjet'],
      ['ct-precisions', 'autresPrecisions'],
      ['ct-montant', 'montantPret'],
      ['ct-assurance', 'assuranceHypothecaire'],
      ['ct-total', 'totalPret'],
      ['ct-taux', 'tauxInteret'],
      ['ct-type-taux', 'typeTaux'],
      ['ct-amort-ans', 'amortissementAns'],
      ['ct-amort-mois', 'amortissementMois'],
      ['ct-terme-ans', 'termeAns'],
      ['ct-terme-mois', 'termeMois'],
      ['ct-versement', 'versement'],
      ['ct-rang', 'rang'],
      ['ct-exigences', 'autresExigences'],
      ['ct-frais-etude', 'fraisEtude'],
      ['ct-honoraires', 'honorairesMontant'],
      ['ct-honoraires-pct', 'honorairesPourcentage'],
      ['ct-double-remuneration', 'doubleRemuneration'],
      ['ct-raison-double', 'raisonDoubleRemuneration'],
      ['ct-resiliation', 'resiliationMontant'],
      ['ct-resiliation-pct', 'resiliationPourcentage'],
      ['ct-validite', 'consentementsValidesJusquau'],
      ['ct-date-verification', 'dateVerification'],
    ];

    const EMPRUNTEUR_CHAMPS: ReadonlyArray<readonly [string, string]> = [
      ['prenom', 'prenom'],
      ['nom', 'nom'],
      ['tel', 'telephone'],
      ['adresse', 'adresse'],
      ['courriel', 'courriel'],
    ];

    function collecter(): Record<string, unknown> {
      const blocsVisibles = visibles();
      const emprunteurs = blocsVisibles.map((bloc) => {
        const rang = bloc.dataset.emprunteur;
        const emprunteur: Record<string, string> = {};
        for (const [suffixe, cle] of EMPRUNTEUR_CHAMPS) emprunteur[cle] = valeur(`ct-${suffixe}-${rang}`);
        return emprunteur;
      });

      const typesFinancement = [...formulaire.querySelectorAll<HTMLInputElement>('[data-type-financement]')]
        .filter((entree) => entree.checked)
        .map((entree) => entree.dataset.typeFinancement ?? '');

      // La colonne d'identité suit le bloc, pas sa position : retirer l'emprunteur 2 de 3
      // laisse visibles les blocs 0 et 2, et la colonne 2 doit aller au deuxième envoyé.
      // Lue par son numéro brut, elle était perdue — et la colonne 1, celle du retiré,
      // passait sous le nom du troisième.
      const positionDuRang = new Map(blocsVisibles.map((bloc, position) => [Number(bloc.dataset.emprunteur), position]));
      const identite: Record<string, string[]> = {};
      for (const champ of formulaire.querySelectorAll<HTMLInputElement>('[data-identite]')) {
        const cle = champ.dataset.identite ?? '';
        const position = positionDuRang.get(Number(champ.dataset.colonne ?? '0'));
        if (position === undefined) continue;
        identite[cle] ??= [];
        identite[cle][position] = lireChamp(champ);
      }
      for (const cle of Object.keys(identite)) {
        identite[cle] = Array.from(identite[cle] ?? [], (v) => v ?? '');
      }

      const donnees: Record<string, unknown> = { emprunteurs, typesFinancement, identite };
      for (const [id, cle] of CHAMPS_TEXTE) donnees[cle] = valeur(id);
      return donnees;
    }

    /** L'inverse de `collecter` : pose les données d'un dossier dans le formulaire. */
    function remplir(donnees: Record<string, unknown>): void {
      const emprunteurs = (Array.isArray(donnees.emprunteurs) ? donnees.emprunteurs : []) as Array<
        Record<string, unknown>
      >;
      for (const [rang, bloc] of blocs().entries()) {
        const emprunteur = emprunteurs[rang];
        bloc.hidden = !emprunteur && rang > 0;
        for (const [suffixe, cle] of EMPRUNTEUR_CHAMPS) {
          const champ = document.getElementById(`ct-${suffixe}-${rang}`) as HTMLInputElement | null;
          if (champ) champ.value = emprunteur ? String(emprunteur[cle] ?? '') : '';
        }
      }

      for (const [id, cle] of CHAMPS_TEXTE) {
        const champ = document.getElementById(id) as HTMLInputElement | HTMLTextAreaElement | HTMLSelectElement | null;
        if (champ) poserChamp(champ, donnees[cle] == null ? '' : String(donnees[cle]));
      }

      const types = Array.isArray(donnees.typesFinancement) ? (donnees.typesFinancement as string[]) : [];
      for (const caseType of formulaire.querySelectorAll<HTMLInputElement>('[data-type-financement]')) {
        caseType.checked = types.includes(caseType.dataset.typeFinancement ?? '');
      }

      const identite = (donnees.identite ?? {}) as Record<string, string[]>;
      for (const champ of formulaire.querySelectorAll<HTMLInputElement>('[data-identite]')) {
        const colonne = Number(champ.dataset.colonne ?? '0');
        poserChamp(champ, identite[champ.dataset.identite ?? '']?.[colonne] ?? '');
      }

      rafraichir();
    }

    /* ---------------- Correction d'un contrat en cours ---------------- */

    /** Le dossier en cours de correction ; `null` quand le formulaire prépare un nouveau contrat. */
    let correction: { id: string; mode: string; signes: string[] } | null = null;
    const bandeauCorrection = formulaire.querySelector<HTMLElement>('[data-correction]');
    const titrePage = formulaire.querySelector<HTMLElement>('.ct-titre');

    async function ouvrirCorrection(dossier: ResumeDossier, declencheur: HTMLButtonElement): Promise<void> {
      declencheur.disabled = true;
      const libelle = declencheur.textContent;
      declencheur.textContent = 'Chargement…';

      try {
        const reponse = await fetch(`/api/contrat-corriger?d=${encodeURIComponent(dossier.id)}`);
        const data = (await reponse.json().catch(() => ({}))) as Record<string, unknown>;
        if (!reponse.ok) {
          const echec = document.createElement('span');
          echec.className = 'ct-note-echec';
          echec.textContent = String(data.error ?? 'Le contrat n’a pas pu être chargé.');
          declencheur.after(echec);
          return;
        }

        remplir((data.donnees ?? {}) as Record<string, unknown>);
        const mode = data.mode === 'presence' ? 'presence' : 'distance';

        // Le mode suit le dossier : changer d'acheminement en cours de route n'est pas une
        // correction, c'est un autre contrat.
        for (const radio of formulaire.querySelectorAll<HTMLInputElement>('input[name="ct-mode"]')) {
          radio.checked = radio.value === mode;
          radio.disabled = true;
        }

        const signes = Array.isArray(data.signes) ? (data.signes as string[]) : [];
        correction = { id: dossier.id, mode, signes };
        const noms = formulaire.querySelector<HTMLElement>('[data-correction-noms]');
        const texte = formulaire.querySelector<HTMLElement>('[data-correction-texte]');
        if (noms) noms.textContent = dossier.emprunteurs.map((e) => e.nom).join(', ');
        if (texte) {
          texte.textContent =
            (signes.length > 0
              ? `${signes.join(', ')} ${signes.length > 1 ? 'ont' : 'a'} déjà signé l’ancien texte : en enregistrant, ${
                  signes.length > 1 ? 'ces signatures seront écartées' : 'cette signature sera écartée'
                } et il faudra signer de nouveau le contrat corrigé. `
              : '') +
            (mode === 'presence'
              ? 'Un nouveau lien s’affichera ici pour le premier signataire ; l’ancien cessera de fonctionner.'
              : 'Le premier signataire recevra un nouveau lien avec la liste de ce qui a changé ; les liens déjà envoyés cesseront de fonctionner.');
        }
        if (bandeauCorrection) bandeauCorrection.hidden = false;
        if (titrePage) titrePage.textContent = 'Corriger le contrat';
        // « Préremplies avec vos valeurs habituelles » cesse d'être vrai : elles portent
        // désormais celles du dossier.
        const intro = formulaire.querySelector<HTMLElement>('.ct-entete .ct-texte');
        if (intro) intro.hidden = true;
        if (erreur) erreur.hidden = true;
        if (bouton) {
          bouton.disabled = false;
          bouton.textContent = 'Enregistrer la correction';
        }
        if (suivi) suivi.open = false;
        bandeauCorrection?.scrollIntoView({ behavior: 'smooth', block: 'start' });
      } catch {
        const echec = document.createElement('span');
        echec.className = 'ct-note-echec';
        echec.textContent = 'Connexion impossible. Réessayez.';
        declencheur.after(echec);
      } finally {
        declencheur.disabled = false;
        declencheur.textContent = libelle;
      }
    }

    // Abandonner ramène au formulaire neuf, préremplis par défaut compris : le plus sûr est
    // de laisser le serveur le rendre de nouveau plutôt que de deviner ce qu'il contenait.
    formulaire.querySelector('[data-correction-abandon]')?.addEventListener('click', () => {
      window.location.assign('/contrat');
    });

    const erreur = formulaire.querySelector<HTMLElement>('[data-erreur]');
    const bouton = formulaire.querySelector<HTMLButtonElement>('[data-envoyer]');

    function montrerErreur(message: string): void {
      if (!erreur) return;
      erreur.textContent = message;
      erreur.hidden = false;
      erreur.scrollIntoView({ behavior: 'smooth', block: 'center' });
    }

    /** Contrôles communs à l'aperçu et à l'envoi. */
    function emprunteursValides(donnees: Record<string, unknown>): boolean {
      const emprunteurs = donnees.emprunteurs as Array<Record<string, string>>;
      if (emprunteurs.length === 0 || emprunteurs.some((e) => !e.prenom || !e.nom || !e.courriel)) {
        montrerErreur('Chaque emprunteur affiché doit avoir un prénom, un nom et un courriel.');
        return false;
      }
      // Les mêmes règles que le serveur (`parserEmprunteurs`), dites ici avec le nom de la
      // personne : là-bas, elles ne produisent qu'un « Champs invalides » sans indice.
      const vus = new Set<string>();
      for (const [position, e] of emprunteurs.entries()) {
        const qui = `${e.prenom} ${e.nom}`.trim() || `l’emprunteur ${position + 1}`;
        const courriel = (e.courriel ?? '').toLowerCase();
        if ((e.prenom ?? '').length < NOM_MIN || (e.nom ?? '').length < NOM_MIN) {
          montrerErreur(`Le prénom et le nom de ${qui} doivent compter au moins ${NOM_MIN} lettres.`);
          return false;
        }
        if (!estCourrielValide(courriel)) {
          montrerErreur(`Le courriel de ${qui} n’est pas une adresse valide : « ${e.courriel} ».`);
          return false;
        }
        // Le remplissage automatique du navigateur pose volontiers ses propres coordonnées
        // dans les cases de l'emprunteur : le lien partirait alors vers elle, et le client
        // attendrait un courriel qui ne viendra jamais.
        if (courrielCourtiere && courriel === courrielCourtiere) {
          montrerErreur(
            `Le courriel de ${qui} est le vôtre (${courriel}) — probablement rempli par le navigateur. Saisissez celui de l’emprunteur.`,
          );
          return false;
        }
        if (vus.has(courriel)) {
          montrerErreur(`Deux emprunteurs ont le même courriel (${courriel}) : chacun reçoit son propre lien.`);
          return false;
        }
        vus.add(courriel);
      }
      return true;
    }

    /* ---------------- Aperçu ---------------- */

    const apercu = formulaire.querySelector<HTMLElement>('[data-apercu]');
    const cadre = formulaire.querySelector<HTMLIFrameElement>('[data-apercu-cadre]');
    let urlApercu: string | null = null;

    formulaire.querySelector('[data-fermer-apercu]')?.addEventListener('click', () => {
      if (apercu) apercu.hidden = true;
    });

    /**
     * Ouvre l'aperçu dans un nouvel onglet, par un vrai formulaire : le navigateur affiche
     * alors le PDF avec son propre lecteur, toutes pages comprises. Un formulaire soumis
     * pendant le clic n'est pas traité en fenêtre surgissante, contrairement à un
     * `window.open` lancé après un `await`.
     */
    function ouvrirApercuOnglet(donnees: Record<string, unknown>): boolean {
      const envoi = document.querySelector<HTMLFormElement>('[data-apercu-onglet]');
      const champ = envoi?.querySelector<HTMLInputElement>('input[name="donnees"]');
      if (!envoi || !champ) return false;
      champ.value = JSON.stringify(donnees);
      envoi.submit();
      return true;
    }

    // Sur téléphone, un PDF dans un cadre n'affiche qu'une page, voire rien du tout.
    const ecranEtroit = window.matchMedia('(max-width: 620px)');

    formulaire.querySelector('[data-apercu-plein-ecran]')?.addEventListener('click', () => {
      const donnees = collecter();
      if (emprunteursValides(donnees)) ouvrirApercuOnglet(donnees);
    });

    formulaire.querySelector('[data-previsualiser]')?.addEventListener('click', async (evenement) => {
      const declencheur = evenement.currentTarget as HTMLButtonElement;
      if (erreur) erreur.hidden = true;

      const donnees = collecter();
      if (!emprunteursValides(donnees)) return;

      if (ecranEtroit.matches && ouvrirApercuOnglet(donnees)) return;

      declencheur.disabled = true;
      const libelle = declencheur.textContent;
      declencheur.textContent = 'Préparation…';

      try {
        const reponse = await fetch('/api/contrat-previsualiser', {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({ donnees }),
        });
        if (!reponse.ok) {
          montrerErreur(await reponse.text().catch(() => 'L’aperçu a échoué.'));
          return;
        }
        // Un blob local plutôt qu'un rechargement du cadre : le PDF n'est jamais remis en
        // cache et disparaît avec l'onglet.
        if (urlApercu) URL.revokeObjectURL(urlApercu);
        urlApercu = URL.createObjectURL(await reponse.blob());
        if (cadre) cadre.src = urlApercu;
        if (apercu) {
          apercu.hidden = false;
          apercu.scrollIntoView({ behavior: 'smooth', block: 'start' });
        }
      } catch {
        montrerErreur('Connexion impossible. Vérifiez votre réseau et réessayez.');
      } finally {
        declencheur.disabled = false;
        declencheur.textContent = libelle;
      }
    });

    /* ---------------- Envoi ---------------- */

    async function enregistrerCorrection(
      enCours: { id: string; mode: string },
      donnees: Record<string, unknown>,
    ): Promise<void> {
      occupe(true, 'Enregistrement…');

      try {
        const reponse = await fetch('/api/contrat-corriger', {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({ d: enCours.id, donnees }),
        });
        const data = (await reponse.json().catch(() => ({}))) as Record<string, unknown>;

        if (!reponse.ok) {
          // Une invitation manquée laisse le dossier corrigé : rendre le bouton ferait
          // corriger une seconde fois. L'écran de fin renvoie au suivi pour relancer.
          if (data.code === 'invitation') {
            correction = null;
            envoiEnCours = false;
            fermerConfirmation();
            afficherEnvoye({
              alerte: true,
              titre: 'Correction enregistrée — le courriel n’est pas parti',
              texte: `${String(data.error ?? 'Le nouveau lien n’a pas pu être envoyé.')} Renvoyez-le depuis les contrats en cours, plus bas.`,
              ordre: signatairesDe(donnees),
              etats: ['lien à renvoyer'],
            });
            if (suivi) suivi.open = true;
            return;
          }
          echouerConfirmation(
            data.code === 'acces'
              ? 'Votre session a expiré. Rechargez la page pour vous reconnecter — rien n’a été modifié.'
              : String(data.error ?? 'La correction a échoué. Réessayez.'),
          );
          return;
        }

        correction = null;
        envoiEnCours = false;
        fermerConfirmation();
        if (bouton) bouton.textContent = 'Correction enregistrée';

        const ordre = (data.ordre ?? signatairesDe(donnees)) as Signataire[];
        const premier = ordre[0];
        const ecartees = (data.signaturesEcartees ?? []) as string[];
        const changements = (data.changements ?? []) as string[];
        const bilan = `${changements.length} changement${changements.length > 1 ? 's' : ''}.${
          ecartees.length > 0
            ? ` Signature${ecartees.length > 1 ? 's' : ''} écartée${ecartees.length > 1 ? 's' : ''} : ${ecartees.join(', ')}.`
            : ''
        }`;

        if (data.mode === 'presence' && typeof data.lien === 'string') {
          afficherEnvoye({
            titre: 'Contrat corrigé',
            texte: `${bilan} Tendez l’appareil à ${premier?.nom ?? 'l’emprunteur'} : le lien ci-dessous ouvre le contrat corrigé. L’ancien ne fonctionne plus.`,
            ordre,
            etats: ['signe maintenant'],
            lien: { url: data.lien, nom: premier?.nom ?? 'le premier emprunteur' },
          });
        } else {
          afficherEnvoye({
            titre: 'Contrat corrigé',
            texte: `${bilan} Un nouveau lien est parti à ${premier?.nom ?? 'l’emprunteur'} (${premier?.courriel ?? ''}) avec la liste de ce qui a changé ; les anciens ne fonctionnent plus.`,
            ordre,
            etats: ['nouveau lien envoyé'],
          });
        }
      } catch {
        echouerConfirmation('Connexion impossible. Vérifiez votre réseau et réessayez — rien n’a été modifié.');
      }
    }

    /* ---------------- Confirmation, envoi, écran de fin ---------------- */

    type Signataire = { nom: string; courriel: string };

    const dialogue = formulaire.querySelector<HTMLDialogElement>('[data-confirmer]');
    const confirmerOk = formulaire.querySelector<HTMLButtonElement>('[data-confirmer-ok]');
    const confirmerRetour = formulaire.querySelector<HTMLButtonElement>('[data-confirmer-retour]');
    const confirmerErreur = formulaire.querySelector<HTMLElement>('[data-confirmer-erreur]');
    const envoye = formulaire.querySelector<HTMLElement>('[data-envoye]');
    let envoiEnCours = false;
    /** Ce que la confirmation s'apprête à envoyer — figé au moment où elle s'ouvre. */
    let enAttente: {
      donnees: Record<string, unknown>;
      mode: string;
      correction: { id: string; mode: string; signes: string[] } | null;
    } | null = null;

    function signatairesDe(donnees: Record<string, unknown>): Signataire[] {
      return (donnees.emprunteurs as Array<Record<string, string>>).map((e) => ({
        nom: `${e.prenom} ${e.nom}`.trim(),
        courriel: e.courriel ?? '',
      }));
    }

    /**
     * L'ordre de signature, une ligne par personne, plus la courtière en dernier : c'est la
     * même liste avant l'envoi (qui va recevoir quoi) et après (où en est le contrat).
     */
    function construireOrdre(liste: HTMLOListElement | null, ordre: Signataire[], etats: string[]): void {
      if (!liste) return;
      liste.replaceChildren();
      const lignes = [...ordre, { nom: 'Vous', courriel: 'relecture et signature finale' }];
      for (const [position, personne] of lignes.entries()) {
        const ligne = document.createElement('li');
        ligne.className = 'ct-ordre-ligne';
        if (position === 0) ligne.dataset.actif = '';

        const rang = document.createElement('span');
        rang.className = 'ct-ordre-rang';
        rang.textContent = position < ordre.length ? String(position + 1) : '✎';

        const qui = document.createElement('span');
        qui.className = 'ct-ordre-qui';
        const nom = document.createElement('strong');
        nom.textContent = personne.nom;
        const detail = document.createElement('small');
        detail.textContent = personne.courriel;
        qui.append(nom, detail);

        const etat = document.createElement('span');
        etat.className = 'ct-ordre-etat';
        etat.textContent = etats[position] ?? (position < ordre.length ? 'à son tour' : 'en dernier');

        ligne.append(rang, qui, etat);
        liste.append(ligne);
      }
      liste.hidden = ordre.length === 0;
    }

    function ouvrirConfirmation(
      donnees: Record<string, unknown>,
      mode: string,
      enCorrection: { id: string; mode: string; signes: string[] } | null,
    ): void {
      const ordre = signatairesDe(donnees);
      const premier = ordre[0];
      const prenom = (donnees.emprunteurs as Array<Record<string, string>>)[0]?.prenom ?? '';
      const presence = mode === 'presence';

      const titre = formulaire.querySelector<HTMLElement>('[data-confirmer-titre]');
      const resume = formulaire.querySelector<HTMLElement>('[data-confirmer-resume]');
      const note = formulaire.querySelector<HTMLElement>('[data-confirmer-note]');
      if (resume) {
        resume.textContent = formulaire.querySelector<HTMLElement>('[data-resume]')?.textContent ?? '';
      }

      let etats: string[];
      let libelleOk: string;
      if (enCorrection) {
        // Une correction efface ce qui a été signé : la fenêtre le dit nom par nom, là où
        // la liste se lit, plutôt que de laisser le bandeau du haut s'en charger seul.
        if (titre) titre.textContent = 'Enregistrer la correction ?';
        etats = ordre.map((personne, position) => {
          if (position === 0) return presence ? 'signe en premier' : 'nouveau lien';
          return enCorrection.signes.includes(personne.nom) ? 'signature écartée' : 'à son tour';
        });
        const signes = enCorrection.signes;
        if (note) {
          note.textContent =
            (signes.length > 0
              ? `${signes.join(', ')} ${signes.length > 1 ? 'ont' : 'a'} déjà signé : ${
                  signes.length > 1 ? 'ces signatures seront écartées' : 'cette signature sera écartée'
                }, et la signature repart du premier. `
              : 'La signature repart du premier. ') +
            (presence
              ? `Aucun courriel ne part : un nouveau lien s’affichera à l’écran pour ${premier?.nom ?? 'l’emprunteur'}, et l’ancien cessera de fonctionner.`
              : `Un nouveau lien part immédiatement à ${premier?.courriel ?? ''} avec la liste de ce qui a changé ; les liens déjà envoyés cesseront de fonctionner.`);
        }
        libelleOk = 'Enregistrer la correction';
      } else {
        if (titre) titre.textContent = presence ? 'Faire signer sur place ?' : 'Envoyer le contrat ?';
        etats = [presence ? 'signe en premier' : 'reçoit le lien'];
        if (note) {
          note.textContent = presence
            ? `Aucun courriel ne part. Le lien de signature s’affichera à l’écran : vous tendrez l’appareil à ${premier?.nom ?? 'l’emprunteur'}.`
            : `Le lien part immédiatement à ${premier?.courriel ?? ''}.${
                ordre.length > 1 ? ' Chacun des suivants recevra le sien dès que le précédent aura signé.' : ''
              } Une fois parti, il ne se retire qu’en annulant le contrat.`;
        }
        libelleOk = presence ? 'Créer et faire signer' : `Envoyer à ${prenom || 'l’emprunteur'}`;
      }

      construireOrdre(formulaire.querySelector<HTMLOListElement>('[data-confirmer-ordre]'), ordre, etats);
      if (confirmerOk) confirmerOk.textContent = libelleOk;
      if (confirmerErreur) confirmerErreur.hidden = true;

      enAttente = { donnees, mode, correction: enCorrection };
      dialogue?.showModal();
      confirmerOk?.focus();
    }

    function occupe(oui: boolean, texte: string): void {
      envoiEnCours = oui;
      if (confirmerOk) {
        confirmerOk.disabled = oui;
        confirmerOk.setAttribute('aria-busy', String(oui));
        if (oui) confirmerOk.textContent = texte;
      }
      if (confirmerRetour) confirmerRetour.disabled = oui;
      if (bouton) bouton.disabled = oui;
    }

    /** Un échec reste dans la fenêtre : rien n'est parti, on réessaie sans ressaisir. */
    function echouerConfirmation(message: string): void {
      occupe(false, '');
      if (confirmerOk) confirmerOk.textContent = 'Réessayer';
      if (confirmerErreur) {
        confirmerErreur.textContent = message;
        confirmerErreur.hidden = false;
      }
    }

    function fermerConfirmation(): void {
      enAttente = null;
      if (dialogue?.open) dialogue.close();
    }

    // Échap ne doit pas fermer la fenêtre pendant l'envoi : on ne saurait plus s'il a abouti.
    dialogue?.addEventListener('cancel', (evenement) => {
      if (envoiEnCours) evenement.preventDefault();
    });
    dialogue?.addEventListener('close', () => {
      if (!envoiEnCours) enAttente = null;
    });
    confirmerRetour?.addEventListener('click', () => fermerConfirmation());
    confirmerOk?.addEventListener('click', () => {
      if (!enAttente || envoiEnCours) return;
      if (enAttente.correction) void enregistrerCorrection(enAttente.correction, enAttente.donnees);
      else void envoyerContrat(enAttente.donnees, enAttente.mode);
    });

    /** Remplace le formulaire par l'écran de fin. */
    function afficherEnvoye(options: {
      alerte?: boolean;
      titre: string;
      texte: string;
      ordre: Signataire[];
      etats: string[];
      lien?: { url: string; nom: string };
    }): void {
      if (!envoye) return;
      envoye.dataset.ton = options.alerte ? 'alerte' : 'ok';
      const icone = envoye.querySelector<HTMLElement>('[data-envoye-icone]');
      const titre = envoye.querySelector<HTMLElement>('[data-envoye-titre]');
      const texte = envoye.querySelector<HTMLElement>('[data-envoye-texte]');
      const hoteLien = envoye.querySelector<HTMLElement>('[data-envoye-lien]');
      if (icone) icone.textContent = options.alerte ? '!' : '✓';
      if (titre) titre.textContent = options.titre;
      if (texte) texte.textContent = options.texte;
      construireOrdre(envoye.querySelector<HTMLOListElement>('[data-envoye-ordre]'), options.ordre, options.etats);
      if (hoteLien) {
        hoteLien.replaceChildren();
        hoteLien.hidden = !options.lien;
        if (options.lien) ajouterLienPresence(hoteLien, options.lien.url, options.lien.nom);
      }

      formulaire.dataset.etat = 'envoye';
      envoye.hidden = false;
      if (apercu) apercu.hidden = true;
      envoye.scrollIntoView({ behavior: 'smooth', block: 'start' });
      envoye.focus({ preventScroll: true });

      // Le dossier qui vient de partir doit apparaître dans le suivi sans rechargement :
      // c'est là qu'elle reviendra pour relancer ou finaliser.
      suiviCharge = true;
      void chargerSuivi();
    }

    // Le serveur rend le formulaire neuf, valeurs habituelles comprises : plus sûr que de
    // deviner ce qu'il faut vider.
    formulaire.querySelector('[data-nouveau-contrat]')?.addEventListener('click', () => {
      window.location.assign('/contrat');
    });

    formulaire.querySelector('[data-voir-suivi]')?.addEventListener('click', () => {
      if (!suivi) return;
      suivi.open = true;
      suivi.scrollIntoView({ behavior: 'smooth', block: 'start' });
    });

    async function envoyerContrat(donnees: Record<string, unknown>, mode: string): Promise<void> {
      const presence = mode === 'presence';
      const saisis = signatairesDe(donnees);
      occupe(true, presence ? 'Création…' : 'Envoi en cours…');

      try {
        const reponse = await fetch('/api/contrat-creer', {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          // Aucune signature ne circule : la sienne est mémorisée côté serveur et n'entrera
          // en jeu qu'à la finalisation ; celles des emprunteurs n'existent pas encore.
          body: JSON.stringify({ donnees, mode }),
        });
        const data = (await reponse.json().catch(() => ({}))) as Record<string, unknown>;

        if (!reponse.ok) {
          // Le dossier est créé, seul le courriel a manqué. Rendre le bouton ferait créer un
          // second dossier — deux liens vivants pour le même contrat. Le suivi rattrape.
          if (data.code === 'invitation') {
            envoiEnCours = false;
            fermerConfirmation();
            afficherEnvoye({
              alerte: true,
              titre: 'Contrat créé — le courriel n’est pas parti',
              texte: `${String(data.error ?? 'Le lien de signature n’a pas pu être envoyé.')} Renvoyez-le depuis les contrats en cours, plus bas.`,
              ordre: saisis,
              etats: ['lien à renvoyer'],
            });
            if (suivi) suivi.open = true;
            return;
          }
          echouerConfirmation(
            data.code === 'acces'
              ? 'Votre session a expiré. Rechargez la page pour vous reconnecter — rien n’a été envoyé.'
              : String(data.error ?? 'L’envoi a échoué. Réessayez.'),
          );
          return;
        }

        envoiEnCours = false;
        fermerConfirmation();
        if (bouton) bouton.textContent = presence ? 'Contrat créé' : 'Contrat envoyé';

        const ordre = (data.ordre ?? saisis) as Signataire[];
        const premier = ordre[0];
        if (data.mode === 'presence' && typeof data.lien === 'string') {
          // En présentiel, le lien ne part nulle part : il est remis ici, et la courtière
          // tend l'appareil au premier signataire.
          afficherEnvoye({
            titre: 'Contrat prêt à signer',
            texte: `Aucun courriel n’est parti. Tendez l’appareil à ${premier?.nom ?? 'l’emprunteur'} : le lien ci-dessous ouvre le contrat à signer.${
              ordre.length > 1 ? ' Chacun signera ensuite à son tour.' : ''
            }`,
            ordre,
            etats: ['signe maintenant'],
            lien: { url: data.lien, nom: premier?.nom ?? 'le premier emprunteur' },
          });
        } else {
          afficherEnvoye({
            titre: `Contrat envoyé à ${premier?.nom ?? 'l’emprunteur'}`,
            texte: `Le lien de signature est parti à ${premier?.courriel ?? ''}.${
              ordre.length > 1 ? ' Le suivant recevra le sien dès que le précédent aura signé.' : ''
            } Vous serez prévenue par courriel quand ce sera à vous de finaliser.`,
            ordre,
            etats: ['lien envoyé'],
          });
        }
      } catch {
        echouerConfirmation('Connexion impossible. Vérifiez votre réseau et réessayez — rien n’a été envoyé.');
      }
    }

    formulaire.addEventListener('submit', async (evenement) => {
      evenement.preventDefault();
      if (erreur) erreur.hidden = true;

      const donnees = collecter();
      if (!emprunteursValides(donnees)) return;

      const mode =
        formulaire.querySelector<HTMLInputElement>('input[name="ct-mode"]:checked')?.value ?? 'distance';

      // Une correction efface des signatures et tue des liens : elle passe par la même
      // fenêtre que l'envoi, avec ce qu'elle va écarter.
      if (correction) {
        ouvrirConfirmation(donnees, correction.mode, correction);
        return;
      }

      if (!signatureEnregistree) {
        montrerErreur('Enregistrez d’abord votre signature, en haut de la page.');
        barreSignature?.scrollIntoView({ behavior: 'smooth', block: 'center' });
        return;
      }

      ouvrirConfirmation(donnees, mode, null);
    });
  }
</script>
