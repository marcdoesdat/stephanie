  .ct-bouton-secondaire:hover {
    border-color: var(--clay, #a85f38);
  }

  .ct-bouton-secondaire:focus-visible {
    outline: 3px solid var(--clay, #a85f38);
    outline-offset: 3px;
  }

  .ct-bouton-secondaire:disabled {
    opacity: 0.6;
    cursor: wait;
  }

  .ct-erreur,
  .ct-alerte {
    margin: 1rem 0 0;
    padding: 0.7rem 0.85rem;
    border-radius: 8px;
    background: #fdeceb;
    color: #8f2f28;
    font-size: 0.88rem;
    line-height: 1.5;
  }

  /* ---------- Aperçu ---------- */

  .ct-apercu {
    margin: 1rem 0 0;
    border: 1px solid var(--line, #e3d9cc);
    border-radius: 12px;
    overflow: hidden;
    background: #f6f2ec;
  }

  .ct-apercu-entete {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1rem;
    padding: 0.6rem 0.9rem;
    background: #fff;
    border-bottom: 1px solid var(--line, #e3d9cc);
    font-size: 0.9rem;
  }

  .ct-apercu-liens {
    display: flex;
    gap: 1rem;
  }

  .ct-apercu iframe {
    display: block;
    width: 100%;
    height: 70vh;
    min-height: 420px;
    border: 0;
  }

  /* ---------- Barre d'action ---------- */

  .ct-barre {
    position: sticky;
    bottom: 0;
    z-index: 5;
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: 0.6rem 1rem;
    margin-top: 1.2rem;
    padding: 0.8rem 1rem;
    border: 1px solid var(--line, #e3d9cc);
    border-radius: 12px;
    background: rgba(255, 255, 255, 0.97);
    box-shadow: 0 -4px 18px rgba(31, 30, 28, 0.08);
    backdrop-filter: blur(6px);
  }

  .ct-barre-resume {
    flex: 1 1 200px;
    margin: 0;
    font-size: 0.85rem;
    color: var(--muted);
  }

  .ct-barre-actions {
    display: flex;
    gap: 0.6rem;
  }

  @media (max-width: 620px) {
    /* Sur téléphone, chaque marge latérale se paie en largeur de champ : la page, la section
       et son contenu en empilaient trois. */
    .ct-page {
      padding: 1.25rem 0.75rem 0.5rem;
    }

    /* `section` porte dans global.css une marge de 1,5 rem pensée pour les pages vitrines :
       ici, elle s'ajoutait à celle de la page. */
    .ct-shell {
      padding: 0;
    }

    .ct-titre {
      font-size: 1.3rem;
      line-height: 1.25;
    }

    .ct-section {
      padding: 0.9rem 0.85rem 1.1rem;
    }

    .ct-repliable summary {
      padding: 0.9rem 0.85rem;
    }

    .ct-repliable-corps {
      padding: 0 0.85rem 1.1rem;
    }

    .ct-signature-barre {
      padding: 0.85rem;
    }

    /* Alignées par le bas : « Amortissement (ans) » passe sur deux lignes, et les deux
       cases d'une même rangée doivent rester à la même hauteur. */
    .ct-grille-compacte {
      grid-template-columns: repeat(2, minmax(0, 1fr));
      align-items: end;
    }

    .ct-pleine-mobile {
      grid-column: 1 / -1;
    }

    .ct-ajouter,
    .ct-lien-bouton,
    .ct-import-bouton {
      min-height: 44px;
    }

    .ct-identite-entete {
      display: none;
    }

    .ct-identite-ligne {
      grid-template-columns: 1fr;
      gap: 0.4rem;
      margin-bottom: 1.1rem;
    }

    .ct-identite-label {
      font-weight: 600;
      color: var(--ink, #1f1e1c);
    }

    /* Une seule colonne visible : le nom n'apprendrait rien. */
    .ct-identite[data-colonnes='multi'] .ct-identite-qui-case:not([hidden]) {
      display: block;
      margin-bottom: 0.15rem;
      color: var(--muted);
    }

    .ct-barre {
      /* La barre colle au bas de l'écran et en épouse la largeur : sur téléphone, une carte
         flottante entre deux marges mange de la hauteur pour rien. */
      margin-inline: -0.75rem;
      padding: 0.6rem 0.75rem calc(0.6rem + env(safe-area-inset-bottom, 0px));
      border-width: 1px 0 0;
      border-radius: 0;
      gap: 0.45rem;
    }

    .ct-barre-resume {
      flex-basis: 100%;
      overflow: hidden;
      font-size: 0.8rem;
      text-overflow: ellipsis;
      white-space: nowrap;
    }

