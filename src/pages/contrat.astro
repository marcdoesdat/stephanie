---
// Générateur de contrat de courtage — /contrat. Réservé à la courtière.
//
// Rendu à l'exécution : la page doit vérifier le cookie d'accès à chaque requête et, faute
// de quoi, ne rendre que l'écran de connexion. Un formulaire protégé côté client seulement
// ne protège rien — /api/contrat-creer applique exactement le même verdict.
//
// Organisation de l'écran : ce qui change à chaque client est ouvert et en haut ; ce qui
// décrit le cabinet est replié et prérempli depuis les réglages mémorisés. Stéphanie remplit
// le même document plusieurs fois par semaine — l'essentiel doit tenir sur un écran, pas
// se perdre dans cinquante champs de même poids.
export const prerender = false;

import MainLayout from '../layouts/MainLayout.astro';
import BarreCourtiere from '../components/BarreCourtiere.astro';
import ConnexionCourtiere from '../components/ConnexionCourtiere.astro';
import SignaturePad from '../components/SignaturePad.astro';
import { loadSiteConfig } from '../config';
import { accesConfigure, accesLibreEnDev, requeteAutorisee } from '../services/accesCourtiere';
import { lireReglages } from '../services/reglagesCourtiere';
import { LIGNES_IDENTITE, TYPES_FINANCEMENT } from '../utils/contratCourtage';

/** Les lignes du tableau d'identité qui sont des dates : elles prennent un calendrier. */
const LIGNES_IDENTITE_DATES: ReadonlySet<string> = new Set([
  'dossier_credit_date',
  'document1_expiration',
  'document2_expiration',
]);

const config = loadSiteConfig();
const autorise = await requeteAutorisee(Astro.request);
const configureManquante = !accesConfigure() && !accesLibreEnDev();

// Les réglages ne sont lus que derrière la porte : ils contiennent le tracé de signature.
const reglages = autorise ? await lireReglages() : null;
const signatureEnregistree = reglages?.signature
  ? `data:image/png;base64,${reglages.signature.tracePngBase64}`
  : null;
const defauts = reglages?.defauts ?? {};

Astro.response.headers.set('Cache-Control', 'no-store');

/** Les trois blocs d'emprunteur du modèle — rendus d'avance, masqués tant qu'inutiles. */
const RANGS = [0, 1, 2];
---

<MainLayout
  title="Générer un contrat de courtage"
  description="Outil interne de génération du contrat de courtage hypothécaire."
  noindex={true}
  sansBarreCta={true}
  sansConsentement={true}
>
  <main id="main-content" class="ct-page">
    <section class="ct-shell">
      {autorise && <BarreCourtiere actif="contrat" />}
      {
        !autorise ? (
          <ConnexionCourtiere
            titre="Générateur de contrat"
            configureManquante={configureManquante}
            nom={config.nom}
          />
        ) : (
          <form
            id="ct-form"
            class="ct-form"
            autocomplete="off"
            data-signature-enregistree={signatureEnregistree ? 'oui' : 'non'}
          >
            <header class="ct-entete">
              <h1 class="ct-titre">Nouveau contrat de courtage</h1>
              <p class="ct-texte">
                Vos coordonnées et votre numéro AMF sont ajoutés automatiquement. Les sections
                repliées sont préremplies avec vos valeurs habituelles — ouvrez-les seulement
                si ce dossier fait exception.
              </p>
            </header>

            {/* ---------------- Contrats en cours ---------------- */}

            {/* En tête de page, avant le formulaire : un dossier qui attend *sa* signature
                passe avant un nouveau contrat. La liste se charge d'elle-même et s'ouvre
                seule quand quelque chose lui revient — un suivi qu'il faut penser à ouvrir
                pour savoir s'il se passe quelque chose ne se consulte pas. */}
            <details class="ct-repliable ct-suivi" id="ct-suivi">
              <summary>
                <span class="ct-repliable-titre">Contrats en cours</span>
                <span class="ct-repliable-note" data-suivi-compte>chargement…</span>
              </summary>
              <div class="ct-repliable-corps">
                <p class="ct-aide" data-suivi-etat aria-live="polite">Chargement…</p>
                <div data-suivi-liste></div>
                <div class="ct-suivi-pied" data-suivi-pied hidden>
                  <button type="button" class="ct-lien" data-suivi-actualiser>Actualiser</button>
                  <span class="ct-suivi-horodatage" data-suivi-horodatage></span>
                </div>
              </div>
            </details>

            {/* ---------------- Correction d'un contrat en cours ---------------- */}

            {/* Montré quand « Corriger le contrat » a rempli le formulaire avec un dossier déjà
                parti : sans lui, rien ne distinguerait une correction d'un nouveau contrat —
                et c'est précisément le moment où il faut savoir quelles signatures tombent. */}
            <div class="ct-correction" data-correction hidden>
              <p class="ct-correction-titre">
                Correction du contrat de <strong data-correction-noms></strong>
              </p>
              <p class="ct-correction-texte" data-correction-texte></p>
              <button type="button" class="ct-lien" data-correction-abandon>
                Abandonner la correction
              </button>
            </div>

            {/* ---------------- Ma signature ---------------- */}

            <div class="ct-signature-barre" data-etat={signatureEnregistree ? 'ok' : 'manquante'}>
              {signatureEnregistree ? (
                <>
                  <div class="ct-signature-apercu">
                    <span class="ct-signature-etiquette">Votre signature</span>
                    <img src={signatureEnregistree} alt="Votre signature enregistrée" />
                  </div>
                  <p class="ct-signature-note">
                    Elle sera apposée quand vous finaliserez un contrat, une fois les
                    emprunteurs signés. Vous n’avez plus à la dessiner.
                  </p>
                  <button type="button" class="ct-lien" data-remplacer-signature>
                    Remplacer ma signature
                  </button>
                </>
              ) : (
                <>
                  <p class="ct-signature-note ct-signature-invite">
                    <strong>Une seule fois :</strong> dessinez votre signature. Elle servira à
                    finaliser vos contrats, une fois les emprunteurs signés.
                  </p>
                </>
              )}

              <div class="ct-signature-saisie" hidden={signatureEnregistree !== null}>
                <SignaturePad id="ct-signature" nom={config.nom} />

                {/* Signer sur une feuille et la photographier donne un tracé bien plus
                    fidèle qu'un doigt sur un écran. Le fond est retiré automatiquement. */}
                <div class="ct-import">
                  <span class="ct-import-ou">ou</span>
                  <label class="ct-import-bouton">
                    <input type="file" accept="image/png,image/jpeg,image/webp" data-fichier-signature />
                    Importer une photo de ma signature
                  </label>
                  <p class="ct-aide">
                    Signez une feuille blanche, photographiez-la bien à plat et sans ombre. Le
                    fond est effacé automatiquement. JPEG, PNG ou WebP — pas de HEIC.
                  </p>
                  <div class="ct-import-apercu" data-import-apercu hidden>
                    <span>Aperçu :</span>
                    <img data-import-image alt="Aperçu de la signature importée" />
                  </div>
                </div>

                <div class="ct-signature-actions">
                  <button type="button" class="btn btn-primary ct-bouton-petit" data-enregistrer-signature>
                    Enregistrer ma signature
                  </button>
                  {signatureEnregistree && (
                    <button type="button" class="ct-lien" data-annuler-signature>
                      annuler
                    </button>
                  )}
                </div>
                <p class="ct-erreur" data-erreur-signature hidden />
              </div>
            </div>

            {/* ---------------- Emprunteurs ---------------- */}

            <fieldset class="ct-section">
              <legend>Emprunteurs</legend>
              {RANGS.map((rang) => (
                <div class="ct-emprunteur" data-emprunteur={rang} hidden={rang > 0}>
                  <h2 class="ct-sous-titre">
                    <span>Emprunteur {rang + 1}</span>
                    {rang > 0 && (
                      <button type="button" class="ct-lien" data-retirer={rang}>
                        retirer
                      </button>
                    )}
                  </h2>
                  <div class="ct-grille">
                    <div>
                      <label class="cform-label" for={`ct-prenom-${rang}`}>
                        Prénom <span class="ct-requis">*</span>
                      </label>
                      <input type="text" id={`ct-prenom-${rang}`} class="cform-input" maxlength="60" />
                    </div>
                    <div>
                      <label class="cform-label" for={`ct-nom-${rang}`}>
                        Nom <span class="ct-requis">*</span>
                      </label>
                      <input type="text" id={`ct-nom-${rang}`} class="cform-input" maxlength="60" />
                    </div>
                    <div>
                      <label class="cform-label" for={`ct-courriel-${rang}`}>
                        Courriel <span class="ct-requis">*</span>
                      </label>
                      <input
                        type="email"
                        id={`ct-courriel-${rang}`}
                        class="cform-input"
                        maxlength="120"
                        placeholder="pour le lien de signature"
                      />
                    </div>
                    <div>
                      <label class="cform-label" for={`ct-tel-${rang}`}>Téléphone</label>
                      <input type="tel" id={`ct-tel-${rang}`} class="cform-input" maxlength="40" />
                    </div>
                    <div class="ct-pleine">
                      <label class="cform-label" for={`ct-adresse-${rang}`}>Adresse</label>
                      <input type="text" id={`ct-adresse-${rang}`} class="cform-input" maxlength="160" />
                    </div>
                  </div>
                </div>
              ))}
              <button type="button" class="ct-ajouter" data-ajouter>+ Ajouter un emprunteur</button>
            </fieldset>

            {/* ---------------- Financement ---------------- */}

            <fieldset class="ct-section">
              <legend>Financement recherché</legend>

              <label class="cform-label" for="ct-adresse-projet">Adresse du projet</label>
              <input type="text" id="ct-adresse-projet" class="cform-input" maxlength="200" />

              <p class="cform-label ct-espace">Type de financement</p>
              <div class="ct-cases">
                {TYPES_FINANCEMENT.map((type) => (
                  <label class="ct-case">
                    <input type="checkbox" data-type-financement={type.cle} />
                    <span>{type.label}</span>
                  </label>
                ))}
              </div>

              <div class="ct-grille ct-espace">
                <div>
                  <label class="cform-label" for="ct-montant">Montant du prêt ($)</label>
                  <input type="text" id="ct-montant" class="cform-input" inputmode="numeric" maxlength="20" />
                </div>
                <div>
                  <label class="cform-label" for="ct-assurance">Assurance hypothécaire ($)</label>
                  <input type="text" id="ct-assurance" class="cform-input" inputmode="numeric" maxlength="20" />
                </div>
                <div>
                  <label class="cform-label" for="ct-total">
                    Total du prêt ($)
                    <span class="ct-astuce" data-calcul-total hidden>calculé</span>
                  </label>
                  <input type="text" id="ct-total" class="cform-input" inputmode="numeric" maxlength="20" />
                </div>
                <div>
                  <label class="cform-label" for="ct-taux">Taux d’intérêt (%)</label>
                  <input type="text" id="ct-taux" class="cform-input" inputmode="decimal" maxlength="10" />
                </div>
                <div>
                  <label class="cform-label" for="ct-type-taux">Type de taux</label>
                  <select id="ct-type-taux" class="cform-input">
                    <option value="">—</option>
                    <option value="fixe">Fixe</option>
                    <option value="variable">Variable</option>
                  </select>
                </div>
                <div>
                  {/* « cap. » seul est lu par Chrome comme « CAP », le code postal italien : le libellé
                      écrit le mot en entier, sans quoi le navigateur y collait le code postal. */}
                  <label class="cform-label" for="ct-versement">Versement capital + intérêts ($)</label>
                  <input type="text" id="ct-versement" class="cform-input" inputmode="numeric" maxlength="20" autocomplete="off" />
                </div>
              </div>

              <div class="ct-grille ct-espace">
                <div>
                  <label class="cform-label" for="ct-amort-ans">Amortissement (ans)</label>
                  <input type="text" id="ct-amort-ans" class="cform-input" inputmode="numeric" maxlength="4" />
                </div>
                <div>
                  <label class="cform-label" for="ct-amort-mois">Amortissement (mois)</label>
                  <input type="text" id="ct-amort-mois" class="cform-input" inputmode="numeric" maxlength="4" />
                </div>
                <div>
                  <label class="cform-label" for="ct-terme-ans">Terme (ans)</label>
                  <input type="text" id="ct-terme-ans" class="cform-input" inputmode="numeric" maxlength="4" />
                </div>
                <div>
                  <label class="cform-label" for="ct-terme-mois">Terme (mois)</label>
                  <input type="text" id="ct-terme-mois" class="cform-input" inputmode="numeric" maxlength="4" />
                </div>
                <div>
                  <label class="cform-label" for="ct-rang">Rang</label>
                  <input type="text" id="ct-rang" class="cform-input" maxlength="10" placeholder="1" />
                </div>
                <div>
                  <label class="cform-label" for="ct-validite">Consentements valides jusqu’au</label>
                  <div class="ct-date-champ">
                    <input type="date" id="ct-validite" class="cform-input" data-date-contrat />
                    <span class="ct-date-ancienne" data-date-ancienne hidden />
                  </div>
                </div>
              </div>

              <label class="cform-label ct-espace" for="ct-precisions">Autres précisions</label>
              <input type="text" id="ct-precisions" class="cform-input" maxlength="200" />

              <label class="cform-label ct-espace" for="ct-exigences">
                Autres exigences de l’emprunteur
              </label>
              <textarea id="ct-exigences" class="cform-input" rows="3" maxlength="600" />
              <p class="ct-aide">4 lignes disponibles sur le contrat ; le surplus est tronqué.</p>
            </fieldset>

            {/* ---------------- Frais et honoraires (mémorisés) ---------------- */}

            <details class="ct-repliable">
              <summary>
                <span class="ct-repliable-titre">Frais et honoraires</span>
                <span class="ct-repliable-note" data-resume-frais>vos valeurs habituelles</span>
              </summary>
              <div class="ct-repliable-corps">
                <div class="ct-grille">
                  <div>
                    <label class="cform-label" for="ct-frais-etude">Frais d’étude de dossier ($)</label>
                    <input
                      type="text"
                      id="ct-frais-etude"
                      class="cform-input"
                      inputmode="numeric"
                      maxlength="20"
                      data-defaut="fraisEtude"
                      value={defauts.fraisEtude ?? ''}
                    />
                  </div>
                  <div>
                    <label class="cform-label" for="ct-honoraires">Rétribution ($)</label>
                    <input
                      type="text"
                      id="ct-honoraires"
                      class="cform-input"
                      inputmode="numeric"
                      maxlength="20"
                      data-defaut="honorairesMontant"
                      value={defauts.honorairesMontant ?? ''}
                    />
                  </div>
                  <div>
                    <label class="cform-label" for="ct-honoraires-pct">Rétribution (%)</label>
                    <input
                      type="text"
                      id="ct-honoraires-pct"
                      class="cform-input"
                      inputmode="decimal"
                      maxlength="10"
                      data-defaut="honorairesPourcentage"
                      value={defauts.honorairesPourcentage ?? ''}
                    />
                  </div>
                  <div>
                    <label class="cform-label" for="ct-resiliation">Frais de résiliation ($)</label>
                    <input
                      type="text"
                      id="ct-resiliation"
                      class="cform-input"
                      inputmode="numeric"
                      maxlength="20"
                      data-defaut="resiliationMontant"
                      value={defauts.resiliationMontant ?? ''}
                    />
                  </div>
                  <div>
                    <label class="cform-label" for="ct-resiliation-pct">Frais de résiliation (%)</label>
                    <input
                      type="text"
                      id="ct-resiliation-pct"
                      class="cform-input"
                      inputmode="decimal"
                      maxlength="10"
                      data-defaut="resiliationPourcentage"
                      value={defauts.resiliationPourcentage ?? ''}
                    />
                  </div>
                  <div>
                    <label class="cform-label" for="ct-double-remuneration">Divulgation additionnelle</label>
                    <select id="ct-double-remuneration" class="cform-input" data-defaut="doubleRemuneration">
                      <option value="">— (pas de frais ni honoraires)</option>
                      <option value="ne_recevra_pas" selected={defauts.doubleRemuneration === 'ne_recevra_pas'}>
                        Le cabinet ne recevra pas de commission du prêteur
                      </option>
                      <option value="recevra" selected={defauts.doubleRemuneration === 'recevra'}>
                        Le cabinet recevra une commission du prêteur
                      </option>
                    </select>
                  </div>
                </div>
                <label class="cform-label ct-espace" for="ct-raison-double">
                  Raison de la double rémunération, le cas échéant
                </label>
                <textarea id="ct-raison-double" class="cform-input" rows="2" maxlength="600" />
              </div>
            </details>

            {/* ---------------- Divulgations (mémorisées) ---------------- */}

            <details class="ct-repliable">
              <summary>
                <span class="ct-repliable-titre">Divulgations du cabinet</span>
                <span class="ct-repliable-note">identiques d’un contrat à l’autre</span>
              </summary>
              <div class="ct-repliable-corps">
                <div class="ct-grille">
                  <div>
                    <label class="cform-label" for="ct-nb-cabinet">Prêteurs — cabinet (12 mois)</label>
                    <input
                      type="text"
                      id="ct-nb-cabinet"
                      class="cform-input"
                      inputmode="numeric"
                      maxlength="10"
                      data-defaut="nbPreteursCabinet"
                      value={defauts.nbPreteursCabinet ?? ''}
                    />
                  </div>
                  <div>
                    <label class="cform-label" for="ct-nb-courtier">Prêteurs — courtier (12 mois)</label>
                    <input
                      type="text"
                      id="ct-nb-courtier"
                      class="cform-input"
                      inputmode="numeric"
                      maxlength="10"
                      data-defaut="nbPreteursCourtier"
                      value={defauts.nbPreteursCourtier ?? ''}
                    />
                  </div>
                  <div>
                    <label class="cform-label" for="ct-preteur-majoritaire">
                      Prêteur ayant consenti &gt; 50 % des prêts
                    </label>
                    <input
                      type="text"
                      id="ct-preteur-majoritaire"
                      class="cform-input"
                      maxlength="200"
                      data-defaut="preteurMajoritaire"
                      value={defauts.preteurMajoritaire ?? ''}
                    />
                  </div>
                  <div>
                    <label class="cform-label" for="ct-autres-logiciels">Autres logiciels utilisés</label>
                    <input
                      type="text"
                      id="ct-autres-logiciels"
                      class="cform-input"
                      maxlength="200"
                      data-defaut="autresLogiciels"
                      value={defauts.autresLogiciels ?? ''}
                    />
                  </div>
                  <div>
                    <label class="cform-label" for="ct-autre-cabinet">Autre cabinet de rattachement</label>
                    <input
                      type="text"
                      id="ct-autre-cabinet"
                      class="cform-input"
                      maxlength="200"
                      data-defaut="autreCabinet"
                      value={defauts.autreCabinet ?? 'N/A'}
                    />
                  </div>
                  <div>
                    <label class="cform-label" for="ct-collaborateur">Collaborateur (assurances)</label>
                    <input
                      type="text"
                      id="ct-collaborateur"
                      class="cform-input"
                      maxlength="200"
                      data-defaut="collaborateur"
                      value={defauts.collaborateur ?? 'N/A'}
                    />
                  </div>
                  <div>
                    <label class="cform-label" for="ct-retribution-entite">Rétribution d’une autre entité</label>
                    <input
                      type="text"
                      id="ct-retribution-entite"
                      class="cform-input"
                      maxlength="200"
                      data-defaut="retributionAutreEntite"
                      value={defauts.retributionAutreEntite ?? 'N/A'}
                    />
                  </div>
                  <div>
                    <label class="cform-label" for="ct-partage-retribution">Partage de la rétribution</label>
                    <input
                      type="text"
                      id="ct-partage-retribution"
                      class="cform-input"
                      maxlength="200"
                      data-defaut="partageRetribution"
                      value={defauts.partageRetribution ?? 'N/A'}
                    />
                  </div>
                </div>

                <div class="ct-memoriser">
                  <button type="button" class="ct-lien" data-memoriser>
                    Mémoriser ces valeurs pour les prochains contrats
                  </button>
                  <span class="ct-memoriser-etat" data-memoriser-etat hidden>Enregistré ✓</span>
                </div>
              </div>
            </details>

            {/* ---------------- Vérification d'identité ---------------- */}

            <details class="ct-repliable">
              <summary>
                <span class="ct-repliable-titre">Vérification de l’identité</span>
                <span class="ct-repliable-note">peut être remplie plus tard</span>
              </summary>
              <div class="ct-repliable-corps">
                <p class="ct-aide">
                  Une colonne par emprunteur, dans le même ordre que plus haut. Laissez vide si
                  vous n’avez pas encore vu les pièces.
                </p>
                <div class="ct-identite">
                  {LIGNES_IDENTITE.map((ligne) => (
                    <div class="ct-identite-ligne">
                      <span class="ct-identite-label">{ligne.label}</span>
                      {RANGS.map((rang) =>
                        LIGNES_IDENTITE_DATES.has(ligne.id) ? (
                          <div class="ct-date-champ">
                            <input
                              type="date"
                              class="cform-input"
                              data-date-contrat
                              data-identite={ligne.id}
                              data-colonne={rang}
                              aria-label={`${ligne.label} — emprunteur ${rang + 1}`}
                            />
                            <span class="ct-date-ancienne" data-date-ancienne hidden />
                          </div>
                        ) : (
                          <input
                            type="text"
                            class="cform-input"
                            maxlength="60"
                            data-identite={ligne.id}
                            data-colonne={rang}
                            aria-label={`${ligne.label} — emprunteur ${rang + 1}`}
                          />
                        ),
                      )}
                    </div>
                  ))}
                </div>
                <label class="cform-label ct-espace" for="ct-date-verification">
                  Date de la vérification
                </label>
                <div class="ct-date-champ ct-date-avec-bouton">
                  <input type="date" id="ct-date-verification" class="cform-input" data-date-contrat />
                  <button type="button" class="ct-lien-bouton" data-date-aujourdhui="ct-date-verification">
                    Aujourd’hui
                  </button>
                  <span class="ct-date-ancienne" data-date-ancienne hidden />
                </div>
              </div>
            </details>

            {/* ---------------- Envoi ---------------- */}

            <fieldset class="ct-section">
              <legend>Ce qui va se passer</legend>
              <ol class="ct-etapes">
                <li>
                  Le <strong>premier</strong> emprunteur lit le contrat en entier, répond aux
                  deux questions qui lui reviennent — fonction politiquement vulnérable,
                  transfert de cabinet — confirme ses coordonnées, et signe.
                </li>
                <li>
                  Le suivant prend le relais et voit le contrat portant déjà la signature du
                  précédent. Un seul document circule, signé l’un après l’autre.
                </li>
                <li>
                  Quand tous ont signé, vous relisez le contrat — qui porte alors leurs
                  réponses — et vous le signez d’un clic.
                </li>
              </ol>
              <p class="ct-aide">
                Le contrat n’est produit qu’à cette dernière étape. C’est ce qui garantit que
                votre signature ne couvre rien que vous n’ayez vu.
              </p>

              <p class="cform-label ct-espace" data-mode-titre>Comment signent-ils ?</p>
              <label class="ct-case ct-case-large">
                <input type="radio" name="ct-mode" value="distance" checked />
                <span>
