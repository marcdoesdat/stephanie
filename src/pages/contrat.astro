</style>

<script>
  import type { SignaturePadElement } from '../scripts/signaturePad';
  import { ErreurImport, importerSignature } from '../scripts/importSignature';

  /* ---------------- Écran de connexion ---------------- */

  const connexion = document.getElementById('ct-connexion-form') as HTMLFormElement | null;
  connexion?.addEventListener('submit', async (evenement) => {
    evenement.preventDefault();
    const erreur = document.querySelector<HTMLElement>('[data-erreur-connexion]');
    const champ = document.getElementById('ct-mdp') as HTMLInputElement | null;
    if (erreur) erreur.hidden = true;

    try {
      const reponse = await fetch('/api/contrat-acces', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({ motDePasse: champ?.value ?? '' }),
      });
      if (reponse.ok) {
        window.location.reload();
        return;
      }
      const data = (await reponse.json().catch(() => ({}))) as { error?: string };
      if (erreur) {
        erreur.textContent = data.error ?? 'Connexion impossible.';
        erreur.hidden = false;
      }
    } catch {
      if (erreur) {
        erreur.textContent = 'Connexion impossible. Vérifiez votre réseau.';
        erreur.hidden = false;
      }
    }
  });

  /* ---------------- Formulaire ---------------- */

  const form = document.getElementById('ct-form') as HTMLFormElement | null;
  if (form) {
    // Alias non nullable : les fonctions déclarées plus bas capturent le formulaire, et
    // TypeScript ne conserve pas l'affinage de `form` à travers une déclaration de fonction.
    const formulaire: HTMLFormElement = form;
    let signatureEnregistree = formulaire.dataset.signatureEnregistree === 'oui';

    const valeur = (id: string): string =>
      (document.getElementById(id) as HTMLInputElement | HTMLTextAreaElement | HTMLSelectElement | null)?.value.trim() ??
      '';

    const blocs = () => [...formulaire.querySelectorAll<HTMLElement>('[data-emprunteur]')];
    const visibles = () => blocs().filter((bloc) => !bloc.hidden);

    /* ---------------- Signature de la courtière ---------------- */

    const barreSignature = formulaire.querySelector<HTMLElement>('.ct-signature-barre');
    const saisieSignature = formulaire.querySelector<HTMLElement>('.ct-signature-saisie');
    const erreurSignature = formulaire.querySelector<HTMLElement>('[data-erreur-signature]');

    formulaire.querySelector('[data-remplacer-signature]')?.addEventListener('click', () => {
      if (saisieSignature) saisieSignature.hidden = false;
    });
    formulaire.querySelector('[data-annuler-signature]')?.addEventListener('click', () => {
      if (saisieSignature) saisieSignature.hidden = true;
    });

    // Une signature importée prend le pas sur le canevas : c'est le dernier geste posé
    // qui compte, et l'aperçu montre laquelle sera enregistrée.
    let signatureImportee: string | null = null;

    formulaire.querySelector<HTMLInputElement>('[data-fichier-signature]')?.addEventListener('change', async (evenement) => {
      const entree = evenement.currentTarget as HTMLInputElement;
      const fichier = entree.files?.[0];
      if (!fichier) return;
      if (erreurSignature) erreurSignature.hidden = true;

      try {
        signatureImportee = await importerSignature(fichier);
        const bloc = formulaire.querySelector<HTMLElement>('[data-import-apercu]');
        const image = formulaire.querySelector<HTMLImageElement>('[data-import-image]');
        if (image) image.src = signatureImportee;
        if (bloc) bloc.hidden = false;
      } catch (err) {
        signatureImportee = null;
        if (erreurSignature) {
          erreurSignature.textContent =
            err instanceof ErreurImport ? err.message : 'Image illisible. Essayez une autre photo.';
          erreurSignature.hidden = false;
        }
      } finally {
        // Permet de reprendre le même fichier après une correction.
        entree.value = '';
      }
    });

    formulaire.querySelector('[data-enregistrer-signature]')?.addEventListener('click', async (evenement) => {
      const bouton = evenement.currentTarget as HTMLButtonElement;
      if (erreurSignature) erreurSignature.hidden = true;

      const pad = document.getElementById('ct-signature') as SignaturePadElement | null;
      const png = signatureImportee ?? pad?.versPng();
      if (!png) {
        if (erreurSignature) {
          erreurSignature.textContent =
            'Dessinez votre signature dans le cadre, ou importez-en une photo.';
          erreurSignature.hidden = false;
        }
        return;
      }

      bouton.disabled = true;
      const libelle = bouton.textContent;
      bouton.textContent = 'Enregistrement…';

      try {
        const reponse = await fetch('/api/contrat-reglages', {
          method: 'PUT',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({ signature: png }),
        });
        if (!reponse.ok) {
          const data = (await reponse.json().catch(() => ({}))) as { error?: string };
          if (erreurSignature) {
            erreurSignature.textContent = data.error ?? 'Enregistrement impossible.';
            erreurSignature.hidden = false;
          }
          bouton.disabled = false;
          bouton.textContent = libelle;
          return;
        }
        signatureEnregistree = true;
        // Recharger montre l'aperçu de la signature servie par le serveur — la preuve
        // qu'elle est bien enregistrée, et non seulement dessinée à l'écran.
        window.location.reload();
      } catch {
        if (erreurSignature) {
          erreurSignature.textContent = 'Connexion impossible. Réessayez.';
          erreurSignature.hidden = false;
        }
        bouton.disabled = false;
        bouton.textContent = libelle;
      }
    });

    /* ---------------- Emprunteurs et signatures en présence ---------------- */

    function rafraichir(): void {
      // Le bouton « Ajouter » disparaît quand les trois blocs du modèle sont utilisés.
      const ajouter = formulaire.querySelector<HTMLElement>('[data-ajouter]');
      if (ajouter) ajouter.hidden = visibles().length >= blocs().length;
      majResume();
    }

    /** Rappelle, sans remonter la page, ce qui partira réellement. */
    function majResume(): void {
      const cible = formulaire.querySelector<HTMLElement>('[data-resume]');
      if (!cible) return;

      const noms = visibles()
        .map((bloc) => `${valeur(`ct-prenom-${bloc.dataset.emprunteur}`)} ${valeur(`ct-nom-${bloc.dataset.emprunteur}`)}`.trim())
        .filter((nom) => nom !== '');

      const types = [...formulaire.querySelectorAll<HTMLInputElement>('[data-type-financement]')]
        .filter((entree) => entree.checked)
        .map((entree) => entree.closest('label')?.querySelector('span')?.textContent?.trim() ?? '');

      const morceaux: string[] = [];
      morceaux.push(noms.length ? noms.join(', ') : 'Aucun emprunteur saisi');
      if (types.length) morceaux.push(types.join(', '));
      const montant = valeur('ct-montant');
      if (montant) morceaux.push(`${montant} $`);

      cible.textContent = morceaux.join(' · ');
    }

    formulaire.querySelector('[data-ajouter]')?.addEventListener('click', () => {
      const suivant = blocs().find((bloc) => bloc.hidden);
      if (suivant) suivant.hidden = false;
      rafraichir();
    });

    for (const bouton of formulaire.querySelectorAll<HTMLButtonElement>('[data-retirer]')) {
      bouton.addEventListener('click', () => {
        const bloc = formulaire.querySelector<HTMLElement>(`[data-emprunteur="${bouton.dataset.retirer}"]`);
        if (!bloc) return;
        bloc.hidden = true;
        for (const champ of bloc.querySelectorAll<HTMLInputElement>('input')) champ.value = '';
        rafraichir();
      });
    }

    formulaire.addEventListener('input', () => rafraichir());
    formulaire.addEventListener('change', () => rafraichir());
    rafraichir();

    /* ---------------- Mémorisation des valeurs habituelles ---------------- */

    formulaire.querySelector('[data-memoriser]')?.addEventListener('click', async (evenement) => {
      const bouton = evenement.currentTarget as HTMLButtonElement;
      const etat = formulaire.querySelector<HTMLElement>('[data-memoriser-etat]');
      const defauts: Record<string, string> = {};
      for (const champ of formulaire.querySelectorAll<HTMLInputElement | HTMLSelectElement>('[data-defaut]')) {
        defauts[champ.dataset.defaut ?? ''] = champ.value.trim();
      }

      bouton.disabled = true;
      try {
        const reponse = await fetch('/api/contrat-reglages', {
          method: 'PUT',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({ defauts }),
        });
        if (etat) {
          etat.textContent = reponse.ok ? 'Enregistré ✓' : 'Échec de l’enregistrement';
          etat.hidden = false;
        }
      } catch {
        if (etat) {
          etat.textContent = 'Échec de l’enregistrement';
          etat.hidden = false;
        }
      } finally {
        bouton.disabled = false;
      }
    });

    /* ---------------- Collecte ---------------- */

    function collecter(): Record<string, unknown> {
      const emprunteurs = visibles().map((bloc) => {
        const rang = bloc.dataset.emprunteur;
        return {
          prenom: valeur(`ct-prenom-${rang}`),
          nom: valeur(`ct-nom-${rang}`),
          telephone: valeur(`ct-tel-${rang}`),
          adresse: valeur(`ct-adresse-${rang}`),
          courriel: valeur(`ct-courriel-${rang}`),
        };
      });

      const typesFinancement = [...formulaire.querySelectorAll<HTMLInputElement>('[data-type-financement]')]
        .filter((entree) => entree.checked)
        .map((entree) => entree.dataset.typeFinancement ?? '');

      const identite: Record<string, string[]> = {};
      for (const champ of formulaire.querySelectorAll<HTMLInputElement>('[data-identite]')) {
        const cle = champ.dataset.identite ?? '';
        const colonne = Number(champ.dataset.colonne ?? '0');
        if (colonne >= emprunteurs.length) continue;
        identite[cle] ??= [];
        identite[cle][colonne] = champ.value.trim();
      }
      for (const cle of Object.keys(identite)) {
        identite[cle] = Array.from(identite[cle] ?? [], (v) => v ?? '');
      }

      return {
        emprunteurs,
        retributionAutreEntite: valeur('ct-retribution-entite'),
        partageRetribution: valeur('ct-partage-retribution'),
        autreCabinet: valeur('ct-autre-cabinet'),
        nbPreteursCabinet: valeur('ct-nb-cabinet'),
        nbPreteursCourtier: valeur('ct-nb-courtier'),
        preteurMajoritaire: valeur('ct-preteur-majoritaire'),
        autresLogiciels: valeur('ct-autres-logiciels'),
        collaborateur: valeur('ct-collaborateur'),
        adresseProjet: valeur('ct-adresse-projet'),
        typesFinancement,
        autresPrecisions: valeur('ct-precisions'),
        montantPret: valeur('ct-montant'),
        assuranceHypothecaire: valeur('ct-assurance'),
        totalPret: valeur('ct-total'),
        tauxInteret: valeur('ct-taux'),
        typeTaux: valeur('ct-type-taux'),
        amortissementAns: valeur('ct-amort-ans'),
        amortissementMois: valeur('ct-amort-mois'),
        termeAns: valeur('ct-terme-ans'),
        termeMois: valeur('ct-terme-mois'),
        versement: valeur('ct-versement'),
        rang: valeur('ct-rang'),
        autresExigences: valeur('ct-exigences'),
        fraisEtude: valeur('ct-frais-etude'),
        honorairesMontant: valeur('ct-honoraires'),
        honorairesPourcentage: valeur('ct-honoraires-pct'),
        doubleRemuneration: valeur('ct-double-remuneration'),
        raisonDoubleRemuneration: valeur('ct-raison-double'),
        resiliationMontant: valeur('ct-resiliation'),
        resiliationPourcentage: valeur('ct-resiliation-pct'),
        consentementsValidesJusquau: valeur('ct-validite'),
        identite,
        dateVerification: valeur('ct-date-verification'),
      };
    }

    const erreur = formulaire.querySelector<HTMLElement>('[data-erreur]');
    const succes = formulaire.querySelector<HTMLElement>('[data-succes]');
    const bouton = formulaire.querySelector<HTMLButtonElement>('[data-envoyer]');

    function montrerErreur(message: string): void {
      if (!erreur) return;
      erreur.textContent = message;
      erreur.hidden = false;
      erreur.scrollIntoView({ behavior: 'smooth', block: 'center' });
    }

    /** Contrôles communs à l'aperçu et à l'envoi. */
    function emprunteursValides(donnees: Record<string, unknown>): boolean {
      const emprunteurs = donnees.emprunteurs as Array<Record<string, string>>;
      if (emprunteurs.length === 0 || emprunteurs.some((e) => !e.prenom || !e.nom || !e.courriel)) {
        montrerErreur('Chaque emprunteur affiché doit avoir un prénom, un nom et un courriel.');
        return false;
      }
      return true;
    }

    /* ---------------- Aperçu ---------------- */

    const apercu = formulaire.querySelector<HTMLElement>('[data-apercu]');
    const cadre = formulaire.querySelector<HTMLIFrameElement>('[data-apercu-cadre]');
    let urlApercu: string | null = null;

    formulaire.querySelector('[data-fermer-apercu]')?.addEventListener('click', () => {
      if (apercu) apercu.hidden = true;
    });

    formulaire.querySelector('[data-previsualiser]')?.addEventListener('click', async (evenement) => {
      const declencheur = evenement.currentTarget as HTMLButtonElement;
      if (erreur) erreur.hidden = true;

      const donnees = collecter();
      if (!emprunteursValides(donnees)) return;

      declencheur.disabled = true;
      const libelle = declencheur.textContent;
      declencheur.textContent = 'Préparation…';

      try {
        const reponse = await fetch('/api/contrat-previsualiser', {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({ donnees }),
        });
        if (!reponse.ok) {
          montrerErreur(await reponse.text().catch(() => 'L’aperçu a échoué.'));
          return;
        }
        // Un blob local plutôt qu'un rechargement du cadre : le PDF n'est jamais remis en
        // cache et disparaît avec l'onglet.
        if (urlApercu) URL.revokeObjectURL(urlApercu);
        urlApercu = URL.createObjectURL(await reponse.blob());
        if (cadre) cadre.src = urlApercu;
        if (apercu) {
          apercu.hidden = false;
          apercu.scrollIntoView({ behavior: 'smooth', block: 'start' });
        }
      } catch {
        montrerErreur('Connexion impossible. Vérifiez votre réseau et réessayez.');
      } finally {
        declencheur.disabled = false;
        declencheur.textContent = libelle;
      }
    });

    /* ---------------- Envoi ---------------- */

    formulaire.addEventListener('submit', async (evenement) => {
      evenement.preventDefault();
      if (erreur) erreur.hidden = true;
      if (succes) succes.hidden = true;

      const donnees = collecter();
      if (!emprunteursValides(donnees)) return;

      if (!signatureEnregistree) {
        montrerErreur('Enregistrez d’abord votre signature, en haut de la page.');
        barreSignature?.scrollIntoView({ behavior: 'smooth', block: 'center' });
        return;
      }

      if (bouton) {
        bouton.disabled = true;
        bouton.textContent = 'Envoi…';
      }

      try {
        const reponse = await fetch('/api/contrat-creer', {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          // Aucune signature ne circule : la sienne est mémorisée côté serveur et n'entrera
          // en jeu qu'à la finalisation ; celles des emprunteurs n'existent pas encore.
          body: JSON.stringify({ donnees }),
        });
        const data = (await reponse.json().catch(() => ({}))) as Record<string, unknown>;

        if (!reponse.ok) {
          if (data.code === 'acces') {
            montrerErreur('Votre session a expiré. Rechargez la page pour vous reconnecter.');
          } else {
            montrerErreur(String(data.error ?? 'L’envoi a échoué. Réessayez.'));
          }
          if (bouton) {
            bouton.disabled = false;
            bouton.textContent = 'Créer et envoyer';
          }
          return;
        }

        const enAttente = (data.enAttente ?? []) as Array<{ nom: string; courriel: string }>;
        if (succes) {
          succes.textContent = `Contrat envoyé à ${enAttente
            .map((e) => `${e.nom} (${e.courriel})`)
            .join(', ')}. Vous recevrez un courriel quand tous auront signé, pour le finaliser.`;
          succes.hidden = false;
          succes.scrollIntoView({ behavior: 'smooth', block: 'center' });
        }
        if (bouton) bouton.textContent = 'Contrat envoyé';
      } catch {
        montrerErreur('Connexion impossible. Vérifiez votre réseau et réessayez.');
        if (bouton) {
          bouton.disabled = false;
          bouton.textContent = 'Créer et envoyer';
        }
      }
    });
  }
</script>
