    padding: 0.75rem 1rem;
    margin-bottom: 0.55rem;
    width: 100%;
    min-height: 44px;
    text-align: left;
    font-family: inherit;
    cursor: pointer;
    font-size: 0.92rem;
    color: var(--ink);
  }

  #dc-app .dc-urgence:focus-visible {
    outline: 2px solid var(--clay-dk);
    outline-offset: 2px;
  }

  #dc-app .dc-urgence-nom {
    font-weight: 600;
  }

  #dc-app .dc-urgence-motif {
    color: var(--clay-dk);
    font-size: 0.83rem;
  }

  /* ---------------- Boutons de contact ---------------- */

  #dc-app .dc-action-contact {
    display: inline-flex;
    align-items: center;
    gap: 0.4rem;
    background: var(--forest);
    color: #fff;
    border: none;
    border-radius: 999px;
    padding: 0.6rem 1.1rem;
    min-height: 44px;
    font: inherit;
    font-size: 0.9rem;
    font-weight: 600;
    text-decoration: none;
    cursor: pointer;
  }

  #dc-app .dc-action-contact:hover {
    background: #334c3f;
    color: #fff;
  }

  #dc-app .dc-action-contact--doux {
    background: var(--white);
    color: var(--ink);
    border: 1px solid var(--border);
  }

  #dc-app .dc-action-contact--doux:hover {
    background: var(--warm);
    color: var(--ink);
  }

  /* ---------------- Documents ---------------- */

  #dc-app .dc-doc {
    display: flex;
    align-items: flex-start;
    gap: 0.7rem;
    border-bottom: 1px dashed var(--border);
  }

  #dc-app .dc-doc:last-of-type {
    border-bottom: none;
  }

  /* La rangée entière bascule l'état « reçu » : une case de 17 px n'est pas une cible
     tactile, et c'est le geste que Stéphanie répète le plus souvent après un appel. */
  #dc-app .dc-doc-bascule {
    flex: 1;
    display: flex;
    align-items: flex-start;
    gap: 0.7rem;
    background: none;
    border: none;
    padding: 0.7rem 0;
    min-height: 44px;
    font: inherit;
    text-align: left;
    cursor: pointer;
    color: var(--ink);
    min-width: 0;
  }

  #dc-app .dc-doc-bascule:focus-visible {
    outline: 2px solid var(--clay);
    outline-offset: 2px;
  }

  #dc-app .dc-doc-case {
    flex: none;
    width: 1.15rem;
    height: 1.15rem;
    margin-top: 0.1rem;
    border: 2px solid var(--border);
    border-radius: 5px;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    font-size: 0.8rem;
    line-height: 1;
    color: #fff;
  }

  #dc-app .dc-doc--recu .dc-doc-case {
    background: var(--forest);
    border-color: var(--forest);
  }

  #dc-app .dc-doc-libelle {
    font-size: 0.92rem;
    line-height: 1.45;
  }

  #dc-app .dc-doc--recu .dc-doc-libelle {
    color: var(--muted);
  }

  #dc-app .dc-doc--non-requis .dc-doc-libelle {
    color: var(--muted);
    text-decoration: line-through;
  }

  #dc-app .dc-doc-qui {
    display: block;
    font-size: 0.72rem;
    color: var(--muted);
    text-transform: uppercase;
    letter-spacing: 0.04em;
    margin-top: 0.1rem;
  }

  #dc-app .dc-doc-menu {
    flex: none;
    display: flex;
    gap: 0.15rem;
  }

  #dc-app .dc-doc-action {
    background: none;
    border: none;
    padding: 0.5rem;
    min-width: 44px;
    min-height: 44px;
    font: inherit;
    font-size: 0.76rem;
    color: var(--muted);
    cursor: pointer;
  }

  #dc-app .dc-doc-action:hover {
    color: var(--clay-dk);
  }

  /* ---------------- Liens croisés et historique ---------------- */

  #dc-app .dc-lien {
    margin: 0 0 0.4rem;
    font-size: 0.9rem;
    color: var(--ink);
  }

  #dc-app .dc-historique {
    list-style: none;
    margin: 0.5rem 0 0;
    padding: 0;
    max-height: 22rem;
    overflow-y: auto;
  }

  #dc-app .dc-evenement {
    padding: 0.5rem 0;
    border-bottom: 1px dashed var(--border);
    font-size: 0.86rem;
    color: var(--ink);
  }

  #dc-app .dc-evenement:last-child {
    border-bottom: none;
  }

  #dc-app .dc-evenement-date {
    display: block;
    color: var(--muted);
    font-size: 0.75rem;
    margin-top: 0.15rem;
  }

  /* ---------------- Tableaux des chiffres ---------------- */

  /* Le conteneur défile, pas la page : cinq colonnes ne tiennent pas sur un téléphone, et
     un débordement horizontal du document entier casse tout l'écran. */
  #dc-app .dc-table-cadre {
    overflow-x: auto;
    margin: 0 0 1.5rem;
    -webkit-overflow-scrolling: touch;
  }

  #dc-app .dc-table {
    width: 100%;
    border-collapse: collapse;
    font-size: 0.86rem;
    min-width: 26rem;
  }

  #dc-app .dc-table th {
    text-align: left;
    font-weight: 600;
    color: var(--muted);
    font-size: 0.74rem;
    text-transform: uppercase;
    letter-spacing: 0.04em;
    padding: 0.4rem 0.6rem 0.4rem 0;
    border-bottom: 1px solid var(--border);
    white-space: nowrap;
  }

  #dc-app .dc-table td {
    padding: 0.5rem 0.6rem 0.5rem 0;
    border-bottom: 1px dashed var(--border);
    color: var(--ink);
  }

  #dc-app .dc-table th:not(:first-child),
  #dc-app .dc-table td:not(:first-child) {
    text-align: right;
  }
</style>

<script>
  import {
    BASES_CONSENTEMENT,
    DELAI_SANS_MOUVEMENT_JOURS,
    DESTINATAIRES,
    DOCUMENTS,
    ETAPES,
    ORIGINES,
    etapeSuivante,
    type CleConsentement,
    type CleDestinataire,
    type CleDocument,
    type CleEtape,
    type CleEtatDocument,
    type CleOrigine,
  } from '../utils/dossiersClients';
  import { urgences, vueDe, type Urgence, type Vue } from '../utils/dossiersEcran';
  import {
    SEUIL_LISIBILITE,
    donneesSuffisantes,
    entonnoir,
    rendementParOrigine,
  } from '../utils/statistiquesDossiers';

  /* ---------------- Écran de connexion ---------------- */

  const connexion = document.getElementById('dc-connexion-form') as HTMLFormElement | null;
  connexion?.addEventListener('submit', async (evenement) => {
    evenement.preventDefault();
    const erreur = document.querySelector<HTMLElement>('[data-erreur-connexion]');
    const champ = document.getElementById('dc-mdp') as HTMLInputElement | null;
    if (erreur) erreur.hidden = true;

    try {
      const reponse = await fetch('/api/contrat-acces', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({ motDePasse: champ?.value ?? '' }),
      });
      if (reponse.ok) {
        window.location.reload();
        return;
      }
      const data = (await reponse.json().catch(() => ({}))) as { error?: string };
      if (erreur) {
        erreur.textContent = data.error ?? 'Connexion impossible.';
        erreur.hidden = false;
      }
    } catch {
      if (erreur) {
        erreur.textContent = 'Connexion impossible. Vérifiez votre réseau.';
        erreur.hidden = false;
      }
    }
  });

  /* ---------------- L'application ---------------- */

  interface Evenement {
    readonly le: string;
    readonly type: string;
    readonly resume: string;
  }

  interface LigneDocument {
    readonly cle: CleDocument;
    readonly pourQui: CleDestinataire;
    readonly etat: CleEtatDocument;
  }

  interface Fiche {
    readonly id: string;
    readonly creeLe: string;
    readonly majLe: string;
    readonly nom: string;
    readonly courriel: string;
    readonly telephone: string;
    readonly notes: string;
    readonly origine: CleOrigine;
    readonly consentement: CleConsentement;
    readonly refereParId: string | null;
    readonly etape: CleEtape;
    readonly documents: LigneDocument[];
    readonly relanceLe: string | null;
    readonly clotLe: string | null;
    readonly historique: Evenement[];
  }

  const app = document.getElementById('dc-app');

  if (app) {
    type Panneau = 'jour' | 'fiche' | 'formulaire';

    let dossiers: Fiche[] = [];
    let selection: string | null = null;
    let enModification = false;
    let vue: Vue = 'actifs';
    let panneau: Panneau = 'jour';
    /** La carte d'où l'on vient, pour lui rendre le focus à la fermeture. */
    let carteOrigine: HTMLElement | null = null;

    const delaiSansMouvement = Number(app.dataset.delai ?? String(DELAI_SANS_MOUVEMENT_JOURS));
    const OPTIONS_URGENCE = { delaiSansMouvementJours: delaiSansMouvement };

    /** `app` capturé une fois : TypeScript ne rétrécit pas un `const` dans une fonction hissée. */
    const racine = app;
    const $ = <T extends HTMLElement>(s: string): T | null => racine.querySelector<T>(s);
    const $$ = <T extends HTMLElement>(s: string): T[] => [...racine.querySelectorAll<T>(s)];

    const liste = $<HTMLElement>('[data-liste]');
    const zoneUrgences = $<HTMLElement>('[data-urgences]');
    const panneauJour = $<HTMLElement>('[data-aujourdhui]');
    const fiche = document.getElementById('dc-fiche');
    const formulaire = document.getElementById('dc-formulaire') as HTMLFormElement | null;
    const recherche = document.getElementById('dc-recherche') as HTMLInputElement | null;
    const statut = $<HTMLElement>('[data-statut]');

    const petitEcran = window.matchMedia('(max-width: 63.99rem)');

    const DATE_COURTE = new Intl.DateTimeFormat('fr-CA', { dateStyle: 'medium' });
    const DATE_COMPLETE = new Intl.DateTimeFormat('fr-CA', { dateStyle: 'long', timeStyle: 'short' });

    function dateCourte(iso: string | null): string {
      if (!iso) return '';
      const instant = Date.parse(iso);
      return Number.isNaN(instant) ? '' : DATE_COURTE.format(new Date(instant));
    }

    function dateComplete(iso: string): string {
      const instant = Date.parse(iso);
      return Number.isNaN(instant) ? '' : DATE_COMPLETE.format(new Date(instant));
    }

    function texte<K extends keyof HTMLElementTagNameMap>(
      balise: K,
      classe: string,
      contenu: string,
    ): HTMLElementTagNameMap[K] {
      const element = document.createElement(balise);
      if (classe) element.className = classe;
      element.textContent = contenu;
      return element;
    }

    function manquants(dossier: Fiche): number {
      return dossier.documents.filter((l) => l.etat === 'a_fournir').length;
    }

    /* ---------------- Confirmation d'écriture ---------------- */

    let effacerStatut: ReturnType<typeof setTimeout> | undefined;

    /**
     * La seule région d'état de l'écran. Toutes les écritures y passent : un geste qui ne
     * confirme rien laisse douter, et sur une connexion lente il sera refait deux fois.
     */
    function signalerStatut(message: string): void {
      if (!statut) return;
      statut.textContent = message;
      statut.hidden = false;
      clearTimeout(effacerStatut);
      effacerStatut = setTimeout(() => {
        statut.hidden = true;
      }, 4000);
    }

    /* ---------------- Appels réseau ---------------- */

    /** Une session expirée ne doit pas se manifester par un bouton qui ne fait rien. */
    async function api<T>(url: string, init?: RequestInit): Promise<T | null> {
      const reponse = await fetch(url, init);
      if (reponse.status === 401) {
        window.location.reload();
        return null;
      }
      const data = (await reponse.json().catch(() => ({}))) as T & { error?: string };
      if (!reponse.ok) throw new Error(data.error ?? 'Opération impossible.');
      return data;
    }

    async function agir(corps: Record<string, unknown>): Promise<Fiche | null> {
      const data = await api<{ dossier?: Fiche }>('/api/crm-dossier', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify(corps),
      });
      return data?.dossier ?? null;
    }

    function remplacer(dossier: Fiche): void {
      const index = dossiers.findIndex((d) => d.id === dossier.id);
      if (index === -1) dossiers.unshift(dossier);
      else dossiers[index] = dossier;
      rendre();
    }

    function signaler(selecteur: string, message: string | null): void {
      const cible = $<HTMLElement>(selecteur);
      if (!cible) return;
      cible.textContent = message ?? '';
      cible.hidden = message === null;
    }

    /**
     * Toute écriture passe par ici : le contrôle se désactive le temps de l'aller-retour —
     * ce qui règle aussi le double-clic — et le résultat est annoncé.
     */
    async function action(
      corps: Record<string, unknown>,
      message: string,
      declencheur?: HTMLButtonElement | HTMLSelectElement | HTMLInputElement | null,
    ): Promise<void> {
      if (declencheur) declencheur.disabled = true;
      try {
        signaler('[data-erreur-formulaire]', null);
        const dossier = await agir(corps);
        if (dossier) remplacer(dossier);
        else await charger();
        signalerStatut(message);
      } catch (err) {
        signalerStatut(err instanceof Error ? err.message : 'Opération impossible.');
      } finally {
        if (declencheur) declencheur.disabled = false;
      }
    }

    async function charger(): Promise<void> {
      try {
        const data = await api<{ dossiers: Fiche[] }>('/api/crm-dossiers');
        if (!data) return;
        dossiers = data.dossiers;
        rendre();
      } catch (err) {
        liste?.replaceChildren(
          texte('p', 'dc-vide', err instanceof Error ? err.message : 'Chargement impossible.'),
        );
      }
    }

    /* ---------------- Panneaux ---------------- */

    /**
     * Le panneau de droite n'a jamais qu'un seul contenu. Sur téléphone il passe par-dessus la
     * liste : on verrouille alors le défilement de la page pour que le retour arrière ramène
     * bien à la liste, et non au milieu d'un document à deux étages.
     */
    function montrer(quoi: Panneau): void {
      panneau = quoi;
      if (panneauJour) panneauJour.hidden = quoi !== 'jour';
      if (formulaire) formulaire.hidden = quoi !== 'formulaire';
      if (fiche) fiche.hidden = quoi !== 'fiche';

      const parDessus = quoi !== 'jour';
      racine.classList.toggle('dc-app--panneau', parDessus);
      document.body.style.overflow = parDessus && petitEcran.matches ? 'hidden' : '';
      if (parDessus && petitEcran.matches) window.scrollTo(0, 0);
    }

    function fermerPanneau(): void {
      selection = null;
      enModification = false;
      montrer('jour');
      rendre();
      carteOrigine?.focus();
      carteOrigine = null;
    }

    /* ---------------- Onglets ---------------- */

    function rendreOnglets(): void {
      const comptes: Record<Vue, number> = { actifs: 0, prospects: 0, clos: 0 };
      for (const dossier of dossiers) comptes[vueDe(dossier)] += 1;

      for (const [cle, selecteur] of [
        ['actifs', '[data-compte-actifs]'],
        ['prospects', '[data-compte-prospects]'],
        ['clos', '[data-compte-clos]'],
      ] as Array<[Vue, string]>) {
        const cible = $<HTMLElement>(selecteur);
        if (cible) cible.textContent = comptes[cle] ? `(${comptes[cle]})` : '';
      }

      for (const onglet of $$<HTMLButtonElement>('[data-vue]')) {
        onglet.setAttribute('aria-pressed', String(onglet.dataset.vue === vue));
      }
    }

    /* ---------------- À faire aujourd'hui ---------------- */

    function phraseUrgence(urgence: Urgence): string {
      switch (urgence.type) {
        case 'relance':
          return urgence.joursDeRetard === 0
            ? 'Relance prévue aujourd’hui'
            : `Relance prévue il y a ${urgence.joursDeRetard} jour${urgence.joursDeRetard > 1 ? 's' : ''}`;
        case 'documents_complets':
          return 'Tous les documents sont reçus — le dossier attend votre prochaine étape';
        case 'sans_mouvement':
          return `Sans mouvement depuis ${urgence.jours} jours`;
      }
    }

    function rendreUrgences(): void {
      if (!zoneUrgences) return;

      const cartes = urgences(dossiers, OPTIONS_URGENCE).map(({ fiche: dossier, urgence }) => {
        const bouton = document.createElement('button');
        bouton.type = 'button';
        bouton.className = 'dc-urgence';
        bouton.append(
          texte('span', 'dc-urgence-nom', dossier.nom),
          texte('span', 'dc-urgence-motif', phraseUrgence(urgence)),
        );
        bouton.addEventListener('click', () => ouvrirFiche(dossier.id, bouton));
        return bouton;
      });

      zoneUrgences.replaceChildren(
        ...(cartes.length ? cartes : [texte('p', 'dc-vide', 'Rien ne presse aujourd’hui.')]),
      );
    }

    /* ---------------- Liste ---------------- */

    function filtrer(): Fiche[] {
      const terme = (recherche?.value ?? '').trim().toLowerCase();
      return dossiers.filter((dossier) => {
        if (vueDe(dossier) !== vue) return false;
        if (!terme) return true;
        // Les notes sont dans le foin : c'est là qu'elle écrit « référée par Me Gagnon ».
        return `${dossier.nom} ${dossier.courriel} ${dossier.telephone} ${dossier.notes}`
          .toLowerCase()
          .includes(terme);
      });
    }

    function carte(dossier: Fiche): HTMLButtonElement {
      const bouton = document.createElement('button');
      bouton.type = 'button';
      bouton.className = 'dc-carte';
      bouton.dataset.id = dossier.id;
      if (dossier.id === selection) bouton.setAttribute('aria-current', 'true');

      const entete = document.createElement('div');
      entete.className = 'dc-carte-entete';
      entete.append(texte('span', 'dc-carte-nom', dossier.nom));

      const etiquette = texte('span', 'dc-etiquette', ETAPES[dossier.etape].libelle);
      if (ETAPES[dossier.etape].clot) etiquette.classList.add('dc-etiquette--fait');
      entete.append(etiquette);
      bouton.append(entete);

      const details: string[] = [];
      if (dossier.etape === 'prospect') details.push(ORIGINES[dossier.origine]);
      else if (!ETAPES[dossier.etape].clot) {
        const restants = manquants(dossier);
        details.push(restants === 0 ? 'documents complets' : `${restants} document${restants > 1 ? 's' : ''} en attente`);
      }
      if (dossier.relanceLe) details.push(`relance ${dateCourte(dossier.relanceLe)}`);
      if (details.length) bouton.append(texte('p', 'dc-carte-meta', details.join(' · ')));

      bouton.addEventListener('click', () => ouvrirFiche(dossier.id, bouton));
      return bouton;
    }

    function rendreListe(): void {
      if (!liste) return;
      const visibles = filtrer();
      // La position de défilement est conservée : re-rendre la liste après avoir coché un
      // document ne doit pas renvoyer Stéphanie en haut de son carnet.
      const defilement = liste.scrollTop;

      liste.replaceChildren(
        ...(visibles.length ? visibles.map(carte) : [texte('p', 'dc-vide', 'Aucun dossier ne correspond.')]),
      );
      liste.scrollTop = defilement;
    }

    /* ---------------- La fiche ---------------- */

    function dossierSelectionne(): Fiche | null {
      return dossiers.find((d) => d.id === selection) ?? null;
    }

    function ouvrirFiche(id: string, origine?: HTMLElement): void {
      selection = id;
      carteOrigine = origine ?? null;
      montrer('fiche');
      rendre();
      void chargerLiens(id);
      // Le focus va au nom : sur le panneau plein écran du téléphone, sans cela le lecteur
      // d'écran comme le clavier resteraient sur une liste qui n'est plus à l'écran.
      $<HTMLElement>('[data-fiche-nom]')?.focus();
    }

    /**
     * Un numéro en lien composable. Retourne `null` plutôt qu'un lien mort : proposer
     * « Appeler » sur un numéro incomplet est pire que ne rien proposer.
     */
    function lienTelephone(numero: string, protocole: 'tel' | 'sms'): string | null {
      const chiffres = numero.replace(/\D/g, '');
      if (chiffres.length < 7) return null;
      if (chiffres.length === 10) return `${protocole}:+1${chiffres}`;
      if (chiffres.length === 11 && chiffres.startsWith('1')) return `${protocole}:+${chiffres}`;
      return `${protocole}:${chiffres}`;
    }

    function actionContact(href: string, libelle: string, doux = false): HTMLAnchorElement {
      const lien = document.createElement('a');
      lien.className = `dc-action-contact${doux ? ' dc-action-contact--doux' : ''}`;
      lien.href = href;
      lien.textContent = libelle;
      return lien;
    }

    /** Appeler, texter, écrire — le geste le plus fréquent de la journée, en un tap. */
    function rendreContact(dossier: Fiche): void {
      const hote = $<HTMLElement>('[data-contact]');
      const avis = $<HTMLElement>('[data-avis-adresse]');
      if (!hote) return;

      const actions: HTMLAnchorElement[] = [];
      const appel = lienTelephone(dossier.telephone, 'tel');
      const texto = lienTelephone(dossier.telephone, 'sms');
      if (appel) actions.push(actionContact(appel, 'Appeler'));
      if (texto) actions.push(actionContact(texto, 'Texter', true));
      if (dossier.courriel) actions.push(actionContact(`mailto:${dossier.courriel}`, 'Écrire', true));

      hote.replaceChildren(
        ...(actions.length
          ? actions
          : [texte('p', 'dc-vide', 'Aucune coordonnée — corrigez la fiche pour pouvoir la joindre.')]),
      );

      if (avis) {
        avis.hidden = Boolean(dossier.courriel);
        if (!dossier.courriel) {
          avis.textContent =
            'Aucune adresse courriel : le portail restera fermé, et le suivi ne peut pas être envoyé.';
        }
      }
    }

    function rendreGeste(dossier: Fiche): void {
      const bouton = $<HTMLButtonElement>('[data-avancer]');
      if (bouton) {
        const suivante = etapeSuivante(dossier.etape);
        if (dossier.etape === 'prospect') {
          bouton.textContent = 'Qualifier — ouvrir le dossier';
          bouton.hidden = false;
        } else if (suivante) {
          bouton.textContent = `Avancer vers ${ETAPES[suivante].libelle}`;
          bouton.hidden = false;
        } else {
          bouton.hidden = true;
        }
      }

      const select = $<HTMLSelectElement>('[data-etape]');
      if (select) select.value = dossier.etape;

      // Ce que le client lira, montré ici : faire avancer un dossier sans savoir ce que le
      // geste annonce à l'autre bout est la façon dont un portail se met à mentir.
      const note = $<HTMLElement>('[data-etape-client]');
      if (note) {
        const etape = ETAPES[dossier.etape];
        note.textContent = etape.visibleClient
          ? `Le client lira : « ${etape.libelleClient} — ${etape.explicationClient} »`
          : 'Le client ne voit rien de cette étape : son portail affiche un écran neutre.';
      }
    }

    function rendreDocuments(dossier: Fiche): void {
      const hote = $<HTMLElement>('[data-documents]');
      if (!hote) return;

      const total = dossier.documents.filter((l) => l.etat !== 'non_requis').length;
      const recus = dossier.documents.filter((l) => l.etat === 'recu').length;

      const compte = $<HTMLElement>('[data-compte-docs]');
      if (compte) {
        compte.textContent = total === 0 ? '' : `${recus} de ${total} reçus`;
      }

      const progres = $<HTMLElement>('[data-progres]');
      const barre = $<HTMLElement>('[data-progres-barre]');
      if (progres && barre) {
        progres.hidden = total === 0;
        barre.style.width = `${total === 0 ? 0 : Math.round((recus / total) * 100)}%`;
      }

      if (dossier.documents.length === 0) {
        hote.replaceChildren(texte('p', 'dc-vide', 'Aucune pièce à la liste.'));
        return;
      }

      // Ce qui manque en premier : c'est ce qu'elle regarde.
      const rang = { a_fournir: 0, recu: 1, non_requis: 2 } as const;
      const ordonnees = [...dossier.documents].sort((a, b) => rang[a.etat] - rang[b.etat]);

      hote.replaceChildren(
        ...ordonnees.map((ligne) => {
          const rangee = document.createElement('div');
          rangee.className = `dc-doc dc-doc--${ligne.etat.replace('_', '-')}`;

          const bascule = document.createElement('button');
          bascule.type = 'button';
          bascule.className = 'dc-doc-bascule';
          bascule.disabled = ligne.etat === 'non_requis';
          bascule.setAttribute('aria-pressed', String(ligne.etat === 'recu'));

          const case_ = texte('span', 'dc-doc-case', ligne.etat === 'recu' ? '✓' : '');
          case_.setAttribute('aria-hidden', 'true');

          const corps = document.createElement('span');
          corps.className = 'dc-doc-corps';
          corps.append(texte('span', 'dc-doc-libelle', DOCUMENTS[ligne.cle].libelle));
          if (ligne.pourQui !== 'dossier') {
            corps.append(texte('span', 'dc-doc-qui', DESTINATAIRES[ligne.pourQui]));
          }

          bascule.append(case_, corps);
          bascule.addEventListener('click', () => {
            void marquer(dossier.id, ligne, ligne.etat === 'recu' ? 'a_fournir' : 'recu', bascule);
          });

          const menu = document.createElement('div');
          menu.className = 'dc-doc-menu';

          const ecarter = texte('button', 'dc-doc-action', ligne.etat === 'non_requis' ? 'Rétablir' : 'Non requis');
          ecarter.type = 'button';
          ecarter.addEventListener('click', () => {
            void marquer(dossier.id, ligne, ligne.etat === 'non_requis' ? 'a_fournir' : 'non_requis', ecarter);
          });

          const retirer = texte('button', 'dc-doc-action', 'Retirer');
          retirer.type = 'button';
          retirer.addEventListener('click', () => {
            void action(
              { action: 'document-retirer', id: dossier.id, document: ligne.cle, pourQui: ligne.pourQui },
              'Pièce retirée de la liste',
              retirer,
            );
          });

          menu.append(ecarter, retirer);
          rangee.append(bascule, menu);
          return rangee;
        }),
      );
    }

    async function marquer(
      id: string,
      ligne: LigneDocument,
      etat: CleEtatDocument,
      declencheur?: HTMLButtonElement,
    ): Promise<void> {
      const libelle = DOCUMENTS[ligne.cle].libelle;
      const message =
        etat === 'recu' ? `${libelle} — reçu` : etat === 'non_requis' ? `${libelle} — écarté` : `${libelle} — à fournir`;
      await action(
        { action: 'document-etat', id, document: ligne.cle, pourQui: ligne.pourQui, etat },
        message,
        declencheur,
      );
    }

    function rendreFiche(): void {
      const dossier = dossierSelectionne();
      if (!fiche || !dossier) return;

      const nom = $<HTMLElement>('[data-fiche-nom]');
      if (nom) nom.textContent = dossier.nom;

      const meta = $<HTMLElement>('[data-fiche-meta]');
      if (meta) {
        const morceaux: string[] = [ETAPES[dossier.etape].libelle, `ouvert ${dateCourte(dossier.creeLe)}`];
        meta.textContent = morceaux.join(' · ');
      }

      const provenance = $<HTMLElement>('[data-fiche-provenance]');
      if (provenance) {
        provenance.textContent = `${ORIGINES[dossier.origine]} · ${BASES_CONSENTEMENT[dossier.consentement]}`;
      }

      rendreContact(dossier);
      rendreGeste(dossier);
      rendreDocuments(dossier);

      const relance = $<HTMLInputElement>('[data-relance]');
      if (relance) relance.value = dossier.relanceLe ?? '';

      const etatRelance = $<HTMLElement>('[data-relance-etat]');
      if (etatRelance) {
        etatRelance.textContent = dossier.relanceLe
          ? `Prévu le ${dateCourte(dossier.relanceLe)}`
          : 'Aucune relance prévue.';
      }

      const prevenir = $<HTMLButtonElement>('[data-prevenir]');
      if (prevenir) prevenir.disabled = !dossier.courriel || !ETAPES[dossier.etape].visibleClient;

      // La confirmation de suppression repart fermée à chaque rendu.
      const confirme = $<HTMLElement>('[data-confirme-suppression]');
      const supprimer = $<HTMLElement>('[data-supprimer]');
      if (confirme && supprimer) {
        confirme.hidden = true;
        supprimer.hidden = false;
      }

      const historique = $<HTMLElement>('[data-historique]');
      if (historique) {
        historique.replaceChildren(
          ...[...dossier.historique].reverse().map((evenement) => {
            const item = document.createElement('li');
            item.className = 'dc-evenement';
            item.append(
              texte('span', '', evenement.resume),
              texte('span', 'dc-evenement-date', dateComplete(evenement.le)),
            );
            return item;
          }),
        );
      }
    }

    /* ---------------- Cette personne, ailleurs ---------------- */

    interface Liens {
      readonly reseau: { nom: string; profession: string; etat: string } | null;
      readonly contrat: { statut: string; signeLe: string | null; aSonTour: boolean } | null;
      readonly referePar: { nom: string; profession: string } | null;
    }

    /**
     * Chargé **à l'ouverture d'une fiche seulement** : la route relit trois magasins, et
     * l'appeler pour chaque ligne de la liste coûterait le triple à chaque affichage.
     */
    async function chargerLiens(id: string): Promise<void> {
      const bloc = $<HTMLElement>('[data-liens-bloc]');
      const hote = $<HTMLElement>('[data-liens]');
      if (!bloc || !hote) return;
      bloc.hidden = true;

      let liens: Liens;
      try {
        const data = await api<{ liens: Liens }>(`/api/crm-lien?id=${encodeURIComponent(id)}`);
        if (!data || selection !== id) return;
        liens = data.liens;
      } catch {
        return; // un encart secondaire ne doit pas faire échouer l'écran
      }

      const lignes: HTMLElement[] = [];
      if (liens.referePar) {
        lignes.push(texte('p', 'dc-lien', `Référé par ${liens.referePar.nom} — ${liens.referePar.profession}`));
      }
      if (liens.reseau) {
        lignes.push(texte('p', 'dc-lien', `Au carnet du réseau : ${liens.reseau.profession} · ${liens.reseau.etat}`));
      }
      if (liens.contrat) {
        const etat = liens.contrat.signeLe
          ? 'a signé'
          : liens.contrat.aSonTour
            ? 'c’est à son tour de signer'
            : 'en attente de son tour';
        lignes.push(texte('p', 'dc-lien', `Contrat de courtage en cours — ${etat}`));
      }

      if (lignes.length === 0) return;
      hote.replaceChildren(...lignes);
      bloc.hidden = false;
    }

    /* ---------------- Les chiffres ---------------- */

    function tableau(entetes: string[], lignes: string[][]): HTMLElement {
      const cadre = document.createElement('div');
      cadre.className = 'dc-table-cadre';

      const table = document.createElement('table');
      table.className = 'dc-table';

      const thead = document.createElement('thead');
      const ligneEntete = document.createElement('tr');
      for (const entete of entetes) ligneEntete.append(texte('th', '', entete));
      thead.append(ligneEntete);

      const tbody = document.createElement('tbody');
      for (const cellules of lignes) {
        const tr = document.createElement('tr');
        for (const cellule of cellules) tr.append(texte('td', '', cellule));
        tbody.append(tr);
      }

      table.append(thead, tbody);
      cadre.append(table);
      return cadre;
    }

    /**
     * Calculés ici même sur la liste déjà chargée — aucune requête de plus.
     *
     * La réserve n'est pas de la modestie : un taux tiré de onze fiches raconte le hasard, et
     * affiché sans réserve il servira quand même à décider.
     */
    function rendreChiffres(): void {
      const hote = $<HTMLElement>('[data-chiffres]');
      const reserve = $<HTMLElement>('[data-reserve]');
      if (!hote) return;

      if (reserve) {
        const mince = !donneesSuffisantes(dossiers);
        reserve.textContent = mince
          ? `Le carnet ne compte que ${dossiers.length} fiche${dossiers.length > 1 ? 's' : ''} : en deçà de ${SEUIL_LISIBILITE}, ces chiffres racontent surtout le hasard. À lire dans quelques mois.`
          : 'Les durées ne se calculent que depuis les étapes franchies après la mise en service du suivi. Les dossiers ouverts avant n’y figurent pas.';
        reserve.hidden = false;
      }

      const rendement = rendementParOrigine(dossiers);
      const etages = entonnoir(dossiers).filter((e) => e.atteintes > 0);
      const blocs: HTMLElement[] = [];

      if (rendement.length > 0) {
        blocs.push(texte('h3', 'dc-h3', 'Ce que chaque porte d’entrée produit'));
        blocs.push(
          tableau(
            ['Porte d’entrée', 'Entrées', 'Qualifiés', 'Financés', 'Perdus'],
            rendement.map((l) => [l.libelle, String(l.total), String(l.qualifies), String(l.finances), String(l.perdus)]),
          ),
        );
      }

      if (etages.length > 0) {
        blocs.push(texte('h3', 'dc-h3', 'Progression et durées'));
        blocs.push(
          tableau(
            ['Étape', 'Fiches passées par là', 'Jours médians'],
            etages.map((e) => [
              e.libelle,
              String(e.atteintes),
              e.joursMedians === null ? '—' : String(Math.round(e.joursMedians * 10) / 10),
            ]),
          ),
        );
      }

      hote.replaceChildren(...(blocs.length ? blocs : [texte('p', 'dc-vide', 'Rien à mesurer pour l’instant.')]));
    }

    function rendre(): void {
      rendreOnglets();
      rendreUrgences();
      rendreListe();
      rendreFiche();
      rendreChiffres();
    }

    /* ---------------- Formulaire ---------------- */

    const champs = {
      nom: document.getElementById('dc-nom') as HTMLInputElement | null,
      courriel: document.getElementById('dc-courriel') as HTMLInputElement | null,
      telephone: document.getElementById('dc-telephone') as HTMLInputElement | null,
      notes: document.getElementById('dc-notes') as HTMLTextAreaElement | null,
    };

    function ouvrirFormulaire(dossier: Fiche | null): void {
      if (!formulaire) return;
      enModification = dossier !== null;

      const titre = $<HTMLElement>('[data-formulaire-titre]');
      if (titre) titre.textContent = dossier ? 'Corriger les coordonnées' : 'Nouveau dossier';

      if (champs.nom) champs.nom.value = dossier?.nom ?? '';
      if (champs.courriel) champs.courriel.value = dossier?.courriel ?? '';
      if (champs.telephone) champs.telephone.value = dossier?.telephone ?? '';
      if (champs.notes) champs.notes.value = dossier?.notes ?? '';

      signaler('[data-erreur-formulaire]', null);
      montrer('formulaire');
      champs.nom?.focus();
    }

    $<HTMLButtonElement>('[data-nouveau]')?.addEventListener('click', () => {
      selection = null;
      rendre();
      ouvrirFormulaire(null);
    });

    $<HTMLButtonElement>('[data-annuler]')?.addEventListener('click', () => {
      if (selection) {
        montrer('fiche');
        rendre();
      } else {
        fermerPanneau();
      }
    });

    formulaire?.addEventListener('submit', async (evenement) => {
      evenement.preventDefault();
      const bouton = formulaire.querySelector<HTMLButtonElement>('button[type="submit"]');
      const donnees = {
        nom: champs.nom?.value ?? '',
        courriel: champs.courriel?.value ?? '',
        telephone: champs.telephone?.value ?? '',
        notes: champs.notes?.value ?? '',
      };

      const courant = dossierSelectionne();
      if (bouton) bouton.disabled = true;
      try {
        signaler('[data-erreur-formulaire]', null);
        const enregistre = await agir(
          enModification && courant
            ? { action: 'modifier', id: courant.id, dossier: donnees }
            : { action: 'creer', dossier: donnees },
        );
        if (!enregistre) return;
        remplacer(enregistre);
        enModification = false;
        signalerStatut(courant ? 'Coordonnées mises à jour' : 'Dossier créé');
        ouvrirFiche(enregistre.id);
      } catch (err) {
        signaler('[data-erreur-formulaire]', err instanceof Error ? err.message : 'Enregistrement impossible.');
      } finally {
        if (bouton) bouton.disabled = false;
      }
    });

    /* ---------------- Actions de la fiche ---------------- */

    $<HTMLButtonElement>('[data-fermer-fiche]')?.addEventListener('click', fermerPanneau);

    $<HTMLButtonElement>('[data-avancer]')?.addEventListener('click', (evenement) => {
      const courant = dossierSelectionne();
      if (!courant) return;
      const suivante = courant.etape === 'prospect' ? 'nouveau' : etapeSuivante(courant.etape);
      if (!suivante) return;
      void action(
        { action: 'etape', id: courant.id, etape: suivante },
        courant.etape === 'prospect' ? 'Dossier ouvert — la liste de documents est établie' : `Avancé vers ${ETAPES[suivante].libelle}`,
        evenement.currentTarget as HTMLButtonElement,
      );
    });

    $<HTMLSelectElement>('[data-etape]')?.addEventListener('change', (evenement) => {
      const courant = dossierSelectionne();
      if (!courant) return;
      const select = evenement.currentTarget as HTMLSelectElement;
      const etape = select.value as CleEtape;
      void action({ action: 'etape', id: courant.id, etape }, `Étape : ${ETAPES[etape].libelle}`, select);
    });

    $<HTMLButtonElement>('[data-ajouter-doc]')?.addEventListener('click', (evenement) => {
      const courant = dossierSelectionne();
      if (!courant) return;
      const cle = $<HTMLSelectElement>('[data-doc-cle]')?.value;
      const pourQui = $<HTMLSelectElement>('[data-doc-qui]')?.value;
      if (!cle || !pourQui) return;
      void action(
        { action: 'document-ajouter', id: courant.id, document: cle, pourQui },
        'Pièce ajoutée à la liste',
        evenement.currentTarget as HTMLButtonElement,
      );
    });

    $<HTMLButtonElement>('[data-noter]')?.addEventListener('click', async (evenement) => {
      const courant = dossierSelectionne();
      const champ = document.getElementById('dc-note-rapide') as HTMLTextAreaElement | null;
      if (!courant || !champ || champ.value.trim().length < 2) return;
      await action(
        { action: 'note', id: courant.id, texte: champ.value },
        'Note ajoutée',
        evenement.currentTarget as HTMLButtonElement,
      );
      champ.value = '';
    });

    /* ---------------- Relance ---------------- */

    function enDate(quand: Date): string {
      const decale = new Date(quand.getTime() - quand.getTimezoneOffset() * 60_000);
      return decale.toISOString().slice(0, 10);
    }

    function fixerRelance(date: string | null, message: string, declencheur?: HTMLElement): void {
      const courant = dossierSelectionne();
      if (!courant) return;
      void action(
        { action: 'relance', id: courant.id, date },
        message,
        declencheur as HTMLButtonElement | undefined,
      );
    }

    for (const chip of $$<HTMLButtonElement>('[data-relance-dans]')) {
      chip.addEventListener('click', () => {
        const jours = Number(chip.dataset.relanceDans ?? '1');
        const cible = new Date();
        cible.setDate(cible.getDate() + jours);
        fixerRelance(enDate(cible), `Relance fixée au ${dateCourte(enDate(cible))}`, chip);
      });
    }

    $<HTMLButtonElement>('[data-relance-lundi]')?.addEventListener('click', (evenement) => {
      const cible = new Date();
      // 1 = lundi ; on va toujours au lundi suivant, jamais à celui d'aujourd'hui.
      const versLundi = ((8 - cible.getDay()) % 7) || 7;
      cible.setDate(cible.getDate() + versLundi);
      fixerRelance(enDate(cible), `Relance fixée au ${dateCourte(enDate(cible))}`, evenement.currentTarget as HTMLButtonElement);
    });

    $<HTMLInputElement>('[data-relance]')?.addEventListener('change', (evenement) => {
      const champ = evenement.currentTarget as HTMLInputElement;
      fixerRelance(champ.value || null, champ.value ? `Relance fixée au ${dateCourte(champ.value)}` : 'Relance effacée', champ);
    });

    $<HTMLButtonElement>('[data-relance-effacer]')?.addEventListener('click', (evenement) => {
      fixerRelance(null, 'Relance effacée', evenement.currentTarget as HTMLButtonElement);
    });

    /* ---------------- Prévenir le client ---------------- */

    $<HTMLButtonElement>('[data-prevenir]')?.addEventListener('click', async (evenement) => {
      const courant = dossierSelectionne();
      if (!courant) return;

      const bouton = evenement.currentTarget as HTMLButtonElement;
      signaler('[data-erreur-prevenir]', null);
      bouton.disabled = true;

      try {
        const data = await api<{ envoye?: boolean; simule?: boolean }>('/api/crm-prevenir', {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({ id: courant.id }),
        });
        if (data) signalerStatut(data.simule ? 'Suivi simulé (voir la console du serveur)' : 'Suivi envoyé au client');
        await charger();
      } catch (err) {
        signaler('[data-erreur-prevenir]', err instanceof Error ? err.message : 'Envoi impossible.');
      } finally {
        bouton.disabled = false;
      }
    });

    /* ---------------- Modifier et supprimer ---------------- */

    $<HTMLButtonElement>('[data-modifier]')?.addEventListener('click', () => {
      ouvrirFormulaire(dossierSelectionne());
    });

    /**
     * Suppression en deux temps, dans la page.
     *
     * `window.confirm` posait une modale de navigateur — sur téléphone, la différence entre
     * un geste réversible et un accident.
     */
    $<HTMLButtonElement>('[data-supprimer]')?.addEventListener('click', (evenement) => {
      (evenement.currentTarget as HTMLElement).hidden = true;
      const confirme = $<HTMLElement>('[data-confirme-suppression]');
      if (confirme) confirme.hidden = false;
      $<HTMLButtonElement>('[data-confirmer-suppression]')?.focus();
    });

    $<HTMLButtonElement>('[data-annuler-suppression]')?.addEventListener('click', () => {
      const confirme = $<HTMLElement>('[data-confirme-suppression]');
      const supprimer = $<HTMLButtonElement>('[data-supprimer]');
      if (confirme) confirme.hidden = true;
      if (supprimer) {
        supprimer.hidden = false;
        supprimer.focus();
      }
    });

    $<HTMLButtonElement>('[data-confirmer-suppression]')?.addEventListener('click', async (evenement) => {
      const courant = dossierSelectionne();
      if (!courant) return;
      const bouton = evenement.currentTarget as HTMLButtonElement;
      bouton.disabled = true;

      try {
        await api('/api/crm-dossier', {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({ action: 'supprimer', id: courant.id }),
        });
        signalerStatut(`Dossier de ${courant.nom} supprimé`);
        selection = null;
        montrer('jour');
        await charger();
      } catch (err) {
        signalerStatut(err instanceof Error ? err.message : 'Suppression impossible.');
      } finally {
        bouton.disabled = false;
      }
    });

    /* ---------------- Vues, recherche, clavier ---------------- */

    for (const onglet of $$<HTMLButtonElement>('[data-vue]')) {
      onglet.addEventListener('click', () => {
        vue = (onglet.dataset.vue ?? 'actifs') as Vue;
        const courant = dossierSelectionne();
        if (courant && vueDe(courant) !== vue) {
          selection = null;
          montrer('jour');
        }
        rendre();
      });
    }

    recherche?.addEventListener('input', rendreListe);

    function dansUnChamp(cible: EventTarget | null): boolean {
      const element = cible as HTMLElement | null;
      if (!element) return false;
      return ['INPUT', 'TEXTAREA', 'SELECT'].includes(element.tagName) || element.isContentEditable;
    }

    document.addEventListener('keydown', (evenement) => {
      if (evenement.key === 'Escape' && panneau !== 'jour') {
        evenement.preventDefault();
        fermerPanneau();
        return;
      }

      if (evenement.key === '/' && !dansUnChamp(evenement.target)) {
        evenement.preventDefault();
        recherche?.focus();
        recherche?.select();
      }
    });

    // Parcourir la liste au clavier depuis une carte.
    liste?.addEventListener('keydown', (evenement) => {
      if (evenement.key !== 'ArrowDown' && evenement.key !== 'ArrowUp') return;
      const cartes = [...(liste.querySelectorAll<HTMLButtonElement>('.dc-carte') ?? [])];
      const index = cartes.indexOf(document.activeElement as HTMLButtonElement);
      if (index === -1) return;
      evenement.preventDefault();
      const suivant = cartes[index + (evenement.key === 'ArrowDown' ? 1 : -1)];
      suivant?.focus();
    });

    // Repasser en grand écran alors qu'un panneau était ouvert doit rendre son défilement
    // à la page : sinon le corps reste bloqué sans qu'aucun panneau ne le justifie.
    petitEcran.addEventListener('change', () => {
      document.body.style.overflow = panneau !== 'jour' && petitEcran.matches ? 'hidden' : '';
    });

    montrer('jour');
    void charger();
  }
</script>
