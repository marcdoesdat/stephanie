<style is:global>
  /* Cartes, urgences, checklist, boutons de contact, historique et tableaux sont bâtis en
     JavaScript : le style scopé d'Astro ne les atteindrait pas — il n'estampe son attribut de
     portée que sur les éléments qu'il rend lui-même. D'où ce bloc global, circonscrit à
     `#dc-app`.

     ⚠️ Les noms restent propres à cet écran (`dc-`). Une règle globale posée sur un nom
     partagé repeindrait les éléments d'une autre page — c'est arrivé avec `.rs-lien`. */

  /* ---------------- Cartes de la liste ---------------- */

  #dc-app .dc-carte {
    width: 100%;
    text-align: left;
    display: block;
    background: var(--white);
    border: 1px solid var(--border);
    border-radius: 12px;
    padding: 0.75rem 0.9rem;
    margin-bottom: 0.5rem;
    cursor: pointer;
    font-family: inherit;
    min-height: 44px;
    transition: border-color 0.15s;
  }

  #dc-app .dc-carte:hover {
    border-color: var(--clay);
  }

  #dc-app .dc-carte:focus-visible {
    outline: 2px solid var(--clay);
    outline-offset: 2px;
  }

  #dc-app .dc-carte[aria-current='true'] {
    border-color: var(--clay-dk);
    background: var(--warm);
  }

  #dc-app .dc-carte-entete {
    display: flex;
    justify-content: space-between;
