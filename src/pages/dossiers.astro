---
// Dossiers clients — /dossiers. Réservé à la courtière.
//
// L'écran répond à deux questions, jamais plus : « qu'est-ce que je dois faire aujourd'hui ? »
// et « que sais-je de cette personne, et comment je la joins ? ». Tout ce qui ne sert pas
// l'une des deux descend ou se replie.
//
// Disposition : deux colonnes sur écran large — la liste à gauche, qui reste en vue, et le
// détail à droite. Le détail n'a jamais qu'un seul contenu à la fois : les urgences du jour
// quand rien n'est sélectionné, la fiche, ou le formulaire de création. **Les urgences sont
// donc l'état vide du panneau**, et non une section de plus qui pousse la liste vers le bas :
// l'écran montre toujours soit ce qu'il y a à faire, soit la personne sur qui elle travaille.
//
// Sur téléphone, une seule colonne : les urgences en tête, la liste dessous, et le détail qui
// s'ouvre **par-dessus** plutôt que de s'ajouter sous une liste qu'il faudrait remonter.
//
// Rendu à l'exécution : la page vérifie le cookie d'accès à chaque requête et, faute de quoi,
// ne rend que l'écran de connexion. Même porte que /contrat et /reseau — c'est la même
// personne. Les endpoints `crm-*` appliquent exactement le même verdict.
export const prerender = false;

import MainLayout from '../layouts/MainLayout.astro';
import { loadSiteConfig } from '../config';
import { accesConfigure, accesLibreEnDev, requeteAutorisee } from '../services/accesCourtiere';
import { portailConfigure } from '../services/portailAcces';
import {
  DELAI_SANS_MOUVEMENT_JOURS,
  DESTINATAIRES,
  DOCUMENTS,
  ETAPES,
  ORDRE_ETAPES,
} from '../utils/dossiersClients';

const config = loadSiteConfig();
const autorise = await requeteAutorisee(Astro.request);
const configureManquante = !accesConfigure() && !accesLibreEnDev();

// Le portail client se signe avec son propre secret. S'il manque, les liens qu'elle enverra
// n'ouvriront rien — autant le lui dire ici, où elle peut encore ne pas les envoyer.
const portailFerme = !portailConfigure() && !import.meta.env.DEV;

Astro.response.headers.set('Cache-Control', 'no-store');

const etapes = ORDRE_ETAPES.map((cle) => ({ cle, libelle: ETAPES[cle].libelle }));
const documents = Object.entries(DOCUMENTS).map(([cle, doc]) => ({ cle, libelle: doc.libelle }));
const destinataires = Object.entries(DESTINATAIRES);
---

<MainLayout
  title="Dossiers clients"
  description="Outil interne de suivi des dossiers clients."
  noindex={true}
  sansBarreCta={true}
>
  <main id="main-content" class="dc-page">
    {
      !autorise ? (
        <div class="dc-shell-connexion">
          <div class="contact-form dc-connexion">
            <h1 class="dc-titre">Dossiers clients</h1>
            {configureManquante ? (
              <p class="dc-alerte">
                L’accès n’est pas configuré : la variable d’environnement
                <code>CONTRAT_MOT_DE_PASSE</code> est absente ou trop courte (12 caractères
                minimum). Ajoutez-la dans Netlify, puis redéployez.
              </p>
            ) : (
              <>
                <p class="dc-texte">Cette page est réservée à {config.nom}.</p>
                <form id="dc-connexion-form" autocomplete="on">
                  <label class="cform-label" for="dc-mdp">Mot de passe</label>
                  <input
                    type="password"
                    id="dc-mdp"
                    class="cform-input"
                    autocomplete="current-password"
                    required
                  />
                  <p class="dc-erreur" data-erreur-connexion hidden />
                  <button type="submit" class="btn btn-primary dc-bouton">Entrer</button>
                </form>
              </>
            )}
          </div>
        </div>
      ) : (
        <div id="dc-app" data-delai={String(DELAI_SANS_MOUVEMENT_JOURS)}>
          {/* ---------------- Barre d'en-tête ---------------- */}
          <header class="dc-topbar">
            <h1 class="dc-titre">Dossiers</h1>
            <button type="button" class="btn-cta dc-mini" data-nouveau>+ Nouveau</button>
          </header>

          {portailFerme && (
            <p class="dc-alerte">
              Le portail client est fermé : la variable <code>PORTAIL_SECRET</code> est absente
              ou trop courte (32 caractères minimum). Les liens que vous enverriez n’ouvriraient
              rien. Ajoutez-la dans Netlify, puis redéployez.
            </p>
          )}

          {/* Une seule région d'état pour toutes les écritures de l'écran. */}
          <p class="dc-statut" data-statut role="status" aria-live="polite" hidden />

          <div class="dc-grille">
            {/* ---------------- Colonne : la liste ---------------- */}
            <aside class="dc-colonne" data-colonne>
              <label class="dc-recherche">
                <span class="sr-only">Rechercher un dossier</span>
                <input
                  type="search"
                  id="dc-recherche"
                  class="cform-input"
                  placeholder="Rechercher…  (touche /)"
                  autocomplete="off"
                />
              </label>

              <nav class="dc-vues" aria-label="Filtrer les fiches">
                <button type="button" class="dc-vue" data-vue="actifs" aria-pressed="true">
                  Actifs <span class="dc-vue-compte" data-compte-actifs />
                </button>
                <button type="button" class="dc-vue" data-vue="prospects" aria-pressed="false">
                  Prospects <span class="dc-vue-compte" data-compte-prospects />
                </button>
                <button type="button" class="dc-vue" data-vue="clos" aria-pressed="false">
                  Clos <span class="dc-vue-compte" data-compte-clos />
                </button>
              </nav>

              <div class="dc-liste" data-liste />
            </aside>

            {/* ---------------- Colonne : le détail ---------------- */}
            <section class="dc-detail" data-detail aria-live="polite">
              {/* État vide : ce qui réclame un geste aujourd'hui. */}
              <div class="dc-panneau-jour" data-aujourdhui>
                <h2 class="dc-h2">À faire aujourd’hui</h2>
                <div data-urgences />
              </div>

              {/* Formulaire de création / correction. */}
              <form class="contact-form dc-panneau" id="dc-formulaire" hidden>
                <div class="dc-panneau-tete">
                  <h2 class="dc-h2" data-formulaire-titre>Nouveau dossier</h2>
                  <button type="button" class="btn-lien" data-annuler>Annuler</button>
                </div>
                <div class="dc-grille-champs">
                  <div>
                    <label class="cform-label" for="dc-nom">Nom du client</label>
                    <input type="text" id="dc-nom" class="cform-input" required maxlength="120" autocomplete="off" />
                  </div>
                  <div>
                    <label class="cform-label" for="dc-courriel">Courriel</label>
                    <input type="email" id="dc-courriel" class="cform-input" maxlength="200" autocomplete="off" />
                  </div>
                  <div>
                    <label class="cform-label" for="dc-telephone">Téléphone</label>
                    <input type="tel" id="dc-telephone" class="cform-input" maxlength="40" autocomplete="off" />
                  </div>
                </div>
                <label class="cform-label" for="dc-notes">Notes internes</label>
                <textarea
                  id="dc-notes"
                  class="cform-input"
                  maxlength="4000"
                  rows="3"
                  placeholder="Ce qu’il faut se rappeler avant de l’appeler. Le client ne voit jamais ce champ."
                />
                <p class="dc-erreur" data-erreur-formulaire hidden />
                <button type="submit" class="btn-cta">Enregistrer</button>
              </form>

              {/* La fiche. */}
              <article class="dc-fiche" id="dc-fiche" hidden>
                <div class="dc-fiche-barre">
                  <button type="button" class="dc-retour" data-fermer-fiche>
                    <span aria-hidden="true">‹</span> Retour à la liste
                  </button>
                </div>

                <header class="dc-fiche-tete">
                  <h2 class="dc-h2" data-fiche-nom tabindex="-1" />
                  <p class="dc-fiche-meta" data-fiche-meta />
                  <p class="dc-fiche-provenance" data-fiche-provenance />

                  {/* Le geste le plus fréquent de la journée. */}
                  <div class="dc-contact" data-contact />
                  <p class="dc-avis" data-avis-adresse hidden />
                </header>

                {/* Le geste suivant — un seul bouton, qui nomme sa destination. */}
                <section class="dc-bloc dc-bloc-geste">
                  <button type="button" class="btn-cta dc-primaire" data-avancer />
                  <p class="dc-note-etape" data-etape-client />
                  <details class="dc-changer">
                    <summary>Changer d’étape</summary>
                    <select data-etape class="cform-input" aria-label="Étape du dossier">
                      {etapes.map(({ cle, libelle }) => <option value={cle}>{libelle}</option>)}
                      <option value="perdu">{ETAPES.perdu.libelle}</option>
                    </select>
                  </details>
                </section>

                {/* Documents. */}
                <section class="dc-bloc">
                  <h3 class="dc-h3">
                    Documents <span class="dc-compte" data-compte-docs />
                  </h3>
                  <div class="dc-progres" data-progres hidden>
                    <div class="dc-progres-barre" data-progres-barre />
                  </div>
                  <div data-documents />
                  <details class="dc-ajout">
                    <summary>Ajouter une pièce</summary>
                    <div class="dc-ligne-actions">
                      <select data-doc-cle class="cform-input" aria-label="Pièce à ajouter">
                        {documents.map(({ cle, libelle }) => <option value={cle}>{libelle}</option>)}
                      </select>
                      <select data-doc-qui class="cform-input" aria-label="Pour qui">
                        {destinataires.map(([cle, libelle]) => <option value={cle}>{libelle}</option>)}
                      </select>
                      <button type="button" class="btn-cta dc-mini" data-ajouter-doc>Ajouter</button>
                    </div>
                  </details>
                </section>

                {/* Note et relance. */}
                <section class="dc-bloc">
                  <h3 class="dc-h3">Note</h3>
                  <textarea
                    id="dc-note-rapide"
                    class="cform-input"
                    rows="2"
                    maxlength="1000"
                    placeholder="« Rappelée, elle magasine encore. »"
                  />
                  <button type="button" class="btn-cta dc-mini" data-noter>Ajouter la note</button>

                  <h3 class="dc-h3 dc-h3--espace">Revenir à ce dossier</h3>
                  <div class="dc-relance" data-relance-chips>
                    <button type="button" class="dc-chip" data-relance-dans="1">Demain</button>
                    <button type="button" class="dc-chip" data-relance-dans="3">Dans 3 jours</button>
                    <button type="button" class="dc-chip" data-relance-lundi>Lundi prochain</button>
                    <input type="date" data-relance class="cform-input dc-date" aria-label="Date de relance" />
                    <button type="button" class="dc-chip dc-chip--effacer" data-relance-effacer>Effacer</button>
                  </div>
                  <p class="dc-relance-etat" data-relance-etat />
                </section>

                {/* Prévenir le client. */}
                <section class="dc-bloc dc-bloc-prevenir">
                  <h3 class="dc-h3">Prévenir le client</h3>
                  <p class="dc-texte-petit">
                    Envoie l’état du dossier, ce qui manque, et un lien vers son portail. Rien
                    ne part de lui-même : c’est vous qui décidez quand il y a matière à écrire.
                  </p>
                  <p class="dc-erreur" data-erreur-prevenir hidden />
                  <button type="button" class="btn-cta dc-mini" data-prevenir>Envoyer le suivi</button>
                </section>

                {/* Cette personne, ailleurs. */}
                <section class="dc-bloc" data-liens-bloc hidden>
                  <h3 class="dc-h3">Cette personne, ailleurs</h3>
                  <div data-liens />
                </section>

                <details class="dc-bloc dc-repli">
                  <summary class="dc-h3">Historique</summary>
                  <ol class="dc-historique" data-historique />
                </details>

                <details class="dc-bloc dc-repli">
                  <summary class="dc-h3">Autres actions</summary>
                  <div class="dc-autres">
                    <button type="button" class="btn-lien" data-modifier>Corriger les coordonnées</button>
                    <div class="dc-suppression">
                      <button type="button" class="btn-lien dc-danger" data-supprimer>Supprimer le dossier</button>
                      <span class="dc-confirme" data-confirme-suppression hidden>
                        Supprimer définitivement&nbsp;?
                        <button type="button" class="btn-lien dc-danger" data-confirmer-suppression>Confirmer</button>
                        <button type="button" class="btn-lien" data-annuler-suppression>Annuler</button>
                      </span>
                    </div>
                  </div>
                </details>
              </article>
            </section>
          </div>

          {/* ---------------- Les chiffres ---------------- */}
          <details class="dc-chiffres">
            <summary class="dc-chiffres-titre">Les chiffres</summary>
            <div class="dc-chiffres-corps">
              <p class="dc-reserve" data-reserve hidden />
              <div data-chiffres />
            </div>
          </details>
        </div>
      )
    }
  </main>
</MainLayout>

<style>
  /* ------------------------------------------------------------------ */
  /*  Ossature                                                           */
  /* ------------------------------------------------------------------ */

  .dc-page {
    background: var(--sand);
    min-height: 100vh;
    padding: 1.5rem 1.1rem 4rem;
  }

  /* global.css donne à tout `section` la respiration d'une section de page vitrine.
     Ici, les sections sont les blocs d'un tableau de bord : cette respiration les
     désaligne et étire l'écran sur deux fois sa hauteur utile. */
  .dc-page section {
    padding: 0;
  }

  .dc-shell-connexion {
    max-width: 62rem;
    margin: 0 auto;
  }

  #dc-app {
    max-width: 80rem;
    margin: 0 auto;
  }

  .dc-topbar {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1rem;
    margin-bottom: 1rem;
  }

  .dc-titre {
    font-size: 1.5rem;
    margin: 0;
  }

  .dc-grille {
    display: grid;
    grid-template-columns: 1fr;
    gap: 1.25rem;
  }

  @media (min-width: 64rem) {
    .dc-page {
      padding: 2rem 1.5rem 4rem;
    }

    .dc-grille {
      grid-template-columns: 21rem minmax(0, 1fr);
      gap: 1.75rem;
      align-items: start;
    }

    /* La liste reste en vue et défile pour elle-même : cocher un document dans la fiche
       ne fait plus perdre sa place dans la liste. */
    .dc-colonne {
      position: sticky;
      top: 1.5rem;
      max-height: calc(100vh - 3rem);
      display: flex;
      flex-direction: column;
      min-height: 0;
    }

    .dc-liste {
      overflow-y: auto;
      flex: 1;
      min-height: 0;
      padding-right: 0.25rem;
    }
  }

  /* ------------------------------------------------------------------ */
  /*  Colonne de gauche                                                  */
  /* ------------------------------------------------------------------ */

  .dc-recherche {
    display: block;
    margin-bottom: 0.6rem;
  }

  .dc-recherche .cform-input {
    margin: 0;
  }

  .dc-vues {
    display: flex;
    flex-wrap: wrap;
    gap: 0.25rem;
    margin-bottom: 0.75rem;
    border-bottom: 1px solid var(--border);
  }

  .dc-vue {
    background: none;
    border: none;
    border-bottom: 2px solid transparent;
    padding: 0.65rem 0.7rem;
    min-height: 44px;
    font: inherit;
    font-size: 0.92rem;
    color: var(--muted);
    cursor: pointer;
    margin-bottom: -1px;
  }

  .dc-vue[aria-pressed='true'] {
    color: var(--ink);
    font-weight: 600;
    border-bottom-color: var(--clay);
  }

  .dc-vue-compte {
    font-size: 0.78rem;
    color: var(--muted);
    font-weight: 400;
  }

  /* ------------------------------------------------------------------ */
  /*  Colonne de droite                                                  */
  /* ------------------------------------------------------------------ */

  .dc-panneau-jour,
  .dc-panneau,
  .dc-fiche {
    background: var(--white);
    border: 1px solid var(--border);
    border-radius: var(--radius-md);
    padding: 1.35rem;
  }

  .dc-panneau-tete {
    display: flex;
    align-items: baseline;
    justify-content: space-between;
    gap: 1rem;
  }

  .dc-grille-champs {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(min(100%, 13rem), 1fr));
    gap: 0 1rem;
  }

  /* Sur téléphone, le détail passe par-dessus la liste plutôt que de s'y ajouter. */
  @media (max-width: 63.99rem) {
    .dc-detail {
      order: -1;
    }

    #dc-app.dc-app--panneau .dc-detail {
      position: fixed;
      inset: 0;
      z-index: 60;
      overflow-y: auto;
      background: var(--sand);
      padding: 1rem 1.1rem 3rem;
      order: 0;
    }

    #dc-app.dc-app--panneau .dc-colonne {
      display: none;
    }
  }

  /* ------------------------------------------------------------------ */
  /*  La fiche                                                           */
  /* ------------------------------------------------------------------ */

  .dc-fiche-barre {
    margin-bottom: 0.75rem;
  }

  .dc-retour {
    background: none;
    border: none;
    padding: 0.5rem 0.6rem 0.5rem 0;
    min-height: 44px;
    font: inherit;
    font-size: 0.92rem;
    color: var(--clay-dk);
    cursor: pointer;
  }

  .dc-fiche-tete {
    border-bottom: 1px solid var(--border);
    padding-bottom: 1.1rem;
    margin-bottom: 1.1rem;
  }

  .dc-h2 {
    font-size: 1.25rem;
    margin: 0 0 0.3rem;
    line-height: 1.3;
  }

  .dc-h2:focus-visible {
    outline: 2px solid var(--clay);
    outline-offset: 3px;
  }

  .dc-h3 {
    font-size: 0.86rem;
    margin: 0 0 0.6rem;
    color: var(--muted);
    text-transform: uppercase;
    letter-spacing: 0.04em;
  }

  .dc-h3--espace {
    margin-top: 1.5rem;
  }

  .dc-fiche-meta,
  .dc-fiche-provenance {
    margin: 0 0 0.25rem;
    font-size: 0.85rem;
    color: var(--muted);
  }

  /* Joindre la personne — le geste le plus fréquent de la journée. */
  .dc-contact {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem;
    margin-top: 0.9rem;
  }

  .dc-avis {
    margin: 0.7rem 0 0;
    font-size: 0.83rem;
    color: var(--clay-dk);
    background: #fdf3ee;
    border-radius: var(--radius-sm);
    padding: 0.5rem 0.7rem;
  }

  .dc-bloc {
    padding-bottom: 1.25rem;
    margin-bottom: 1.25rem;
    border-bottom: 1px solid var(--border);
  }

  .dc-bloc:last-child {
    border-bottom: none;
    margin-bottom: 0;
    padding-bottom: 0;
  }

  .dc-bloc-geste {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: 0.6rem;
  }

  .dc-primaire {
    min-height: 44px;
  }

  .dc-bloc-prevenir {
    background: var(--warm);
    border: 1px solid var(--border);
    border-radius: var(--radius-sm);
    padding: 1rem 1.1rem;
  }

  .dc-changer summary,
  .dc-ajout summary,
  .dc-repli summary {
    cursor: pointer;
    font-size: 0.85rem;
    color: var(--muted);
    padding: 0.5rem 0;
    min-height: 44px;
    display: flex;
    align-items: center;
  }

  .dc-repli summary {
    margin: 0;
  }

  .dc-changer select,
  .dc-ajout .dc-ligne-actions {
    margin-top: 0.5rem;
  }

  .dc-ligne-actions {
    display: flex;
    gap: 0.5rem;
    flex-wrap: wrap;
  }

  .dc-ligne-actions .cform-input {
    margin: 0;
    flex: 1 1 min(100%, 11rem);
    min-height: 44px;
  }

  .dc-progres {
    height: 6px;
    background: var(--warm);
    border-radius: 999px;
    overflow: hidden;
    margin: 0 0 0.85rem;
  }

  .dc-progres-barre {
    height: 100%;
    background: var(--forest);
    border-radius: 999px;
    transition: width 0.25s ease;
  }

  .dc-relance {
    display: flex;
    flex-wrap: wrap;
    gap: 0.45rem;
    align-items: center;
  }

  .dc-chip {
    background: var(--white);
    border: 1px solid var(--border);
    border-radius: 999px;
    padding: 0.5rem 0.9rem;
    min-height: 44px;
    font: inherit;
    font-size: 0.86rem;
    color: var(--ink);
    cursor: pointer;
  }

  .dc-chip:hover {
    border-color: var(--clay);
  }

  .dc-chip--effacer {
    color: var(--muted);
  }

  .dc-date {
    margin: 0;
    min-height: 44px;
    flex: 0 1 11rem;
  }

  .dc-relance-etat {
    margin: 0.6rem 0 0;
    font-size: 0.85rem;
    color: var(--muted);
  }

  .dc-note-etape {
    margin: 0;
    font-size: 0.84rem;
    color: var(--muted);
    line-height: 1.55;
  }

  .dc-autres {
    display: flex;
    flex-direction: column;
    gap: 0.75rem;
    align-items: flex-start;
    padding-top: 0.5rem;
  }

  .dc-danger {
    color: var(--muted);
  }

  .dc-confirme {
    display: inline-flex;
    flex-wrap: wrap;
    gap: 0.75rem;
    align-items: center;
    font-size: 0.86rem;
    color: var(--ink);
  }

  /* ------------------------------------------------------------------ */
  /*  Divers                                                             */
  /* ------------------------------------------------------------------ */

  .dc-connexion {
    max-width: 27rem;
    margin: 3rem auto;
  }

  .dc-texte {
    color: var(--muted);
    font-size: 0.95rem;
    line-height: 1.6;
    margin: 0 0 1rem;
  }

  .dc-texte-petit {
    color: var(--muted);
    font-size: 0.85rem;
    line-height: 1.6;
    margin: 0 0 0.75rem;
  }

  .dc-alerte {
    background: #fdf3ee;
    border: 1px solid var(--clay);
    border-radius: var(--radius-sm);
    padding: 0.9rem 1.1rem;
    font-size: 0.9rem;
    line-height: 1.6;
    margin: 0 0 1rem;
  }

  .dc-erreur {
    color: #a5342a;
    font-size: 0.85rem;
    margin: 0.5rem 0 0;
  }

  /* La confirmation d'écriture : discrète, mais toujours au même endroit. */
  .dc-statut {
    background: #eaf1ec;
    border: 1px solid #cadbcf;
    color: var(--forest);
    border-radius: var(--radius-sm);
    padding: 0.6rem 0.9rem;
    font-size: 0.88rem;
    margin: 0 0 1rem;
  }

  .dc-compte {
    font-size: 0.82rem;
    font-weight: 400;
    color: var(--muted);
    text-transform: none;
    letter-spacing: 0;
  }

  .dc-mini {
    padding: 0.55rem 1.1rem;
    min-height: 44px;
    font-size: 0.88rem;
