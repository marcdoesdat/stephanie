</style>

<script>
  import { BASES_CONSENTEMENT, ETATS, PROFESSIONS, type CleEtat } from '../utils/reseauCourtiers';
  import { phraseUrgenceReseau, urgencesReseau } from '../utils/tableauDeBord';

  /* ---------------- L'application ---------------- */

  interface Evenement {
    readonly le: string;
    readonly type: string;
    readonly resume: string;
    readonly objet?: string;
    readonly corps?: string;
  }

  interface Fiche {
    readonly id: string;
    readonly creeLe: string;
    readonly majLe: string;
    readonly nom: string;
    readonly courriel: string;
    readonly telephone: string;
    readonly agence: string;
    readonly secteur: string;
    readonly profession: string;
    readonly notes: string;
    /* Typé sur le catalogue, et non `string` : c'est ce qui permet de passer la fiche telle
       quelle à la règle d'urgence partagée. */
    readonly etat: CleEtat;
    readonly consentement: { base: string; source: string; le: string };
    readonly relanceLe: string | null;
    readonly dernierEnvoiLe: string | null;
    readonly historique: Evenement[];
  }

  const app = document.getElementById('rs-app');

  if (app) {
    let contacts: Fiche[] = [];
    let selection: string | null = null;
    let envoisFaits = 0;
    const plafond = Number(app.dataset.plafond ?? '25');

    const $ = <T extends HTMLElement>(selecteur: string): T | null =>
      app.querySelector<T>(selecteur);

    const liste = $<HTMLElement>('[data-liste]');
    const urgences = $<HTMLElement>('[data-urgences]');
    const fiche = document.getElementById('rs-fiche');
    const formulaire = document.getElementById('rs-formulaire') as HTMLFormElement | null;
    const panneauImport = document.getElementById('rs-import') as HTMLFormElement | null;

    const RELATIF = new Intl.RelativeTimeFormat('fr-CA', { numeric: 'auto' });
    const DATE_COURTE = new Intl.DateTimeFormat('fr-CA', { dateStyle: 'medium' });
    const DATE_COMPLETE = new Intl.DateTimeFormat('fr-CA', { dateStyle: 'long', timeStyle: 'short' });

    function relatif(iso: string): string {
      const cible = Date.parse(iso);
      if (Number.isNaN(cible)) return '';
      const ecart = cible - Date.now();
      const heures = Math.round(ecart / 3600000);
      if (Math.abs(heures) < 24) return RELATIF.format(heures, 'hour');
      return RELATIF.format(Math.round(ecart / 86400000), 'day');
    }

    function dateComplete(iso: string): string {
      const instant = Date.parse(iso);
      return Number.isNaN(instant) ? '' : DATE_COMPLETE.format(new Date(instant));
    }

    function libelleEtat(cle: string): string {
      return (ETATS as Record<string, string>)[cle] ?? cle;
    }

    function libelleProfession(cle: string): string {
      return (PROFESSIONS as Record<string, string>)[cle] ?? cle;
    }

    /* ---------------- Appels réseau ---------------- */

    /**
     * Une session expirée ne doit pas se manifester par un bouton qui ne fait rien : on
     * recharge, et la page rend son écran de connexion.
     */
    async function api<T>(url: string, init?: RequestInit): Promise<T | null> {
      const reponse = await fetch(url, init);
      if (reponse.status === 401) {
        window.location.reload();
        return null;
      }
      const data = (await reponse.json().catch(() => ({}))) as T & { error?: string };
      if (!reponse.ok) throw new Error(data.error ?? 'Opération impossible.');
      return data;
    }

    async function charger(): Promise<void> {
      try {
        const data = await api<{ contacts: Fiche[]; envoisDuJour: number }>('/api/reseau-contacts');
        if (!data) return;
        contacts = data.contacts;
        envoisFaits = data.envoisDuJour;
        rendre();
      } catch (err) {
        if (liste) {
          liste.replaceChildren(
            texte('p', 'rs-vide', err instanceof Error ? err.message : 'Chargement impossible.'),
          );
        }
      }
    }

    /* ---------------- Fabrique d'éléments ---------------- */

    function texte<K extends keyof HTMLElementTagNameMap>(
      balise: K,
      classe: string,
      contenu: string,
    ): HTMLElementTagNameMap[K] {
      const element = document.createElement(balise);
      if (classe) element.className = classe;
      element.textContent = contenu;
      return element;
    }

    function badge(etat: string): HTMLSpanElement {
      const element = texte('span', 'rs-badge', libelleEtat(etat));
      element.dataset.etat = etat;
      return element;
    }

    /* ---------------- Urgences ---------------- */

    /*
     * La règle vit dans `utils/tableauDeBord.ts`, pas ici : le tableau de bord la lit aussi,
     * et une règle en double dans le script d'une page finit par diverger sans que rien ne
     * le signale. La page ne garde que le rendu.
     */

    function rendreUrgences(): void {
      if (!urgences) return;

      const pressants = urgencesReseau(contacts);
      const aContacter = contacts.filter((contact) => contact.etat === 'a_contacter').length;

      if (pressants.length === 0) {
        const message =
          aContacter > 0
            ? `Rien à relancer aujourd’hui. ${aContacter} contact${aContacter > 1 ? 's' : ''} n’${aContacter > 1 ? 'ont' : 'a'} jamais été approché${aContacter > 1 ? 's' : ''}.`
            : 'Rien à relancer aujourd’hui.';
        urgences.replaceChildren(texte('p', 'rs-vide', message));
        return;
      }

      const fragment = document.createDocumentFragment();
      for (const { contact, urgence: motif } of pressants) {
        fragment.append(carte(contact, phraseUrgenceReseau(motif)));
      }
      urgences.replaceChildren(fragment);
    }

    /* ---------------- Carnet ---------------- */

    function carte(contact: Fiche, motif?: string): HTMLButtonElement {
      const bouton = document.createElement('button');
      bouton.type = 'button';
      bouton.className = 'rs-carte';
      bouton.dataset.id = contact.id;
      if (selection === contact.id) bouton.dataset.actif = 'oui';

      const titre = document.createElement('p');
      titre.className = 'rs-carte-titre';
      titre.append(document.createTextNode(contact.nom));
      if (contact.agence) titre.append(texte('span', 'rs-carte-agence', contact.agence));
      titre.append(badge(contact.etat));

      const morceaux = [libelleProfession(contact.profession)];
      if (contact.secteur) morceaux.push(contact.secteur);
      if (contact.dernierEnvoiLe) morceaux.push(`écrit ${relatif(contact.dernierEnvoiLe)}`);

      const meta = texte('p', 'rs-carte-meta', morceaux.join(' · '));
      if (motif) {
        meta.append(document.createTextNode(' · '));
        meta.append(texte('span', 'rs-urgent', motif));
      }

      bouton.append(titre, meta);
      bouton.addEventListener('click', () => ouvrirFiche(contact.id));
      return bouton;
    }

    function filtres(): Fiche[] {
      const recherche = ($<HTMLInputElement>('#rs-recherche')?.value ?? '').trim().toLowerCase();
      const etat = $<HTMLSelectElement>('#rs-filtre-etat')?.value ?? '';
      const profession = $<HTMLSelectElement>('#rs-filtre-profession')?.value ?? '';

      return contacts.filter((contact) => {
        if (etat && contact.etat !== etat) return false;
        if (profession && contact.profession !== profession) return false;
        if (!recherche) return true;
        return `${contact.nom} ${contact.agence} ${contact.courriel} ${contact.secteur}`
          .toLowerCase()
          .includes(recherche);
      });
    }

    function rendreListe(): void {
      if (!liste) return;
      const visibles = filtres();

      const compte = $<HTMLElement>('[data-compte]');
      if (compte) {
        compte.textContent =
          visibles.length === contacts.length
            ? `${contacts.length} contact${contacts.length > 1 ? 's' : ''}`
            : `${visibles.length} sur ${contacts.length}`;
      }

      if (visibles.length === 0) {
        liste.replaceChildren(
          texte(
            'p',
            'rs-vide',
            contacts.length === 0
              ? 'Le carnet est vide. Ajoutez un premier contact, ou importez une liste.'
              : 'Aucun contact ne correspond à ce filtre.',
          ),
        );
        return;
      }

      const fragment = document.createDocumentFragment();
      for (const contact of visibles) fragment.append(carte(contact));
      liste.replaceChildren(fragment);
    }

    function rendreQuota(): void {
      const quota = $<HTMLElement>('[data-quota]');
      if (!quota) return;
      const reste = Math.max(0, plafond - envoisFaits);
      quota.textContent = `${envoisFaits} envoi${envoisFaits > 1 ? 's' : ''} aujourd’hui · ${reste} restant${reste > 1 ? 's' : ''}`;
      quota.hidden = false;
    }

    function rendre(): void {
      rendreQuota();
      rendreUrgences();
      rendreListe();
      if (selection) rendreFiche();
    }

    /* ---------------- Fiche ---------------- */

    function contactCourant(): Fiche | null {
      return contacts.find((contact) => contact.id === selection) ?? null;
    }

    function ouvrirFiche(id: string): void {
      selection = id;
      rendreListe();
      rendreUrgences();
      rendreFiche();
      // Le message se charge à l'ouverture de la fiche : tant qu'il fallait toucher au
      // sélecteur pour voir apparaître un texte, la zone de composition s'ouvrait vide et
      // donnait l'impression qu'il n'y avait rien à envoyer.
      if (contactCourant()?.etat !== 'refuse') void chargerGabarit();
      void chargerLiens(id);
      fiche?.scrollIntoView({ behavior: 'smooth', block: 'start' });
    }

    interface Liens {
      readonly dossier: { nom: string; etape: string; origine: string } | null;
      readonly contrat: { signeLe: string | null; aSonTour: boolean } | null;
    }

    /**
     * Le pendant de l'encart de /dossiers : ce professionnel est-il aussi un client ?
     *
     * Chargé à l'ouverture d'une fiche seulement — la route relit trois magasins, et
     * l'appeler pour chaque ligne du carnet coûterait le triple à chaque affichage.
     */
    async function chargerLiens(id: string): Promise<void> {
      const bloc = $<HTMLElement>('[data-liens-bloc]');
      const hote = $<HTMLElement>('[data-liens]');
      const contact = contacts.find((c) => c.id === id);
      if (!bloc || !hote || !contact) return;
      bloc.hidden = true;

      let liens: Liens;
      try {
        const data = await api<{ liens: Liens }>(
          `/api/crm-lien?courriel=${encodeURIComponent(contact.courriel)}`,
        );
        if (!data || selection !== id) return; // elle a changé de fiche entre-temps
        liens = data.liens;
      } catch {
        return; // un encart secondaire ne doit pas faire échouer l'écran
      }

      const lignes: HTMLElement[] = [];
      if (liens.dossier) {
        lignes.push(
          texte('p', 'rs-lien-croise', `A aussi un dossier client : ${liens.dossier.etape} · entré par ${liens.dossier.origine}`),
        );
      }
      if (liens.contrat) {
        lignes.push(
          texte(
            'p',
            'rs-lien-croise',
            liens.contrat.signeLe
              ? 'A signé un contrat de courtage en cours'
              : 'Contrat de courtage en cours — pas encore signé',
          ),
        );
      }

      if (lignes.length === 0) return;
      hote.replaceChildren(...lignes);
      bloc.hidden = false;
    }

    function rendreFiche(): void {
      const contact = contactCourant();
      if (!fiche || !contact) {
        if (fiche) fiche.hidden = true;
        return;
      }
      fiche.hidden = false;

      const identite = fiche.querySelector<HTMLElement>('[data-fiche-identite]');
      if (identite) {
        const nom = texte('h2', 'rs-fiche-nom', contact.nom);

        const coord = document.createElement('p');
        coord.className = 'rs-fiche-coord';
        const courriel = document.createElement('a');
        courriel.href = `mailto:${contact.courriel}`;
        courriel.textContent = contact.courriel;
        coord.append(courriel);
        if (contact.telephone) coord.append(document.createTextNode(` · ${contact.telephone}`));

        const detail = [libelleProfession(contact.profession), contact.agence, contact.secteur]
          .filter(Boolean)
          .join(' · ');

        const consentement = texte(
          'p',
          'rs-fiche-consentement',
          `${(BASES_CONSENTEMENT as Record<string, string>)[contact.consentement.base] ?? contact.consentement.base} — ${contact.consentement.source} (noté le ${DATE_COURTE.format(new Date(contact.consentement.le))})`,
        );

        const enfants: HTMLElement[] = [nom, coord];
        if (detail) enfants.push(texte('p', 'rs-fiche-coord', detail));
        if (contact.notes) enfants.push(texte('p', 'rs-fiche-coord', contact.notes));
        enfants.push(consentement);
        identite.replaceChildren(...enfants);
      }

      const selecteurEtat = fiche.querySelector<HTMLSelectElement>('[data-fiche-etat]');
      if (selecteurEtat) selecteurEtat.value = contact.etat;

      const relance = fiche.querySelector<HTMLInputElement>('[data-fiche-relance]');
      if (relance) relance.value = contact.relanceLe ?? '';

      // Un contact retiré : on retire aussi les moyens de lui écrire. Laisser le bloc de
      // composition ouvert serait une invitation à contourner sa demande.
      const composer = fiche.querySelector<HTMLElement>('[data-composer]');
      if (composer) composer.hidden = contact.etat === 'refuse';

      rendreHistorique(contact);
    }

    function rendreHistorique(contact: Fiche): void {
      const cible = fiche?.querySelector<HTMLElement>('[data-historique]');
      if (!cible) return;

      const fragment = document.createDocumentFragment();
      for (const evenement of [...contact.historique].reverse()) {
        const ligne = document.createElement('li');
        ligne.append(texte('span', 'rs-evenement-date', dateComplete(evenement.le)));
        ligne.append(texte('p', 'rs-evenement-texte', evenement.resume));

        // Le texte réellement envoyé, replié : c'est ce qui permet de dire, un an plus tard,
        // ce qui a été écrit — sans encombrer la lecture courante.
        if (evenement.corps) {
          const detail = document.createElement('details');
          detail.className = 'rs-evenement-detail';
          detail.append(texte('summary', '', 'Voir le message'));
          detail.append(texte('p', 'rs-evenement-corps', evenement.corps));
          ligne.append(detail);
        }
        fragment.append(ligne);
      }
      cible.replaceChildren(fragment);
    }

    fiche?.querySelector('[data-fermer-fiche]')?.addEventListener('click', () => {
      selection = null;
      fiche.hidden = true;
      rendreListe();
    });

    /* ---------------- Actions sur la fiche ---------------- */

    async function agir(corps: Record<string, unknown>, erreurCible?: HTMLElement | null): Promise<void> {
      try {
        const data = await api<{ contact?: Fiche }>('/api/reseau-contact', {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify(corps),
        });
        if (!data) return;
        await charger();
      } catch (err) {
        const message = err instanceof Error ? err.message : 'Opération impossible.';
        if (erreurCible) {
          erreurCible.textContent = message;
          erreurCible.hidden = false;
        } else {
          window.alert(message);
        }
      }
    }

    fiche?.querySelector('[data-fiche-etat]')?.addEventListener('change', (evenement) => {
      const selecteur = evenement.currentTarget as HTMLSelectElement;
      if (!selection) return;
      void agir({ action: 'etat', id: selection, etat: selecteur.value });
    });

    fiche?.querySelector('[data-fiche-relance]')?.addEventListener('change', (evenement) => {
      const champ = evenement.currentTarget as HTMLInputElement;
      if (!selection) return;
      void agir({ action: 'relance', id: selection, date: champ.value || null });
    });

    fiche?.querySelector('[data-ajouter-note]')?.addEventListener('click', () => {
      const champ = document.getElementById('rs-note-rapide') as HTMLInputElement | null;
      const valeur = champ?.value.trim() ?? '';
      if (!selection || valeur.length < 2) return;
      if (champ) champ.value = '';
      void agir({ action: 'note', id: selection, texte: valeur });
    });

    fiche?.querySelector('[data-fiche-supprimer]')?.addEventListener('click', async () => {
      const contact = contactCourant();
      if (!contact) return;
      if (!window.confirm(`Supprimer définitivement la fiche de ${contact.nom} ? L’historique part avec.`)) {
        return;
      }
      selection = null;
      if (fiche) fiche.hidden = true;
      await agir({ action: 'supprimer', id: contact.id });
    });

    /* ---------------- Formulaire de contact ---------------- */

    const champs = {
      id: () => $<HTMLInputElement>('[data-formulaire-id]'),
      nom: () => document.getElementById('rs-nom') as HTMLInputElement | null,
      courriel: () => document.getElementById('rs-courriel') as HTMLInputElement | null,
      telephone: () => document.getElementById('rs-telephone') as HTMLInputElement | null,
      profession: () => document.getElementById('rs-profession') as HTMLSelectElement | null,
      agence: () => document.getElementById('rs-agence') as HTMLInputElement | null,
      secteur: () => document.getElementById('rs-secteur') as HTMLInputElement | null,
      base: () => document.getElementById('rs-consentement-base') as HTMLSelectElement | null,
      source: () => document.getElementById('rs-consentement-source') as HTMLInputElement | null,
      notes: () => document.getElementById('rs-notes') as HTMLTextAreaElement | null,
    };

    function ouvrirFormulaire(contact: Fiche | null): void {
      if (!formulaire) return;
      formulaire.hidden = false;
      if (panneauImport) panneauImport.hidden = true;

      const titre = formulaire.querySelector<HTMLElement>('[data-formulaire-titre]');
      if (titre) titre.textContent = contact ? `Corriger — ${contact.nom}` : 'Nouveau contact';

      const valeurs = {
        id: contact?.id ?? '',
        nom: contact?.nom ?? '',
        courriel: contact?.courriel ?? '',
        telephone: contact?.telephone ?? '',
        profession: contact?.profession ?? 'courtier-immobilier',
        agence: contact?.agence ?? '',
        secteur: contact?.secteur ?? '',
        base: contact?.consentement.base ?? 'tacite_publie',
        source: contact?.consentement.source ?? '',
        notes: contact?.notes ?? '',
      };

      for (const [cle, valeur] of Object.entries(valeurs)) {
        const champ = champs[cle as keyof typeof champs]();
        if (champ) champ.value = valeur;
      }

      const erreur = formulaire.querySelector<HTMLElement>('[data-erreur-formulaire]');
      if (erreur) erreur.hidden = true;
      formulaire.scrollIntoView({ behavior: 'smooth', block: 'center' });
      champs.nom()?.focus();
    }

    app.querySelector('[data-ouvrir-formulaire]')?.addEventListener('click', () => ouvrirFormulaire(null));
    fiche?.querySelector('[data-fiche-modifier]')?.addEventListener('click', () => {
      const contact = contactCourant();
      if (contact) ouvrirFormulaire(contact);
    });
    formulaire?.querySelector('[data-fermer-formulaire]')?.addEventListener('click', () => {
      formulaire.hidden = true;
    });

    formulaire?.addEventListener('submit', async (evenement) => {
      evenement.preventDefault();
      const erreur = formulaire.querySelector<HTMLElement>('[data-erreur-formulaire]');
      if (erreur) erreur.hidden = true;

      const id = champs.id()?.value ?? '';
      const contact = {
        nom: champs.nom()?.value ?? '',
        courriel: champs.courriel()?.value ?? '',
        telephone: champs.telephone()?.value ?? '',
        profession: champs.profession()?.value ?? '',
        agence: champs.agence()?.value ?? '',
        secteur: champs.secteur()?.value ?? '',
        notes: champs.notes()?.value ?? '',
        consentement: {
          base: champs.base()?.value ?? '',
          source: champs.source()?.value ?? '',
        },
      };

      try {
        const data = await api<{ contact: Fiche }>('/api/reseau-contact', {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify(id ? { action: 'modifier', id, contact } : { action: 'creer', contact }),
        });
        if (!data) return;
        formulaire.hidden = true;
        await charger();
        ouvrirFiche(data.contact.id);
      } catch (err) {
        if (erreur) {
          erreur.textContent = err instanceof Error ? err.message : 'Enregistrement impossible.';
          erreur.hidden = false;
        }
      }
    });

    /* ---------------- Import ---------------- */

    app.querySelector('[data-ouvrir-import]')?.addEventListener('click', () => {
      if (!panneauImport) return;
      panneauImport.hidden = false;
      if (formulaire) formulaire.hidden = true;
      panneauImport.scrollIntoView({ behavior: 'smooth', block: 'center' });
    });

    panneauImport?.querySelector('[data-fermer-import]')?.addEventListener('click', () => {
      panneauImport.hidden = true;
    });

    /** Une ligne collée depuis un tableur : tabulation, point-virgule ou virgule. */
    function lireLignes(brut: string): Array<Record<string, string>> {
      return brut
        .split('\n')
        .map((ligne) => ligne.trim())
        .filter(Boolean)
        .map((ligne) => {
          const colonnes = ligne.split(/\t|;|,/).map((colonne) => colonne.trim());
          return {
            nom: colonnes[0] ?? '',
            courriel: colonnes[1] ?? '',
            agence: colonnes[2] ?? '',
            secteur: colonnes[3] ?? '',
          };
        });
    }

    panneauImport?.addEventListener('submit', async (evenement) => {
      evenement.preventDefault();
      const erreur = panneauImport.querySelector<HTMLElement>('[data-erreur-import]');
      if (erreur) erreur.hidden = true;

      const brut = (document.getElementById('rs-import-texte') as HTMLTextAreaElement | null)?.value ?? '';
      const lignes = lireLignes(brut);
      if (lignes.length === 0) {
        if (erreur) {
          erreur.textContent = 'Rien à importer.';
          erreur.hidden = false;
        }
        return;
      }

      try {
        const data = await api<{ crees: number; ignores: number; rejets: string[] }>(
          '/api/reseau-contact',
          {
            method: 'POST',
            headers: { 'Content-Type': 'application/json' },
            body: JSON.stringify({
              action: 'importer',
              lignes,
              profession:
                (document.getElementById('rs-import-profession') as HTMLSelectElement | null)?.value ?? '',
              consentement: {
                base: (document.getElementById('rs-import-base') as HTMLSelectElement | null)?.value ?? '',
                source:
                  (document.getElementById('rs-import-source') as HTMLInputElement | null)?.value ?? '',
              },
            }),
          },
        );
        if (!data) return;

        const bilan = [
          `${data.crees} contact${data.crees > 1 ? 's' : ''} ajouté${data.crees > 1 ? 's' : ''}`,
          data.ignores ? `${data.ignores} déjà au carnet` : '',
          data.rejets.length ? `${data.rejets.length} ligne(s) illisible(s) : ${data.rejets.join(', ')}` : '',
        ]
          .filter(Boolean)
          .join(' · ');

        panneauImport.hidden = true;
        await charger();
        window.alert(bilan);
      } catch (err) {
        if (erreur) {
          erreur.textContent = err instanceof Error ? err.message : 'Import impossible.';
          erreur.hidden = false;
        }
      }
    });

    /* ---------------- Composition et envoi ---------------- */

    const selecteurGabarit = document.getElementById('rs-gabarit') as HTMLSelectElement | null;
    const champObjet = document.getElementById('rs-objet') as HTMLInputElement | null;
    const champCorps = document.getElementById('rs-corps') as HTMLTextAreaElement | null;

    /**
     * Le rendu vient du serveur : le catalogue de gabarits n'existe qu'à un seul endroit, et
     * ce que l'écran montre est exactement ce que le serveur sait produire.
     */
    async function chargerGabarit(): Promise<void> {
      if (!selection || !selecteurGabarit) return;
      const erreur = fiche?.querySelector<HTMLElement>('[data-erreur-envoi]');
      if (erreur) erreur.hidden = true;

      try {
        const data = await api<{ objet: string; corps: string; personnalise?: boolean }>(
          `/api/reseau-envoi?id=${encodeURIComponent(selection)}&gabarit=${encodeURIComponent(selecteurGabarit.value)}`,
        );
        if (!data) return;
        if (champObjet) champObjet.value = data.objet;
        if (champCorps) champCorps.value = data.corps;
        marquerPersonnalise(data.personnalise === true);
      } catch (err) {
        if (erreur) {
          erreur.textContent = err instanceof Error ? err.message : 'Gabarit indisponible.';
          erreur.hidden = false;
        }
      }
    }

    selecteurGabarit?.addEventListener('change', () => {
      fermerEditeur();
      void chargerGabarit();
    });

    /* ---------------- Édition du gabarit ---------------- */

    /**
     * Ce qu'on modifie ici, c'est le **modèle** — pas le message en cours. La portée est le
     * couple (gabarit, profession) : c'est ce qu'elle a sous les yeux, et un texte retouché
     * pour un notaire n'a pas à partir ensuite à un comptable. L'écran le dit en toutes
     * lettres, faute de quoi on croit corriger une phrase et on en corrige cinquante.
     */
    const editeur = fiche?.querySelector<HTMLElement>('[data-editeur-gabarit]') ?? null;
    const editeurObjet = document.getElementById('rs-editeur-objet') as HTMLInputElement | null;
    const editeurCorps = document.getElementById('rs-editeur-corps') as HTMLTextAreaElement | null;

    function fermerEditeur(): void {
      if (editeur) editeur.hidden = true;
    }

    function marquerPersonnalise(personnalise: boolean): void {
      const etiquette = fiche?.querySelector<HTMLElement>('[data-gabarit-personnalise]');
      if (etiquette) etiquette.hidden = !personnalise;
      const retour = fiche?.querySelector<HTMLElement>('[data-reinitialiser-gabarit]');
      if (retour) retour.hidden = !personnalise;
    }

    interface ReponseGabarit {
      readonly objet: string;
      readonly corps: string;
      readonly personnalise: boolean;
      /** Le nom affichable du gabarit — seul le GET le renvoie. */
      readonly nom?: string;
    }

    async function requeteGabarit(
      methode: 'GET' | 'PUT' | 'DELETE',
      corps?: Record<string, unknown>,
    ): Promise<ReponseGabarit | null> {
      const contact = contactCourant();
      if (!contact || !selecteurGabarit) return null;
      const base = { gabarit: selecteurGabarit.value, profession: contact.profession };

      if (methode === 'GET') {
        const params = new URLSearchParams(base);
        return api<ReponseGabarit>(`/api/reseau-gabarit?${params.toString()}`);
      }
      return api<ReponseGabarit>('/api/reseau-gabarit', {
        method: methode,
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({ ...base, ...corps }),
      });
    }

    function erreurEditeur(message: string | null): void {
      const cible = fiche?.querySelector<HTMLElement>('[data-erreur-editeur]');
      if (!cible) return;
      cible.textContent = message ?? '';
      cible.hidden = message === null;
    }

    fiche?.querySelector('[data-modifier-gabarit]')?.addEventListener('click', async () => {
      const contact = contactCourant();
      if (!editeur || !contact) return;
      erreurEditeur(null);

      try {
        const data = await requeteGabarit('GET');
        if (!data) return;
        if (editeurObjet) editeurObjet.value = data.objet;
        if (editeurCorps) editeurCorps.value = data.corps;

        const titre = editeur.querySelector<HTMLElement>('[data-editeur-titre]');
        if (titre) {
          titre.textContent = `Modèle « ${data.nom ?? ''} » — ${libelleProfession(contact.profession)}`;
        }
        marquerPersonnalise(data.personnalise);
        editeur.hidden = false;
        editeur.scrollIntoView({ behavior: 'smooth', block: 'center' });
      } catch (err) {
        erreurEditeur(err instanceof Error ? err.message : 'Gabarit illisible.');
      }
    });

    fiche?.querySelector('[data-fermer-editeur]')?.addEventListener('click', fermerEditeur);

    fiche?.querySelector('[data-enregistrer-gabarit]')?.addEventListener('click', async (evenement) => {
      const bouton = evenement.currentTarget as HTMLButtonElement;
      const etat = fiche.querySelector<HTMLElement>('[data-etat-editeur]');
      erreurEditeur(null);
      bouton.disabled = true;

      try {
        const data = await requeteGabarit('PUT', {
          objet: editeurObjet?.value ?? '',
          corps: editeurCorps?.value ?? '',
        });
        if (!data) return;
        marquerPersonnalise(true);
        if (etat) {
          etat.textContent = 'Modèle enregistré ✓';
          etat.hidden = false;
        }
        // Le message en cours est réécrit à partir du nouveau modèle : sinon elle vient
        // d'enregistrer un texte qu'elle ne voit nulle part.
        await chargerGabarit();
      } catch (err) {
        if (etat) etat.hidden = true;
        erreurEditeur(err instanceof Error ? err.message : 'Enregistrement impossible.');
      } finally {
        bouton.disabled = false;
      }
    });

    fiche?.querySelector('[data-reinitialiser-gabarit]')?.addEventListener('click', async () => {
      if (!window.confirm('Revenir au modèle d’origine ? Votre version sera perdue.')) return;
      erreurEditeur(null);

      try {
        const data = await requeteGabarit('DELETE');
        if (!data) return;
        if (editeurObjet) editeurObjet.value = data.objet;
        if (editeurCorps) editeurCorps.value = data.corps;
        marquerPersonnalise(false);
        await chargerGabarit();
      } catch (err) {
        erreurEditeur(err instanceof Error ? err.message : 'Retour au modèle impossible.');
      }
    });

    fiche?.querySelector('[data-envoyer]')?.addEventListener('click', async (evenement) => {
      const bouton = evenement.currentTarget as HTMLButtonElement;
      const contact = contactCourant();
      const erreur = fiche.querySelector<HTMLElement>('[data-erreur-envoi]');
      const etat = fiche.querySelector<HTMLElement>('[data-etat-envoi]');
      if (!contact || !selecteurGabarit) return;
      if (erreur) erreur.hidden = true;

      if (!window.confirm(`Envoyer ce courriel à ${contact.nom} (${contact.courriel}) ?`)) return;

      bouton.disabled = true;
      if (etat) {
        etat.textContent = 'Envoi…';
        etat.hidden = false;
      }

      try {
        const data = await api<{ dev?: boolean; envoisDuJour?: number }>('/api/reseau-envoi', {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({
            id: contact.id,
            gabarit: selecteurGabarit.value,
            objet: champObjet?.value ?? '',
            corps: champCorps?.value ?? '',
          }),
        });
        if (!data) return;
        if (etat) etat.textContent = data.dev ? 'Simulé (Resend absent)' : 'Envoyé ✓';
        await charger();
      } catch (err) {
        if (etat) etat.hidden = true;
        if (erreur) {
          erreur.textContent = err instanceof Error ? err.message : 'Envoi impossible.';
          erreur.hidden = false;
        }
      } finally {
        bouton.disabled = false;
      }
    });

    /* ---------------- Export ---------------- */

    /**
     * Le carnet ne vit que dans Netlify Blobs. Un export en un clic est une assurance à coût
     * nul contre la seule chose qu'on ne saurait pas réparer : sa perte.
     */
    app.querySelector('[data-exporter]')?.addEventListener('click', () => {
      const colonnes = [
        'Nom',
        'Courriel',
        'Téléphone',
        'Agence',
        'Secteur',
        'Profession',
        'État',
        'Relance',
        'Dernier envoi',
        'Consentement',
        'Source',
        'Notes',
      ];

      const echapper = (valeur: string): string => `"${valeur.replace(/"/g, '""')}"`;
      const lignes = contacts.map((contact) =>
        [
          contact.nom,
          contact.courriel,
          contact.telephone,
          contact.agence,
          contact.secteur,
          libelleProfession(contact.profession),
          libelleEtat(contact.etat),
          contact.relanceLe ?? '',
          contact.dernierEnvoiLe ?? '',
          (BASES_CONSENTEMENT as Record<string, string>)[contact.consentement.base] ?? '',
          contact.consentement.source,
          contact.notes,
        ]
          .map(echapper)
          .join(';'),
      );

      // Le BOM et le point-virgule : sans eux, Excel en français ouvre le fichier en une
      // seule colonne et massacre les accents.
      const csv = `﻿${[colonnes.map(echapper).join(';'), ...lignes].join('\r\n')}`;
      const url = URL.createObjectURL(new Blob([csv], { type: 'text/csv;charset=utf-8' }));
      const lien = document.createElement('a');
      lien.href = url;
      lien.download = `reseau-${new Date().toISOString().slice(0, 10)}.csv`;
      lien.click();
      URL.revokeObjectURL(url);
    });

    /* ---------------- Filtres ---------------- */

    for (const selecteur of ['#rs-recherche', '#rs-filtre-etat', '#rs-filtre-profession']) {
      $<HTMLElement>(selecteur)?.addEventListener('input', () => rendreListe());
    }

    /**
     * Un lien du tableau de bord peut nommer un contact par `#f=<id>` : on l'ouvre une fois le
     * carnet chargé.
     */
    function ouvrirDepuisHash(): void {
      const cible = new RegExp('^#f=(.+)$').exec(location.hash);
      if (!cible) return;
      const id = decodeURIComponent(cible[1] ?? '');
      if (contacts.some((c) => c.id === id)) ouvrirFiche(id);
    }

    void charger().then(ouvrirDepuisHash);
  }
</script>
