  }

  #rs-app .rs-fiche-consentement {
    font-size: 0.78rem;
    color: var(--muted);
    margin: 0.5rem 0 0;
  }

  /* Bâti en JavaScript par `chargerLiens` — donc hors de portée du style scopé.
     Nom distinct de `.rs-lien`, qui habille déjà les boutons-liens de la page : une règle
     globale sur ce nom-là les aurait tous repeints. */
  #rs-app .rs-lien-croise {
    margin: 0 0 0.4rem;
    font-size: 0.9rem;
