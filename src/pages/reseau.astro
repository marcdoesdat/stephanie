</style>

<style is:global>
  /* Les cartes du carnet, les urgences et l'historique sont bâties en JavaScript : le style
     scopé d'Astro ne les atteindrait pas — il n'estampe son attribut de portée que sur les
     éléments qu'il rend lui-même. D'où ce bloc global, circonscrit à `#rs-app`. */

  #rs-app .rs-carte {
    width: 100%;
    text-align: left;
    display: block;
    background: var(--white);
    border: 1px solid var(--border);
    border-radius: 14px;
    padding: 0.9rem 1.1rem;
    margin-bottom: 0.6rem;
    cursor: pointer;
