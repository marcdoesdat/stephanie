---
// Réseau de partenaires — /reseau. Réservé à la courtière.
//
// `/partenaires` est la porte entrante : un professionnel arrive et réfère un client. Cette
// page-ci sert le mouvement inverse — Stéphanie qui approche un professionnel, un par un,
// et qui se souvient de qui elle a relancé.
//
// Rendu à l'exécution : la page vérifie le cookie d'accès à chaque requête et, faute de quoi,
// ne rend que l'écran de connexion. Même porte que /contrat — c'est la même personne, et un
// second mot de passe protégerait moins qu'il ne compliquerait. Les endpoints `reseau-*`
// appliquent exactement le même verdict.
//
// Organisation de l'écran : ce qui réclame un geste aujourd'hui est en haut, avant le
// carnet. Une relance qu'il faut chercher est une relance qui n'aura pas lieu.
export const prerender = false;

import MainLayout from '../layouts/MainLayout.astro';
import BarreCourtiere from '../components/BarreCourtiere.astro';
import ConnexionCourtiere from '../components/ConnexionCourtiere.astro';
import { loadSiteConfig } from '../config';
import { accesConfigure, accesLibreEnDev, requeteAutorisee } from '../services/accesCourtiere';
import { adresseDediee } from '../services/reseauCourriels';
import {
  BASES_CONSENTEMENT,
  ETATS,
  GABARITS,
  PLAFOND_QUOTIDIEN,
  PROFESSIONS,
  VARIABLES_DISPONIBLES,
} from '../utils/reseauCourtiers';

const config = loadSiteConfig();
const autorise = await requeteAutorisee(Astro.request);
const configureManquante = !accesConfigure() && !accesLibreEnDev();

Astro.response.headers.set('Cache-Control', 'no-store');

const professions = Object.entries(PROFESSIONS);
const etats = Object.entries(ETATS);
const bases = Object.entries(BASES_CONSENTEMENT);
const gabarits = Object.entries(GABARITS).map(([cle, gabarit]) => ({
  cle,
  nom: gabarit.nom,
  resume: gabarit.resume,
}));

// De quelle adresse partent les approches. Faute de second domaine vérifié dans Resend,
// elles partent aujourd'hui de la même que les liens de signature et les accusés de rappel :
// l'écran le dit en clair plutôt que de le taire, mais sans alarme — un avertissement qui ne
// peut pas être suivi d'effet n'apprend qu'à ignorer les avertissements. Le jour où
// RESEND_FROM_RESEAU sera renseignée, la ligne affichera l'adresse dédiée, ce qui rend aussi
// une coquille visible.
const adresseEnvoi = adresseDediee();
---

<MainLayout
  title="Réseau de partenaires"
  description="Outil interne de développement du réseau de référencement."
  noindex={true}
  sansBarreCta={true}
>
  <main id="main-content" class="rs-page">
    <section class="rs-shell">
      {
        !autorise ? (
          <ConnexionCourtiere
            titre="Réseau de partenaires"
            configureManquante={configureManquante}
            nom={config.nom}
          />
        ) : (
          <div id="rs-app" data-plafond={String(PLAFOND_QUOTIDIEN)}>
            <BarreCourtiere actif="reseau" />
            <header class="rs-entete">
              <div>
                <h1 class="rs-titre">Réseau de partenaires</h1>
                <p class="rs-texte">
                  Les professionnels que vous approchez : courtiers immobiliers, notaires,
                  comptables, planificateurs. Un courriel personnalisé, et le suivi qui va avec.
                </p>
              </div>
              <p class="rs-quota" data-quota hidden />
            </header>

            {adresseEnvoi ? (
              <p class="rs-expediteur">
                Les approches partent de <strong>{adresseEnvoi}</strong>. Les réponses arrivent
                dans votre boîte&nbsp;: {config.courriel}.
              </p>
            ) : (
              <p class="rs-expediteur">
                Les approches partent de l’adresse d’envoi commune du site, celle des liens de
                signature et des accusés de rappel. Les réponses arrivent dans votre
                boîte&nbsp;: {config.courriel}. Espacez vos envois plutôt que de vider le
                carnet en une matinée&nbsp;: une plainte pour pourriel toucherait aussi vos
                courriels de contrat.
              </p>
            )}

            {/* ---------------- À faire aujourd'hui ---------------- */}
            <section class="rs-urgences" id="rs-urgences" aria-live="polite">
              <h2 class="rs-h2">À faire aujourd’hui</h2>
              <div data-urgences />
            </section>

            {/* ---------------- Barre d'outils ---------------- */}
            <section class="rs-outils">
              <div class="rs-filtres">
                <label class="rs-champ-recherche">
                  <span class="sr-only">Rechercher un contact</span>
                  <input
                    type="search"
                    id="rs-recherche"
                    placeholder="Rechercher un nom, une agence…"
                    autocomplete="off"
                  />
                </label>
                <select id="rs-filtre-etat" aria-label="Filtrer par état">
                  <option value="">Tous les états</option>
                  {etats.map(([cle, libelle]) => (
                    <option value={cle}>{libelle}</option>
                  ))}
                </select>
                <select id="rs-filtre-profession" aria-label="Filtrer par profession">
                  <option value="">Toutes les professions</option>
                  {professions.map(([cle, libelle]) => (
                    <option value={cle}>{libelle}</option>
                  ))}
                </select>
              </div>
              <div class="rs-actions-globales">
                <button type="button" class="btn-secondary btn-secondary--sm" data-ouvrir-formulaire>
                  + Nouveau contact
                </button>
                <button type="button" class="rs-lien" data-ouvrir-import>Importer une liste</button>
                <button type="button" class="rs-lien" data-exporter>Exporter (CSV)</button>
              </div>
            </section>

            {/* ---------------- Nouveau contact / correction ---------------- */}
            <form class="contact-form rs-panneau" id="rs-formulaire" hidden>
              <h2 class="rs-h2" data-formulaire-titre>Nouveau contact</h2>
              <input type="hidden" data-formulaire-id />

              <div class="rs-grille">
                <div>
                  <label class="cform-label" for="rs-nom">Nom <span class="cform-required">*</span></label>
                  <input type="text" id="rs-nom" required maxlength="120" autocomplete="off" />
                </div>
                <div>
                  <label class="cform-label" for="rs-courriel">
                    Courriel <span class="cform-required">*</span>
                  </label>
                  <input type="email" id="rs-courriel" required maxlength="200" autocomplete="off" />
                </div>
                <div>
                  <label class="cform-label" for="rs-telephone">Téléphone</label>
                  <input type="tel" id="rs-telephone" maxlength="40" autocomplete="off" />
                </div>
                <div>
                  <label class="cform-label" for="rs-profession">
                    Profession <span class="cform-required">*</span>
                  </label>
                  <select id="rs-profession" required>
                    {professions.map(([cle, libelle]) => (
                      <option value={cle}>{libelle}</option>
                    ))}
                  </select>
                </div>
                <div>
                  <label class="cform-label" for="rs-agence">Agence / cabinet</label>
                  <input type="text" id="rs-agence" maxlength="120" autocomplete="off" />
                </div>
                <div>
                  <label class="cform-label" for="rs-secteur">Secteur</label>
                  <input type="text" id="rs-secteur" maxlength="120" autocomplete="off" placeholder={config.region} />
                </div>
              </div>

              <fieldset class="rs-consentement">
                <legend class="cform-label">
                  D’où vient cette adresse ? <span class="cform-required">*</span>
                </legend>
                <p class="rs-aide">
                  La loi anti-pourriel exige de pouvoir dire, un an plus tard, pourquoi vous
                  aviez le droit d’écrire. C’est aussi ce qui vous protège.
                </p>
                <select id="rs-consentement-base" required>
                  {bases.map(([cle, libelle]) => (
                    <option value={cle}>{libelle}</option>
                  ))}
                </select>
                <input
                  type="text"
                  id="rs-consentement-source"
                  maxlength="200"
                  required
                  placeholder="Ex. : adresse publiée sur le site de son agence"
                />
              </fieldset>

              <label class="cform-label" for="rs-notes">Notes</label>
              <textarea id="rs-notes" maxlength="2000" rows="3" placeholder="Ce qu’il faut se rappeler avant de l’appeler." />

              <p class="rs-erreur" data-erreur-formulaire hidden />
              <div class="rs-panneau-actions">
                <button type="submit" class="btn-cta">Enregistrer</button>
                <button type="button" class="rs-lien" data-fermer-formulaire>Annuler</button>
              </div>
            </form>

            {/* ---------------- Import en lot ---------------- */}
            <form class="contact-form rs-panneau" id="rs-import" hidden>
              <h2 class="rs-h2">Importer une liste</h2>
              <p class="rs-aide">
                Collez une colonne par tabulation ou point-virgule :
                <code>nom ; courriel ; agence ; secteur</code>. Les adresses déjà au carnet
                sont ignorées. La profession et l’origine s’appliquent à tout le lot.
              </p>
              <textarea id="rs-import-texte" rows="6" placeholder="Marie Tremblay ; marie@agence.ca ; RE/MAX Repentigny" />

              <div class="rs-grille">
                <div>
                  <label class="cform-label" for="rs-import-profession">Profession du lot</label>
                  <select id="rs-import-profession">
                    {professions.map(([cle, libelle]) => (
                      <option value={cle}>{libelle}</option>
                    ))}
                  </select>
                </div>
                <div>
                  <label class="cform-label" for="rs-import-base">Origine des adresses</label>
                  <select id="rs-import-base">
                    {bases.map(([cle, libelle]) => (
                      <option value={cle}>{libelle}</option>
                    ))}
                  </select>
                </div>
              </div>
              <label class="cform-label" for="rs-import-source">Précisez la source</label>
              <input
                type="text"
                id="rs-import-source"
                maxlength="200"
                placeholder="Ex. : bottin public des courtiers de Repentigny, août 2026"
              />

              <p class="rs-erreur" data-erreur-import hidden />
              <div class="rs-panneau-actions">
                <button type="submit" class="btn-cta">Importer</button>
                <button type="button" class="rs-lien" data-fermer-import>Annuler</button>
              </div>
            </form>

            {/* ---------------- Le carnet ---------------- */}
            <section class="rs-carnet">
              <h2 class="rs-h2">
                Le carnet <span class="rs-compte" data-compte />
              </h2>
              <div class="rs-liste" data-liste />
            </section>

            {/* ---------------- Fiche ---------------- */}
            <section class="rs-fiche" id="rs-fiche" hidden aria-live="polite">
              <div class="rs-fiche-entete">
                <div data-fiche-identite />
                <button type="button" class="rs-lien" data-fermer-fiche>Fermer</button>
              </div>

              <div class="rs-fiche-actions">
                <select data-fiche-etat aria-label="État du contact">
                  {etats.map(([cle, libelle]) => (
                    <option value={cle}>{libelle}</option>
                  ))}
                </select>
                <label class="rs-fiche-relance">
                  <span>Revenir le</span>
                  <input type="date" data-fiche-relance />
                </label>
                <button type="button" class="btn-secondary btn-secondary--sm" data-fiche-modifier>
                  Corriger la fiche
                </button>
                <button type="button" class="rs-lien rs-lien--danger" data-fiche-supprimer>
                  Supprimer
                </button>
              </div>

              <div class="rs-fiche-note">
                <label class="cform-label" for="rs-note-rapide">Ajouter une note</label>
                <div class="rs-note-ligne">
                  <input
                    type="text"
                    id="rs-note-rapide"
                    maxlength="2000"
                    placeholder="« Rappelé, veut qu'on se voie en septembre »"
                  />
                  <button type="button" class="btn-secondary btn-secondary--sm" data-ajouter-note>
                    Noter
                  </button>
                </div>
              </div>

              {/* ---------------- Composition ---------------- */}
              <div class="rs-composer" data-composer>
                <h3 class="rs-h3">Écrire</h3>
                <div class="rs-gabarit-ligne">
                  <label class="cform-label" for="rs-gabarit">Gabarit</label>
                  <span class="rs-gabarit-etat" data-gabarit-personnalise hidden>réécrit par vous</span>
                  <button type="button" class="rs-lien" data-modifier-gabarit>Modifier ce gabarit</button>
                </div>
                <select id="rs-gabarit">
                  {gabarits.map((gabarit) => (
                    <option value={gabarit.cle} title={gabarit.resume}>
                      {gabarit.nom} — {gabarit.resume}
                    </option>
                  ))}
                </select>

                {/* ---------------- Édition du gabarit ---------------- */}
                <div class="rs-editeur" data-editeur-gabarit hidden>
                  <h4 class="rs-editeur-titre" data-editeur-titre />
                  <p class="rs-aide">
                    Vous modifiez le modèle, pas ce message-ci : il servira à toutes vos
                    prochaines approches de cette profession. Les mots entre accolades sont
                    remplacés à l’envoi.
                  </p>

                  <label class="cform-label" for="rs-editeur-objet">Objet du modèle</label>
                  <input type="text" id="rs-editeur-objet" maxlength="200" />

                  <label class="cform-label" for="rs-editeur-corps">Texte du modèle</label>
                  <textarea id="rs-editeur-corps" rows="16" maxlength="6000" />

                  <details class="rs-variables">
                    <summary>Les variables disponibles</summary>
                    <ul>
                      {VARIABLES_DISPONIBLES.map((variable) => (
                        <li>
                          <code>{`{{${variable.cle}}}`}</code> — {variable.aide}
                        </li>
                      ))}
                    </ul>
                    <p class="rs-aide">
                      Pour un passage qui ne doit paraître que si l’information existe,
                      encadrez-le : <code>{'{{#agence}}'}</code> chez <code>{'{{agence}}'}</code>
                      <code>{'{{/agence}}'}</code>. Sans agence connue, le passage disparaît au
                      lieu de laisser un blanc.
                    </p>
                  </details>

                  <p class="rs-erreur" data-erreur-editeur hidden />
                  <div class="rs-panneau-actions">
                    <button type="button" class="btn-secondary btn-secondary--sm" data-enregistrer-gabarit>
                      Enregistrer le modèle
                    </button>
                    <button type="button" class="rs-lien" data-reinitialiser-gabarit hidden>
                      Revenir au modèle d’origine
                    </button>
                    <button type="button" class="rs-lien" data-fermer-editeur>Annuler</button>
                    <span class="rs-etat-envoi" data-etat-editeur hidden />
                  </div>
                </div>

                <label class="cform-label" for="rs-objet">Objet</label>
                <input type="text" id="rs-objet" maxlength="200" />

                <label class="cform-label" for="rs-corps">Message</label>
                <textarea id="rs-corps" rows="16" maxlength="6000" />
                <p class="rs-aide">
                  Votre signature, vos coordonnées, votre numéro AMF et le lien de retrait
                  sont ajoutés automatiquement au bas du courriel. Relisez, retouchez —
                  <strong>l’objet autant que le message</strong> : un texte qu’on n’a pas
                  retouché se reconnaît à dix mètres, et vingt objets identiques se
                  reconnaissent aussi, mais par les filtres.
                </p>

                <p class="rs-erreur" data-erreur-envoi hidden />
                <div class="rs-panneau-actions">
                  <button type="button" class="btn-cta" data-envoyer>Envoyer</button>
                  <span class="rs-etat-envoi" data-etat-envoi hidden />
                </div>
              </div>

              <div class="rs-panneau-liens" data-liens-bloc hidden>
                <h3 class="rs-h3">Ce contact, ailleurs</h3>
                <div data-liens />
              </div>

              <div class="rs-historique">
                <h3 class="rs-h3">Historique</h3>
                <ol data-historique />
              </div>
            </section>
          </div>
        )
      }
    </section>
  </main>
</MainLayout>

<style>
  .rs-page {
    background: var(--sand);
    min-height: 100vh;
    padding: 2.5rem 1.25rem 5rem;
  }

  .rs-shell {
    max-width: 62rem;
    margin: 0 auto;
  }

  /* global.css donne à tout `section` la respiration d'une section de page vitrine
     (jusqu'à 4rem de padding). Ici, les sections sont les blocs d'un tableau de bord :
     cette respiration les désaligne et étire l'écran sur deux fois sa hauteur utile. */
  .rs-page section {
    padding: 0;
  }

  .rs-titre {
    font-size: 1.6rem;
    margin: 0 0 0.5rem;
  }

  .rs-h2 {
    font-size: 1.05rem;
    margin: 0 0 0.85rem;
    display: flex;
    align-items: baseline;
    gap: 0.5rem;
  }

  .rs-h3 {
    font-size: 0.95rem;
    margin: 0 0 0.75rem;
  }

  .rs-texte {
    font-size: 0.92rem;
    line-height: 1.6;
    color: var(--muted);
    margin: 0;
    max-width: 46ch;
  }

  .rs-alerte {
    font-size: 0.9rem;
    line-height: 1.6;
    background: #fdf3ec;
    border: 1px solid var(--clay);
    border-radius: 12px;
    padding: 1rem;
  }

  .rs-note {
    font-size: 0.85rem;
    line-height: 1.6;
    background: #fdf3ec;
    border: 1px solid var(--border);
    border-radius: 12px;
    padding: 0.85rem 1rem;
    margin: 0 0 1.5rem;
    color: var(--muted);
  }

  .rs-note code,
  .rs-alerte code {
    font-size: 0.82em;
    background: var(--white);
    padding: 0.1rem 0.35rem;
    border-radius: 5px;
  }

  .rs-erreur {
    font-size: 0.85rem;
    color: #b3261e;
    margin: 0.5rem 0 0;
  }

  .rs-expediteur {
    font-size: 0.82rem;
    line-height: 1.6;
    color: var(--muted);
    margin: 0 0 1.5rem;
  }

  .rs-expediteur strong {
    color: var(--ink);
  }

  .rs-entete {
    display: flex;
    flex-wrap: wrap;
    gap: 1rem;
    align-items: flex-start;
    justify-content: space-between;
    margin-bottom: 1.5rem;
  }

  .rs-quota {
    font-size: 0.8rem;
    color: var(--muted);
    background: var(--white);
    border: 1px solid var(--border);
    border-radius: 999px;
    padding: 0.4rem 0.9rem;
    margin: 0;
    white-space: nowrap;
  }

  .rs-urgences {
    margin-bottom: 1.75rem;
  }

  .rs-outils {
    display: flex;
    flex-wrap: wrap;
    gap: 0.75rem 1rem;
    align-items: center;
    justify-content: space-between;
    margin-bottom: 1.25rem;
  }

  .rs-filtres {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem;
  }

  .rs-filtres input,
  .rs-filtres select {
    padding: 0.55rem 0.9rem;
    background: var(--white);
    border: 1.5px solid var(--border);
    border-radius: 10px;
    font-family: inherit;
    font-size: 0.88rem;
    color: var(--ink);
  }

  .rs-champ-recherche input {
    min-width: 15rem;
  }

  .rs-actions-globales {
    display: flex;
    align-items: center;
    gap: 0.9rem;
  }

  .rs-lien {
    background: none;
    border: none;
    padding: 0;
    font-family: inherit;
    font-size: 0.85rem;
    color: var(--clay);
    text-decoration: underline;
    cursor: pointer;
  }

  .rs-lien--danger {
    color: #b3261e;
  }

  .rs-panneau {
    margin-bottom: 1.75rem;
  }

  .rs-grille {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(13rem, 1fr));
    gap: 0 1rem;
  }

  .rs-consentement {
    border: 1px solid var(--border);
    border-radius: 12px;
    padding: 1rem 1.1rem 0.4rem;
    margin: 0 0 1.2rem;
  }

  .rs-aide {
    font-size: 0.8rem;
    line-height: 1.55;
    color: var(--muted);
    margin: 0 0 0.75rem;
  }

  .rs-panneau-actions {
    display: flex;
    align-items: center;
    gap: 1rem;
    margin-top: 0.5rem;
  }

  .rs-compte {
    font-size: 0.8rem;
    font-weight: 400;
    color: var(--muted);
  }

  .rs-fiche {
    background: var(--white);
    border: 1px solid var(--border);
    border-radius: 20px;
    padding: 1.75rem;
    margin-top: 1.75rem;
  }

  .rs-fiche-entete {
    display: flex;
    justify-content: space-between;
    align-items: flex-start;
    gap: 1rem;
    margin-bottom: 1rem;
  }

  .rs-fiche-actions {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0.75rem;
    padding: 0.9rem 0;
    border-top: 1px solid var(--border);
    border-bottom: 1px solid var(--border);
  }

  .rs-fiche-actions select,
  .rs-fiche-relance input {
    padding: 0.5rem 0.75rem;
    background: var(--sand);
    border: 1.5px solid var(--border);
    border-radius: 10px;
    font-family: inherit;
    font-size: 0.85rem;
    color: var(--ink);
  }

  .rs-fiche-relance {
    display: flex;
    align-items: center;
    gap: 0.5rem;
    font-size: 0.82rem;
    color: var(--muted);
  }

  .rs-fiche-note {
    margin: 1.25rem 0;
  }

  .rs-note-ligne {
    display: flex;
    gap: 0.6rem;
  }

  .rs-note-ligne input {
    flex: 1;
    padding: 0.6rem 0.9rem;
    background: var(--sand);
    border: 1.5px solid var(--border);
    border-radius: 10px;
    font-family: inherit;
    font-size: 0.88rem;
    color: var(--ink);
  }

  .rs-composer {
    border-top: 1px solid var(--border);
    padding-top: 1.25rem;
  }

  .rs-composer select,
  .rs-composer input,
  .rs-composer textarea {
    width: 100%;
    padding: 0.7rem 0.95rem;
    background: var(--sand);
    border: 1.5px solid var(--border);
    border-radius: 10px;
    font-family: inherit;
    font-size: 0.9rem;
    color: var(--ink);
    margin-bottom: 1rem;
  }

  .rs-composer textarea {
    line-height: 1.6;
    resize: vertical;
  }

  .rs-etat-envoi {
    font-size: 0.85rem;
    color: var(--muted);
  }

  .rs-gabarit-ligne {
    display: flex;
    align-items: baseline;
    gap: 0.75rem;
    flex-wrap: wrap;
  }

  .rs-gabarit-ligne .cform-label {
    margin-bottom: 0.6rem;
  }

  .rs-gabarit-etat {
    font-size: 0.72rem;
    font-weight: 600;
    letter-spacing: 0.02em;
    padding: 0.15rem 0.55rem;
    border-radius: 999px;
    background: #fdf3ec;
    border: 1px solid #edd0ba;
    color: var(--clay);
  }

