    padding: 0.18rem 0.6rem;
    border-radius: 999px;
    background: var(--sand);
    border: 1px solid var(--border);
    color: var(--muted);
  }

  #rs-app .rs-badge[data-etat='a_contacter'] {
    background: #eef3fb;
    border-color: #c6d6ec;
    color: #2f5d99;
  }

  #rs-app .rs-badge[data-etat='partenaire'] {
    background: #eaf6ee;
    border-color: #b8dcc4;
